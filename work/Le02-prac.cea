// Le02 1.20a practice port.
// Native-menu interaction derived from Priw8 prac.cea v0.2.
// Stage/pattern research: leprac, Oscar; phase skips: RosePenguin100.
// Target SHA-256: 22bba60f6250f95437c08cdcf1e1114ea16aa1537f26c4334f1a699dc37cb8c9
// CE: attach to the prepared Le02prac.exe; enable before entering practice.
// All numeric literals are hexadecimal. Do not apply to another version.
define(game,"Le02prac.exe")
define(cave,game+B92000)
define(DIFF,game+ADDFE8)
define(CHAR_IDX,game+ADDFEC)
define(getInput,game+74510)
define(getTextTexture,game+EBF60)
define(drawTextTexture,game+F2C40)
define(KEY_DOWN,KEYS+0)
define(KEY_LEFT,KEYS+4)
define(KEY_RIGHT,KEYS+8)
define(KEY_UP,KEYS+C)
define(KEY_Z,KEYS+10)
define(KEY_X,KEYS+14)
define(KEY_SHIFT,KEYS+18)
// --- F12 overlay (v0.4.0) ---
define(KBD_IAT,game+3AC2E8)
define(KEYSHADOW,game+5E0B8C)
define(box,game+D1010)
// --- hint file I/O (v0.6.0), all stdcall ---
define(MODULE_IAT,game+3AC1B0)
define(FILE_IAT,game+3AC238)
define(READ_IAT,game+3AC0E8)
define(CLOSE_IAT,game+3AC250)
define(WRITE_IAT,game+3AC22C)
define(GETSIZE_IAT,game+3AC0E0)
define(SEEK_IAT,game+3AC0CC)
define(FINDFIRST_IAT,game+3AC0D8)
define(FINDNEXT_IAT,game+3AC0DC)
define(FINDCLOSE_IAT,game+3AC0D4)

[ENABLE]
// --- F12 overlay (v0.4.0): hooks inside the real per-frame function ---
// game+CFFCD is 10 bytes into the frame function (mov [game+65110],1).
assert(game+CFFCD,C7 05 10 51 A6 00 01 00 00 00)
// game+14BD50 is the present function's entry: `push ebp / mov ebp,esp /
// sub esp,0x4cc`.  It is called once per frame from game+DF9AF, at the
// moment the scene has been drawn but nothing has been blitted yet, and
// it is reached in every mode (title, menu, stage, replay).  That makes
// it the one point where an overlay can be drawn and still be presented.
assert(game+14BD50,55 8B EC 81 EC CC 04 00 00)
// the four keyboard-refresh call sites, all `call game+140CD0`.
assert(game+CF255,E8 76 1A 07 00)
assert(game+CF2B5,E8 16 1A 07 00)
assert(game+CF445,E8 86 18 07 00)
assert(game+CF7CD,E8 FE 14 07 00)
// The IAT slots hold the RVA of the hint/name entry on disk, which is
// what pins us to this exact build.
assert(game+3AC2E8,80 67 44 00)
assert(game+3AC018,C4 68 44 00)
assert(game+3AC01C,D8 68 44 00)
assert(game+5E0B8C,00 00 00 00)
// ---- v0.4.0: the game-over decision and the per-frame power clamp ----
// game+B980C is the `cmp [player+0x48], 0 / jg <respawn>` that decides
// between respawning and GAME OVER.  Six bytes, and the check happens
// BEFORE the shared `dec [player+0x48]`, so "pretend life == 1" is enough.
assert(game+B980C,83 78 48 00 7F 2E)
// game+B9B05 is the tail of the player update: `clamp power into [0,500]`.
// It runs every frame anyway, which is why freezing power here costs
// nothing extra -- we are replacing an existing write, not adding one.
assert(game+B9B05,8B 07 83 78 7C 00 7D 07 C7 40 7C 00 00 00 00 8B 07 81 78 7C F4 01 00 00 7C 07 C7 40 7C F4 01 00 00)
// ---- v0.5.0: the RNG seed ----
// game+B2BD9 is the ONLY call to the seed wrapper (verified by a full
// .text sweep: the wrapper at 0xD04D0 has exactly one caller, and the
// seed global 0xEDDFF4 has exactly one reader -- this one).  Five bytes.
assert(game+B2BD9,E8 F2 D8 01 00)
assert(game+74112,68 d0 9c 83 00)
assert(game+B264E,8b f9 0f 57 c0)
assert(game+B32C6,c7 47 4c 00 00 00 00)
assert(game+27E90,89 07 e8 c8 69 29 00)
assert(game+B67E9,e8 c2 bc 02 00)
assert(game+B37CE,c7 87 24 28 00 00 00 00 00 00)
assert(game+B9091,c7 40 58 00 00 00 00)
assert(game+C29A5,8b 46 4c 3b 46 68)
assert(game+C29D0,6a 00 ff 76 30)
assert(game+C49FB,80 bb a1 00 00 00 01)
assert(game+C4C92,80 bb a1 00 00 00 01)
assert(game+C4DAE,80 bb a1 00 00 00 01)
assert(game+C4F80,80 bb a1 00 00 00 01)
assert(game+C513E,80 bb a1 00 00 00 00)
assert(game+6B7BA,c7 05 88 08 9e 00 01 00 00 00)
assert(game+6B837,81 fe 7c 0b 00 00)
assert(game+27724,c7 83 24 09 00 00 94 2f 00 00)
assert(game+D5DB,c7 46 08 00 00 00 00)
assert(game+D698,e8 10 08 2b 00)
assert(game+D588,e8 e2 15 2b 00)
assert(game+B902B,c7 40 48 09 00 00 00)
assert(game+B9064,8b 84 83 a8 00 00 00)
assert(game+73F67,0a)
assert(game+7405F,68 36 01 00 00)
assert(game+7409B,68 36 01 00 00)
assert(cave+3FF0,4c 45 50 52 41 43 32 3a 46 49 58 45 44 3a 31 00)
