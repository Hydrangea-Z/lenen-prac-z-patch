DLL_LOADED:
  dd 0
SPEED_FPS:
  dd 3C
SPEED_TYPING:
  dd 0
DLLNAME:
  db 4C 65 30 33 73 70 65 65 64 2E 64 6C 6C 00
NOVSYNC_PTR:
  dd 0
NVNAME:
  db 67 5F 6E 6F 56 73 79 6E 63 00
// =================================================================== //
// F12 overlay (v0.4.0) -- infrastructure.                            //
//   game+CFFCD  -> logic (read keys, menu)                            //
//   game+CF7CD + 3 siblings -> run the game's input refresh, then     //
//                  wipe KEYSHADOW while the menu is open              //
//   game+14BD50 -> present-function entry: paint the overlay there    //
// =================================================================== //
overlay_entry:
  pushfd
  pushad
  inc dword ptr [PRB_FRAMES]
  call overlay_logic
  popad
  popfd
  // re-execute the instruction we displaced, then rejoin the function
  mov dword ptr [game+665110], 1
  jmp game+CFFD7

// ---- end-of-scene hook --------------------------------------------- //
// game+14BD50 is the present function.  Its entry is the last point at
// which the game's own drawing helpers still work AND nothing has been
// blitted to the window yet, so the overlay we paint here is guaranteed
// to be part of the frame the game is about to show.  (Drawing at the
// end of the frame function instead is silently discarded: the renderer
// is already torn down by then, which is why v0.3.1/v0.3.2 showed
// nothing even though every hook fired.)
overlay_present:
  pushfd
  pushad
  inc dword ptr [PRB_PRES]
  // v0.6.0: call this every frame, not only when the menu is open -- hint
  // markers are meant to be visible while you are playing.  overlay_draw
  // decides what actually gets painted.
  call overlay_draw
ovl_pres_done:
  popad
  popfd
  // re-execute the prologue we displaced, then rejoin the function
  push ebp
  mov ebp, esp
  sub esp, 4cc
  jmp game+14BD59

// ---- input-refresh wrapper ---------------------------------------- //
// Entered by a `call` that replaced `call game+140CD0`, so the stack
// is [ret][arg] -- exactly what the real callee expects.  All four
// sites push one argument and `add esp,4` after the call.
overlay_input:
  pushfd
  pushad
  inc dword ptr [PRB_INPUT]
  push dword ptr [esp+40]
  call game+140CD0
  add esp, 4
  cmp dword ptr [OVERLAY_OPEN], 0
  je ovl_in_done
  xor eax, eax
  mov ecx, 40
  mov edi, KEYSHADOW
ovl_in_clear:
  mov [edi], eax
  add edi, 4
  dec ecx
  jnz ovl_in_clear
ovl_in_done:
  popad
  popfd
  ret

fps_tick:
  jmp fps_tick2


overlay_logic:
  pushfd
  pushad
  call fps_tick
  // A new frame starts here: allow exactly one overlay draw this frame.
  mov dword ptr [OVL_DRAWN], 0
  // ---- settings file (v0.7.8): load once, then persist any change ----
  // Deliberately first, and before the menu-open test further down: it
  // must run in every scene, not only while the F12 panel is up.
  call cfg_tick
  // Mirror the hit counter into its read-only menu row.  It counts every
  // hit, not just fatal ones -- see NOSORE_DEBT.
  mov eax, [NOSORE_DEBT]
  mov [OVL_V_DEBT], eax
  // Same for the stage frame counter at [stage+0x4C].  The pointer is only
  // stashed at stage start, so range-check it: outside the stage it holds a
  // stale value, and a wild pointer here would fault on every frame.
  mov eax, [DBG_STAGE]
  cmp eax, 10000
  jb ovl_frame_done
  cmp eax, 7FFF0000
  ja ovl_frame_done
  mov eax, [eax+4C]
ovl_frame_done:
  mov [OVL_V_FRAME], eax
  // ---- boss pattern tracking (v0.7.2) --------------------------------
  // MUST live up here, not down with the menu work: when the menu is
  // closed overlay_logic jumps straight to ovl_logic_done, so anything
  // after that point only runs while F12 is open -- and the boss patterns
  // have to be tracked during ordinary play.
  //
  // POLL, do not hook: the pattern index is reachable from the stage object
  // we already keep, and the one obvious hook site (game+27E90) is already
  // taken by BAN's applyPatternIdWarp.  The chain, all verified against the
  // vanilla exe:
  //   RVA 0xB2F4C  mov [stage+8], eax    ; the boss manager
  //   RVA 0x27E90  mov [manager+0], eax  ; the boss pattern object
  //   ...and the game keeps the 0-BASED pattern ordinal at [boss+0x44]
  //      (0 = the first pattern of the stage = the mid non-spell).
  // See the long evidence chain further down, right before the read -- it
  // covers the doc quote, BAN's own write site, and the live F12 read.
  //
  // [stage+0x30] (the stage number, 1..7) doubles as a liveness check, so a
  // stale DBG_STAGE -- between stages, or on the title screen -- can never
  // make us walk into freed memory.
  mov eax, [DBG_STAGE]
  cmp eax, 10000
  jb ovl_boss_clear
  cmp eax, 7FFF0000
  ja ovl_boss_clear
  mov ecx, [eax+30]
  cmp ecx, 1
  jb ovl_boss_clear
  cmp ecx, 7
  ja ovl_boss_clear
  mov eax, [eax+8]
  cmp eax, 10000
  jb ovl_boss_clear
  cmp eax, 7FFF0000
  ja ovl_boss_clear
  mov eax, [eax]
  cmp eax, 10000
  jb ovl_boss_clear
  cmp eax, 7FFF0000
  ja ovl_boss_clear
  // ---- is a boss/mid-boss on screen at all? ----
  // [boss+0x08] is the gate, NOT [boss+0x44].  Measured through stage 1:
  //   0x08: 0 mid-stage, 1 from frame 2600 (mid-boss) to 2805, 0 until
  //         4000, then 1 again for the stage boss.
  //
  // [boss+0x44] is the game's own "Pattern number" -- and it is 0-BASED.
  //
  // v0.7.6 -- this was wrong twice, so here is the evidence chain.
  //
  // (1) The authoritative practice doc for this game
  //     (D:/STG/leprac/EMSRMIprac.txt) says, of the value you warp with:
  //       "This value determines what pattern the boss will use.  The
  //        FIRST pattern of the stage will have a value of 0, the second
  //        will have 1, third 2 etc."
  //
  // (2) BAN's own upstream source writes exactly that value here.  Its
  //     applyPatternIdWarp hook (game+27E90) does
  //         mov ebx, [SELECTED_ID]
  //         mov [eax+44], ebx
  //     and SELECTED_ID is built as
  //         mov ebx, [IDS_TABLE+eax*4]     ; ids_0 = FFFFFFFF 0 1 2 3 4 5
  //         mov edx, [ebx+ecx*4]           ; ecx = menu row index
  //     with the names_0 row list being
  //         None / MNon 1 / MSpell 1 / Non 1 / Spell 1 / Non 2 / Spell 2
  //
  // (3) The F12 menu of the PREVIOUS build settled it.  During stage 1 the
  //     user read: mid non -> -1, mid spell -> 0.  That build displayed
  //     `raw - 1`, so mid non really has raw 0 and mid spell raw 1.
  //
  // (4) This build's own probe agrees: [boss+0x44] becomes 0 on the exact
  //     frame the mid-boss appears (stage frame 2600).
  //
  // So the ordinal to expose is [boss+0x44] ITSELF -- value 0 is the mid
  // non-spell, which is exactly what the hint file's `boss:0:...` must
  // match.  (v0.7.4 subtracted 1 and so shifted every window up by one
  // pattern, which is why `boss:0:0 -> boss:1:0` lit up during the mid
  // SPELL instead of the mid non.)
  mov ecx, [eax+8]
  test ecx, ecx
  jz ovl_boss_clear
  // ---- a new fight just began? ----
  // A freshly built boss object carries the PREVIOUS fight's last pattern
  // number until its own first pattern starts.  Left alone that shows the
  // mid-boss's last spell for the whole of the stage boss's intro dialogue.
  // Patterns only ever increase, so the first pattern of a new fight can
  // never legitimately equal the last one of the previous fight -- which
  // makes that value safe to treat as "not started yet" and skip.
  cmp dword ptr [HINT_PAT_WAS], 0
  jne ovl_boss_same_fight
  mov ecx, [HINT_PAT_LAST]
  mov [HINT_PAT_SKIP], ecx
ovl_boss_same_fight:
  mov dword ptr [HINT_PAT_WAS], 1
  mov eax, [eax+44]
  // v0.7.5 -- sanity-clamp the raw ordinal, and reject negatives.
  //
  // The pointer chain above can only prove the address is PLAUSIBLE, not
  // that the object is still alive: during boss teardown the manager still
  // points at memory the game has already recycled, and one frame of a
  // real stage-1 run was measured reading [boss+0x44] = 0xCC8A9D04 (heap
  // fill junk) and [boss+0x08] = 0x1F6E0A6A (junk that happens to be
  // non-zero, so the on-screen gate passed it).  Left unchecked that
  // garbage got stored in HINT_PAT_IDX / HINT_PAT_LAST and could suppress
  // a legitimate pattern in the NEXT fight via HINT_PAT_SKIP.
  //
  // No stage of this game has anywhere near 0x400 patterns
  // (MAX_PATTERNID tops out at 0x15), so anything outside 0..0x3FF is junk
  // and is treated as "not on a pattern" (HINT_PAT_ON = 0), i.e. the same
  // state as mid-stage.  Signed compare so a negative raw lands there too.
  cmp eax, 0
  jl ovl_boss_zero
  cmp eax, 400
  jae ovl_boss_zero
  jmp ovl_boss_have
ovl_boss_zero:
  // v0.7.6 -- this label now means "the boss is on screen but we cannot
  // trust a pattern number for it": either the raw field is garbage
  // (out of 0..0x3FF) or negative.  A boss IS present, we just do not know
  // which pattern, so leave HINT_PAT_IDX at its last known value and keep
  // HINT_PAT_ON = 0 so no boss:P:F window can fire.
  //
  // NOTE: raw 0 is NOT routed here any more -- 0 is the mid non-spell
  // (see the evidence chain above), so it takes the normal ovl_boss_have
  // path and HINT_PAT_IDX becomes 0.
  mov dword ptr [HINT_PAT_ON], 0
  jmp ovl_boss_done
ovl_boss_have:
  cmp eax, [HINT_PAT_SKIP]
  je ovl_boss_suppress
  mov dword ptr [HINT_PAT_SKIP], FFFFFFFF
  cmp eax, [HINT_PAT_IDX]
  je ovl_boss_tick
  // A new pattern: restart the pattern-local clock.
  mov [HINT_PAT_IDX], eax
  mov [HINT_PAT_LAST], eax
  mov dword ptr [HINT_PAT_FRAME], 0
  mov dword ptr [HINT_PAT_ON], 1
  jmp ovl_boss_done
ovl_boss_tick:
  // The pattern-local frame count is OUR OWN counter, incremented once per
  // frame, and NOT a delta on [stage+0x4C].  That stage timer FREEZES for
  // the duration of the intro dialogue (measured: 13 frames over 55 seconds
  // across the mid non-spell), so a delta on it would sit near zero for the
  // whole first pattern of a fight and boss:P:F could never fire.
  inc dword ptr [HINT_PAT_FRAME]
  mov dword ptr [HINT_PAT_ON], 1
  jmp ovl_boss_done
ovl_boss_suppress:
  mov dword ptr [HINT_PAT_ON], 0
  jmp ovl_boss_done
ovl_boss_clear:
  mov dword ptr [HINT_PAT_ON], 0
  mov dword ptr [HINT_PAT_WAS], 0
  mov dword ptr [HINT_PAT_IDX], 0
ovl_boss_done:
  // Mirror into the read-only Pattern row.  Deliberately a mirror of
  // HINT_PAT_IDX and not a second read of the game: the row must show what
  // the hint logic is actually using, or it is useless for working out
  // which number to write in a boss:P:F window.
  //
  // Mid-stage it shows -1, NOT 0.  Pattern 0 is a real pattern (the mid
  // non-spell), so "no boss" has to be a different value or the two are
  // indistinguishable -- exactly the trap that made a boss:0 window light
  // up in the middle of the mid-stage.
  mov eax, [HINT_PAT_IDX]
  cmp dword ptr [HINT_PAT_ON], 0
  jne ovl_boss_mirror
  mov eax, FFFFFFFF
ovl_boss_mirror:
  mov [OVL_V_PATTERN], eax
  // ---- the physical keyboard, into our own 256-byte buffer ----
  push OVL_VKBUF
  call dword ptr [KBD_IAT]
  // ---- v0.8.0: pause-menu quick keys (R = restart, Q = title) ----------
  // These do NOT drive the menu and do NOT inject keystrokes: they write the
  // same scene phase the menu's 从头再来 / 返回标题 items write once confirmed.
  // Inert unless the pause menu is open, so R/Q are harmless in play.
  mov al, byte ptr [OVL_VKBUF+52]
  and al, 80
  mov cl, byte ptr [OVL_PREV_RQ+0]
  mov byte ptr [OVL_PREV_RQ+0], al
  cmp al, cl
  je ovl_pk_r_done
  test al, al
  jz ovl_pk_r_done
  mov edx, 6
  call ovl_pause_action
ovl_pk_r_done:
  mov al, byte ptr [OVL_VKBUF+51]
  and al, 80
  mov cl, byte ptr [OVL_PREV_RQ+1]
  mov byte ptr [OVL_PREV_RQ+1], al
  cmp al, cl
  je ovl_pk_q_done
  test al, al
  jz ovl_pk_q_done
  mov edx, 9
  call ovl_pause_action
ovl_pk_q_done:
  movzx eax, byte ptr [OVL_VKBUF+7B]
  mov [PRB_F12], eax
  // ---- F12 (VK 7B) rising edge toggles the menu ----
  and al, 80
  mov cl, byte ptr [OVL_PREV_F12]
  mov byte ptr [OVL_PREV_F12], al
  cmp al, cl
  je ovl_toggle_done
  test al, al
  jz ovl_toggle_done
  xor dword ptr [OVERLAY_OPEN], 1
  inc dword ptr [PRB_F12N]
ovl_toggle_done:
  mov eax, [OVERLAY_OPEN]
  mov [PRB_OPEN], eax
  // NOTE: the old "freeze while the menu is open" switch lived here.  It
  // was never verified (see plan-hint.md 19) and the user asked for it to
  // be dropped, so the row and this branch are both gone.
  cmp eax, 0
  jne ovl_menu_open
  // Closed: forget the edges and the held key so reopening starts clean,
  // and make sure the Seed row is showing its normal label again.
  mov dword ptr [OVL_PREV_KEYS], 0
  mov dword ptr [OVL_PREV_KEYS+4], 0
  // v0.7.11 -- with the panel closed the row set is the main table again,
  // so F12 always reopens on the main menu.
  mov dword ptr [OVL_SUB], 0
  call ovl_type_exit
  call ovl_reset_hold
  jmp ovl_logic_done
ovl_menu_open:
  // v0.7.11 -- pick up the live row set before any key is interpreted, so
  // the input handler and the renderer always agree even if OVL_SUB
  // changed since the last frame.
  call ovl_set_active
  mov al, byte ptr [OVL_VKBUF+26]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+0]
  mov byte ptr [OVL_PREV_KEYS+0], al
  cmp al, cl
  je ovl_up_done
  test al, al
  jz ovl_up_done
  call ovl_move_up
ovl_up_done:
  mov al, byte ptr [OVL_VKBUF+28]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+1]
  mov byte ptr [OVL_PREV_KEYS+1], al
  cmp al, cl
  je ovl_down_done
  test al, al
  jz ovl_down_done
  call ovl_move_down
ovl_down_done:
  mov al, byte ptr [OVL_VKBUF+25]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+2]
  mov byte ptr [OVL_PREV_KEYS+2], al
  cmp al, cl
  je ovl_left_done
  test al, al
  jz ovl_left_done
  call ovl_move_left
ovl_left_done:
  mov al, byte ptr [OVL_VKBUF+27]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+3]
  mov byte ptr [OVL_PREV_KEYS+3], al
  cmp al, cl
  je ovl_right_done
  test al, al
  jz ovl_right_done
  call ovl_move_right
ovl_right_done:
  // ---- held LEFT/RIGHT: after OVL_HOLD_DELAY frames, fine-step by 1 --
  mov dl, byte ptr [OVL_VKBUF+27]
  and dl, 80
  jz ovl_hold_not_right
  mov ecx, 1
  jmp ovl_hold_check
ovl_hold_not_right:
  mov dl, byte ptr [OVL_VKBUF+25]
  and dl, 80
  jz ovl_hold_none
  mov ecx, 2
ovl_hold_check:
  cmp ecx, [OVL_HOLD_DIR]
  jne ovl_hold_new
  inc dword ptr [OVL_HOLD_N]
  mov eax, [OVL_HOLD_N]
  cmp eax, [OVL_HOLD_DELAY]
  jl ovl_hold_done
  inc dword ptr [OVL_NUDGE_N]
  mov eax, [OVL_NUDGE_N]
  cmp eax, [OVL_NUDGE_EVERY]
  jl ovl_hold_done
  mov dword ptr [OVL_NUDGE_N], 0
  cmp ecx, 1
  jne ovl_hold_left
  call ovl_nudge_right
  jmp ovl_hold_done
ovl_hold_left:
  call ovl_nudge_left
  jmp ovl_hold_done
ovl_hold_new:
  mov [OVL_HOLD_DIR], ecx
  mov dword ptr [OVL_HOLD_N], 0
  mov dword ptr [OVL_NUDGE_N], 0
  jmp ovl_hold_done
ovl_hold_none:
  call ovl_reset_hold
ovl_hold_done:
  // ---- Lock Seed rising edge: adopt the seed already in use ----------
  // Deliberately SEED_USED (what the RNG was actually seeded with at this
  // stage's start) and NOT the seed global at 0xEDDFF4.  Measured: the
  // global is stable during play but does NOT hold the seed the RNG got --
  // a second code path (0x72E39) overwrites it with a bare A*A right after
  // the stage scene is built.  SEED_USED is the value handed to the seed
  // wrapper, which is the thing a replay has to reproduce.
  mov eax, [SEED_ON]
  cmp eax, [OVL_PREV_SEEDSW]
  je ovl_seedsw_done
  mov [OVL_PREV_SEEDSW], eax
  test eax, eax
  jz ovl_seedsw_done
  mov eax, [SEED_USED]
  mov [SEL_SEED], eax
ovl_seedsw_done:
  // Capture is triggered by Z on its row (see ovl_type_toggle), so its
  // value is read-only and just shows how many lines have been written.
  // ---- the Seed row's direct digit entry ----
  call ovl_type_keys
  // ---- suppress the game's own keyboard input while the menu is open --
  // The game rebuilds KEYSHADOW from GetKeyboardState earlier in the
  // frame, so clearing it here means gameplay sees nothing pressed.
  xor eax, eax
  mov ecx, 40
  mov edi, KEYSHADOW
ovl_clear:
  mov [edi], eax
  add edi, 4
  dec ecx
  jnz ovl_clear
ovl_logic_done:
  popad
  popfd
  ret

// ---- v0.8.0 ovl_pause_action: edx = scene phase to switch to ----------
// 6 = restart the current stage (从头再来), 9 = back to the title (返回标题).
// This is exactly what the game's own pause menu does once the confirmation
// box is accepted -- Le02 v1.01a 0x4C87AA..0x4C87D6:
//     mov dword [esi+283C], 0        ; the menu's own input-delay timer
//     mov dword [esi+114], 6 | 9     ; scene phase
//     ret
// so we reuse its path instead of driving the menu: nothing flashes and the
// cursor never moves.
//
// GATE: the scene phase must be 1.  The phase lives at [scene+114] and the
// dispatcher (0x4CC2D6, jump table 0x4CC4C4) routes phase 1 to the pause-menu
// update function 0x4C8450 -- so phase 1 *is* "the pause menu is open".
// R/Q are therefore inert during ordinary play.  (Le03 keeps a different but
// equivalent gate -- the game's own pause flag -- see plan-pause-hotkeys.md.)
ovl_pause_action:
  pushfd
  pushad
  mov eax, [DBG_STAGE]
  cmp eax, 10000
  jb ovl_pa_done
  cmp eax, 7FFF0000
  ja ovl_pa_done
  mov ecx, [eax+30]
  cmp ecx, 1
  jb ovl_pa_done
  cmp ecx, 7
  ja ovl_pa_done
  cmp dword ptr [eax+114], 1
  jne ovl_pa_done
  mov dword ptr [eax+283C], 0
  mov [eax+114], edx
ovl_pa_done:
  popad
  popfd
  ret

// Skips developer-only rows while devmode is off; the search wraps and
// gives up after one full turn so an all-hidden table cannot spin.
ovl_move_up:
  push ebx
  push edx
  push esi
  push edi
  mov ecx, [OVL_ACTIVE_CUR]
  mov edx, [OVL_ACTIVE_FLAG]
  mov ebx, [OVL_ACTIVE_N]
  mov edi, ebx
  mov eax, [ecx]
ovl_up_loop:
  dec eax
  jns ovl_up_pos
  lea eax, [ebx-1]
ovl_up_pos:
  movzx esi, byte ptr [edx+eax]
  test esi, 1
  jz ovl_up_ok
  cmp dword ptr [CFG_DEVMODE], 0
  jne ovl_up_ok
  dec edi
  jz ovl_up_ok
  jmp ovl_up_loop
ovl_up_ok:
  mov [ecx], eax
  pop edi
  pop esi
  pop edx
  pop ebx
  ret

ovl_move_down:
  push ebx
  push edx
  push esi
  push edi
  mov ecx, [OVL_ACTIVE_CUR]
  mov edx, [OVL_ACTIVE_FLAG]
  mov ebx, [OVL_ACTIVE_N]
  mov edi, ebx
  mov eax, [ecx]
ovl_dn_loop:
  inc eax
  cmp eax, ebx
  jl ovl_dn_pos
  xor eax, eax
ovl_dn_pos:
  movzx esi, byte ptr [edx+eax]
  test esi, 1
  jz ovl_down_ok
  cmp dword ptr [CFG_DEVMODE], 0
  jne ovl_down_ok
  dec edi
  jz ovl_down_ok
  jmp ovl_dn_loop
ovl_down_ok:
  mov [ecx], eax
  pop edi
  pop esi
  pop edx
  pop ebx
  ret

// A row is six dwords: text, value pointer, min, max, step, wrap.
// `wrap` = 1 -> stepping past an end jumps to the other end (a switch);
//          0 -> stepping past an end stops there (a wide range, so the
//               held-key nudge below can land on an exact value).
//
// ovl_row: esi = &OVL_ACTIVE_TBL[OVL_ACTIVE_CUR]
ovl_row:
  mov ecx, [OVL_ACTIVE_CUR]
  mov eax, [ecx]
  imul eax, eax, 18
  add eax, [OVL_ACTIVE_TBL]
  mov esi, eax
  ret

// ovl_apply: esi = row pointer, edx = signed delta.
// The range checks are UNSIGNED: the Seed row's max is FFFFFFFF, which as a
// signed value is -1, so a signed compare would make RIGHT clamp to
// FFFFFFFF from anywhere.  Every other row has max <= 65535, where signed
// and unsigned agree, so this is a strict widening.
ovl_apply:
  mov eax, [esi+4]
  mov ecx, [eax]
  add ecx, edx
  cmp ecx, [esi+0C]
  jbe ovl_apply_lo
  cmp dword ptr [esi+14], 0
  je ovl_apply_hi_clamp
  mov ecx, [esi+8]
  jmp ovl_apply_store
ovl_apply_hi_clamp:
  mov ecx, [esi+0C]
  jmp ovl_apply_store
ovl_apply_lo:
  cmp ecx, [esi+8]
  jae ovl_apply_store
  cmp dword ptr [esi+14], 0
  je ovl_apply_lo_clamp
  mov ecx, [esi+0C]
  jmp ovl_apply_store
ovl_apply_lo_clamp:
  mov ecx, [esi+8]
ovl_apply_store:
  mov [eax], ecx
  ret

// While the seed row is in typing mode the arrow keys must not fight the
// digits, so all four value-movers bail out through one shared exit.
ovl_move_right:
  cmp dword ptr [OVL_TYPE_ON], 0
  jne ovl_move_blocked
  call ovl_row
  // v0.7.11 -- a colour row steps through PP_PRESETS instead of adding to
  // the number, so the twelve presets are one press apart.
  call ovl_row_is_colour
  test eax, eax
  jz ovl_mr_normal
  mov edx, 1
  jmp ovl_colour_step
ovl_mr_normal:
  mov edx, [esi+10]
  jmp ovl_apply

ovl_move_left:
  cmp dword ptr [OVL_TYPE_ON], 0
  jne ovl_move_blocked
  call ovl_row
  call ovl_row_is_colour
  test eax, eax
  jz ovl_ml_normal
  mov edx, ffffffff
  jmp ovl_colour_step
ovl_ml_normal:
  mov edx, [esi+10]
  neg edx
  jmp ovl_apply

ovl_nudge_right:
  cmp dword ptr [OVL_TYPE_ON], 0
  jne ovl_move_blocked
  call ovl_row
  call ovl_row_is_colour
  test eax, eax
  jz ovl_nr_normal
  mov edx, 1
  jmp ovl_colour_step
ovl_nr_normal:
  mov edx, 1
  jmp ovl_apply

ovl_nudge_left:
  cmp dword ptr [OVL_TYPE_ON], 0
  jne ovl_move_blocked
  call ovl_row
  call ovl_row_is_colour
  test eax, eax
  jz ovl_nl_normal
  mov edx, ffffffff
  jmp ovl_colour_step
ovl_nl_normal:
  mov edx, ffffffff
  jmp ovl_apply

ovl_move_blocked:
  ret

ovl_reset_hold:
  mov dword ptr [OVL_HOLD_DIR], 0
  mov dword ptr [OVL_HOLD_N], 0
  mov dword ptr [OVL_NUDGE_N], 0
  ret

// ================= seed row: direct digit entry ===================== //
// The overlay already reads GetKeyboardState into OVL_VKBUF, so digits are
// just VK 30..39.  Typing beats nudging for a 32-bit value: 4294967295 is
// ten digits, and no step size makes that pleasant.
//
//   Z        enter typing (cursor on the Seed row) / commit
//   digits   append; the FIRST digit replaces the old value
//   BACK(08) drop the last digit
//   ESC      cancel, restore the value you started with
//
// Edge detection for all ten digits with one state word: remember the VK of
// the digit currently held, and only act when a *different* one goes down.
// That also handles rolling from 5 to 6 without releasing 5.
ovl_type_keys:
  // ---- Z (5A) ----
  mov al, byte ptr [OVL_VKBUF+5A]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+4]
  mov byte ptr [OVL_PREV_KEYS+4], al
  cmp al, cl
  je ovl_type_z_done
  test al, al
  jz ovl_type_z_done
  call ovl_type_toggle
ovl_type_z_done:
  // ---- ESC (1B) ----
  mov al, byte ptr [OVL_VKBUF+1B]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+5]
  mov byte ptr [OVL_PREV_KEYS+5], al
  cmp al, cl
  je ovl_type_esc_done
  test al, al
  jz ovl_type_esc_done
  call ovl_type_cancel
ovl_type_esc_done:
  // ---- BACK (08) ----
  mov al, byte ptr [OVL_VKBUF+08]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+6]
  mov byte ptr [OVL_PREV_KEYS+6], al
  cmp al, cl
  je ovl_type_back_done
  test al, al
  jz ovl_type_back_done
  cmp dword ptr [OVL_TYPE_ON], 0
  je ovl_type_back_done
  cmp dword ptr [OVL_TYPE_KIND], 0
  jne ovl_type_back_hex
  mov eax, [OVL_TYPE_VAL]
  mov ecx, [eax]
  xor edx, edx
  push eax
  mov eax, ecx
  mov ecx, 0A
  div ecx
  pop ecx
  mov [ecx], eax
  jmp ovl_type_back_done
ovl_type_back_hex:
  // Drop the last HEX digit: one nibble, counted from the left, so the six
  // digits read exactly like the RRGGBB you typed.
  mov eax, [OVL_TYPE_HEXN]
  test eax, eax
  jz ovl_type_back_done
  dec eax
  mov [OVL_TYPE_HEXN], eax
  mov ecx, 5
  sub ecx, eax
  shl ecx, 2
  mov edx, 0F
  shl edx, cl
  not edx
  mov eax, [OVL_TYPE_VAL]
  mov ecx, [eax]
  and ecx, edx
  mov [eax], ecx
ovl_type_back_done:
  // ---- digits ----
  cmp dword ptr [OVL_TYPE_ON], 0
  je ovl_type_digits_done
  // ebx tracks whether ANY digit is currently down.  Only when none is
  // down may OVL_TYPE_LAST be cleared -- clearing it at the end of the
  // scan while a key is still held makes the very next call see a fresh
  // press, which doubles every digit (the overlay runs twice per frame).
  xor ebx, ebx
  mov ecx, 30
ovl_type_digit_loop:
  movzx eax, byte ptr [OVL_VKBUF+ecx]
  and al, 80
  jz ovl_type_digit_next
  mov ebx, 1
  cmp ecx, [OVL_TYPE_LAST]
  je ovl_type_digit_next
  mov [OVL_TYPE_LAST], ecx
  mov edx, ecx
  cmp ecx, 3A
  jb ovl_td_num
  // 0x3A..0x40 are not digits at all; 0x41..0x46 are A..F and only count
  // in hex mode.  Either way the key is remembered as LAST so it cannot
  // retrigger, but the scan carries on rather than aborting.
  cmp dword ptr [OVL_TYPE_KIND], 0
  je ovl_type_digit_next
  cmp ecx, 41
  jb ovl_type_digit_next
  cmp ecx, 47
  jae ovl_type_digit_next
  sub edx, 37
  jmp ovl_td_have
ovl_td_num:
  sub edx, 30
ovl_td_have:
  cmp dword ptr [OVL_TYPE_KIND], 0
  jne ovl_td_hex
  call ovl_type_append
  jmp ovl_type_digits_done
ovl_td_hex:
  call ovl_type_append_hex
  jmp ovl_type_digits_done
ovl_type_digit_next:
  inc ecx
  cmp ecx, 47
  jl ovl_type_digit_loop
  test ebx, ebx
  jnz ovl_type_digits_done
  mov dword ptr [OVL_TYPE_LAST], 0
ovl_type_digits_done:
  ret

// Z.  Which row the cursor is on decides what it does:
//   any 0..1 row   -> flip it (these render as on/off)
//   the Seed row   -> enter/commit direct digit entry
//   the Capture row-> capture the current spot once
// EVERY case is decided from the row DESCRIPTOR -- its value pointer, or
// its min/max range -- and never from a row INDEX.  Hard-coded indices are
// exactly what once made the Capture row render the Seed label and steal
// its digit entry, the moment the hint rows were inserted above the seed
// rows.  With this form, reordering the table cannot break the dispatch.
ovl_type_toggle:
  cmp dword ptr [OVL_TYPE_ON], 0
  jne ovl_type_commit
  call ovl_row
  // v0.7.11 -- Z on the MAIN table's Hint row opens the hint settings
  // panel instead of toggling Hint.  (The panel carries its own Hint
  // switch as its first row, so nothing is lost.)  Keyed on the row's
  // VALUE POINTER plus which table is live -- never on a row index.
  cmp dword ptr [OVL_SUB], 0
  jne ovl_type_try_switch
  mov eax, OVL_V_HINT
  cmp [esi+4], eax
  je ovl_sub_open
ovl_type_try_switch:
  // The Speed row types a decimal number too.  Dispatch is by value pointer,
  // like every other row test, so no row index is involved.
  mov eax, SPEED_FPS
  cmp [esi+4], eax
  je ovl_type_try_speed
  cmp dword ptr [esi+0C], 1
  jne ovl_type_try_seed
  cmp dword ptr [esi+8], 0
  jne ovl_type_try_seed
  mov eax, [esi+4]
  mov ecx, [eax]
  xor ecx, 1
  mov [eax], ecx
  ret
ovl_type_try_speed:
  call spd_typing_on
  mov eax, [SPEED_FPS]
  mov [OVL_TYPE_OLD], eax
  mov dword ptr [OVL_TYPE_FRESH], 1
  mov dword ptr [OVL_TYPE_LAST], 0
  mov dword ptr [OVL_TYPE_ON], 1
  mov dword ptr [OVL_TYPE_KIND], 0
  // clear the value up front: FRESH alone was not enough on Le03, where typing
  // "30" appended to the existing 60 and produced 6030.
  mov dword ptr [SPEED_FPS], 0
  mov eax, SPEED_FPS
  mov [OVL_TYPE_VAL], eax
  mov eax, TXT_OVL_SPEED
  mov [OVL_TYPE_ORIG], eax
  mov [OVL_TYPE_ROW], esi
  mov eax, TXT_OVL_SPEED
  mov [esi], eax
  ret

ovl_type_try_seed:
  mov eax, SEL_SEED
  cmp [esi+4], eax
  jne ovl_type_try_colour
  mov eax, [SEL_SEED]
  mov [OVL_TYPE_OLD], eax
  mov dword ptr [OVL_TYPE_FRESH], 1
  mov dword ptr [OVL_TYPE_LAST], 0
  mov dword ptr [OVL_TYPE_ON], 1
  // v0.7.11 -- the typing machinery is generic over OVL_TYPE_VAL /
  // OVL_TYPE_ORIG now, so the Seed row and the two colour rows all go
  // through one append / cancel / restore path.
  mov dword ptr [OVL_TYPE_KIND], 0
  mov eax, SEL_SEED
  mov [OVL_TYPE_VAL], eax
  mov eax, TXT_OVL_SEED
  mov [OVL_TYPE_ORIG], eax
  // Remember WHICH row is in typing mode, so restoring its label later
  // needs no row index either.
  mov [OVL_TYPE_ROW], esi
  mov eax, TXT_OVL_SEED_EDIT
  mov [esi], eax
  ret
// v0.7.11 -- the two colour rows type a 6-digit hex value.  Which of them
// is decided from the value pointer, exactly like everything else here.
ovl_type_try_colour:
  call ovl_row_is_colour
  test eax, eax
  jz ovl_type_try_capture
  mov eax, [esi+4]
  mov [OVL_TYPE_VAL], eax
  mov eax, [eax]
  mov [OVL_TYPE_OLD], eax
  mov dword ptr [OVL_TYPE_LAST], 0
  mov dword ptr [OVL_TYPE_HEXN], 0
  mov dword ptr [OVL_TYPE_ON], 1
  mov dword ptr [OVL_TYPE_KIND], 1
  mov eax, [esi]
  mov [OVL_TYPE_ORIG], eax
  mov [OVL_TYPE_ROW], esi
  mov ecx, [esi+4]
  mov eax, OVL_V_PCOL
  cmp ecx, eax
  mov eax, TXT_OVL_HINTCOL_EDIT
  jne ovl_type_colour_set
  mov eax, TXT_OVL_PCOL_EDIT
ovl_type_colour_set:
  mov [esi], eax
  ret
ovl_type_try_capture:
  mov eax, OVL_V_CAPTURE
  cmp [esi+4], eax
  jne ovl_type_toggle_done
  call hint_capture
  cmp dword ptr [HINT_CAP_OK], 0
  je ovl_type_toggle_done
  inc dword ptr [OVL_V_CAPTURE]
  ret
ovl_type_commit:
  call fps_commit_clamp
  // Committing a hand-typed seed switches the lock on -- you typed it, so
  // you want it used -- and arms the edge detector so the Lock Seed row
  // does not immediately grab the current seed over the top of it.
  // (To grab instead, toggle Lock Seed off and on again.)  A typed COLOUR
  // has no such side effect, so it just exits.
  mov eax, [OVL_TYPE_VAL]
  cmp eax, SEL_SEED
  jne ovl_type_exit
  mov dword ptr [SEED_ON], 1
  mov dword ptr [OVL_PREV_SEEDSW], 1
ovl_type_exit:
  call spd_typing_off
  mov dword ptr [OVL_TYPE_ON], 0
  mov dword ptr [OVL_TYPE_LAST], 0
  mov ecx, [OVL_TYPE_ROW]
  test ecx, ecx
  jz ovl_type_toggle_done
  // v0.7.11 -- the ORIGINAL label is remembered per row, so the Seed row and
  // the two colour rows all restore correctly with no row index anywhere.
  mov eax, [OVL_TYPE_ORIG]
  test eax, eax
  jz ovl_type_toggle_done
  mov [ecx], eax
ovl_type_toggle_done:
  ret

ovl_type_cancel:
  cmp dword ptr [OVL_TYPE_ON], 0
  je ovl_type_cancel_sub
  // Restore the value the row held when typing began -- through the value
  // pointer, so this works for the Seed row and the colour rows alike.
  mov eax, [OVL_TYPE_VAL]
  test eax, eax
  jz ovl_type_exit
  mov ecx, [OVL_TYPE_OLD]
  mov [eax], ecx
  jmp ovl_type_exit
ovl_type_cancel_sub:
  // v0.7.11 -- ESC with nothing being typed closes the hint settings
  // panel and leaves the main table's cursor where it was.
  cmp dword ptr [OVL_SUB], 0
  je ovl_type_cancel_done
  mov dword ptr [OVL_SUB], 0
  call ovl_set_active
ovl_type_cancel_done:
  ret

// edx = the digit (0..9).  Append to the value behind OVL_TYPE_VAL, clamped
// at FFFFFFFF.  The first digit after entering typing mode replaces the value,
// so you do not have to backspace away a previous seed before typing a new one.
ovl_type_append:
  mov eax, [OVL_TYPE_VAL]
  cmp dword ptr [OVL_TYPE_FRESH], 0
  je ovl_type_app_shift
  mov dword ptr [OVL_TYPE_FRESH], 0
  mov [eax], edx
  ret
ovl_type_app_shift:
  mov ecx, [eax]
  cmp ecx, 19999999
  ja ovl_type_app_done
  jne ovl_type_app_room
  cmp edx, 5
  ja ovl_type_app_done
ovl_type_app_room:
  imul ecx, ecx, 0A
  add ecx, edx
  mov [eax], ecx
ovl_type_app_done:
  ret

// edx = the hex digit (0..15).  The digits fill the value from the LEFT, so
// typing F, F, 0, 0, 0, 0 reads "FF0000" the whole way rather than sliding
// right; that is the whole reason for the nibble counter.
ovl_type_append_hex:
  mov ecx, [OVL_TYPE_HEXN]
  cmp ecx, 6
  jae ovl_type_apph_done
  test ecx, ecx
  jnz ovl_type_apph_shift
  mov eax, [OVL_TYPE_VAL]
  mov dword ptr [eax], 0
ovl_type_apph_shift:
  mov eax, 5
  sub eax, ecx
  shl eax, 2
  mov ecx, eax
  shl edx, cl
  mov eax, [OVL_TYPE_VAL]
  mov ecx, [eax]
  or ecx, edx
  mov [eax], ecx
  inc dword ptr [OVL_TYPE_HEXN]
ovl_type_apph_done:
  ret

// ---- the active row set (v0.7.11) ------------------------------------
// The menu is two tables: OVL_ROWS is what F12 shows, OVL_ROWS2 is the
// HINT SETTINGS panel reached by pressing Z on the main table's Hint row.
// ovl_set_active points the five OVL_ACTIVE_* cells at whichever one
// OVL_SUB selects, and everything else works through them -- so no logic is
// duplicated and, more importantly, nothing has to know a row INDEX: the
// dispatch stays on the row DESCRIPTOR (its value pointer, its min/max
// range), which is what made the split possible without touching
// ovl_apply / ovl_type_toggle / the typing code at all.
//
// Safe to clobber ebx/edi: every caller (overlay_logic, overlay_draw) is
// inside a pushad.
ovl_set_active:
  mov eax, OVL_ROWS
  mov ecx, [OVL_ROWS_N]
  mov edx, OVL_CUR
  mov ebx, OVL_ALT
  mov edi, OVL_SWATCH
  mov esi, OVL_ROWFLAG
  cmp dword ptr [OVL_SUB], 0
  je ovl_sa_done
  mov eax, OVL_ROWS2
  mov ecx, [OVL_ROWS2_N]
  mov edx, OVL_CUR2
  mov ebx, OVL_ALT2
  mov edi, OVL_SWATCH2
  mov esi, OVL_ROWFLAG2
ovl_sa_done:
  mov [OVL_ACTIVE_TBL], eax
  mov [OVL_ACTIVE_N], ecx
  mov [OVL_ACTIVE_CUR], edx
  mov [OVL_ACTIVE_ALT], ebx
  mov [OVL_ACTIVE_SW], edi
  mov [OVL_ACTIVE_FLAG], esi
  ret

// Z on the MAIN table's Hint row: open the hint settings panel.  The
// cursor in it starts on Hint every time, so the panel always opens the
// same way.
ovl_sub_open:
  mov dword ptr [OVL_SUB], 1
  mov dword ptr [OVL_CUR2], 0
  call ovl_set_active
ovl_sub_open_done:
  ret

// eax = 1 when the selected row is one of the two COLOUR rows.  Clobbers
// ecx; the callers do not need it back.
ovl_row_is_colour:
  mov ecx, [esi+4]
  mov eax, HINT_COL
  cmp ecx, eax
  je ovl_ric_yes
  mov eax, OVL_V_PCOL
  cmp ecx, eax
  je ovl_ric_yes
  xor eax, eax
  ret
ovl_ric_yes:
  mov eax, 1
  ret

// ---- HTML <-> box colour --------------------------------------------
// 0x00RRGGBB <-> 0x00BBGGRR.  A plain R/B swap, so one routine does both
// directions.  Every colour we hold is in HTML order and the swap happens
// here, at the single point where a colour is handed to `box`.
ovl_swaprb:
  push eax
  push edx
  mov eax, ecx
  and eax, 0FF
  shl eax, 10
  mov edx, ecx
  and edx, 0FF00
  or eax, edx
  mov edx, ecx
  shr edx, 10
  and edx, 0FF
  or eax, edx
  mov ecx, eax
  pop edx
  pop eax
  ret

// edx = +1 / -1.  Left/right (and the held-key repeat) on a colour row walk
// PP_PRESETS instead of adding to the number, so the presets are one press
// apart.  A hand-typed colour that is not in the list enters the list at its
// near end rather than being rejected.
ovl_colour_step:
  call ovl_row
  mov eax, [esi+4]
  mov ecx, [eax]
  mov edi, PP_PRESETS
  mov ebx, [PP_PRESETS_N]
ovl_cs_scan:
  test ebx, ebx
  jz ovl_cs_miss
  cmp [edi], ecx
  je ovl_cs_found
  add edi, 4
  dec ebx
  jmp ovl_cs_scan
ovl_cs_found:
  sub edi, PP_PRESETS
  shr edi, 2
  add edi, edx
  mov ebx, [PP_PRESETS_N]
  cmp edi, ebx
  jl ovl_cs_lo
  xor edi, edi
  jmp ovl_cs_store
ovl_cs_lo:
  test edi, edi
  jns ovl_cs_store
  mov edi, ebx
  dec edi
ovl_cs_store:
  mov ecx, [PP_PRESETS+edi*4]
  mov [eax], ecx
  ret
ovl_cs_miss:
  mov ecx, [PP_PRESETS]
  test edx, edx
  jns ovl_cs_miss2
  mov ebx, [PP_PRESETS_N]
  dec ebx
  mov ecx, [PP_PRESETS+ebx*4]
ovl_cs_miss2:
  mov [eax], ecx
ovl_cs_done:
  ret

// ---- the colour swatch ----------------------------------------------
// Drawn at the right-hand end of a colour row so the colour is obvious even
// if the text formatter cannot do %06X.  OVL_ACTIVE_SW is a parallel array:
// 0, or the address of the colour to show.
ovl_swatch:
  mov ecx, [OVL_ACTIVE_SW]
  mov eax, [OVL_RCUR]
  mov eax, [ecx+eax*4]
  test eax, eax
  jz ovl_sw_done
  mov ecx, [eax]
  call ovl_swaprb
  mov eax, [OVL_SWX]
  mov ebx, eax
  add ebx, 0C
  mov edx, [OVL_RY]
  add edx, 2
  mov edi, edx
  add edi, 0A
  push 1
  push ecx
  push edi
  push ebx
  push edx
  push eax
  call box
  add esp, 18
ovl_sw_done:
  ret

ovl_getColor:
  // eax = row index; the selected row draws dark, the rest bright.
  mov ecx, [OVL_ACTIVE_CUR]
  cmp eax, [ecx]
  je ovl_color_sel
  mov eax, FF
  ret
ovl_color_sel:
  xor eax, eax
  ret

overlay_draw:
  pushfd
  pushad
  inc dword ptr [PRB_BLIT]
  // Draw once per frame at most: several blit sites may fire, and the
  // overlay must not be painted N times on top of itself.
  cmp dword ptr [OVL_DRAWN], 0
  jne ovl_draw_done
  mov dword ptr [OVL_DRAWN], 1
  // ---- the self-machine cross first, so hint markers and the panel sit
  //      on top of it.  Independent of the Hint switch (v0.7.7). ----
  // ---- v0.8.1: leave the game COMPLETELY ALONE while it plays back a
  //      replay or an attract demo.  The markers go through the game's own
  //      box() / drawTextTexture() into its scene buffers, and a replay is
  //      FRAME-INDEXED (see desync分析.md), so extra per-frame work on that
  //      path can shift the frame sequence and desync it.  This is exactly
  //      the gate Le03 got in v0.5.19; Le01 and Le02 never had it.
  //      The replay object's +5 byte is 1 for BOTH a user replay and an
  //      attract demo (measured on all three games -- plan-zreplay.md 9.2).
  //      Only the markers are skipped: the F12 panel below still draws.
  cmp byte ptr [game+AD556D], 0
  jne ovl_draw_panel
  call draw_pcross
  // ---- hint markers next, so the panel sits on top of them ----
  cmp dword ptr [OVL_V_HINT], 0
  je ovl_draw_panel
  call draw_hints
ovl_draw_panel:
  cmp dword ptr [OVERLAY_OPEN], 0
  je ovl_draw_done
  // v0.7.11 -- resolve the live row set (main vs hint settings) before
  // anything reads OVL_ACTIVE_*, and derive the panel bottom from the row
  // count: bottom = 0x28 + rows*0x10 (row pitch 0x10, first row at 0x28).
  // At 12 rows that is 0xE8, exactly the height this panel always had.
  call ovl_set_active
  // count visible rows: hidden ones must not reserve a slot
  mov dword ptr [OVL_VISN], 0
  mov edi, [OVL_ACTIVE_N]
  mov esi, [OVL_ACTIVE_FLAG]
  xor eax, eax
ovl_vis_l:
  cmp eax, edi
  jge ovl_vis_done
  movzx ebx, byte ptr [esi+eax]
  test ebx, 1
  jz ovl_vis_cnt
  cmp dword ptr [CFG_DEVMODE], 0
  jne ovl_vis_cnt
  jmp ovl_vis_next
ovl_vis_cnt:
  inc dword ptr [OVL_VISN]
ovl_vis_next:
  inc eax
  jmp ovl_vis_l
ovl_vis_done:
  mov eax, [OVL_VISN]
  shl eax, 4
  add eax, 28
  mov [OVL_PANEL_B], eax
  // ---- the panel.  box(x1,y1,x2,y2,colour,filled) is cdecl with six
  //      args; we pass both values of `filled` so we get the solid pass
  //      whichever of the two inner primitives actually fills.
  push 1
  push 0
  push dword ptr [OVL_PANEL_B]
  push F0
  push 10
  push 10
  call box
  push 0
  push ff
  push dword ptr [OVL_PANEL_B]
  push F0
  push 10
  push 10
  call box
  add esp, 30
  // ---- title: shadow at (19,19), then the real one at (18,18) ----
  // v0.7.11 -- the hint settings panel gets its own title, so it is obvious
  // which layer you are on and that ESC goes back.
  mov eax, TXT_OVL_TITLE
  cmp dword ptr [OVL_SUB], 0
  je ovl_title_pick
  mov eax, TXT_OVL_TITLE2
ovl_title_pick:
  mov [OVL_RTXT], eax
  push 0
  push dword ptr [OVL_RTXT]
  push 0
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push 19
  push 19
  call drawTextTexture
  add esp, 14
  push 0
  push dword ptr [OVL_RTXT]
  push ff
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push 18
  push 18
  call drawTextTexture
  add esp, 14
  // ---- rows ----
  // The row cursor lives in MEMORY and is reloaded every iteration.
  // getTextTexture / drawTextTexture are game functions and this engine's
  // drawing helpers do NOT preserve ecx/edx/esi (box() clobbers them too).
  // Holding the cursor in a register across those calls is exactly what made
  // one row render another row's label.
  mov dword ptr [OVL_RCUR], 0
  mov dword ptr [OVL_RVIS], 0
ovl_draw_row:
  mov eax, [OVL_RCUR]
  cmp eax, [OVL_ACTIVE_N]
  jge ovl_draw_done
  mov ecx, [OVL_ACTIVE_FLAG]
  movzx edx, byte ptr [ecx+eax]
  test edx, 1
  jz ovl_draw_vis
  cmp dword ptr [CFG_DEVMODE], 0
  jne ovl_draw_vis
  jmp ovl_draw_next
ovl_draw_vis:
  mov eax, [OVL_RCUR]
  imul eax, eax, 18
  add eax, [OVL_ACTIVE_TBL]
  mov [OVL_RPTR], eax
  mov eax, [OVL_RVIS]
  imul eax, eax, 10
  add eax, 28
  mov [OVL_RY], eax
  // ---- pick this row's label ----
  // OVL_ALT is a parallel array, one dword per row.  0 -> the row keeps
  // its own format string (a number).  Otherwise it points at a 2-dword
  // {text_if_0, text_if_1} pair, and the row renders that instead -- which
  // is how a 0/1 switch reads "off"/"on".  The value is still pushed as
  // the format argument either way; a string with no %d just ignores it.
  mov esi, [OVL_RPTR]
  mov eax, [esi+4]
  mov ecx, [eax]
  mov eax, [OVL_RCUR]
  mov edx, [OVL_ACTIVE_ALT]
  mov eax, [edx+eax*4]
  test eax, eax
  jz ovl_pick_plain
  and ecx, 1
  mov eax, [eax+ecx*4]
  jmp ovl_pick_done
ovl_pick_plain:
  mov eax, [esi]
ovl_pick_done:
  mov [OVL_RTXT], eax
  // shadow
  mov esi, [OVL_RPTR]
  mov eax, [esi+4]
  push dword ptr [eax]
  push dword ptr [OVL_RTXT]
  push 0
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  mov eax, [OVL_RY]
  inc eax
  push eax
  push 19
  call drawTextTexture
  add esp, 14
  // the row itself
  mov esi, [OVL_RPTR]
  mov eax, [esi+4]
  push dword ptr [eax]
  push dword ptr [OVL_RTXT]
  mov eax, [OVL_RCUR]
  call ovl_getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push dword ptr [OVL_RY]
  push 18
  call drawTextTexture
  add esp, 14
  // v0.7.11 -- the colour swatch, if this row has one
  call ovl_swatch
  inc dword ptr [OVL_RVIS]
ovl_draw_next:
  inc dword ptr [OVL_RCUR]
  jmp ovl_draw_row
ovl_draw_done:
  popad
  popfd
  ret

// =================================================================== //
// v0.4.0 -- the two game-side hooks.                                 //
// =================================================================== //

// ---- No Gameover ---------------------------------------------------- //
// (Called "No Gameover" rather than "No Miss" because it does not stop
//  you being hit -- it stops the hit from ending the run.)
// Entered from game+B980C, which vanilla spells
//     cmp dword ptr [eax+0x48], 0
//     jg  game+B9840          ; lives left -> die and respawn
//     ...                     ; else -> GAME OVER
// eax is already the player object, and the shared `dec [eax+0x48]`
// happens later at game+B9894 with nothing reading the field in between
// (verified by a full .text sweep).
//
// v0.7.5 -- lives are NO LONGER smashed to 0.
// The old form wrote 1 unconditionally, so the shared `dec` landed on 0
// and the very first hit took you from N lives straight to 0 (and every
// later hit kept it there).  The user called that out as a nasty side
// effect: the feature was fine, the wrecked HUD was not.
//
// Now the two cases are separated, which is what vanilla itself does:
//   * lives > 0 -- take the ordinary death path and let the shared `dec`
//     run, so the counter ticks down exactly like vanilla (3 -> 2 -> 1).
//   * lives == 0 -- this is the hit vanilla would have ended the run on.
//     Fake 1 so the `dec` lands back on 0: the death/respawn animation
//     plays and you keep playing with 0 lives.
// So the counter never goes negative, it only ever reaches 0 the way the
// game itself would, and the run simply never ends.
//
// The important property is unchanged: with the switch OFF this reproduces
// the original two instructions byte for byte, and with it ON lives > 0
// still takes the ORIGINAL path -- only the would-have-been-GAME-OVER case
// differs.  So a replay is still frame-accurate right up to the first
// fatal hit, and the life counter itself matches vanilla until 0.
nogameover_hook:
  cmp dword ptr [OVL_V_NOGAMEOVER], 0
  je nogameover_vanilla
  cmp dword ptr [eax+48], 0
  jg nogameover_count
  mov dword ptr [eax+48], 1
nogameover_count:
  inc dword ptr [PRB_NOGAMEOVER]
  jmp game+B9840
nogameover_vanilla:
  cmp dword ptr [eax+48], 0
  jg game+B9840
  jmp game+B9812

// ---- freeze power (locks onto whatever power you currently have) ---- //
// Replaces the vanilla clamp that closes the player update:
//     mov eax, [edi]
//     cmp [eax+0x7c], 0      / jge / mov [eax+0x7c], 0
//     mov eax, [edi]
//     cmp [eax+0x7c], 0x1f4  / jl  / mov [eax+0x7c], 0x1f4
//
// There is no value to type in: the first frame after the switch goes on
// captures the live power into OVL_LP_TARGET, and every frame after that
// stores it back.  So power becomes genuinely static -- pickups cannot
// raise it and hits cannot lower it.  Switching it off re-arms the
// capture, so toggling it re-locks to the power you have right then.
// The vanilla path is kept verbatim for when the lock is off.
// ---- autobomb: fire a bomb instead of taking the hit -------------------
// Entered by the 7-byte jmp that replaced the state-machine dispatch
// prologue at game+B9766.  ECX = player, EDI = controller.
// The bomb routine is the same __thiscall the X-key handler uses
// (ECX = controller); it sets state 5, decrements +0x60 and arms the bomb
// timer, and does not touch the bullet vectors.
// ---- miss counter: one increment per life actually lost ---------------
// Entered by the 5-byte call that replaced the call sitting immediately
// after `dec [player+0x48]` in the death branch.  Flags are preserved so
// the surrounding code cannot tell the difference.
ovl_miss:
  pushfd
  inc dword ptr [NOSORE_DEBT]
  popfd
  jmp game+25AE0

ovl_autobomb:
  mov eax, [ecx+54]              // displaced instruction #1
  cmp eax, 1
  jne ovl_ab_vanilla
  cmp dword ptr [OVL_V_AUTOBOMB], 0
  je ovl_ab_vanilla
  cmp dword ptr [ecx+60], 0
  jle ovl_ab_vanilla
  pushad
  mov ecx, edi                   // controller
  call game+BA450                // the game's own bomb routine
  popad
  cmp dword ptr [ecx+54], 5      // did it actually start a bomb?
  jne ovl_ab_vanilla
  jmp game+B9AD8                 // skip the hit body: no life loss
ovl_ab_vanilla:
  dec eax                        // displaced #2
  cmp eax, 5                     // displaced #3
  jmp game+B976D                 // original `ja` + jump table

ovl_lockpower:
  mov eax, [edi]
  // Diagnostic mirror: remember the live player object so an external
  // tool can read lives/power straight out of the game (and so the
  // later seed/hint work has a pointer to hang off).  One store into
  // our own scratch memory, no game state touched.
  mov [DBG_PLAYER], eax
  cmp dword ptr [OVL_V_LOCKPWR], 0
  jne ovl_lp_on
  mov dword ptr [OVL_LP_HELD], 0
  jmp ovl_lp_vanilla
ovl_lp_on:
  cmp dword ptr [OVL_LP_HELD], 0
  jne ovl_lp_pin
  mov edx, [eax+7C]
  mov dword ptr [OVL_LP_TARGET], edx
  mov dword ptr [OVL_LP_HELD], 1
ovl_lp_pin:
  mov edx, [OVL_LP_TARGET]
  mov dword ptr [eax+7C], edx
  inc dword ptr [PRB_LP]
  jmp ovl_lb_check
ovl_lp_vanilla:
  cmp dword ptr [eax+7C], 0
  jge ovl_lp_hi
  mov dword ptr [eax+7C], 0
ovl_lp_hi:
  cmp dword ptr [eax+7C], 1F4
  jl ovl_lp_done
  mov dword ptr [eax+7C], 1F4
ovl_lp_done:
ovl_lb_check:
  // Lock Bomb: latch [player+0x60] on the first frame after the switch is
  // turned on, then write it back every frame.  Nothing else is touched.
  cmp dword ptr [OVL_V_LOCKBOMB], 0
  je ovl_lb_off
  cmp dword ptr [BOMB_HELD], 0
  jne ovl_lb_pin
  mov edx, [eax+60]
  mov dword ptr [BOMB_TARGET], edx
  mov dword ptr [BOMB_HELD], 1
ovl_lb_pin:
  mov edx, [BOMB_TARGET]
  mov dword ptr [eax+60], edx
  jmp ovl_lb_done
ovl_lb_off:
  mov dword ptr [BOMB_HELD], 0
ovl_lb_done:
  jmp game+B9B26

// ---- seed lock ------------------------------------------------------ //
// Entered via `call` from game+B2BD9.  On entry [esp] = return address and
// [esp+4] = the seed the game pushed.  We deliberately do NOT rewrite that
// stack slot: we push our own value for the wrapper call instead, so the
// caller's frame is never touched (the game's own `add esp,4` at 0xB2BDE
// still pops its stale argument).
//
// Registers are saved one at a time rather than with pushad, because we
// need the caller's EDI *live* for the [edi+0x3C] write -- reading it out
// of a pushad slot means depending on the slot order, and getting that
// wrong writes the seed to an arbitrary address.
//
// NOTE every literal is HEX.  pushfd plus the five pushes below cover
// 6*4 = 24 bytes, so the game's argument -- at [esp+4] on entry -- ends up
// at [esp+1C] (that is 28 DECIMAL).  Writing `28` means 0x28 = 40 and reads
// the stale dword 12 bytes ABOVE the argument, seeding the RNG with
// something that is NOT the game's seed; that silently breaks replay
// determinism because the recording used the real seed.  Keep it 1C.
seed_hook:
  pushfd
  push eax
  push ecx
  push edx
  push esi
  push edi
  mov eax, [esp+1C]
  cmp dword ptr [SEED_ON], 0
  je seed_hook_used
  mov eax, [SEL_SEED]
  mov dword ptr [edi+3C], eax
  inc dword ptr [PRB_SEEDON]
seed_hook_used:
  mov [SEED_USED], eax
  inc dword ptr [PRB_SEEDN]
  push eax
  call game+D04D0
  add esp, 4
  // fingerprint the freshly seeded MT state (VA 0xEC8A90)
  mov esi, EC8A90
  mov edi, SEED_FP
  mov ecx, 10
seed_fp_loop:
  mov eax, [esi]
  mov [edi], eax
  add esi, 4
  add edi, 4
  dec ecx
  jnz seed_fp_loop
  pop edi
  pop esi
  pop edx
  pop ecx
  pop eax
  popfd
  xor eax, eax
  ret

// ---- hint files (v0.6.7) -------------------------------------------- //
// Enumerates <exe dir>\hint\*.txt and loads every one that applies, so
// both layouts work with no extra code:
//   * one file per stage   (first line is the stage number)
//   * everything merged    ("stage N" lines switch stage mid-file)
// A file whose NAME contains -easy / -normal / -hard / -unreal is only
// used on that difficulty; a name with no such tag applies to all of them.
//
// Everything is UTF-16 because that is what the W APIs want, and
// GetModuleFileNameW hands us the exe path in exactly that form.
//
// Called once per stage.  Preserves all registers.
load_hints:
  pushfd
  pushad
  mov dword ptr [HINT_N], 0
  mov dword ptr [HINT_SKIP], 0
  // The stage the parser keeps.  Prefer the REAL stage the game is running:
  // the stage object carries it at +0x30 (the game copies it there from the
  // global 0xEDDFF0 while setting the stage up -- see the disassembly at
  // RVA 0xB2CB5), and DBG_STAGE is that very object, stored by our
  // initFrameTimer hook immediately above.  This is also correct in a full
  // run, where SEL_STAGE would still read 1 forever.
  mov eax, [DBG_STAGE]
  cmp eax, 10000
  jb load_hints_selstage
  cmp eax, 7FFF0000
  ja load_hints_selstage
  mov eax, [eax+30]
  test eax, eax
  jz load_hints_selstage
  cmp eax, 9
  jbe load_hints_want
load_hints_selstage:
  // Fallback: the practice menu's selection.  SEL_STAGE is 0-based (it
  // indexes SECTION_CNT / MAX_PATTERNID; the menu displays it + 1).
  mov eax, [SEL_STAGE]
  inc eax
  cmp eax, 9
  jbe load_hints_want
  xor eax, eax
load_hints_want:
  mov [HINT_WANT], eax
  // ---- 1. the exe's own path ----
  push 104
  push HINT_PATHW
  push 0
  call dword ptr [MODULE_IAT]
  test eax, eax
  jz load_hints_done
  // ---- 2. find the last backslash so we can keep the directory ----
  mov esi, HINT_PATHW
  mov ecx, eax
  xor edx, edx
  xor ebx, ebx
load_hints_scan:
  cmp ebx, ecx
  jae load_hints_cut
  cmp word ptr [esi], 5C
  jne load_hints_next
  mov edx, ebx
load_hints_next:
  add esi, 2
  inc ebx
  jmp load_hints_scan
load_hints_cut:
  inc edx
  mov edi, HINT_PATHW
  lea edi, [edi+edx*2]
  // ---- 3. append "hint\" and remember how long the prefix is ----
  mov esi, HINT_PRE
  mov ecx, 5
load_hints_p1:
  mov ax, [esi]
  mov [edi], ax
  add esi, 2
  add edi, 2
  dec ecx
  jnz load_hints_p1
  add edx, 5
  mov [HINT_PRELEN], edx
  // ---- 4. append the search pattern and start enumerating ----
  mov esi, HINT_GLOB
  mov ecx, 5
load_hints_p2:
  mov ax, [esi]
  mov [edi], ax
  add esi, 2
  add edi, 2
  dec ecx
  jnz load_hints_p2
  mov word ptr [edi], 0
  push HINT_FIND
  push HINT_PATHW
  call dword ptr [FINDFIRST_IAT]
  cmp eax, ffffffff
  je load_hints_done
  mov [HINT_FH], eax
load_hints_loop:
  call hint_diff_ok
  test eax, eax
  jz load_hints_skip
  call hint_build_path
  call hint_read_one
  call parse_hints
load_hints_skip:
  push HINT_FIND
  push dword ptr [HINT_FH]
  call dword ptr [FINDNEXT_IAT]
  test eax, eax
  jnz load_hints_loop
  push dword ptr [HINT_FH]
  call dword ptr [FINDCLOSE_IAT]
load_hints_done:
  popad
  popfd
  ret

// hint_build_path: HINT_PATHW = <dir>\hint\ + cFileName.
// The first HINT_PRELEN WCHARs are the prefix and are never overwritten,
// so copying from the start of the same buffer is safe even on the
// second and later files (when the tail no longer holds the pattern).
hint_build_path:
  pushad
  mov esi, HINT_PATHW
  mov edi, HINT_PATHW
  mov ecx, [HINT_PRELEN]
hint_bp_copy:
  mov ax, [esi]
  mov [edi], ax
  add esi, 2
  add edi, 2
  dec ecx
  jnz hint_bp_copy
  mov esi, HINT_FIND
  add esi, 2C
hint_bp_name:
  mov ax, [esi]
  test ax, ax
  jz hint_bp_done
  mov [edi], ax
  add esi, 2
  add edi, 2
  jmp hint_bp_name
hint_bp_done:
  mov word ptr [edi], 0
  popad
  ret

// hint_diff_ok: does this file apply to the current difficulty?
// Scans cFileName for -easy/-normal/-hard/-unreal (case-folded by ORing
// bit 5 into each UTF-16 unit).  No tag -> applies to every difficulty.
// -> eax = 1 to load, 0 to skip.
hint_diff_ok:
  pushad
  mov esi, HINT_FIND
  add esi, 2C
hint_diff_scan:
  mov ax, [esi]
  test ax, ax
  jz hint_diff_none
  cmp ax, 2D
  jne hint_diff_next
  mov eax, [esi+2]
  or eax, 200020
  cmp eax, 610065
  je hint_diff_easy
  cmp eax, 6F006E
  je hint_diff_normal
  cmp eax, 610068
  je hint_diff_hard
  cmp eax, 6E0075
  je hint_diff_unreal
hint_diff_next:
  add esi, 2
  jmp hint_diff_scan
hint_diff_easy:
  xor ebx, ebx
  jmp hint_diff_cmp
hint_diff_normal:
  mov ebx, 1
  jmp hint_diff_cmp
hint_diff_hard:
  mov ebx, 2
  jmp hint_diff_cmp
hint_diff_unreal:
  mov ebx, 3
hint_diff_cmp:
  mov eax, [SEL_DIFF]
  cmp eax, 3
  jbe hint_diff_have
  xor eax, eax
hint_diff_have:
  cmp ebx, eax
  jne hint_diff_no
  mov dword ptr [HINT_OK], 1
  jmp hint_diff_out
hint_diff_none:
  mov dword ptr [HINT_OK], 1
  jmp hint_diff_out
hint_diff_no:
  mov dword ptr [HINT_OK], 0
hint_diff_out:
  popad
  mov eax, [HINT_OK]
  ret

// hint_read_one: slurp HINT_PATHW into HINT_BUF, set HINT_LEN.
hint_read_one:
  pushad
  mov dword ptr [HINT_LEN], 0
  mov dword ptr [HINT_GOT], 0
  push 0
  push 80
  push 3
  push 0
  push 1
  push 80000000
  push HINT_PATHW
  call dword ptr [FILE_IAT]
  cmp eax, ffffffff
  je hint_read_done
  mov [HINT_HANDLE], eax
  push 0
  push HINT_GOT
  push dword ptr [HINT_BUFMAX]
  push HINT_BUF
  push eax
  call dword ptr [READ_IAT]
  mov eax, [HINT_GOT]
  mov [HINT_LEN], eax
  push dword ptr [HINT_HANDLE]
  call dword ptr [CLOSE_IAT]
hint_read_done:
  popad
  ret

// ---- hint markers (v0.6.3) ------------------------------------------ //
// Walks HINT_ARR and draws every entry whose time window contains the
// current stage frame.  Two shapes, chosen by the entry's marker char:
//   '+'  a crosshair, drawn as two filled rectangles
//   '-'  a full-width horizontal dashed line (a "safe line")
// box() is used rather than drawTextTexture because that helper takes
// (fmt, value, colour, x, y) and has NO size argument at all.
//
// box() is a game function and does not preserve ecx/edx/esi, so every
// coordinate is reloaded from memory for each rectangle.  Relying on the
// registers surviving a call silently drew the second bar off-screen.
//
// Entry layout (0x30 = 48 bytes):
//   +00 mark  +04 size  +08 char  +0C x  +10 y
//   +14 start kind  +18 start pattern  +1C start frame
//   +20 end kind    +24 end pattern    +28 end frame
//
// v0.7.5 -- BOTH bounds are HALF-OPEN: the window is the set of positions
// (pattern, frame) with start <= pos < end.  The end bound is therefore
// exclusive, which makes "boss:N:0" as the END mean "until pattern N
// starts" -- i.e. exactly "until the pattern before it ends" -- and that is
// what the F2 capture writes.  The previous inclusive end stayed open for
// the first frame of the end pattern, which showed the mid non-spell hint
// bleeding into the mid spell (and the spell-1 hint into non 2).
draw_hints:
  pushfd
  pushad
  mov dword ptr [HINT_CUR], 0
  // The player's playfield position, once: it is both the fade reference
  // and what the calibration mirrors report.  DBG_PLAYER is only refreshed
  // while a stage is running, so range-check it.
  mov dword ptr [DBG_PX], 0
  mov dword ptr [DBG_PY], 0
  mov eax, [DBG_PLAYER]
  cmp eax, 10000
  jb draw_hints_loop
  cmp eax, 7FFF0000
  ja draw_hints_loop
  mov eax, [eax]
  cmp eax, 10000
  jb draw_hints_loop
  cmp eax, 7FFF0000
  ja draw_hints_loop
  cvttss2si ecx, dword ptr [eax]
  cvttss2si edx, dword ptr [eax+4]
  mov [DBG_PX], ecx
  mov [DBG_PY], edx
draw_hints_loop:
  mov eax, [HINT_CUR]
  cmp eax, [HINT_N]
  jae draw_hints_done
  imul eax, eax, 30
  add eax, HINT_ARR
  mov [HINT_ROW], eax
  // ---- character filter ----
  // Entry +8 is 0 for "every character", else 1..4.  CHAR_IDX is the game
  // global the practice menu's per-character bomb default reads
  // (game+ADDFEC, 0-based).  NOTE: that mapping is inherited from le03 and
  // reads 0 for the default character, so a per-character hint is only as
  // trustworthy as that global -- see the README.
  mov eax, [HINT_ROW]
  cmp dword ptr [eax+8], 0
  je draw_hints_char_ok
  mov ecx, [game+ADDFEC]
  inc ecx
  cmp ecx, [eax+8]
  jne draw_hints_next
draw_hints_char_ok:
  // ---- time window ----
  // Two forms, and BOTH ends must agree on which one they use.  A mixed
  // pair (boss start, absolute end) is skipped rather than guessed at --
  // silently picking one would show the hint at a meaningless time.
  mov esi, [HINT_ROW]
  mov eax, [esi+14]
  cmp eax, [esi+20]
  jne draw_hints_next
  test eax, eax
  jnz draw_hints_boss
  // ---- form 0: absolute stage frames ----
  mov eax, [DBG_STAGE]
  cmp eax, 10000
  jb draw_hints_next
  cmp eax, 7FFF0000
  ja draw_hints_next
  mov eax, [eax+4C]
  cmp eax, [esi+1C]
  jb draw_hints_next
  // v0.7.5: exclusive end here too, so the two forms agree.
  cmp eax, [esi+28]
  jae draw_hints_next
  jmp draw_hints_boss_ok
  // ---- form 1: boss patterns ----
  // The current position is the pair (pattern index, pattern-relative
  // frame) and it is compared against (start, end) LEXICOGRAPHICALLY, so
  // one window may legitimately span several patterns -- e.g. from
  // boss:2:60 to boss:4:0 covers the tail of pattern 2 and all of 3.
draw_hints_boss:
  // Gate on "a boss is on screen", never on the pattern number: pattern 0
  // is the mid non-spell, so testing the number for zero would throw away
  // the first pattern of every stage.
  cmp dword ptr [HINT_PAT_ON], 0
  je draw_hints_next
  mov eax, [HINT_PAT_IDX]
  mov edx, [HINT_PAT_FRAME]
  cmp eax, [esi+18]
  jb draw_hints_next
  ja draw_hints_boss_start
  cmp edx, [esi+1C]
  jb draw_hints_next
draw_hints_boss_start:
  // ---- v0.7.5: the END bound is EXCLUSIVE (half-open [start, end)) ----
  // Before this, both ends were inclusive, so a window ending at
  // boss:4:0 stayed open for the whole first frame of pattern 4.  That is
  // exactly what the user saw: the mid non-spell window (ending boss:1:0)
  // still lit through the opening of the mid spell, and the stage-boss
  // spell-1 window (ending boss:5:0) lit through the opening of non 2.
  //
  // The capture output already writes end = boss:<idx+1>:0 for "until
  // this pattern ends", which is only correct under half-open semantics:
  // the window must close the instant the NEXT pattern begins.
  cmp eax, [esi+24]
  ja draw_hints_next
  jb draw_hints_boss_ok
  mov eax, [HINT_PAT_FRAME]
  cmp eax, [esi+28]
  jae draw_hints_next
draw_hints_boss_ok:
  // ---- colour: dim it when the player is standing on the marker ----
  mov eax, [DBG_PX]
  sub eax, [esi+0C]
  test eax, eax
  jns draw_hints_adx
  neg eax
draw_hints_adx:
  mov ebx, [DBG_PY]
  sub ebx, [esi+10]
  test ebx, ebx
  jns draw_hints_ady
  neg ebx
draw_hints_ady:
  add eax, ebx
  // v0.7.11 -- the line's OWN colour if it named one (record +0x2C, from the
  // optional 7th..9th columns of the hint file), else whatever the Hint col
  // row holds.  Dimmed when the player stands on the marker.  Both are HTML
  // order, so the R/B swap happens once, right here.
  mov ecx, [esi+2C]
  test ecx, ecx
  jnz draw_hints_have_col
  mov ecx, [HINT_COL]
draw_hints_have_col:
  cmp eax, [HINT_FADE_R]
  jae draw_hints_col
  // Dim by halving each channel rather than keeping a second colour in
  // step with the first: HINT_COL_DIM could only ever dim one fixed colour.
  shr ecx, 1
  and ecx, 7F7F7F
draw_hints_col:
  call ovl_swaprb
  mov [HINT_USECOL], ecx
  // ---- marker position: playfield + fix + playfield origin ----
  // v0.7.13 -- the same 1/8-unit Fix scale draw_pcross uses, so the cross
  // and the markers can never drift apart.  The marker's own coordinate
  // comes from the file as a whole number, so here the finer step only
  // moves WHERE the truncation boundary falls -- which is exactly what
  // lets the marker be dialled onto the game's own hitbox dot.
  mov ecx, [esi+0C]
  shl ecx, 3
  mov edx, [esi+10]
  shl edx, 3
  mov eax, [OVL_V_FIX_X]
  sub eax, 80
  add ecx, eax
  mov eax, [OVL_V_FIX_Y]
  sub eax, 80
  add edx, eax
  sar ecx, 3
  sar edx, 3
  add ecx, [HINT_OX]
  add edx, [HINT_OY]
  mov [HINT_CX], ecx
  mov [HINT_CY], edx
  mov eax, [esi+4]
  mov [HINT_SIZE], eax
  shr eax, 1
  mov [HINT_HALF], eax
  cmp dword ptr [esi], 2D
  je draw_hints_dash
  cmp dword ptr [esi], 7C
  je draw_hints_vline
  // ---- the crosshair ----
  mov ecx, [HINT_CX]
  mov edx, [HINT_CY]
  mov esi, [HINT_HALF]
  mov eax, ecx
  sub eax, esi
  mov ebx, ecx
  add ebx, esi
  mov edi, edx
  inc edi
  push 1
  push dword ptr [HINT_USECOL]
  push edi
  push ebx
  push edx
  push eax
  call box
  add esp, 18
  mov ecx, [HINT_CX]
  mov edx, [HINT_CY]
  mov esi, [HINT_HALF]
  mov eax, edx
  sub eax, esi
  mov ebx, edx
  add ebx, esi
  mov edi, ecx
  inc edi
  push 1
  push dword ptr [HINT_USECOL]
  push ebx
  push edi
  push eax
  push ecx
  call box
  add esp, 18
  jmp draw_hints_next
  // ---- the dashed safe line ----
  // Spans the whole playfield width at the marker's y; the marker's x is
  // irrelevant, which is why the capture tool can still write a point and
  // you just change the symbol in the txt.
draw_hints_dash:
  mov eax, [HINT_SIZE]
  shr eax, 1
  test eax, eax
  jnz draw_hints_dash_len
  mov eax, 8
draw_hints_dash_len:
  mov [HINT_DASHLEN], eax
  mov eax, [HINT_OX]
  mov [HINT_CX], eax
  add eax, 180
  mov [HINT_DASHEND], eax
draw_hints_dash_loop:
  mov eax, [HINT_CX]
  cmp eax, [HINT_DASHEND]
  jae draw_hints_next
  mov ebx, eax
  add ebx, [HINT_DASHLEN]
  cmp ebx, [HINT_DASHEND]
  jbe draw_hints_dash_seg
  mov ebx, [HINT_DASHEND]
draw_hints_dash_seg:
  mov ecx, [HINT_CY]
  mov edx, ecx
  inc edx
  push 1
  push dword ptr [HINT_USECOL]
  push edx
  push ebx
  push ecx
  push eax
  call box
  add esp, 18
  mov eax, [HINT_DASHLEN]
  add eax, eax
  add [HINT_CX], eax
  jmp draw_hints_dash_loop
  // ---- the vertical safe line ('|') ----
  // The exact mirror of the dash above: it spans the whole playfield
  // HEIGHT at the marker's x, so the marker's y is irrelevant and only the
  // x column matters.  Same dash length rule (size/2, gap = dash).
draw_hints_vline:
  mov eax, [HINT_SIZE]
  shr eax, 1
  test eax, eax
  jnz draw_hints_vl_len
  mov eax, 8
draw_hints_vl_len:
  mov [HINT_DASHLEN], eax
  mov eax, [HINT_OY]
  mov [HINT_CY], eax
  add eax, 1C0
  mov [HINT_DASHEND], eax
draw_hints_vl_loop:
  mov eax, [HINT_CY]
  cmp eax, [HINT_DASHEND]
  jae draw_hints_next
  mov ebx, eax
  add ebx, [HINT_DASHLEN]
  cmp ebx, [HINT_DASHEND]
  jbe draw_hints_vl_seg
  mov ebx, [HINT_DASHEND]
draw_hints_vl_seg:
  mov ecx, [HINT_CX]
  mov edx, ecx
  inc edx
  push 1
  push dword ptr [HINT_USECOL]
  push ebx
  push edx
  push eax
  push ecx
  call box
  add esp, 18
  mov eax, [HINT_DASHLEN]
  add eax, eax
  add [HINT_CY], eax
  jmp draw_hints_vl_loop
draw_hints_next:
  inc dword ptr [HINT_CUR]
  jmp draw_hints_loop
draw_hints_done:
  popad
  popfd
  ret

// draw_pcross (v0.7.8): the self-machine judgement-point cross ---- //
// Ported from le03's `Player +` row.  It is drawn from the SAME playfield
// position, through the SAME transform the hint markers use --
//     game coord = pos + (Fix - 0x40) + HINT_OX/HINT_OY
// -- so with Fix X/Y at their neutral 0x40 the cross sits exactly on the
// judgement dot AND exactly on any hint marker placed there, and one Fix
// nudge moves both together.  It is gated by its OWN switch, NOT by Hint,
// so turning the hint markers off does not take the cross away.
//
// le02 draws in the game's own 640x480 logical space (box() scales it),
// so unlike le03 there is no client-scale arithmetic here at all -- which
// is also why the cross is sized in LOGICAL units (see below), not in the
// screen pixels le03 can use directly.
//
// v0.7.8: the size.  v0.7.7 copied le03's arm-12 numbers verbatim, which in
// this logical space is ~80 screen px -- over three times le03's 25 px.  It
// is now arm 4 / 1 logical px thick = ~27 x 3 screen px, matching le03.
draw_pcross:
  pushfd
  pushad
  // Zero the mirrors first, exactly as draw_hints does: DBG_PLAYER is only
  // refreshed while a stage is running, and a stale pair would otherwise
  // survive into the hint fade test when Hint is off.
  mov dword ptr [DBG_PX], 0
  mov dword ptr [DBG_PY], 0
  cmp dword ptr [OVL_V_PCROSS], 0
  je ovl_pc_done
  // ---- the player's playfield position (the same read draw_hints does)
  mov eax, [DBG_PLAYER]
  cmp eax, 10000
  jb ovl_pc_done
  cmp eax, 7FFF0000
  ja ovl_pc_done
  mov eax, [eax]
  cmp eax, 10000
  jb ovl_pc_done
  cmp eax, 7FFF0000
  ja ovl_pc_done
  cvttss2si ecx, dword ptr [eax]
  cvttss2si edx, dword ptr [eax+4]
  mov [DBG_PX], ecx
  mov [DBG_PY], edx
  // ---- playfield + Fix + origin, byte for byte what draw_hints does ----
  // v0.7.13 -- Fix X/Y are 1/8 logical units with 0x80 (128) as neutral.
  // The cross still lands on whole logical pixels (box() takes integers),
  // but the NUDGE is eight times finer, and what that buys is control over
  // where the truncation boundary falls.  That is the only thing that can
  // line this cross up with a game dot drawn at a different rounding,
  // because the player's position is fractional.  So the float is scaled
  // into eighth-units FIRST and truncated once, at the end.
  // (DBG_PX/PY above keep the RAW coordinates -- the hint fade measures
  // distances in raw playfield pixels and must not see the scaled pair.)
  movss xmm0, dword ptr [eax]
  mulss xmm0, dword ptr [HINT_F8]
  cvttss2si ecx, xmm0
  movss xmm0, dword ptr [eax+4]
  mulss xmm0, dword ptr [HINT_F8]
  cvttss2si edx, xmm0
  mov eax, [OVL_V_FIX_X]
  sub eax, 80
  add ecx, eax
  sar ecx, 3
  add ecx, [HINT_OX]
  mov eax, [OVL_V_FIX_Y]
  sub eax, 80
  add edx, eax
  sar edx, 3
  add edx, [HINT_OY]
  mov [HINT_CX], ecx
  mov [HINT_CY], edx
  // ---- horizontal bar ----
  // arm 4, 1 px thick.  le02's box() works in the game's own 640x480
  // logical space, which the window then stretches by ~3.33x (2560x1600),
  // so a logical unit is ~3.3 screen px.  le03's cross is 25 x 3 SCREEN px,
  // i.e. ~7.5 x 1 logical here -- drawing it at le03's literal numbers
  // (arm 12) came out ~80 px wide, which is what the user spotted.  box()
  // is half-open on x1/y1, so a bar spans (x1-x0) x (y1-y0) logical px.
  mov ecx, [HINT_CX]
  mov edx, [HINT_CY]
  mov eax, ecx
  sub eax, [OVL_V_PSIZE]
  mov ebx, ecx
  add ebx, [OVL_V_PSIZE]
  mov esi, edx
  mov edi, edx
  inc edi
  // v0.7.11 -- the cross has its OWN colour (P+ col), stored in HTML order,
  // so it goes through the same R/B swap every other colour does.
  mov ecx, [OVL_V_PCOL]
  call ovl_swaprb
  push 1
  push ecx
  push edi
  push ebx
  push esi
  push eax
  call box
  add esp, 18
  // ---- vertical bar ----
  // box() clobbers ecx/edx/esi, so reload every coordinate from memory.
  mov ecx, [HINT_CX]
  mov edx, [HINT_CY]
  mov esi, ecx
  mov edi, ecx
  inc edi
  mov eax, edx
  sub eax, [OVL_V_PSIZE]
  mov ebx, edx
  add ebx, [OVL_V_PSIZE]
  mov ecx, [OVL_V_PCOL]
  call ovl_swaprb
  push 1
  push ecx
  push ebx
  push edi
  push eax
  push esi
  call box
  add esp, 18
ovl_pc_done:
  popad
  popfd
  ret

// ---- hint parsing (v0.6.3) ------------------------------------------ //
// hint_skip: advance HINT_P past separators, blank lines and comments.
hint_skip:
  mov esi, [HINT_P]
  mov edi, [HINT_END]
hint_skip_loop:
  cmp esi, edi
  jae hint_skip_done
  mov al, [esi]
  cmp al, 23
  je hint_skip_comment
  cmp al, 20
  je hint_skip_adv
  cmp al, 09
  je hint_skip_adv
  cmp al, 0D
  je hint_skip_adv
  cmp al, 0A
  je hint_skip_adv
  cmp al, 2C
  je hint_skip_adv
  cmp al, 3A
  je hint_skip_adv
  jmp hint_skip_done
hint_skip_adv:
  inc esi
  jmp hint_skip_loop
hint_skip_comment:
  inc esi
  cmp esi, edi
  jae hint_skip_done
  cmp byte ptr [esi], 0A
  jne hint_skip_comment
  inc esi
  jmp hint_skip_loop
hint_skip_done:
  mov [HINT_P], esi
  ret

// hint_tok: copy the next token into HINT_TOK (NUL-terminated).
// Returns its length in eax.
hint_tok:
  call hint_skip
  mov esi, [HINT_P]
  mov edi, [HINT_END]
  mov edx, HINT_TOK
  xor ecx, ecx
hint_tok_loop:
  cmp esi, edi
  jae hint_tok_done
  mov al, [esi]
  cmp al, 20
  je hint_tok_done
  cmp al, 09
  je hint_tok_done
  cmp al, 0D
  je hint_tok_done
  cmp al, 0A
  je hint_tok_done
  cmp al, 2C
  je hint_tok_done
  cmp al, 3A
  je hint_tok_done
  cmp al, 23
  je hint_tok_done
  cmp ecx, 18
  jae hint_tok_adv
  mov [edx], al
  inc edx
  inc ecx
hint_tok_adv:
  inc esi
  jmp hint_tok_loop
hint_tok_done:
  mov byte ptr [edx], 0
  mov [HINT_P], esi
  mov eax, ecx
  ret

// hint_atoi: decimal HINT_TOK -> eax (0 if it is not a number).
hint_atoi:
  mov esi, HINT_TOK
  xor eax, eax
hint_atoi_loop:
  movzx edx, byte ptr [esi]
  test edx, edx
  jz hint_atoi_done
  cmp edx, 30
  jb hint_atoi_done
  cmp edx, 39
  ja hint_atoi_done
  imul eax, eax, 0A
  sub edx, 30
  add eax, edx
  inc esi
  jmp hint_atoi_loop
hint_atoi_done:
  ret

// hint_time: parse one time spec into HINT_TKIND / HINT_TPAT / HINT_TFR.
//   "1200"      -> kind 0, frame 1200 (absolute stage frame)
//   "boss:2:60" -> kind 1, pattern 2, frame 60 (relative to the pattern)
hint_time:
  call hint_tok
  mov dword ptr [HINT_TKIND], 0
  mov dword ptr [HINT_TPAT], 0
  mov dword ptr [HINT_TFR], 0
  mov esi, HINT_TOK
  movzx eax, byte ptr [esi]
  or al, 20
  cmp al, 62
  jne hint_time_num
  mov dword ptr [HINT_TKIND], 1
  call hint_tok
  call hint_atoi
  mov [HINT_TPAT], eax
  call hint_tok
  call hint_atoi
  mov [HINT_TFR], eax
  ret
hint_time_num:
  call hint_atoi
  mov [HINT_TFR], eax
  ret

// hint_store: copy the HINT_E_* scratch into the array at index HINT_N.
// hint_tok_line: the SAME-LINE tokenizer, for the optional colour column
// (v0.7.13).  hint_tok treats a newline as ordinary whitespace, so it would
// happily read the NEXT line's first number as this line's colour -- hence a
// second, line-aware scanner rather than a flag on the existing one.
// Space / tab / CR / comma separate; a newline, '#' or end-of-buffer stops.
// -> eax = token length (0 = nothing left on this line), HINT_P advanced.
hint_tok_line:
  mov esi, [HINT_P]
  mov edi, [HINT_END]
htl_skip:
  cmp esi, edi
  jae htl_empty
  mov al, [esi]
  cmp al, 20
  je htl_adv
  cmp al, 09
  je htl_adv
  cmp al, 0D
  je htl_adv
  cmp al, 2C
  je htl_adv
  jmp htl_tok
htl_adv:
  inc esi
  jmp htl_skip
htl_tok:
  mov edx, HINT_TOK
  xor ecx, ecx
htl_loop:
  cmp esi, edi
  jae htl_done
  mov al, [esi]
  cmp al, 20
  je htl_done
  cmp al, 09
  je htl_done
  cmp al, 0D
  je htl_done
  cmp al, 0A
  je htl_done
  cmp al, 2C
  je htl_done
  cmp al, 23
  je htl_done
  cmp ecx, 18
  jae htl_adv2
  mov [edx], al
  inc edx
  inc ecx
htl_adv2:
  inc esi
  jmp htl_loop
htl_done:
  mov byte ptr [edx], 0
  mov [HINT_P], esi
  mov eax, ecx
  ret
htl_empty:
  mov byte ptr [HINT_TOK], 0
  xor eax, eax
  ret

// hint_parse_col: the OPTIONAL colour column.  Three extra decimal numbers on
// the SAME line are R,G,B.  Anything else -- fewer than three, a non-number,
// a trailing comment -- leaves HINT_E_COL at 0, which means "use the Hint col
// row".  Falling back to the default is deliberate: a six-column file written
// before this version must keep rendering exactly as it did.
hint_parse_col:
  mov dword ptr [HINT_E_COL], 0
  call hint_tok_line
  test eax, eax
  jz hint_pc_done
  call hint_atoi
  mov [HINT_TMP_N], eax
  call hint_tok_line
  test eax, eax
  jz hint_pc_done
  call hint_atoi
  mov [HINT_TMP_COL], eax
  call hint_tok_line
  test eax, eax
  jz hint_pc_done
  call hint_atoi
  mov ecx, [HINT_TMP_N]
  cmp ecx, 0FF
  ja hint_pc_done
  mov edx, [HINT_TMP_COL]
  cmp edx, 0FF
  ja hint_pc_done
  cmp eax, 0FF
  ja hint_pc_done
  // Pack in HTML order; ovl_swaprb turns it into what box() wants.
  shl ecx, 10
  shl edx, 8
  or ecx, edx
  or ecx, eax
  mov [HINT_E_COL], ecx
hint_pc_done:
  ret

hint_store:
  mov eax, [HINT_N]
  imul eax, eax, 30
  add eax, HINT_ARR
  mov ecx, [HINT_E_MARK]
  mov [eax], ecx
  mov ecx, [HINT_E_SIZE]
  mov [eax+4], ecx
  mov ecx, [HINT_E_CHAR]
  mov [eax+8], ecx
  mov ecx, [HINT_E_X]
  mov [eax+0C], ecx
  mov ecx, [HINT_E_Y]
  mov [eax+10], ecx
  mov ecx, [HINT_E_SK]
  mov [eax+14], ecx
  mov ecx, [HINT_E_SP]
  mov [eax+18], ecx
  mov ecx, [HINT_E_SF]
  mov [eax+1C], ecx
  mov ecx, [HINT_E_EK]
  mov [eax+20], ecx
  mov ecx, [HINT_E_EP]
  mov [eax+24], ecx
  mov ecx, [HINT_E_EF]
  mov [eax+28], ecx
  // v0.7.13 -- the optional per-line colour (0 = "use Hint col").
  mov ecx, [HINT_E_COL]
  mov [eax+2C], ecx
  inc dword ptr [HINT_N]
  ret

// parse_hints: the main pass.  HINT_WANT holds the stage to keep.
parse_hints:
  pushfd
  pushad
  // HINT_N / HINT_SKIP are reset once by load_hints, not here: it
  // calls parse_hints once per file and the counts must accumulate.
  mov dword ptr [HINT_CURSTAGE], 0
  mov eax, HINT_BUF
  mov [HINT_P], eax
  add eax, [HINT_LEN]
  mov [HINT_END], eax
parse_loop:
  call hint_skip
  mov eax, [HINT_P]
  cmp eax, [HINT_END]
  jae parse_done
  call hint_tok
  test eax, eax
  jz parse_done
  // A first token that is a bare number, or the word "stage" followed by
  // one, is a stage header rather than a marker.  (The word form is what
  // lets a single merged file carry several stages.)
  cmp eax, 5
  jne parse_not_stage
  movzx eax, byte ptr [HINT_TOK]
  or al, 20
  cmp al, 73
  je parse_stage_word
parse_not_stage:
  movzx eax, byte ptr [HINT_TOK]
  cmp eax, 30
  jb parse_hint
  cmp eax, 39
  ja parse_hint
  call hint_atoi
  mov [HINT_CURSTAGE], eax
  jmp parse_loop
parse_stage_word:
  call hint_tok
  call hint_atoi
  mov [HINT_CURSTAGE], eax
  jmp parse_loop
parse_hint:
  movzx eax, byte ptr [HINT_TOK]
  mov [HINT_E_MARK], eax
  call hint_tok
  call hint_atoi
  mov [HINT_E_SIZE], eax
  call hint_tok
  // Stored as 0 = every character, or 1..4 = that character in the game's
  // own order.  Anything unrecognised stays 0: failing OPEN is deliberate,
  // because an unknown name must never silently hide a hint.
  mov dword ptr [HINT_E_CHAR], 0
  mov esi, HINT_TOK
  movzx eax, byte ptr [esi]
  cmp eax, 31
  jb parse_char_done
  cmp eax, 34
  ja parse_char_done
  cmp byte ptr [esi+1], 0
  jne parse_char_done
  sub eax, 30
  mov [HINT_E_CHAR], eax
parse_char_done:
  call hint_time
  mov eax, [HINT_TKIND]
  mov [HINT_E_SK], eax
  mov eax, [HINT_TPAT]
  mov [HINT_E_SP], eax
  mov eax, [HINT_TFR]
  mov [HINT_E_SF], eax
  call hint_tok
  call hint_atoi
  mov [HINT_E_X], eax
  call hint_tok
  call hint_atoi
  mov [HINT_E_Y], eax
  call hint_time
  mov eax, [HINT_TKIND]
  mov [HINT_E_EK], eax
  mov eax, [HINT_TPAT]
  mov [HINT_E_EP], eax
  mov eax, [HINT_TFR]
  mov [HINT_E_EF], eax
  // v0.7.13 -- the optional colour column, if this line has one.  Same-line
  // only, so a line without it can never steal the next line's numbers.
  call hint_parse_col
  // Keep only entries belonging to the stage we loaded for.
  mov eax, [HINT_CURSTAGE]
  cmp eax, [HINT_WANT]
  jne parse_skip
  cmp dword ptr [HINT_N], HINT_MAXN
  jae parse_skip
  call hint_store
  jmp parse_loop
parse_skip:
  inc dword ptr [HINT_SKIP]
  jmp parse_loop
parse_done:
  popad
  popfd
  ret

// ---- capture (v0.6.4) ------------------------------------------------ //
// hint_itoa: eax = value, edi = destination.  Writes decimal digits and
// advances edi.  pushad would undo edi, so the new value is stashed.
hint_itoa:
  pushad
  mov ebx, 0A
  xor ecx, ecx
  test eax, eax
  jnz hint_itoa_loop
  mov byte ptr [edi], 30
  inc edi
  jmp hint_itoa_out
hint_itoa_loop:
  xor edx, edx
  div ebx
  add edx, 30
  push edx
  inc ecx
  test eax, eax
  jnz hint_itoa_loop
hint_itoa_pop:
  pop eax
  mov [edi], al
  inc edi
  dec ecx
  jnz hint_itoa_pop
hint_itoa_out:
  mov [HINT_IEDI], edi
  popad
  mov edi, [HINT_IEDI]
  ret

// hint_emit_time: write one time spec at edi and advance it.
//   eax = kind (0 = absolute stage frame, 1 = boss pattern)
//   ecx = pattern index (kind 1 only)
//   edx = frame
// kind 0 -> "<frame>"      kind 1 -> "boss:<pattern>:<frame>"
// hint_itoa preserves ecx/edx (it brackets its work with pushad/popad), so
// the second call still sees the frame.
hint_emit_time:
  test eax, eax
  jz hint_emit_abs
  mov byte ptr [edi], 62
  mov byte ptr [edi+1], 6F
  mov byte ptr [edi+2], 73
  mov byte ptr [edi+3], 73
  mov byte ptr [edi+4], 3A
  add edi, 5
  mov eax, ecx
  call hint_itoa
  mov byte ptr [edi], 3A
  inc edi
  mov eax, edx
  call hint_itoa
  ret
hint_emit_abs:
  mov eax, edx
  call hint_itoa
  ret

// hint_chapter_end: end frame of the chapter containing HINT_C_F.
// SECTION_TABLE[stage] points at a per-chapter frame-count list (dwords),
// indexed 0-based -- and HINT_WANT is the REAL 1-based stage (see
// load_hints), so this is HINT_WANT-1.  Using SEL_STAGE here was wrong in
// a full run for exactly the same reason it was wrong in load_hints.
hint_chapter_end:
  pushad
  mov eax, [HINT_WANT]
  test eax, eax
  jz hint_chap_ok
  dec eax
  cmp eax, 6
  jbe hint_chap_ok
  xor eax, eax
hint_chap_ok:
  mov esi, [SECTION_TABLE+eax*4]
  movzx ecx, byte ptr [SECTION_CNT+eax]
  xor edx, edx
hint_chap_loop:
  test ecx, ecx
  jz hint_chap_out
  mov eax, [esi]
  add edx, eax
  cmp edx, [HINT_C_F]
  jae hint_chap_hit
  add esi, 4
  dec ecx
  jmp hint_chap_loop
hint_chap_hit:
  mov [HINT_CHAP_END], edx
  jmp hint_chap_fin
hint_chap_out:
  mov eax, [HINT_C_F]
  add eax, 12C
  mov [HINT_CHAP_END], eax
hint_chap_fin:
  popad
  mov eax, [HINT_CHAP_END]
  ret

// hint_cap_path: HINT_PATHW = <dir>\hint\ + <HINT_WANT>.txt.
// The first HINT_PRELEN WCHARs are the directory prefix load_hints already
// worked out (and they are still in the buffer), so only the file name has
// to be written.  Copying from the start of the same buffer is safe because
// the destination never overtakes the source.
hint_cap_path:
  pushad
  mov esi, HINT_PATHW
  mov edi, HINT_PATHW
  mov ecx, [HINT_PRELEN]
  test ecx, ecx
  jz hint_cp_done
hint_cp_copy:
  mov ax, [esi]
  mov [edi], ax
  add esi, 2
  add edi, 2
  dec ecx
  jnz hint_cp_copy
  // One UTF-16 digit for the stage.  Stages are 1..7 and load_hints
  // already clamps HINT_WANT to 0..9, so one character always suffices.
  // hint_itoa can NOT be reused here: it writes ANSI BYTES, while this
  // buffer is UTF-16, and the mismatch shifted every following character
  // into the high half of the previous code unit -- which is how a
  // capture produced a file literally named "<dir>7\u7400\u7800\u7400".
  mov eax, [HINT_WANT]
  test eax, eax
  jnz hint_cp_num
  mov eax, 1
hint_cp_num:
  cmp eax, 9
  jbe hint_cp_digit
  mov eax, 1
hint_cp_digit:
  add eax, 30
  mov [edi], ax
  add edi, 2
  mov word ptr [edi], 2E
  mov word ptr [edi+2], 74
  mov word ptr [edi+4], 78
  mov word ptr [edi+6], 74
  add edi, 8
  mov word ptr [edi], 0
hint_cp_done:
  popad
  ret

hint_capture:
  pushfd
  pushad
  mov dword ptr [HINT_CAP_OK], 0
  // ---- the player's raw playfield position ----
  mov eax, [DBG_PLAYER]
  cmp eax, 10000
  jb hint_capture_done
  cmp eax, 7FFF0000
  ja hint_capture_done
  mov eax, [eax]
  cmp eax, 10000
  jb hint_capture_done
  cmp eax, 7FFF0000
  ja hint_capture_done
  cvttss2si ecx, dword ptr [eax]
  cvttss2si edx, dword ptr [eax+4]
  mov [HINT_C_X], ecx
  mov [HINT_C_Y], edx
  // ---- the current stage frame ----
  mov eax, [DBG_STAGE]
  cmp eax, 10000
  jb hint_capture_done
  cmp eax, 7FFF0000
  ja hint_capture_done
  mov eax, [eax+4C]
  mov [HINT_C_F], eax
  call hint_chapter_end
  // ---- choose the time form ----
  // Inside a boss fight an absolute stage frame is useless for authoring a
  // boss:P:F window: you cannot tell which pattern you are in, and the frame
  // counter freezes through the dialogue.  So write the form the format
  // actually wants -- boss:<current pattern>:<frames into it>, ending at
  // boss:<next pattern>:0, i.e. "until this pattern ends".
  mov dword ptr [HINT_C_KIND], 0
  mov dword ptr [HINT_C_PID], 0
  mov eax, [HINT_C_F]
  mov [HINT_C_PF], eax
  mov dword ptr [HINT_C_EKIND], 0
  mov dword ptr [HINT_C_EPID], 0
  mov eax, [HINT_CHAP_END]
  mov [HINT_C_EF], eax
  cmp dword ptr [HINT_PAT_ON], 0
  je hint_cap_form_done
  mov eax, [HINT_PAT_IDX]
  mov dword ptr [HINT_C_KIND], 1
  mov [HINT_C_PID], eax
  mov ecx, [HINT_PAT_FRAME]
  mov [HINT_C_PF], ecx
  mov dword ptr [HINT_C_EKIND], 1
  inc eax
  mov [HINT_C_EPID], eax
  mov dword ptr [HINT_C_EF], 0
hint_cap_form_done:
  // ---- build: "+ 16 all <start> <x>,<y> <end>" CRLF ----
  mov edi, HINT_LINE
  mov byte ptr [edi], 2B
  mov byte ptr [edi+1], 20
  add edi, 2
  mov eax, [HINT_SIZE]
  call hint_itoa
  mov byte ptr [edi], 20
  inc edi
  mov byte ptr [edi], 61
  mov byte ptr [edi+1], 6C
  mov byte ptr [edi+2], 6C
  mov byte ptr [edi+3], 20
  add edi, 4
  mov eax, [HINT_C_KIND]
  mov ecx, [HINT_C_PID]
  mov edx, [HINT_C_PF]
  call hint_emit_time
  mov byte ptr [edi], 20
  inc edi
  mov eax, [HINT_C_X]
  call hint_itoa
  mov byte ptr [edi], 2C
  inc edi
  mov eax, [HINT_C_Y]
  call hint_itoa
  mov byte ptr [edi], 20
  inc edi
  mov eax, [HINT_C_EKIND]
  mov ecx, [HINT_C_EPID]
  mov edx, [HINT_C_EF]
  call hint_emit_time
  mov byte ptr [edi], 0D
  mov byte ptr [edi+1], 0A
  add edi, 2
  mov eax, HINT_LINE
  sub edi, eax
  mov [HINT_CAPLEN], edi
  // ---- aim HINT_PATHW at <stage>.txt before opening ----
  // load_hints leaves HINT_PATHW pointing at whichever file the directory
  // walk happened to finish on, so appending straight to it dumped every
  // capture into that one file -- which is exactly how a stage-7 capture
  // ended up inside 1.txt.  Rebuild the name from the stage we resolved.
  call hint_cap_path
  // ---- open (creating if needed) and append ----
  push 0
  push 80
  push 4
  push 0
  push 1
  // GENERIC_READ | GENERIC_WRITE, not write-only: the tail check below
  // has to READ the last byte, and a write-only handle makes ReadFile fail
  // (ERROR_ACCESS_DENIED).  That failure is silent but not harmless -- the
  // file pointer never advances, so the following write lands ON the last
  // byte instead of after it.  It cost us a real character: a file ending
  // "...boss:3:0" came back as "...boss:3:".
  push C0000000
  push HINT_PATHW
  call dword ptr [FILE_IAT]
  cmp eax, ffffffff
  je hint_capture_done
  mov [HINT_HANDLE], eax
  // A brand new file needs its stage header first.
  push 0
  push eax
  call dword ptr [GETSIZE_IAT]
  test eax, eax
  jnz hint_cap_ensure_nl
  mov edi, HINT_LINE2
  mov eax, [HINT_WANT]
  call hint_itoa
  mov byte ptr [edi], 0D
  mov byte ptr [edi+1], 0A
  add edi, 2
  mov eax, HINT_LINE2
  sub edi, eax
  mov [HINT_CAPLEN2], edi
  push 0
  push HINT_WROTE
  push dword ptr [HINT_CAPLEN2]
  push HINT_LINE2
  push dword ptr [HINT_HANDLE]
  call dword ptr [WRITE_IAT]
  jmp hint_capture_seek
hint_cap_ensure_nl:
  // The file already has content.  Make sure it ends with a line break
  // BEFORE appending.  A file whose last line has no newline would have our
  // entry glued onto it -- and that is not merely ugly: the tokens that end
  // up after the merge get parsed as a stage header, so the rest of the
  // file is misread (a real report: "boss:1:0+ 16 all boss:3:1 ..." made
  // the parser take 16 for a stage number).
  mov ecx, eax
  dec ecx
  push 0
  push 0
  push ecx
  push dword ptr [HINT_HANDLE]
  call dword ptr [SEEK_IAT]
  push 0
  push HINT_GOT
  push 1
  push HINT_LASTCH
  push dword ptr [HINT_HANDLE]
  call dword ptr [READ_IAT]
  cmp byte ptr [HINT_LASTCH], 0A
  je hint_capture_seek
  // Terminate the last line first -- but seek to the END explicitly rather
  // than trusting where the read left us.  If that read ever fails again,
  // writing at the stale position would overwrite the file's last byte.
  push 2
  push 0
  push 0
  push dword ptr [HINT_HANDLE]
  call dword ptr [SEEK_IAT]
  mov byte ptr [HINT_LASTCH], 0D
  mov byte ptr [HINT_LASTCH+1], 0A
  push 0
  push HINT_WROTE
  push 2
  push HINT_LASTCH
  push dword ptr [HINT_HANDLE]
  call dword ptr [WRITE_IAT]
hint_capture_seek:
  push 2
  push 0
  push 0
  push dword ptr [HINT_HANDLE]
  call dword ptr [SEEK_IAT]
  push 0
  push HINT_WROTE
  push dword ptr [HINT_CAPLEN]
  push HINT_LINE
  push dword ptr [HINT_HANDLE]
  call dword ptr [WRITE_IAT]
  mov dword ptr [HINT_CAP_OK], 1
  push dword ptr [HINT_HANDLE]
  call dword ptr [CLOSE_IAT]
hint_capture_done:
  popad
  popfd
  ret
// ---- cfg_path: CFG_PATHW = "<exe dir>prac.cfg" ------------------
cfg_path:
  pushad
  push 104
  push CFG_PATHW
  push 0
  call dword ptr [MODULE_IAT]      // GetModuleFileNameW
  test eax, eax
  jz cfg_path_done
  mov esi, CFG_PATHW
  lea edi, [esi+eax*2]
cfg_path_cut:
  cmp edi, esi
  jbe cfg_path_done
  sub edi, 2
  cmp word ptr [edi], 5C           // backslash
  jne cfg_path_cut
  add edi, 2
  mov esi, CFG_TAILW
cfg_path_cp:
  mov ax, [esi]
  mov [edi], ax
  add esi, 2
  add edi, 2
  test ax, ax
  jnz cfg_path_cp
cfg_path_done:
  popad
  ret

// ---- cfg_load: read the file once and apply playerplus -------------
// A missing file, a short file, or no matching key all leave the build's
// own default alone, so a fresh install behaves exactly as before.
// cfg_load: read the whole file once and apply every key we know.  A
// missing file, a short file, or an unknown key all leave the build-time
// default in place, so a fresh install behaves exactly like the previous
// version.
cave+9C00:
// ---- devmode gate ---------------------------------------------------
// Developer mode stays on only when prac.cfg contains the code token
// somewhere in its first 256 bytes.  The token is not a key/value pair,
// so the normal key parser ignores it.
code_present:
  push esi
  push edi
  push ecx
  push edx
  mov edx, CFG_BUF               // candidate start
  mov ecx, 0E2                   // 256 - 31 + 1 positions
cp_scan:
  mov esi, edx
  mov edi, CODE_STR
  push ecx
  mov ecx, 1F                    // 31 bytes
cp_cmp:
  mov al, [esi]
  cmp al, [edi]
  jne cp_miss
  inc esi
  inc edi
  dec ecx
  jnz cp_cmp
  pop ecx
  mov eax, 1
  jmp cp_done
cp_miss:
  pop ecx
  inc edx
  dec ecx
  jnz cp_scan
  xor eax, eax
cp_done:
  pop edx
  pop ecx
  pop edi
  pop esi
  ret
CODE_STR:
  db 4A 79 6E 58 6A 75 6E 67 75 6F 7A 68 75 79 69 62 61 69 6C 65 69 73 69 64 69 65 6C 61 6E 6D 61, 00
CODE_SEEN:
  dd 0
CODE_LINE:
  db 63 6F 64 65 3A 20 4A 79 6E 58 6A 75 6E 67 75 6F 7A 68 75 79 69 62 61 69 6C 65 69 73 69 64 69 65 6C 61 6E 6D 61 0A

cfg_load:
  pushfd
  pushad
  mov dword ptr [CFG_LOADED], 1
  call cfg_path
  push 0
  push 80                       // FILE_ATTRIBUTE_NORMAL
  push 3                        // OPEN_EXISTING
  push 0
  push 1                        // FILE_SHARE_READ
  push 80000000                 // GENERIC_READ
  push CFG_PATHW
  call dword ptr [FILE_IAT]
  cmp eax, FFFFFFFF
  je cfg_load_done
  mov [CFG_H], eax
  push 0
  push CFG_RD
  // Read exactly CFG_BUF's size: a larger read would run off the end of
  // the buffer and clobber CFG_LINE / CFG_TABLE, which sit right after it.
  push 100                      // 256 bytes
  push CFG_BUF
  push dword ptr [CFG_H]
  call dword ptr [READ_IAT]
  push dword ptr [CFG_H]
  call dword ptr [CLOSE_IAT]
  xor edi, edi
cfg_load_entry:
  cmp edi, [CFG_N]
  jae cfg_load_done
  mov eax, edi
  imul eax, eax, 10
  add eax, CFG_TABLE
  mov [CFG_ENT], eax
  mov esi, [eax]
  mov ecx, [eax+4]
  call cfg_find
  test eax, eax
  jz cfg_load_next
  mov esi, eax
  call cfg_atoi
  mov ecx, [CFG_ENT]
  mov edx, [ecx+0C]
  cmp eax, edx
  jbe cfg_load_ok
  mov eax, edx                  // clamp to the row's own maximum
cfg_load_ok:
  mov ecx, [CFG_ENT]
  mov ecx, [ecx+8]
  mov [ecx], eax
cfg_load_next:
  inc edi
  jmp cfg_load_entry
cfg_load_done:
  call code_present
  mov [CODE_SEEN], eax
  cmp dword ptr [CFG_DEVMODE], 0
  je cfg_load_end
  call code_present
  test eax, eax
  jnz cfg_load_end
  mov dword ptr [CFG_DEVMODE], 0
cfg_load_end:
  popad
  popfd
  ret

// ---- cfg_save: rewrite the file with the current value -------------
// cfg_save: rewrite the file with ALL keys, in table order.
cfg_save:
  pushfd
  pushad
  call cfg_path
  push 0
  push 80
  push 2                        // CREATE_ALWAYS
  push 0
  push 1
  push 40000000                 // GENERIC_WRITE
  push CFG_PATHW
  call dword ptr [FILE_IAT]
  cmp eax, FFFFFFFF
  je cfg_save_done
  mov [CFG_H], eax
  xor edi, edi
cfg_save_loop:
  cmp edi, [CFG_N]
  jae cfg_save_close
  mov eax, edi
  imul eax, eax, 10
  add eax, CFG_TABLE
  mov [CFG_ENT], eax
  mov esi, [eax]
  mov ecx, [eax+4]
  mov ebx, CFG_LINE
cfg_save_cp:
  mov al, [esi]
  mov [ebx], al
  inc esi
  inc ebx
  dec ecx
  jnz cfg_save_cp
  mov byte ptr [ebx], 3D
  inc ebx
  mov eax, [CFG_ENT]
  mov eax, [eax+8]
  mov eax, [eax]
  call cfg_itoa
  mov byte ptr [ebx], 0A
  inc ebx
  mov eax, ebx
  sub eax, CFG_LINE
  push 0
  push CFG_WROTE
  push eax
  push CFG_LINE
  push dword ptr [CFG_H]
  call dword ptr [WRITE_IAT]
  inc edi
  jmp cfg_save_loop
cfg_save_close:
  cmp dword ptr [CFG_DEVMODE], 0
  jne cfg_save_code
  cmp dword ptr [CODE_SEEN], 0
  je cfg_save_close2
cfg_save_code:
  je cfg_save_close2
  push 0
  push CFG_WROTE
  push CODE_LEN
  push CODE_LINE
  push dword ptr [CFG_H]
  call dword ptr [WRITE_IAT]
cfg_save_close2:
  push dword ptr [CFG_H]
  call dword ptr [CLOSE_IAT]
  call cfg_snap
cfg_save_done:
  popad
  popfd
  ret

// ---- cfg_tick: once per frame, from overlay_logic ------------------
// Load on the first frame; after that write back only when the value the
// menu holds stops matching what we last persisted.
// cfg_tick: once per frame, from overlay_logic.  Load on the very first
// frame, then rewrite the file whenever one of the values stops matching
// what we last wrote.
cfg_tick:
  pushfd
  pushad
  cmp dword ptr [CFG_LOADED], 0
  jne cfg_tick_chk
  call cfg_load
  call cfg_snap
  jmp cfg_tick_done
cfg_tick_chk:
  mov esi, CFG_TABLE
  mov edi, CFG_LAST
  mov ecx, [CFG_N]
cfg_tick_scan:
  test ecx, ecx
  jz cfg_tick_done
  mov eax, [esi+8]
  mov eax, [eax]
  cmp eax, [edi]
  jne cfg_tick_save
  add esi, 10
  add edi, 4
  dec ecx
  jmp cfg_tick_scan
cfg_tick_save:
  call cfg_save
cfg_tick_done:
  popad
  popfd
  ret

// Copy the live values into CFG_LAST, so cfg_tick has a baseline to compare
// against and does not rewrite the disk every single frame.
cfg_snap:
  pushad
  mov esi, CFG_TABLE
  mov edi, CFG_LAST
  mov ecx, [CFG_N]
cfg_snap_loop:
  test ecx, ecx
  jz cfg_snap_done
  mov eax, [esi+8]
  mov eax, [eax]
  mov [edi], eax
  add esi, 10
  add edi, 4
  dec ecx
  jmp cfg_snap_loop
cfg_snap_done:
  popad
  ret

// cfg_find: esi = key, ecx = key length -> eax = pointer to the first digit
// after "key=", or 0.  The '=' is what stops a short key from matching the
// front of a longer one ("hint" vs "hintcol").
//
// NOTE the '=' test has to happen while ebx is still advanced past the key:
// restoring ebx first would test the key's own first character instead, and
// then nothing would ever match.
cfg_find:
  mov edx, [CFG_RD]
  mov ebx, CFG_BUF
cfg_find_scan:
  cmp edx, ecx
  jb cfg_find_no
  push esi
  push ecx
  push ebx
cfg_find_cmp:
  mov al, [ebx]
  cmp al, [esi]
  jne cfg_find_miss
  inc ebx
  inc esi
  dec ecx
  jnz cfg_find_cmp
  cmp byte ptr [ebx], 3D
  je cfg_find_hit
cfg_find_miss:
  pop ebx
  pop ecx
  pop esi
cfg_find_adv:
  inc ebx
  dec edx
  jmp cfg_find_scan
cfg_find_hit:
  mov eax, ebx
  inc eax
  pop ebx
  pop ecx
  pop esi
  ret
cfg_find_no:
  xor eax, eax
  ret

// cfg_atoi: esi -> eax.  Decimal, stops at the first non-digit.
cfg_atoi:
  xor eax, eax
cfg_atoi_loop:
  movzx edx, byte ptr [esi]
  cmp edx, 30
  jb cfg_atoi_done
  cmp edx, 39
  ja cfg_atoi_done
  imul eax, eax, 0A
  sub edx, 30
  add eax, edx
  inc esi
  jmp cfg_atoi_loop
cfg_atoi_done:
  ret

// cfg_itoa: eax = value, ebx = destination.  Writes decimal digits and
// advances ebx.  (hint_itoa writes through edi and would fight this
// caller's use of it.)
cfg_itoa:
  push eax
  push ecx
  push edx
  push esi
  push edi
  mov edi, CFG_TMPD
  mov ecx, 0A
  xor esi, esi
cfg_itoa_loop:
  xor edx, edx
  div ecx
  add edx, 30
  mov [edi], dl
  inc edi
  inc esi
  test eax, eax
  jnz cfg_itoa_loop
cfg_itoa_pop:
  dec edi
  mov al, [edi]
  mov [ebx], al
  inc ebx
  dec esi
  jnz cfg_itoa_pop
cfg_itoa_out:
  pop edi
  pop esi
  pop edx
  pop ecx
  pop eax
  ret
customMenuRender:
  pushfd
  pushad
  // Start `Bomb:` at the selected character's real default.  Re-applied
  // whenever the character changes, so it is also correct if the player
  // backs out and picks somebody else.
  mov eax, [CHAR_IDX]
  cmp eax, [LAST_CHAR]
  je menu_char_done
  mov [LAST_CHAR], eax
  cmp eax, 3
  ja menu_char_done
  mov eax, [BOMB_DEF+eax*4]
  mov [SEL_BOMB], eax
menu_char_done:
  call getInput
  mov esi, eax
  xor ecx, ecx
menu_keys:
  mov edx, [esi+ecx*4+84]
  mov edx, [esi+edx*4+4]
  mov [KEYS+ecx*4], edx
  inc ecx
  cmp ecx, 7
  jl menu_keys
  cmp dword ptr [CURR_SEL], 0
  jne menu_ready
  mov eax, SEL_STAGE
  mov [CURR_SEL], eax
  mov eax, [DIFF]
  mov [SEL_DIFF], eax
menu_ready:
  mov edi, [CURR_SEL]
  mov esi, edi
  sub esi, SEL_ARR_BEGIN
  add esi, SEL_DATA
  movzx ebx, word ptr [esi]
  movzx esi, word ptr [esi+2]

  // The Pattern row is the only one whose real upper bound is dynamic:
  // it is the last pattern of the stage, or the last chapter in Section
  // mode.  Computing it here feeds both the clamp and the left-wrap.
  cmp edi, PATTERN_WARP
  jne menu_max_ok
  mov eax, [SEL_STAGE]
  cmp dword ptr [SEL_MODE], 0
  jne menu_sec_max
  movzx ebx, byte ptr [MAX_PATTERNID+eax]
  jmp menu_max_ok
menu_sec_max:
  movzx ebx, byte ptr [SECTION_CNT+eax]
  test ebx, ebx
  jz menu_max_ffff
  mov edi, SEL_SECTION
  dec ebx
  xor esi, esi
  jmp menu_max_ok
menu_max_ffff:
  mov ebx, ffff
menu_max_ok:
  mov [SEL_MAX], ebx

  cmp esi, 0
  je customMenu_slowInc
  mov eax, ffffffff
  jmp customMenu_keyCheck
customMenu_slowInc:
  mov eax, 1

customMenu_keyCheck:
  // Wrap dwell: the value has just landed on an extreme, so give the
  // player a moment to let go before the held key can move it again.
  cmp dword ptr [WRAP_LOCK], 0
  je wrap_no_lock
  cmp dword ptr [WRAP_TIMER], 0
  jz wrap_release
  dec dword ptr [WRAP_TIMER]
  jmp customMenu_notLeft
wrap_release:
  mov dword ptr [WRAP_LOCK], 0
wrap_no_lock:
  mov ecx, [KEY_RIGHT]
  cmp ecx, 0
  je customMenu_notRight
  cmp ecx, eax
  ja customMenu_notRight
  add [edi], ecx
  cmp ebx, ffff
  je customMenu_rightClb
  cmp [edi], ebx
  jna customMenu_rightClb // does not exceed max
  // Over the maximum: wrap to the bottom.  Unbounded rows (max ==
  // FFFF) never reach here, so they keep their plain clamp.
  mov dword ptr [edi], 0
  call wrap_latch
customMenu_rightClb:
  call customMenuSwitchClb
customMenu_notRight:
  mov ecx, [KEY_LEFT]
  cmp ecx, 0
  je customMenu_notLeft
  cmp ecx, eax
  ja customMenu_notLeft
  sub [edi], ecx
  cmp [edi], 0
  jnl customMenu_leftClb // not <zero
  // Under the minimum: bounded rows wrap to the top, unbounded ones
  // (max == FFFF, i.e. Frame and Score) just clamp at zero.
  mov eax, [SEL_MAX]
  cmp eax, ffff
  je customMenu_leftZero
  mov [edi], eax
  call wrap_latch
  jmp customMenu_leftClb
customMenu_leftZero:
  mov [edi], 0
customMenu_leftClb:
  call customMenuSwitchClb
customMenu_notLeft:
  mov edi, [CURR_SEL]
  cmp [KEY_UP], 1
  jne customMenu_notUp
  sub edi, 4
  cmp edi, SEL_ARR_BEGIN
  jnl customMenu_notUp
  mov edi, SEL_ARR_LAST
customMenu_notUp:
  cmp [KEY_DOWN], 1
  jne customMenu_notDown
  add edi, 4
  cmp edi, SEL_ARR_LAST
  jng customMenu_notDown
  mov edi, SEL_ARR_BEGIN
customMenu_notDown:

  mov [CURR_SEL], edi
  mov edi, 90

  mov eax, [SEL_STAGE]
  inc eax
  push eax
  push TXT_STAGE
  mov eax, SEL_STAGE
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  mov eax, [SEL_MODE]
  push [MODE_TXTS+eax*4]
  push TXT_MODE
  mov eax, SEL_MODE
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  mov eax, [SEL_DIFF]
  push [DIFF_TXTS+eax*4]
  push TXT_DIFF
  mov eax, SEL_DIFF
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  push [FRAME_COUNT_INIT]
  push TXT_FRAME
  mov eax, FRAME_COUNT_INIT
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  cmp dword ptr [SEL_MODE], 0
  jne draw_section
  mov eax, [SEL_STAGE]
  mov ebx, [PATTERNS_TABLE+eax*4]
  mov eax, [PATTERN_WARP]
  mov ebx, [ebx+eax*4]
  push ebx
  push TXT_PATTERN
  mov eax, PATTERN_WARP
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10
  jmp draw_row_done
draw_section:
  mov eax, [SEL_SECTION]
  inc eax
  push eax
  push TXT_SECTION
  mov eax, PATTERN_WARP
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10
draw_row_done:

  push [SEL_POWER]
  push TXT_POWER
  mov eax, SEL_POWER
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  push [SEL_FLASHBOMB]
  push TXT_FLASHBOMB
  mov eax, SEL_FLASHBOMB
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  push [SEL_RESOURCE]
  push TXT_RESOURCE
  mov eax, SEL_RESOURCE
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  push [SEL_LIFE]
  push TXT_LIFE
  mov eax, SEL_LIFE
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  push [SEL_BOMB]
  push TXT_BOMB
  mov eax, SEL_BOMB
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  mov eax, [SEL_SCORE]
  cdq
  mov ebx, 3E8 // 1000
  div ebx
  push edx
  push eax
  push TXT_SCORE
  mov eax, SEL_SCORE
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 18
  add edi, 10


  mov eax, [SEL_DIFF]
  mov [DIFF], eax
  popad
  popfd
  mov eax, [SEL_STAGE]
  mov [ebx+638], eax
  mov dword ptr [IS_PRAC], 1

  jmp customMenuRender_ret

beginPracticeStage:

  pushfd
  pushad
  call preparePracticeState
  popad
  popfd
  mov edi, ecx
  xorps xmm0, xmm0
  jmp beginPracticeStage_ret

initFrameTimer:

  pushfd
  push eax
  mov [DBG_STAGE], edi
  // load_hints already calls parse_hints once per file it enumerates,
  // so there must NOT be a parse_hints call here as well: it would
  // re-parse whatever text is still sitting in HINT_BUF (the last file
  // read) and double-count that file's entries.
  call load_hints
  // v0.7.5 -- the Hit counter is per ATTEMPT, not per process.  It used
  // to accumulate from launch forever, so a retry (or starting a new
  // stage in a full run) inherited the previous attempt's total.  This
  // hook is the one point guaranteed to run at every stage start, so
  // zero it here.  (NOSORE_DEBT is the storage; the F12 row mirrors it
  // into OVL_V_DEBT every frame, so the row follows automatically.)
  mov dword ptr [NOSORE_DEBT], 0
  // v0.7.11 -- the boss-pattern tracker is per ATTEMPT too, exactly like
  // the Hit counter above.  Its "new fight" rule (see ovl_boss_poll)
  // suppresses the first pattern number it reads, which is only sound
  // when the next fight really is a DIFFERENT fight.  An in-stage RETRY
  // replays the SAME fight, and the re-created boss object comes back
  // carrying the very pattern number the previous attempt died on, so
  // the value the rule waits for never changes, the suppression never
  // lifts, and every boss:P:F window is dead for the whole fight.
  // (Found and fixed in Le01 v0.1.10; same code here.)
  mov dword ptr [HINT_PAT_ON], 0
  mov dword ptr [HINT_PAT_IDX], 0
  mov dword ptr [HINT_PAT_FRAME], 0
  mov dword ptr [HINT_PAT_WAS], 0
  mov dword ptr [HINT_PAT_SKIP], FFFFFFFF
  // HINT_PAT_LAST is the ONE field that must survive a stage CHANGE --
  // it is exactly what suppresses the recycled value at the next stage's
  // first fight -- but it must NOT survive a retry of the same stage,
  // because the retry's first pattern number can legitimately equal it
  // and then nothing ever lifts the suppression.  Clear it only when the
  // stage number repeats.
  mov eax, [edi+30]
  cmp eax, [HINT_PAT_STAGE]
  je initFrameTimer_same_stage
  mov [HINT_PAT_STAGE], eax
  jmp initFrameTimer_pat_done
initFrameTimer_same_stage:
  mov dword ptr [HINT_PAT_LAST], FFFFFFFF
initFrameTimer_pat_done:
  // v0.7.14 -- a new stage means the player object from the previous
  // one is gone.  DBG_PLAYER is only refreshed by ovl_lockpower, so
  // drop it here too; see setPracFalse for the crash a stale value
  // caused (Le03, in-stage restart).
  mov dword ptr [DBG_PLAYER], 0
  mov dword ptr [edi+4C], 0
  mov dword ptr [MUSIC_PLAYED], 0
  mov dword ptr [MUSIC_KIND], 0
  cmp dword ptr [IS_PRAC], 1
  jne frame_done
  mov eax, [FRAME_COUNT_INIT]
  mov [edi+4C], eax
frame_done:
  pop eax
  popfd
  jmp initFrameTimer_ret

applyPatternIdWarp:

  pushfd
  push ebx
  cmp dword ptr [IS_PRAC], 1
  jne boss_done
  mov ebx, [SELECTED_ID]
  cmp ebx, 0
  jl boss_done
  mov [eax+44], ebx
boss_done:
  pop ebx
  popfd
  mov [edi], eax
  call game+2BE85F
  jmp applyPatternIdWarp_ret

setPracFalse:
  mov dword ptr [IS_PRAC], 0
  // v0.7.14 -- drop the player pointer the moment practice ends.
  // DBG_PLAYER is written every frame by ovl_lockpower (the power
  // clamp) and read by draw_pcross / draw_hints / hint_capture.  When
  // practice ends the player object is freed, but the overlay keeps
  // running -- it is driven by the present hook, which fires on menus
  // too -- so those readers dereferenced a stale pointer.  Their guard
  // is only "does this look like a pointer" (0x10000..0x7fff0000),
  // and a freed block that the allocator has reused for text passes
  // that easily: the game then died with 0xC0000005 inside
  // `cvttss2si ecx,[eax]` reading the position floats.  Found in Le03
  // on in-stage restart; same code here.  Clearing the pointer makes
  // the first range check reject it and the readers bail cleanly.
  mov dword ptr [DBG_PLAYER], 0
  call game+E24B0
  jmp setPracFalse_ret

setPower:
  pushfd
  push eax
  push edx
  cmp dword ptr [IS_PRAC], 1
  jne power_done
  mov eax, [edi]
  mov eax, [eax]
  mov edx, [SEL_POWER]
  mov [eax+7C], edx
  mov edx, [SEL_FLASHBOMB]
  mov [eax+6C], edx
  mov edx, [SEL_RESOURCE]
  mov [eax+8C], edx
  mov edx, [SEL_LIFE]
  mov [eax+48], edx
  mov edx, [SEL_BOMB]
  mov [eax+60], edx
power_done:
  pop edx
  pop eax
  popfd
  mov dword ptr [edi+2824], 0
  jmp setPower_ret

setScore:

  pushfd
  push ebx
  mov dword ptr [eax+58], 0
  cmp dword ptr [IS_PRAC], 1
  jne score_done
  mov ebx, [SEL_SCORE]
  imul ebx, ebx, 3E8
  mov [eax+58], ebx
score_done:
  pop ebx
  popfd
  jmp setScore_ret

musicFix1:
  mov eax, [esi+4C]
  cmp dword ptr [IS_PRAC], 1
  jne music_original
  cmp dword ptr [MUSIC_PLAYED], 0
  je music_first
  cmp dword ptr [MUSIC_PLAYED], 1
  jne music_original
  push edx
  mov edx, [SEL_STAGE]
  mov edx, [BOSS_FRAMES+edx*4]
  cmp [FRAME_COUNT_INIT], edx
  pop edx
  jl music_original
  mov dword ptr [MUSIC_PLAYED], 2
  mov dword ptr [MUSIC_KIND], 1
  call selectBossMusicKind
  cmp eax, eax
  jmp musicFix1_ret
music_first:
  call prepareAlphaMusic
  cmp eax, [esi+68]
  jl music_original
  mov dword ptr [MUSIC_PLAYED], 1
  mov dword ptr [MUSIC_KIND], 0
  cmp eax, eax
  jmp musicFix1_ret
music_original:
  cmp eax, [esi+68]
  jmp musicFix1_ret

musicFix2:

  cmp dword ptr [IS_PRAC], 1
  jne music_normal_kind
  push dword ptr [MUSIC_KIND]
  jmp music_push_stage
music_normal_kind:
  push 0
music_push_stage:
  push dword ptr [esi+30]
  jmp musicFix2_ret

selectBossMusicKind:
  ret
prepareAlphaMusic:
  ret

// The game has two player-init paths and we do not know which one runs
// last, so write Life/Bomb in both -- setPower above, and these two.
life_stub:
  cmp dword ptr [IS_PRAC], 1
  jne life_stub_orig
  push edx
  mov edx, [SEL_LIFE]
  mov [eax+48], edx
  pop edx
  jmp life_stub_ret
life_stub_orig:
  mov dword ptr [eax+48], 9
  jmp life_stub_ret
bomb_stub:
  cmp dword ptr [IS_PRAC], 1
  jne bomb_stub_orig
  mov eax, [SEL_BOMB]
  jmp bomb_stub_ret
bomb_stub_orig:
  mov eax, [ebx+eax*4+A8]
  jmp bomb_stub_ret
wrap_latch:
  // esi still holds this row's SEL_DATA fast flag.  Only the
  // hold-to-scroll rows need the dwell; a slow row already needs a fresh
  // key press for every single step, so it cannot run away on its own.
  cmp esi, 0
  je wrap_latch_ret
  mov dword ptr [WRAP_LOCK], 1
  mov dword ptr [WRAP_TIMER], 12 // 18 frames, about 0.3 s
wrap_latch_ret:
  ret
getBossExtraFlag:
  // ecx and edx are live at every bossBombGate site, so preserve them.
  push ecx
  push edx
  mov al, [ebx+A1]
  cmp dword ptr [IS_PRAC], 1
  jne boss_extra_return
  // Ground truth: what the practice menu is set to right now.
  // Stage index 6 is the Extra stage; 5/6 are Extra / AbsurdlyExtra.
  mov ecx, [SEL_STAGE]
  cmp ecx, 6
  jne boss_extra_scene
  mov ecx, [SEL_DIFF]
  cmp ecx, 5
  jl boss_extra_scene
  cmp ecx, 6
  jg boss_extra_scene
  mov al, 1
  jmp boss_extra_return
boss_extra_scene:
  // BAN's boss-object snapshot test, kept as a second opinion.
  cmp dword ptr [ebx+30], 7
  jl boss_extra_return
  cmp dword ptr [ebx+30], 7
  jg boss_extra_return
  cmp dword ptr [ebx+34], 5
  jl boss_extra_return
  cmp dword ptr [ebx+34], 6
  jg boss_extra_return
  mov al, 1
boss_extra_return:
  pop edx
  pop ecx
  ret

bossBombGate0:

  push eax
  call getBossExtraFlag
  cmp al, 1
  pop eax
  jmp bossBombGate0_ret

bossBombGate1:

  push eax
  call getBossExtraFlag
  cmp al, 1
  pop eax
  jmp bossBombGate1_ret

bossBombGate2:

  push eax
  call getBossExtraFlag
  cmp al, 1
  pop eax
  jmp bossBombGate2_ret

bossBombGate3:

  push eax
  call getBossExtraFlag
  cmp al, 1
  pop eax
  jmp bossBombGate3_ret

bossBombGate4:

  push eax
  call getBossExtraFlag
  cmp al, 0
  pop eax
  jmp bossBombGate4_ret

getPhase:
  xor eax, eax
  cmp dword ptr [IS_PRAC], 1
  jne phase_return
  mov eax, [SELECTED_PHASE]
phase_return:
  ret

tasStart:

  pushfd
  push eax
  call getPhase
  mov eax, [TAS_START+eax*4]
  mov [game+5E0888], eax
  pop eax
  popfd
  jmp tasStart_ret

tasLength:

  push eax
  call getPhase
  cmp esi, [TAS_LENGTH+eax*4]
  pop eax
  jmp tasLength_ret

tasTimer:

  pushfd
  push eax
  call getPhase
  mov eax, [TAS_TIMER+eax*4]
  mov [ebx+924], eax
  pop eax
  popfd
  jmp tasTimer_ret

customMenuSwitchClb:
  mov eax, [CURR_SEL]
  cmp eax, SEL_STAGE
  jne callback_pattern
  mov dword ptr [FRAME_COUNT_INIT], 0
  mov dword ptr [PATTERN_WARP], 0
  mov dword ptr [SEL_SECTION], 0
callback_pattern:
  mov eax, [SEL_STAGE]
  cmp dword ptr [SEL_MODE], 0
  jne callback_section
  movzx ebx, byte ptr [MAX_PATTERNID+eax]
  cmp [PATTERN_WARP], ebx
  jle callback_in_range
  mov [PATTERN_WARP], ebx
callback_in_range:
  mov ecx, [PATTERN_WARP]
  mov ebx, [IDS_TABLE+eax*4]
  mov edx, [ebx+ecx*4]
  mov [SELECTED_ID], edx
  mov ebx, [PHASES_TABLE+eax*4]
  mov ebx, [ebx+ecx*4]
  mov [SELECTED_PHASE], ebx
  // Boss mode: the frame is part of the pattern, and a frame that does
  // not match the pattern desyncs the boss and can crash the game, so
  // re-derive it on every change -- that makes the Frame row read-only.
  cmp edx, 0
  jl callback_none
  movzx ebx, byte ptr [MBOSS_PATTERN_CNT+eax]
  cmp edx, ebx
  jge callback_boss
  mov eax, [MBOSS_FRAMES+eax*4]
  jmp callback_frame
callback_boss:
  mov eax, [BOSS_FRAMES+eax*4]
callback_frame:
  mov [FRAME_COUNT_INIT], eax
  jmp callback_done
callback_none:
  mov dword ptr [FRAME_COUNT_INIT], 0
  jmp callback_done
callback_section:
  // Section mode: the frame is the user's to nudge; only re-derive it
  // when something other than the Frame row changed.
  cmp dword ptr [CURR_SEL], FRAME_COUNT_INIT
  je callback_done
  mov dword ptr [PATTERN_WARP], 0
  mov dword ptr [SELECTED_ID], ffffffff
  mov dword ptr [SELECTED_PHASE], 0
  movzx ebx, byte ptr [SECTION_CNT+eax]
  test ebx, ebx
  jz callback_sec_none
  dec ebx
  cmp [SEL_SECTION], ebx
  jle callback_sec_ok
  mov [SEL_SECTION], ebx
callback_sec_ok:
  mov ecx, [SEL_SECTION]
  mov ebx, [SECTION_TABLE+eax*4]
  mov ebx, [ebx+ecx*4]
  mov [FRAME_COUNT_INIT], ebx
  // If this chapter starts PAST the midboss frame the game never runs its
  // `timer == midboss_frame` branch, so [boss+0x48] stays 0 (midboss) and
  // the boss frame plays the MIDBOSS's pattern set.  Point the boss's
  // starting pattern at this stage's first BOSS pattern instead.
  mov eax, [SEL_STAGE]
  mov ecx, [MBOSS_FRAMES+eax*4]
  cmp [FRAME_COUNT_INIT], ecx
  jle callback_sec_no_boss
  movzx ecx, byte ptr [MBOSS_PATTERN_CNT+eax]
  inc ecx
  mov [PATTERN_WARP], ecx
  mov ebx, [IDS_TABLE+eax*4]
  mov ebx, [ebx+ecx*4]
  mov [SELECTED_ID], ebx
  mov ebx, [PHASES_TABLE+eax*4]
  mov ebx, [ebx+ecx*4]
  mov [SELECTED_PHASE], ebx
  jmp callback_done
callback_sec_no_boss:
  mov dword ptr [PATTERN_WARP], 0
  jmp callback_done
callback_sec_none:
  mov dword ptr [SEL_SECTION], 0
  mov dword ptr [FRAME_COUNT_INIT], 0
callback_done:
  ret
mgrNudge:
  push eax
  push ecx
  push edx
  cmp dword ptr [IS_PRAC], 1
  jne mgrNudge_out
  cmp dword ptr [SEL_MODE], 1
  jne mgrNudge_out
  mov eax, [edi]
  test eax, eax
  je mgrNudge_out
  cmp dword ptr [eax+48], 0
  jne mgrNudge_out
  mov eax, [edi+28]
  dec eax
  cmp eax, 6
  ja mgrNudge_out
  mov ecx, [BOSS_FRAMES+eax*4]
  dec ecx
  cmp [edi+d4], ecx
  jne mgrNudge_out
  inc dword ptr [edi+d4]
mgrNudge_out:
  pop edx
  pop ecx
  pop eax
  mov ecx, [edi+d4]
  jmp mgrNudge_ret
getColor:
  cmp [CURR_SEL], eax
  je color_selected
  mov eax, FF
  ret
color_selected:
  xor eax, eax
  ret

preparePracticeState:
  mov dword ptr [RECORD_VALID], 0
  cmp byte ptr [game+ADDFFC], 0
  jne practice_state_inactive
  cmp byte ptr [game+ADDFFA], 0
  jne practice_state_replay
  cmp byte ptr [game+ADDFF9], 1
  jne practice_state_inactive
  cmp dword ptr [IS_PRAC], 1
  jne practice_state_inactive
  mov eax, [SEL_STAGE]
  mov [RECORD_CONFIG+10], eax
  mov eax, [SEL_DIFF]
  mov [RECORD_CONFIG+14], eax
  mov eax, [FRAME_COUNT_INIT]
  mov [RECORD_CONFIG+18], eax
  mov eax, [PATTERN_WARP]
  mov [RECORD_CONFIG+1C], eax
  mov eax, [SEL_POWER]
  mov [RECORD_CONFIG+20], eax
  xor eax, eax
  mov [RECORD_CONFIG+24], eax
  mov eax, [SEL_FLASHBOMB]
  mov [RECORD_CONFIG+28], eax
  mov eax, [SEL_RESOURCE]
  mov [RECORD_CONFIG+2C], eax
  mov eax, [SEL_SCORE]
  mov [RECORD_CONFIG+30], eax
  mov eax, [SELECTED_ID]
  mov [RECORD_CONFIG+34], eax
  mov eax, [SELECTED_PHASE]
  mov [RECORD_CONFIG+38], eax
  mov dword ptr [RECORD_CONFIG], 5250454C
  mov dword ptr [RECORD_CONFIG+4], 50524341
  mov dword ptr [RECORD_CONFIG+8], 1
  mov dword ptr [RECORD_CONFIG+C], 2
  mov esi, RECORD_CONFIG
  xor eax, eax
  mov ecx, F
practice_checksum:
  xor eax, [esi]
  add esi, 4
  loop practice_checksum
  mov [RECORD_CONFIG+3C], eax
  mov dword ptr [RECORD_VALID], 1
  ret
practice_state_replay:
  cmp dword ptr [REPLAY_VALID], 1
  jne practice_state_inactive
  mov eax, [REPLAY_CONFIG+10]
  mov [SEL_STAGE], eax
  mov eax, [REPLAY_CONFIG+14]
  mov [SEL_DIFF], eax
  mov eax, [REPLAY_CONFIG+18]
  mov [FRAME_COUNT_INIT], eax
  mov eax, [REPLAY_CONFIG+1C]
  mov [PATTERN_WARP], eax
  mov eax, [REPLAY_CONFIG+20]
  mov [SEL_POWER], eax
  mov eax, [REPLAY_CONFIG+28]
  mov [SEL_FLASHBOMB], eax
  mov eax, [REPLAY_CONFIG+2C]
  mov [SEL_RESOURCE], eax
  mov eax, [REPLAY_CONFIG+30]
  mov [SEL_SCORE], eax
  mov eax, [REPLAY_CONFIG+34]
  mov [SELECTED_ID], eax
  mov eax, [REPLAY_CONFIG+38]
  mov [SELECTED_PHASE], eax
  mov eax, [SEL_STAGE]
  inc eax
  mov [game+ADDFF0], eax
  mov eax, [SEL_DIFF]
  mov [DIFF], eax
  mov dword ptr [IS_PRAC], 1
  ret
practice_state_inactive:
  mov dword ptr [IS_PRAC], 0
  ret
validateReplayConfig:
  cmp dword ptr [REPLAY_CONFIG], 5250454C
  jne replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+4], 50524341
  jne replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+8], 1
  jne replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+C], 2
  jne replay_config_bad
  mov esi, REPLAY_CONFIG
  xor eax, eax
  mov ecx, 10
replay_checksum:
  xor eax, [esi]
  add esi, 4
  loop replay_checksum
  test eax, eax
  jne replay_config_bad
  mov eax, [REPLAY_CONFIG+10]
  cmp eax, 6
  ja replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+14], 6
  ja replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+18], FFFF
  ja replay_config_bad
  mov ecx, [REPLAY_CONFIG+1C]
  movzx edx, byte ptr [MAX_PATTERNID+eax]
  cmp ecx, edx
  ja replay_config_bad
  mov edx, [IDS_TABLE+eax*4]
  mov edx, [edx+ecx*4]
  cmp edx, [REPLAY_CONFIG+34]
  jne replay_config_bad
  mov edx, [PHASES_TABLE+eax*4]
  mov edx, [edx+ecx*4]
  cmp edx, [REPLAY_CONFIG+38]
  jne replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+20], 1F4
  ja replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+24], 0
  ja replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+28], 1770
  ja replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+2C], 1388
  ja replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+30], FFFF
  ja replay_config_bad
  mov eax, 1
  ret
replay_config_bad:
  xor eax, eax
  ret

replayLoadBegin:

  mov dword ptr [REPLAY_VALID], 0
  mov dword ptr [esi+8], 0
  jmp replayLoadBegin_ret

replayLoadSettings:

  call game+2BDEAD
  pushfd
  pushad
  cmp dword ptr [ebp-8C], 0
  je replay_load_body_complete
  cmp eax, 1
  jne replay_load_done
replay_load_body_complete:
  cmp byte ptr [esi+74], 1
  jne replay_load_done
  push dword ptr [ebp-88]
  push 1
  push 40
  push REPLAY_CONFIG
  call game+2BDEAD
  add esp, 10
  cmp eax, 1
  jne replay_load_done
  call validateReplayConfig
  mov [REPLAY_VALID], eax
replay_load_done:
  popad
  popfd
  jmp replayLoadSettings_ret

replaySaveSettings:

  call game+2BEB6F
  pushfd
  pushad
  cmp dword ptr [ebp-8C], 0
  je replay_save_body_complete
  cmp eax, 1
  jne replay_save_done
replay_save_body_complete:
  cmp dword ptr [RECORD_VALID], 1
  jne replay_save_done
  cmp byte ptr [esi+74], 1
  jne replay_save_done
  push dword ptr [ebp-88]
  push 1
  push 40
  push RECORD_CONFIG
  call game+2BEB6F
  add esp, 10
replay_save_done:
  popad
  popfd
  jmp replaySaveSettings_ret
