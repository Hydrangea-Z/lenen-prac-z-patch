// ---- marker shape and colour ----
HINT_SYM:
  dd 2B
HINT_COL:
  dd FF
HINT_COL_DIM:
  dd 40
HINT_FADE_R:
  dd 28
// Marker correction, added to the marker's playfield coordinates.
// BIASED by 0x40 because ovl_apply compares unsigned, so a row
// cannot hold a negative number: 0x40 means no shift, 0x40+n moves
// the marker n pixels right/down.  Menu rows Fix X / Fix Y expose
// this so the marker can be dialled onto the game's own hitbox dot.
HINT_DX:
  dd 41
HINT_DY:
  dd 40
HINT_DASH:
  dd 10
HINT_USECOL:
  dd 0
HINT_DASHLEN:
  dd 0
