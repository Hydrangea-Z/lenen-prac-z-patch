// --- F12 overlay (v0.4.0): eight in-place patches --------------------- //
// game+CFFCD is 10 bytes into the real per-frame function.
game+CFFCD:
 jmp overlay_entry
 nop
 nop
 nop
 nop
 nop
game+CFFD7:
// the present function's entry (9 bytes: push ebp / mov ebp,esp /
// sub esp,0x4cc).  Everything the game draws for this frame is already
// in the surface; nothing has been blitted yet.
game+14BD50:
 jmp overlay_present
 nop
 nop
 nop
 nop
game+14BD59:
// the four keyboard-refresh sites, each `call game+140CD0` (5 bytes).
game+CF255:
 call overlay_input
game+CF25A:
game+CF2B5:
