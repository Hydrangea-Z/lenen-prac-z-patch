HINT_LINE:
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
HINT_LINE2:
  db 00 00 00 00 00 00 00 00
// Scratch for the tail-of-file newline check: holds the file's last byte,
// and is written back as CRLF when that byte is not already a newline.
HINT_LASTCH:
  db 00 00
