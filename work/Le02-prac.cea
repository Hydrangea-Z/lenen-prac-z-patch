cave+6000:
HINT_BUF:
cave+7800:
HINT_ARR:
cave_end:

// ---- Speed clamp on commit (lives after the pinned string table) ----
cave+9000:
fps_commit_clamp:
  push eax
  mov eax, [OVL_TYPE_VAL]
  cmp eax, SPEED_FPS
  jne fcc_done
  // 0 means nothing was typed yet -- clamping it is what snapped the
  // row back to 60 the instant Z was pressed.
  cmp dword ptr [SPEED_FPS], 1
  jb fcc_done
  cmp dword ptr [CFG_DEVMODE], 0
  jne fcc_done
  cmp dword ptr [SPEED_FPS], 3C
  jae fcc_done
  mov dword ptr [SPEED_FPS], 3C
fcc_done:
  pop eax
  ret

cave+9100:
spd_typing_on:
  mov dword ptr [SPEED_TYPING], 1
  ret

cave+9200:
spd_typing_off:
  mov dword ptr [SPEED_TYPING], 0
  ret

cave+9400:
fps_tick2:
  push eax
  push ecx
  push edx
  cmp dword ptr [DLL_LOADED], 0
  jne ft_no_dll
  mov dword ptr [DLL_LOADED], 1
  // ---- embedded speed DLL: extract to the temp dir and load it --------
  // Falls back to the sidecar next to the exe when anything fails.
  pushad
  push SPD_TMPBUF               // stdcall: rightmost arg first
  push 104
  call dword ptr [7AC138]      // GetTempPathA(260, buf)
  test eax, eax
  jz ft_spd_fb
  mov edi, SPD_TMPBUF
  add edi, eax
  mov esi, SPD_TMPNAME
ft_spd_nc:
  mov al, [esi]
  test al, al
  jz ft_spd_ne
  mov [edi], al
  inc esi
  inc edi
  jmp ft_spd_nc
ft_spd_ne:
  mov byte ptr [edi], 0
  push 104
  push SPD_TMPW
  push -1
  push SPD_TMPBUF
  push 0
  push 0
  call dword ptr [7AC144]        // MultiByteToWideChar(CP_ACP,0,buf,-1,wbuf,260)
  test eax, eax
  jz ft_spd_fb
  push SPD_TMPW
  call dword ptr [7AC234]       // drop a stale copy from a previous run
  push 0
  push 80
  push 2
  push 0
  push 0
  push 40000000
  push SPD_TMPW
  call dword ptr [7AC238]       // CreateFileW(..., GENERIC_WRITE, CREATE_ALWAYS)
  cmp eax, -1
  je ft_spd_fb
  mov ebx, eax
  push 0
  push SPD_WRITTEN
  mov eax, SPD_DLL_END
  sub eax, SPD_DLL
  push eax
  push SPD_DLL
  push ebx
  call dword ptr [7AC22C]        // WriteFile
  push ebx
  call dword ptr [7AC250]        // CloseHandle
  push SPD_TMPBUF
  call dword ptr [7AC0D0]      // LoadLibraryA(temp path)
  jmp ft_spd_done
ft_spd_fb:
  push DLLNAME
  call dword ptr [7AC0D0]      // fallback: sidecar next to the exe
ft_spd_done:
  mov [SPD_HMOD], eax
  popad
  mov eax, [SPD_HMOD]
  test eax, eax
  jz ft_no_dll
  push eax
  push NVNAME
  push eax
  call dword ptr [7AC204]          // GetProcAddress(h, "g_noVsync")
  mov [NOVSYNC_PTR], eax
  pop eax
ft_no_dll:
  // 0 = the row was just cleared for typing: leave K alone
  mov eax, [SPEED_FPS]
  cmp eax, 1
  jb ft_done
  // never touch the speed while the digits are still arriving
  cmp dword ptr [SPEED_TYPING], 0
  jne ft_done
  // deceleration is devmode-only; stepping included, so it lives here
  cmp dword ptr [CFG_DEVMODE], 0
  jne ft_div
  cmp eax, 3C
  jae ft_div
  mov eax, 3C
  mov [SPEED_FPS], eax
ft_div:
  // vsync only has to go when the target rate is above 60
  mov ecx, [NOVSYNC_PTR]
  test ecx, ecx
  jz ft_nv_skip
  push eax
  xor edx, edx
  cmp eax, 3C
  seta dl
  mov [ecx], edx
  pop eax
ft_nv_skip:
  push eax
  mov eax, 0EA60
  pop ecx
  xor edx, edx
  div ecx
  mov [game+B5000], eax
ft_done:
  pop edx
  pop ecx
  pop eax
  ret

// =================================================================== //
// Hitbox overlay (v0.11.0-alpha) -- read-only collision display.      //
// The DLL only reads game memory; nothing here writes collision data. //
// =================================================================== //
ovl_hb_stage:
  // Collision dispatcher entry, ECX = the live stage object. Recording it
  // here means the display never uses a cached pointer from a previous stage.
  pushfd
  push eax
  mov eax, ecx
  mov [HB_STAGE], eax
  mov dword ptr [HB_ACTIVE], 1
  pop eax
  popfd
  // re-execute the displaced prologue, then rejoin the dispatcher
  push ebp
  mov ebp, esp
  and esp, FFFFFFF8
  jmp game+C2D56

ovl_hb_draw:
  // Replaces `call game+1C4720`; the 14 composite arguments are on the stack.
  // After the overlay is written into the scene texture we tail-call the
  // original compositor, so its `ret` lands on the game's `add esp,0x38`.
  pushfd
  pushad
  cmp dword ptr [HB_ACTIVE], 0
  je ovl_hb_skip
  mov dword ptr [HB_ACTIVE], 0
  cmp dword ptr [CFG_DEVMODE], 0
  je ovl_hb_skip
  cmp dword ptr [HB_FN], 0
  jne ovl_hb_call
  cmp dword ptr [HB_TRIED], 0
  jne ovl_hb_skip
  mov dword ptr [HB_TRIED], 1
  // ---- embedded hitbox DLL: extract to the temp dir and load it --------
  // Activation is unchanged: only when the stage-capture hook has set
  // HB_ACTIVE and CFG_DEVMODE is on does this block run at all.
  pushad
  push HB_TMPBUF                  // stdcall: rightmost argument first
  push 104
  call dword ptr [7AC138]      // GetTempPathA(260, buf)
  test eax, eax
  jz ovl_hb_fb
  mov edi, HB_TMPBUF
  add edi, eax
  mov esi, HB_TMPNAME
ovl_hb_nc:
  mov al, [esi]
  test al, al
  jz ovl_hb_ne
  mov [edi], al
  inc esi
  inc edi
  jmp ovl_hb_nc
ovl_hb_ne:
  mov byte ptr [edi], 0
  push 104
  push HB_TMPW
  push -1
  push HB_TMPBUF
  push 0
  push 0
  call dword ptr [7AC144]        // MultiByteToWideChar(CP_ACP,0,buf,-1,wbuf,260)
  test eax, eax
  jz ovl_hb_fb
  push HB_TMPW
  call dword ptr [7AC234]       // drop a stale copy from a previous run
  push 0
  push 80
  push 2
  push 0
  push 0
  push 40000000
  push HB_TMPW
  call dword ptr [7AC238]       // CreateFileW(..., GENERIC_WRITE, CREATE_ALWAYS)
  cmp eax, -1
  je ovl_hb_fb
  mov ebx, eax
  push 0
  push HB_WRITTEN
  mov eax, HB_DLL_END
  sub eax, HB_DLL
  push eax
  push HB_DLL
  push ebx
  call dword ptr [7AC22C]        // WriteFile
  push ebx
  call dword ptr [7AC250]        // CloseHandle
  push HB_TMPBUF
  call dword ptr [7AC0D0]      // LoadLibraryA(temp path)
  jmp ovl_hb_ld
ovl_hb_fb:
  push HB_DLLNAME
  call dword ptr [7AC0D0]      // fallback: sidecar next to the exe
ovl_hb_ld:
  mov [HB_HMOD], eax
  popad
  mov eax, [HB_HMOD]
  test eax, eax
  jz ovl_hb_skip
  push HB_FNNAME
  push eax
  call dword ptr [7AC204]         // GetProcAddress(h, "hb_frame")
  mov [HB_FN], eax
  test eax, eax
  jz ovl_hb_skip
ovl_hb_call:
  // HBCTX field order must match work/Le02hitbox.cpp.
  mov eax, [HB_STAGE]
  mov dword ptr [HB_CTX+0], eax
  mov eax, [E84814]               // scene texture the compositor consumes
  mov dword ptr [HB_CTX+4], eax
  mov eax, [E8480C]
  mov dword ptr [HB_CTX+8], eax
  mov eax, [E84810]
  mov dword ptr [HB_CTX+C], eax
  mov dword ptr [HB_CTX+10], 42000000  // 32.0f playfield origin X (fixx=136 -> +1)
  mov dword ptr [HB_CTX+14], 41800000  // 16.0f playfield origin Y
  mov dword ptr [HB_CTX+18], 44200000  // 640.0f logical width
  mov dword ptr [HB_CTX+1C], 43F00000  // 480.0f logical height
  mov dword ptr [HB_CTX+20], 1
  push HB_CTX
  call dword ptr [HB_FN]
  add esp, 4
ovl_hb_skip:
  popad
  popfd
  jmp game+1C4720

HB_STAGE:
  dd 0
HB_ACTIVE:
  dd 0
HB_FN:
  dd 0
HB_TRIED:
  dd 0
HB_CTX:
  dd 0, 0, 0, 0, 0, 0, 0, 0, 0
HB_DLLNAME:
  db 4C 65 30 32 68 69 74 62 6F 78 2D 76 31 2E 64 6C 6C 00 // "Le02hitbox-v1.dll"
HB_FNNAME:
  db 68 62 5F 66 72 61 6D 65 00                            // "hb_frame"



