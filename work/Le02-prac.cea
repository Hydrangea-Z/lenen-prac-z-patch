HINT_P:
  dd 0
HINT_END:
  dd 0
HINT_CURSTAGE:
  dd 0
HINT_WANT:
  dd 0
HINT_N:
  dd 0
HINT_MAXN:
  dd 18
HINT_SKIP:
  dd 0
HINT_TOK:
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
HINT_E_MARK:
  dd 0
HINT_E_SIZE:
  dd 0
HINT_E_CHAR:
  dd 0
HINT_E_X:
  dd 0
HINT_E_Y:
  dd 0
HINT_E_SK:
  dd 0
HINT_E_SP:
  dd 0
HINT_E_SF:
  dd 0
HINT_E_EK:
  dd 0
HINT_E_EP:
  dd 0
HINT_E_EF:
  dd 0
// v0.7.13 -- the optional per-line colour, taken from three extra decimal
// columns on the same line (R,G,B).  0 means "not written, use Hint col".
// The scratch pair is what the three numbers land in before they are packed
// into HINT_E_COL, which hint_store copies into the entry's +0x2C slot.
HINT_E_COL:
  dd 0
HINT_TMP_N:
  dd 0
HINT_TMP_COL:
  dd 0
HINT_TKIND:
  dd 0
HINT_TPAT:
  dd 0
HINT_TFR:
  dd 0
HINT_CUR:
  dd 0
HINT_ROW:
  dd 0
// ---- capture state (v0.6.4) ----
HINT_C_X:
  dd 0
HINT_C_Y:
  dd 0
HINT_C_F:
  dd 0
HINT_CHAP_END:
  dd 0
// ---- boss pattern state (v0.7.2) ----
// HINT_PAT_IDX is the 0-BASED pattern ordinal the boss is on right now --
// the very same number the hint file's boss:P:F uses: 0 midnon, 1 midspell,
// 2 non1, 3 spell1, 4 non2, 5 spell2 ... for stage 1.  It is a straight
// copy of the game's own [boss+0x44] (no offset -- see the evidence chain
// in ovl_boss_poll) and is only meaningful while HINT_PAT_ON is 1.
// HINT_PAT_FRAME counts frames into the pattern (our own clock).
HINT_PAT_IDX:
  dd 0
// 1 only while a boss or mid-boss is on screen AND its pattern number is
// trustworthy.  Pattern 0 is a real pattern (the mid non-spell), so "no
// pattern" can never be spelled with a number -- it needs this flag (the
// Pattern row renders ON=0 as -1).
HINT_PAT_ON:
  dd 0
// Frames into the current pattern, counted by US (one per frame) rather
// than as a delta on [stage+0x4C], which freezes during intro dialogue.
HINT_PAT_FRAME:
  dd 0
// Was a boss on screen last frame?  A 0->1 edge means a new fight, whose
// object is built carrying the previous fight's last pattern number.
HINT_PAT_WAS:
  dd 0
// The last pattern actually accepted (FFFFFFFF = none yet), and the value
// to ignore until the new fight's own first pattern starts.
HINT_PAT_LAST:
  dd FFFFFFFF
HINT_PAT_SKIP:
  dd FFFFFFFF
// v0.7.11 -- the stage number of the last stage start.  initFrameTimer
// compares the new stage's number against it: a repeat means this is a
// RETRY of the same stage (so HINT_PAT_LAST must be cleared, or the
// retry's first pattern number can equal it and latch the new-fight
// suppression forever); a different number means a stage change, where
// HINT_PAT_LAST is exactly what suppresses the recycled value during the
// new boss's intro.  See the v0.1.10 note in Le01's CHANGELOG.
HINT_PAT_STAGE:
  dd 0
// The time specs the capture is about to write (see hint_emit_time).
HINT_C_KIND:
  dd 0
HINT_C_PID:
  dd 0
HINT_C_PF:
  dd 0
HINT_C_EKIND:
  dd 0
HINT_C_EPID:
  dd 0
HINT_C_EF:
  dd 0
HINT_IEDI:
  dd 0
HINT_CAPLEN:
  dd 0
HINT_CAPLEN2:
  dd 0
HINT_WROTE:
  dd 0
HINT_CAP_OK:
  dd 0
HINT_LINE:
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
HINT_LINE2:
  db 00 00 00 00 00 00 00 00
// Scratch for the tail-of-file newline check: holds the file's last byte,
// and is written back as CRLF when that byte is not already a newline.
HINT_LASTCH:
  db 00 00
OVL_PREV_CAP:
  dd 0
