// Diagnostic mirror of the live player object, refreshed once per frame
// by ovl_lockpower.  Read [DBG_PLAYER] to get the pointer; lives are at
// +0x48, bombs +0x60, power +0x7C.
DBG_PLAYER:
  dd 0

// ---- hint files (v0.6.0) ----
