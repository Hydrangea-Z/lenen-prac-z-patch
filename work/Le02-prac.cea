game+CF2BA:
game+CF445:
 call overlay_input
game+CF44A:
game+CF7CD:
 call overlay_input
game+CF7D2:
// ---- v0.4.0: the game-over decision (6 bytes) ----
// `cmp [player+0x48],0 / jg respawn` -- when the comparison would say
// "no lives left" and No Gameover is on, we hand the game a life of 1
// so the shared `dec` lands on 0 instead of the GAME OVER branch.
game+B980C:
 jmp nogameover_hook
 nop
game+B9812:
// ---- v0.4.0: freeze power (33 bytes); v0.4.2 locks onto the live value ----
// The whole vanilla `clamp power into [0,500]` block.  It already runs
