TXT_PCROSS_ON:
  db 50 00 6C 00 61 00 79 00 65 00 72 00 20 00 2B 00 3A 00 20 00 20 00 20 00 20 00 6F 00 6E 00 20 00 00 00
TXT_LOCKSEED_OFF:
  db 4C 00 6F 00 63 00 6B 00 20 00 53 00 65 00 65 00 64 00 3A 00 20 00 20 00 20 00 6F 00 66 00 66 00 00 00
