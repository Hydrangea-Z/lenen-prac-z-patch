// ---- marker shape and colour ----
HINT_SYM:
  dd 2B
HINT_COL:
  // HTML red, 0x00RRGGBB.  It used to be stored raw as FF, which box()
  // reads as 0x00BBGGRR = red; as HTML red is FF0000, and ovl_swaprb turns
  // that back into FF -- so the visible default colour is unchanged.
  dd 0FF0000
HINT_COL_DIM:
  dd 40
HINT_FADE_R:
  dd 28
// ---- v0.7.11: the colour rows (Le01 v0.1.9 design) -------------------
// HINT_COL is the Hint col row's storage AND the default marker colour.
// OVL_V_PCOL is the Player+ cross colour, OVL_V_PSIZE its arm in logical
// pixels.  All of them are HTML 0x00RRGGBB and are converted to what box()
// wants by ovl_swaprb at the single point where a colour is handed over.
OVL_V_PCOL:
  dd 0FF0000
OVL_V_PSIZE:
  dd 4
OVL_SWX:
  // logical x.  Clear of the value column even while the [t] label is one
  // character wider, which is what made it overlap the last hex digit.
  dd 0D8
OVL_TYPE_KIND:
  dd 0
OVL_TYPE_VAL:
  dd 0
OVL_TYPE_ORIG:
  dd 0
OVL_TYPE_HEXN:
  dd 0
// Preset colours for the two colour rows, in HTML order (0x00RRGGBB).
// Left/right on a colour row walks this list; Z types an exact value.
PP_PRESETS:
  dd 0FFFFFF
  dd 0FFFFA0
  dd 0FF0000
  dd 0FF8000
  dd 0FFFF00
  dd 000FF00
  dd 000FFFF
  dd 00000FF
  dd 08000FF
  dd 0FF00FF
  dd 0FF80C0
  dd 0808080
PP_PRESETS_N:
  dd C
// ---- marker correction (v0.7.13) -------------------------------------
// Fix X / Fix Y are now in 1/8 logical pixels with 0x80 (128) as neutral,
// exactly like Le01 v0.1.9.  The old HINT_DX / HINT_DY pair was one whole
// logical pixel per step with 0x40 neutral; those two cells are kept (they
// are still in the layout, so anything reading them keeps working) but
// nothing uses them any more.
//
// Why 1/8: the marker still lands on whole logical pixels -- box() takes
// integers -- but what the finer step buys is control over WHERE the
// truncation boundary falls.  The player's position is fractional, so that
// is the only way to line the cross up with a game dot drawn at a
// different rounding.
HINT_DX:
  dd 41
HINT_DY:
  dd 40
OVL_V_FIX_X:
  dd 87
OVL_V_FIX_Y:
  dd 81
// 8.0f, for the 1/8-unit scale (0x41000000).  SSE is available and the
// engine itself uses movss/mulss, so the float path costs nothing here.
HINT_F8:
  dd 41000000
HINT_DASH:
  dd 10
HINT_USECOL:
  dd 0
HINT_DASHLEN:
  dd 0
HINT_DASHEND:
  dd 0
