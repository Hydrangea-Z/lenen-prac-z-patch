// ---- embedded speed DLL (v0.13) -----------------------------------
// incbin pulls the stripped Le03speed.dll into the cave; the loader
// above copies it to the temp dir and loads it from there.
cave+11000:
SPD_DLL:
  incbin("../out/Le03speed.stripped.dll")
SPD_DLL_END:
SPD_TMPBUF:
  res 104                         // 260 ANSI bytes
SPD_TMPW:
  res 208                         // 260 wide chars
SPD_WRITTEN:
  dd 0
SPD_HMOD:
  dd 0
SPD_TMPNAME:
  db 7E 6C 65 30 33 73 70 64 2E 64 6C 6C 00


