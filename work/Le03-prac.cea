// BITMAPINFOHEADER for a top-down 32bpp BI_RGB DIB.  biWidth (offset 4) and
// biHeight (offset 8) are filled in at runtime by ovl_dib_ensure.
OVL_BMI:
  dd 28
  dd 0
  dd 0
  dw 1
  dw 20
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
// D3D11_BOX (left, top, front, right, bottom, back), filled per frame.
OVL_BOX:
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
OVERLAY_OPEN:
  dd 0
OVL_PREV_F12:
  dd 0
// Edge-detect state: +0 = UP, +1 = DOWN (left/right land here in v0.4.1).
OVL_PREV_KEYS:
  dd 0
  dd 0
// Hold-to-repeat: after OVL_HOLD_DELAY frames of a held LEFT/RIGHT, step by
// 1 every OVL_NUDGE_EVERY frames.  OVL_HOLD_DIR: 0 none, 1 right, 2 left.
OVL_HOLD_DIR:
  dd 0
OVL_HOLD_N:
  dd 0
OVL_HOLD_DELAY:
  dd 14
OVL_NUDGE_N:
  dd 0
OVL_NUDGE_EVERY:
  dd 2
OVL_VKBUF:
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00

// UTF-16LE strings (each terminated by a 16-bit NUL).
// These are plain labels, NOT printf formats: the overlay draws them with
// GDI TextOutW, so numeric values are composed by ovl_numtext and drawn
// separately, right-aligned.
// NOTE: every UTF-16 literal below MUST be 2-byte aligned or TextOutW fails
// outright.  cea has no `align` directive, so ovl_text fixes the alignment at
// runtime by copying the string into OVL_TXTCOPY first.
TXT_OVL_TITLE:
  db 46 00 31 00 32 00 20 00 4d 00 45 00 4e 00 55 00 00 00
TXT_OVL_LOCKPWR:
  db 4c 00 6f 00 63 00 6b 00 20 00 50 00 6f 00 77 00 65 00 72 00 3a 00 20 00 00 00
TXT_OVL_NOGAMEOVER:
  db 4e 00 6f 00 20 00 47 00 61 00 6d 00 65 00 6f 00 76 00 65 00 72 00 3a 00 20 00 00 00
TXT_OVL_HINT:
  db 48 00 69 00 6e 00 74 00 3a 00 20 00 00 00
TXT_OVL_PCROSS:
  db 50 00 6c 00 61 00 79 00 65 00 72 00 20 00 2b 00 3a 00 20 00 00 00
TXT_OVL_CAPTURE:
  db 43 00 61 00 70 00 74 00 75 00 72 00 65 00 3a 00 20 00 00 00
TXT_OVL_PATTERN:
  db 50 00 61 00 74 00 74 00 65 00 72 00 6e 00 3a 00 20 00 00 00
TXT_OVL_HIT:
  db 48 00 69 00 74 00 3a 00 20 00 00 00
TXT_OVL_LOCKSEED:
  db 4c 00 6f 00 63 00 6b 00 20 00 53 00 65 00 65 00 64 00 3a 00 20 00 00 00
TXT_OVL_SEED_EDIT:
  db 53 00 65 00 65 00 64 00 5b 00 74 00 79 00 70 00 65 00 5d 00 3a 00 20 00 00 00
TXT_OVL_SEED:
  db 53 00 65 00 65 00 64 00 3a 00 20 00 00 00
TXT_OVL_FIX_X:
  db 46 00 69 00 78 00 20 00 58 00 3a 00 20 00 00 00
TXT_OVL_FIX_Y:
  db 46 00 69 00 78 00 20 00 59 00 3a 00 20 00 00 00
TXT_OVL_FRAME:
  db 46 00 72 00 61 00 6d 00 65 00 3a 00 20 00 00 00
TXT_OFF:
  db 4f 00 46 00 46 00 00 00
TXT_ON:
  db 4f 00 4e 00 00 00
TXT_OVL_FACE:
  db 43 00 6f 00 6e 00 73 00 6f 00 6c 00 61 00 73 00 00 00
// For resolving GdiFlush at runtime (see ovl_flush).
TXT_GDI32:
  db 67 00 64 00 69 00 33 00 32 00 2e 00 64 00 6c 00 6c 00 00 00
TXT_GDIFLUSH:
  db 47 64 69 46 6c 75 73 68 00
cave_end:

