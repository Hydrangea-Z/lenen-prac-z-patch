// ---- hint colours and the near-player fade (Le02's HINT_COL block) -----
// The dword is (A<<24)|(B<<16)|(G<<8)|R because the backbuffer is R8G8B8A8.
HINT_COL:
  dd 0A0FFFF                    // RGB(255,255,160): normal marker colour
HINT_COL_DIM:
  dd 355555                     // RGB(85,85,53): dimmed while the player is on it
HINT_FADE_R:
  dd 28                         // dim within 40 playfield units (Manhattan)
HINT_USECOL:
  dd 0A0FFFF
HINT_OK:
  dd 0
// Scratch copy used by ovl_text when a string literal is not 2-byte aligned
// (TextOutW rejects a misaligned UTF-16 pointer).  ovl_text rounds its base up
