ovl_hitboxes:
  pushfd
  pushad
  inc dword ptr [OVL_HB_CALL]    // diagnostic: every call
  cmp dword ptr [CFG_DEVMODE], 0
  je ovl_hb_done
  inc dword ptr [OVL_HB_DEV]     // diagnostic: devmode gate passed
  // Self-test red square removed: the render path is already validated.
ovl_hb_nosq:
  // ---- stage gate (same liveness test as ovl_pause_action) --------------
  mov esi, [OVL_STAGE]
  test esi, esi
  jz ovl_hb_done
  mov ecx, [esi+30]              // stage number 1..8
  mov [OVL_HB_STNUM], ecx
  cmp ecx, 1
  jb ovl_hb_done
  cmp ecx, 8
  ja ovl_hb_done
  mov [OVL_HB_STAGE], esi
  inc dword ptr [OVL_HB_FRAMES]
  // ---- lazy-load versioned Le03hitbox-v11.dll (once) --------------------
  cmp dword ptr [HB_FN], 0
  jne ovl_hb_fill
  cmp dword ptr [HB_TRIED], 0
  jne ovl_hb_done
  mov dword ptr [HB_TRIED], 1
  // ---- embedded hitbox DLL: extract to the temp dir and load it --------
  // Activation is unchanged: only when the stage-capture hook has set
  // HB_ACTIVE and CFG_DEVMODE is on does this block run at all.
  pushad
  push HB_TMPBUF                  // stdcall: rightmost argument first
  push 104
  call dword ptr [7D9138]      // GetTempPathA(260, buf)
  test eax, eax
  jz ovl_hb_fb
  mov edi, HB_TMPBUF
  add edi, eax
  mov esi, HB_TMPNAME
ovl_hb_nc:
  mov al, [esi]
  test al, al
  jz ovl_hb_ne
  mov [edi], al
  inc esi
  inc edi
  jmp ovl_hb_nc
ovl_hb_ne:
  mov byte ptr [edi], 0
  push 104
  push HB_TMPW
  push -1
  push HB_TMPBUF
  push 0
  push 0
  call dword ptr [7D9168]        // MultiByteToWideChar(CP_ACP,0,buf,-1,wbuf,260)
  test eax, eax
  jz ovl_hb_fb
  push HB_TMPW
  call dword ptr [7D9230]       // drop a stale copy from a previous run
  push 0
  push 80
  push 2
  push 0
  push 0
  push 40000000
  push HB_TMPW
  call dword ptr [7D9234]       // CreateFileW(..., GENERIC_WRITE, CREATE_ALWAYS)
  cmp eax, -1
  je ovl_hb_fb
  mov ebx, eax
  push 0
  push HB_WRITTEN
  mov eax, HB_DLL_END
  sub eax, HB_DLL
  push eax
  push HB_DLL
  push ebx
  call dword ptr [7D9228]        // WriteFile
  push ebx
  call dword ptr [7D924C]        // CloseHandle
  push HB_TMPBUF
  call dword ptr [7D90D0]      // LoadLibraryA(temp path)
  jmp ovl_hb_ld
ovl_hb_fb:
  push HBDLLNAME
  call dword ptr [7D90D0]      // fallback: sidecar next to the exe
ovl_hb_ld:
  mov [HB_HMOD], eax
  popad
  mov eax, [HB_HMOD]
  test eax, eax
  jz ovl_hb_done
  push HBFNNAME
  push eax
  call dword ptr [7D9200]        // GetProcAddress(h, "hb_frame")
  mov [HB_FN], eax
  test eax, eax
  jz ovl_hb_done
ovl_hb_fill:
  // ---- fill the HBCTX the DLL reads -------------------------------------
  // (the cave struct lives at HBCTX; the DLL interprets it as its own
  //  HBCTX -- keep the field order in sync with work/Le03hitbox.cpp)
  mov eax, [OVL_STAGE]
  mov dword ptr [HBCTX+0], eax
  mov eax, game+1B9B90           // UpdateSubresource, absolute VA
  mov dword ptr [HBCTX+4], eax
  mov eax, OVL_BOX
  mov dword ptr [HBCTX+8], eax
  mov eax, OVL_HBBUF
  mov dword ptr [HBCTX+0C], eax
  mov eax, [OVL_SXP]
  mov dword ptr [HBCTX+10], eax
  mov eax, [OVL_SYP]
  mov dword ptr [HBCTX+14], eax
  mov eax, [HINT_DX]
  mov dword ptr [HBCTX+18], eax
  mov eax, [HINT_DY]
  mov dword ptr [HBCTX+1C], eax
  mov eax, [HINT_OXQ]
  mov dword ptr [HBCTX+20], eax
  mov eax, [HINT_OYQ]
  mov dword ptr [HBCTX+24], eax
  mov eax, [OVL_CLW]
  mov dword ptr [HBCTX+28], eax
  mov eax, [OVL_CLH]
  mov dword ptr [HBCTX+2C], eax
  mov eax, [OVL_BACKBUF]
  mov dword ptr [HBCTX+30], eax
  mov dword ptr [HBCTX+34], 1F4 // legacy ABI value: renderer ignores cap
  push HBCTX
  call dword ptr [HB_FN]         // the DLL does the walk + the drawing
  add esp, 4
  mov [OVL_HB_LAST], eax         // drawn count (diagnostic)
ovl_hb_done:
  popad
  popfd
  ret

// ---- hitbox DLL plumbing -------------------------------------------------
HB_FN:                            // hb_frame() pointer, filled on first stage
  dd 0
HB_TRIED:                         // only try to load once
  dd 0
HBDLLNAME:
  db 4C 65 30 33 68 69 74 62 6F 78 2D 76 31 31 2E 64 6C 6C 00 // "Le03hitbox-v11.dll"
HBFNNAME:
  db 68 62 5F 66 72 61 6D 65 00                        // "hb_frame"
// HBCTX: the frame context handed to the DLL (field order == Le03hitbox.cpp)
HBCTX:
  dd 0                            // +00 barrage (OVL_STAGE)
  dd 0                            // +04 UpdateSubresource
  dd 0                            // +08 OVL_BOX
  dd 0                            // +0C OVL_HBBUF (3x3 cyan dot)
  dd 0                            // +10 SXP
  dd 0                            // +14 SYP
  dd 0                            // +18 HINT_DX
  dd 0                            // +1C HINT_DY
  dd 0                            // +20 HINT_OXQ
  dd 0                            // +24 HINT_OYQ
  dd 0                            // +28 CLW
  dd 0                            // +2C CLH
  dd 0                            // +30 backbuf
  dd 0                            // +34 cap
OVL_HB_CALL:
  dd 0
OVL_HB_DEV:
  dd 0
OVL_HB_FRAMES:
  dd 0
OVL_HB_LAST:
  dd 0
OVL_HB_STAGE:
  dd 0
OVL_HB_STNUM:
  dd 0
// 3x3 dot, COLORREF cyan (0x00BBGGRR -> R=0,G=FF,B=FF), 9 dwords.
OVL_HBBUF:
  dd 0FFFF00
  dd 0FFFF00
  dd 0FFFF00
  dd 0FFFF00
  dd 0FFFF00
  dd 0FFFF00
  dd 0FFFF00
  dd 0FFFF00
  dd 0FFFF00
// Self-test square: 8x8 solid RED, COLORREF 0x000000FF.
OVL_HBST:
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
  dd 000000FF
