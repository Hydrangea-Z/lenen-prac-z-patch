cave:
// ===================================================================
// v0.2.6: F12 OVERLAY PANEL  (native-GDI edition)
// -------------------------------------------------------------------
// A SEPARATE menu from the v0.2.5 practice menu.  SEL_DATA (the 12-row
// practice table) is NEVER touched -- the game's own menu walks it, and
// appending rows there is what produced the "ghost rows" at the bottom
// of the practice list.
//
// Painting strategy: the game renders scenes into software DIBs and
// blits them to the window with StretchDIBits inside the present
// function 0x578DD0.  Drawing with the game's own box()/text primitives
// is unreliable (they write into scene buffers that are already
// flushed).  So: hook the single present call at 0x50B52F (this runs
// once per frame in EVERY scene), let the game present normally, then
// grab a window DC with GetDC([0xA91AF4]) -- [0xA91AF4] is the cached
// game HWND -- and paint the panel with native GDI.  Fully
// scene-independent.
// ===================================================================
ovl_present_hook:
  pushfd
  pushad
  call game+178DD0          // the original present/compositor
  call ovl_frame            // input edge-detect + (if open) paint
  popad
  popfd
  jmp game+10B534           // continue with the displaced `mov [0xa1ec20],0`

// ---- ovl_frame: per-frame tick, INPUT ONLY ------------------------------
// v0.3.0 painted the DESKTOP dc from here, after the game had already
// presented.  That surface is not the game frame, so the menu was only ever
// visible in screenshots (and for an instant on exit) -- never during play.
// Painting has moved to ovl_d3d11_present, which composites into the game's
// own backbuffer before Present.  This hook is kept because 0x50B390 runs
// once per frame in EVERY scene, which is what the F12 edge-detect needs.
ovl_frame:
  pushfd
  pushad
  call ovl_input
  call ovl_mirror
  // NOTE: ovl_measure is deliberately NOT called here.  Adding it (or calling
  // it from ovl_marker) shifts the layout and the panel text disappears again
  // -- the same unresolved sensitivity.  ovl_panel_draw calls it, so the scale
  // is correct from the first time the menu is opened, and it persists after
  // the menu is closed.
ovl_frame_done:
  popad
  popfd
  ret

// ---- ovl_d3d11_present: composite the panel, then present ---------------
// Entered from the 5-byte `jmp` that replaced `call 0x5BACD0` at 0x5F3EBC.
// Stack at entry: [esp+0]=swapChain, [esp+4]=SyncInterval, [esp+8]=Flags.
// The displaced call is re-issued here, so the caller's own `add esp,0x0C`
// at 0x5F3EC1 still cleans exactly the three arguments it pushed.
ovl_d3d11_present:
  pushfd
  pushad
  call ovl_d3d11_composite
  popad
  popfd
  call game+1BACD0              // the displaced DXGI Present wrapper
  jmp game+1F3EC1               // resume at the caller's `add esp,0x0C`

// ---- ovl_d3d11_composite: draw the panel into the game backbuffer -------
// Uses the game's own helper wrappers so no vtable slot is guessed:
//   0x5B9A00  OMSetRenderTargets(NumViews, ppRTVs, pDSV)   (cdecl)
//   0x5B9B90  UpdateSubresource(res, sub, box, src, rowPitch, depthPitch)
ovl_d3d11_composite:
  pushfd
  pushad
  cmp dword ptr [0DA4600], 0    // ID3D11Device* -- null on the D3D9 path
  je ovl_d3d_done
  // record = 0xEAB80C + [0xEB380C]*0x80 ; +0x48 = backbuffer texture
  mov eax, [0EB380C]
  imul eax, eax, 80
  add eax, EAB80C
  mov edi, eax
  mov eax, [edi+48]
  test eax, eax
  jz ovl_d3d_done
  mov [OVL_BACKBUF], eax
  // Hint markers are meant to be visible while PLAYING, so they are drawn
  // before the menu-open test -- same as Le02, where overlay_draw calls
  // draw_hints before it checks OVERLAY_OPEN.
  // Measure the client scale ONCE here, before either the calibration cross
  // or the hints read it.  ovl_measure used to run only inside ovl_panel_draw,
  // so with the menu closed the cross was scaled with a stale value while the
  // hints (drawn later) picked up a different one.
  call ovl_measure
  // v0.5.19 -- LEAVE THE GAME ALONE while it is playing back a replay or an
  // attract demo.  The markers are drawn by writing the game's own back-buffer
  // texture (game+1B9B90), and that is the ONLY thing this patch does to the
  // game's resources while a replay runs -- see `desync分析.md`.  A replay is
  // FRAME-INDEXED (every 0x44-byte record carries the game frame number it
  // belongs to, and the game looks the record up by that number), so any extra
  // per-frame work on that path can shift the frame sequence and desync it.
  // `preparePracticeState` already reads these two flags, so their meaning is
  // established: B0A552 = a replay is being played back, B0A554 = attract demo.
  cmp byte ptr [game+B0A552], 0
  jne ovl_comp_skip_draw
  cmp byte ptr [game+B0A554], 0
  jne ovl_comp_skip_draw
  call ovl_marker
  call hint_draw
  // Bullet hitboxes (devmode only) -- same frame path as the marker, so the
  // dots are composited into the game backbuffer and visible while PLAYING.
  call ovl_hitboxes
ovl_comp_skip_draw:
  cmp dword ptr [OVERLAY_OPEN], 0
  je ovl_d3d_done
  // render the panel into the offscreen DIB; this also sets OVL_PX/PY/PW/PH
  call ovl_panel_draw
  cmp dword ptr [OVL_BITS], 0
  je ovl_d3d_done
  // NOTE: do NOT unbind the render target here.  v0.3.1 called
  // OMSetRenderTargets(0,NULL,NULL) before the update, which left the game's
  // composition output discarded: the panel showed, but the whole game frame
  // went black.  D3D11 permits a copy into a resource that is still bound as
  // an output (the app owns the hazard), so the binding is left untouched and
  // the engine's state stays exactly as it was.
  // D3D11_BOX: left, top, front, right, bottom, back
  mov eax, [OVL_PX]
  mov dword ptr [OVL_BOX], eax
  mov eax, [OVL_PY]
  mov dword ptr [OVL_BOX+4], eax
  mov dword ptr [OVL_BOX+8], 0
  mov eax, [OVL_PX]
  add eax, [OVL_PW]
  mov dword ptr [OVL_BOX+0C], eax
  mov eax, [OVL_PY]
  add eax, [OVL_PH]
  mov dword ptr [OVL_BOX+10], eax
  mov dword ptr [OVL_BOX+14], 1
  // UpdateSubresource(backbuffer, 0, &box, bits, w*4, 0)
  push 0
  mov eax, [OVL_PW]
  imul eax, eax, 4
  push eax                      // SrcRowPitch
  push dword ptr [OVL_BITS]     // pSrcData
  push OVL_BOX                  // pDstBox
  push 0                        // DstSubresource
  mov eax, [edi+48]
  push eax                      // pDstResource
  call game+1B9B90              // UpdateSubresource
  add esp, 18
ovl_d3d_done:
  popad
  popfd
  ret

// ---- ovl_input: F12 toggles the panel, then the menu cursor keys -------
// Key state comes from GetKeyboardState (256-byte table).  Every key is
// edge-detected against OVL_PREV_KEYS so a held key does not auto-repeat.
// The edge state is tracked even while the panel is closed, otherwise the
// first press after opening would be swallowed as a "new" edge.
ovl_input:
  pushfd
  pushad
  push OVL_VKBUF
  call dword ptr [7D92E4]   // GetKeyboardState
  // Resolve the live row table before anything reads OVL_ACTIVE_*.
  call ovl_set_active
  // ---- v0.6.0: pause-menu quick keys (R = restart, Q = title) ----------
  // These do NOT drive the menu and do NOT inject keystrokes: they write the
  // same scene phase the menu's 从头再来 / 返回标题 items write once confirmed
  // (see plan-pause-hotkeys.md section 10).  Inert unless the game's own pause
  // menu is open, so R/Q are harmless during normal play.
  mov al, byte ptr [OVL_VKBUF+52]      // R
  and al, 80
  mov cl, byte ptr [OVL_PREV_RQ+0]
  mov byte ptr [OVL_PREV_RQ+0], al
  cmp al, cl
  je ovl_pk_r_done
  test al, al
  jz ovl_pk_r_done
  mov edx, 6                           // 6 = restart the current stage
  call ovl_pause_action
ovl_pk_r_done:
  mov al, byte ptr [OVL_VKBUF+51]      // Q
  and al, 80
  mov cl, byte ptr [OVL_PREV_RQ+1]
  mov byte ptr [OVL_PREV_RQ+1], al
  cmp al, cl
  je ovl_pk_q_done
  test al, al
  jz ovl_pk_q_done
  mov edx, 9                           // 9 = back to the title screen
  call ovl_pause_action
ovl_pk_q_done:
  // ---- F12 (VK 7B) toggles the panel ----
  movzx eax, byte ptr [OVL_VKBUF+7B]
  and al, 80
  shr al, 7
  movzx eax, al
  cmp eax, [OVL_PREV_F12]
  je ovl_f12_done
  mov [OVL_PREV_F12], eax
  test eax, eax
  jz ovl_f12_done
  xor dword ptr [OVERLAY_OPEN], 1
ovl_f12_done:
  // ---- panel closed: forget the edges and drop out of the hint panel and
  //      any typing mode with it, so reopening always starts clean ----
  cmp dword ptr [OVERLAY_OPEN], 0
  jne ovl_in_live
  mov dword ptr [OVL_PREV_KEYS], 0
  mov dword ptr [OVL_PREV_KEYS+4], 0
  mov dword ptr [OVL_HOLD_DIR], 0
  mov dword ptr [OVL_SUB], 0
  cmp dword ptr [OVL_TYPE_ON], 0
  je ovl_z_done
  call ovl_type_exit
  jmp ovl_z_done
ovl_in_live:
  // ---- UP (VK 26) moves the cursor up, wrapping ----
  mov al, byte ptr [OVL_VKBUF+26]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+0]
  mov byte ptr [OVL_PREV_KEYS+0], al
  cmp dword ptr [OVERLAY_OPEN], 0
  je ovl_up_done
  cmp al, cl
  je ovl_up_done
  test al, al
  jz ovl_up_done
  call ovl_move_up
ovl_up_done:
  // ---- DOWN (VK 28) moves the cursor down, wrapping ----
  mov al, byte ptr [OVL_VKBUF+28]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+1]
  mov byte ptr [OVL_PREV_KEYS+1], al
  cmp dword ptr [OVERLAY_OPEN], 0
  je ovl_down_done
  cmp al, cl
  je ovl_down_done
  test al, al
  jz ovl_down_done
  call ovl_move_down
ovl_down_done:
  // ---- LEFT (VK 25) steps the value down ----
  mov al, byte ptr [OVL_VKBUF+25]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+2]
  mov byte ptr [OVL_PREV_KEYS+2], al
  cmp dword ptr [OVERLAY_OPEN], 0
  je ovl_left_done
  cmp al, cl
  je ovl_left_done
  test al, al
  jz ovl_left_done
  call ovl_move_left
ovl_left_done:
  // ---- RIGHT (VK 27) steps the value up ----
  mov al, byte ptr [OVL_VKBUF+27]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+3]
  mov byte ptr [OVL_PREV_KEYS+3], al
  cmp dword ptr [OVERLAY_OPEN], 0
  je ovl_right_done
  cmp al, cl
  je ovl_right_done
  test al, al
  jz ovl_right_done
  call ovl_move_right
ovl_right_done:
  // ---- held LEFT/RIGHT: after OVL_HOLD_DELAY frames, fine-step by 1 ----
  // A single tap moves by the row's `step`; holding moves by 1 so a wide
  // range can be landed on an exact value.
  mov dl, byte ptr [OVL_VKBUF+27]
  and dl, 80
  jz ovl_hold_not_right
  mov ecx, 1
  jmp ovl_hold_check
ovl_hold_not_right:
  mov dl, byte ptr [OVL_VKBUF+25]
  and dl, 80
  jz ovl_hold_none
  mov ecx, 2
ovl_hold_check:
  cmp dword ptr [OVERLAY_OPEN], 0
  je ovl_hold_none
  cmp ecx, [OVL_HOLD_DIR]
  jne ovl_hold_new
  inc dword ptr [OVL_HOLD_N]
  mov eax, [OVL_HOLD_N]
  cmp eax, [OVL_HOLD_DELAY]
  jl ovl_hold_done
  inc dword ptr [OVL_NUDGE_N]
  mov eax, [OVL_NUDGE_N]
  cmp eax, [OVL_NUDGE_EVERY]
  jl ovl_hold_done
  mov dword ptr [OVL_NUDGE_N], 0
  cmp ecx, 1
  jne ovl_hold_left
  call ovl_nudge_right
  jmp ovl_hold_done
ovl_hold_left:
  call ovl_nudge_left
  jmp ovl_hold_done
ovl_hold_new:
  mov [OVL_HOLD_DIR], ecx
  mov dword ptr [OVL_HOLD_N], 0
  mov dword ptr [OVL_NUDGE_N], 0
  jmp ovl_hold_done
ovl_hold_none:
  mov dword ptr [OVL_HOLD_DIR], 0
ovl_hold_done:
  // ---- Z / ESC / BACK / digits: row action + seed entry ----------------
  cmp dword ptr [OVERLAY_OPEN], 0
  je ovl_z_done
  call ovl_type_keys
ovl_z_done:
ovl_input_done:
  popad
  popfd
  ret

// ---- ovl_pause_action: edx = scene phase to switch to ------------------
// Called from ovl_input when R or Q is pressed while the pause menu is open.
//   6 = restart the current stage   (what 从头再来 does)
//   9 = return to the title screen  (what 返回标题 does)
// The game's own pause menu does exactly this (mov [obj+284C],0 ;
// mov [obj+124],6|9 ; ret -- Le03 v1.21a 0x4F2F7A..0x4F2FB6), so we reuse its
// logic instead of driving the menu.  Two guards:
//   * the game's own pause flag must be 1 -- R/Q stay inert during normal play
//   * the stage object must still look alive (stage number 1..8), the same
//     liveness test ovl_mirror uses, so a stale OVL_STAGE cannot be written to
ovl_pause_action:
  pushfd
  pushad
  cmp byte ptr [0F0A520], 1
  jne ovl_pa_done
  mov eax, [OVL_STAGE]
  test eax, eax
  jz ovl_pa_done
  mov ecx, [eax+30]
  cmp ecx, 1
  jb ovl_pa_done
  cmp ecx, 8
  ja ovl_pa_done
  mov dword ptr [eax+284C], 0
  mov [eax+124], edx
ovl_pa_done:
  popad
  popfd
  ret

// Cursor movement skips rows that are developer-only while devmode is off.
// The search must wrap and must give up after one full turn, otherwise a table
// whose rows are ALL hidden would spin forever.
ovl_move_up:
  push ebx
  push edx
  push esi
  push edi
  mov ecx, [OVL_ACTIVE_CUR]
  mov edx, [OVL_ACTIVE_FLAG]
  mov ebx, [OVL_ACTIVE_N]
  mov edi, ebx
  mov eax, [ecx]
ovl_move_up_loop:
  dec eax
  jns ovl_move_up_pos
  lea eax, [ebx-1]
ovl_move_up_pos:
  movzx esi, byte ptr [edx+eax]
  test esi, 1
  jz ovl_move_up_ok
  cmp dword ptr [CFG_DEVMODE], 0
  jne ovl_move_up_ok
  dec edi
  jz ovl_move_up_ok
  jmp ovl_move_up_loop
ovl_move_up_ok:
  mov [ecx], eax
  pop edi
  pop esi
  pop edx
  pop ebx
  ret

ovl_move_down:
  push ebx
  push edx
  push esi
  push edi
  mov ecx, [OVL_ACTIVE_CUR]
  mov edx, [OVL_ACTIVE_FLAG]
  mov ebx, [OVL_ACTIVE_N]
  mov edi, ebx
  mov eax, [ecx]
ovl_move_down_loop:
  inc eax
  cmp eax, ebx
  jl ovl_move_down_pos
  xor eax, eax
ovl_move_down_pos:
  movzx esi, byte ptr [edx+eax]
  test esi, 1
  jz ovl_move_down_ok
  cmp dword ptr [CFG_DEVMODE], 0
  jne ovl_move_down_ok
  dec edi
  jz ovl_move_down_ok
  jmp ovl_move_down_loop
ovl_move_down_ok:
  mov [ecx], eax
  pop edi
  pop esi
  pop edx
  pop ebx
  ret

// ---- ovl_set_active: point OVL_ACTIVE_* at the live table --------------
// Called once per frame from ovl_input and again from ovl_panel_draw, so the
// renderer and the input handler always agree even if OVL_SUB flips between
// them.  Every row operation resolves through these, which is what let the
// menu split in two without touching ovl_apply / ovl_toggle / the typing code.
ovl_set_active:
  push esi
  mov eax, OVL_ROWS
  mov ecx, [OVL_ROWS_N]
  mov edx, OVL_SELROW
  mov ebx, OVL_ALT
  mov edi, OVL_SWATCH
  mov esi, OVL_ROWFLAG
  cmp dword ptr [OVL_SUB], 0
  je ovl_sa_done
  mov eax, OVL_ROWS2
  mov ecx, [OVL_ROWS2_N]
  mov edx, OVL_SELROW2
  mov ebx, OVL_ALT2
  mov edi, OVL_SWATCH2
  mov esi, OVL_ROWFLAG2
ovl_sa_done:
  mov [OVL_ACTIVE_TBL], eax
  mov [OVL_ACTIVE_N], ecx
  mov [OVL_ACTIVE_CUR], edx
  mov [OVL_ACTIVE_ALT], ebx
  mov [OVL_ACTIVE_SW], edi
  mov [OVL_ACTIVE_FLAG], esi
  pop esi
  ret

// Z on the MAIN table's Hint row: open the hint settings panel.  The cursor
// in it starts on Hint every time, so the panel always opens the same way.
ovl_sub_open:
  mov dword ptr [OVL_SUB], 1
  mov dword ptr [OVL_SELROW2], 0
  call ovl_set_active
ovl_sub_open_done:
  ret

// ---- ovl_row: esi = &ACTIVE_TBL[ACTIVE_CUR] ---------------------------
// Each row is six dwords: text, value pointer, min, max, step, wrap.
ovl_row:
  mov ecx, [OVL_ACTIVE_CUR]
  mov eax, [ecx]
  imul eax, eax, 18
  add eax, [OVL_ACTIVE_TBL]
  mov esi, eax
  ret

// eax = 1 when the selected row is one of the two COLOUR rows.  Decided from
// the row's VALUE POINTER, never from a row index -- see the note on
// ovl_type_toggle for why hard-coded indices are banned here.  Clobbers ecx;
// the callers do not need it back.
ovl_row_is_colour:
  mov ecx, [esi+4]
  mov eax, HINT_COL
  cmp ecx, eax
  je ovl_ric_yes
  mov eax, OVL_V_PCOL
  cmp ecx, eax
  je ovl_ric_yes
  xor eax, eax
  ret
ovl_ric_yes:
  mov eax, 1
  ret

// ---- HTML <-> COLORREF ------------------------------------------------
// 0x00RRGGBB <-> 0x00BBGGRR.  A plain R/B swap, so one routine does both
// directions.  Every colour we HOLD is in HTML order -- that is what the
// menu shows, what the presets list and what prac.cfg stores -- and the swap
// happens at the single point where a colour is handed to a consumer that
// wants COLORREF: the hint/marker colour buffers (and, in Le01/Le02, box()).
// The panel's own direct DIB writes take HTML directly, because ovl_rect_bits
// already performs the same swap internally.
ovl_swaprb:
  push eax
  push edx
  mov eax, ecx
  and eax, 0FF
  shl eax, 10
  mov edx, ecx
  and edx, 0FF00
  or eax, edx
  mov edx, ecx
  shr edx, 10
  and edx, 0FF
  or eax, edx
  mov ecx, eax
  pop edx
  pop eax
  ret

// edx = +1 / -1.  Left/right (and the held-key repeat) on a colour row walk
// PP_PRESETS instead of adding to the number, so the presets are one press
// apart.  A hand-typed colour that is not in the list enters the list at its
// near end rather than being rejected.
ovl_colour_step:
  call ovl_row
  mov eax, [esi+4]
  mov ecx, [eax]
  mov edi, PP_PRESETS
  mov ebx, [PP_PRESETS_N]
ovl_cs_scan:
  test ebx, ebx
  jz ovl_cs_miss
  cmp [edi], ecx
  je ovl_cs_found
  add edi, 4
  dec ebx
  jmp ovl_cs_scan
ovl_cs_found:
  sub edi, PP_PRESETS
  shr edi, 2
  add edi, edx
  mov ebx, [PP_PRESETS_N]
  cmp edi, ebx
  jl ovl_cs_lo
  xor edi, edi
  jmp ovl_cs_store
ovl_cs_lo:
  test edi, edi
  jns ovl_cs_store
  mov edi, ebx
  dec edi
ovl_cs_store:
  mov ecx, [PP_PRESETS+edi*4]
  mov [eax], ecx
  ret
ovl_cs_miss:
  mov ecx, [PP_PRESETS]
  test edx, edx
  jns ovl_cs_miss2
  mov ebx, [PP_PRESETS_N]
  dec ebx
  mov ecx, [PP_PRESETS+ebx*4]
ovl_cs_miss2:
  mov [eax], ecx
ovl_cs_done:
  ret


// ---- ovl_apply: esi = row, edx = signed delta -------------------------
// The range checks are UNSIGNED.  A row whose max is FFFFFFFF would read as
// -1 under a signed compare, and every other row has max <= 65535 where the
// two agree, so unsigned is a strict widening.
// The sign of the delta is taken FIRST.  Le02 compared unsigned after a
// single `add`, so a negative delta became 0xFFFFFFFF and read as "above
// max" -- which made LEFT at the bottom of a range wrap to the MINIMUM (a
// no-op) instead of the maximum.  Splitting the two directions fixes that
// and keeps the unsigned compare for the non-negative case.
ovl_apply:
  mov eax, [esi+4]
  mov ecx, [eax]
  test edx, edx
  js ovl_apply_dec
  // ---- increasing ----
  add ecx, edx
  cmp ecx, [esi+0C]
  jbe ovl_apply_store
  cmp dword ptr [esi+14], 0
  je ovl_apply_hi_clamp
  mov ecx, [esi+8]
  jmp ovl_apply_store
ovl_apply_hi_clamp:
  mov ecx, [esi+0C]
  jmp ovl_apply_store
  // ---- decreasing: use |delta| so nudge(-1) stays a 1-step ----
ovl_apply_dec:
  neg edx
  sub ecx, edx
  // SIGNED compare here: after a decrement past the bottom, ecx has wrapped
  // to 0xFFFFFFFF and an unsigned compare would read it as "still >= min".
  // min is always a small non-negative number, so signed is correct.
  cmp ecx, [esi+8]
  jge ovl_apply_store
  cmp dword ptr [esi+14], 0
  je ovl_apply_lo_clamp
  mov ecx, [esi+0C]
  jmp ovl_apply_store
ovl_apply_lo_clamp:
  mov ecx, [esi+8]
ovl_apply_store:
  mov [eax], ecx
  ret

ovl_move_right:
  call ovl_row
  // A colour row walks the preset list rather than adding `step`, so one
  // press lands on the next preset instead of +1 in the low byte.
  call ovl_row_is_colour
  test eax, eax
  jz ovl_mr_num
  mov edx, 1
  jmp ovl_colour_step
ovl_mr_num:
  mov edx, [esi+10]
  jmp ovl_apply

ovl_move_left:
  call ovl_row
  call ovl_row_is_colour
  test eax, eax
  jz ovl_ml_num
  mov edx, ffffffff
  jmp ovl_colour_step
ovl_ml_num:
  mov edx, [esi+10]
  neg edx
  jmp ovl_apply

ovl_nudge_right:
  call ovl_row
  mov edx, 1
  jmp ovl_apply

ovl_nudge_left:
  call ovl_row
  mov edx, ffffffff
  jmp ovl_apply

// ===================================================================== //
// Hint system -- file loading (ported from Le02 v0.7.6)                 //
//   <exe dir>\hint\*.txt, UTF-16 text                                   //
//   "stage N" switches stage (a bare number does the same), '#' is a    //
//   comment, and a marker line is                               //
//       <mark> <size> <char> <x> <y> <sk> <sp> <sf> <ek> <ep> <ef>      //
//   where -1 in a window field means "no bound".                        //
// ===================================================================== //

// ---- hint_atoi: decimal from HINT_TOK, leading '-' allowed ------------
hint_atoi:
  push esi
  push ecx
  mov esi, HINT_TOK
  xor eax, eax
  xor ecx, ecx
  cmp byte ptr [esi], 2D
  jne hint_atoi_l
  mov ecx, 1
  inc esi
hint_atoi_l:
  movzx edx, byte ptr [esi]
  cmp edx, 30
  jb hint_atoi_d
  cmp edx, 39
  ja hint_atoi_d
  imul eax, eax, 0A
  sub edx, 30
  add eax, edx
  inc esi
  jmp hint_atoi_l
hint_atoi_d:
  test ecx, ecx
  jz hint_atoi_r
  neg eax
hint_atoi_r:
  pop ecx
  pop esi
  ret

// ---- hint_tok_line: like hint_tok, but STOPS AT THE NEWLINE -------------
// The optional colour column has to be read from the SAME line as the marker,
// and hint_tok deliberately treats 0x0A as whitespace (it skips control
// characters), so it would happily walk into the next marker line and steal
// its first token as a colour.  This variant refuses to cross a line break.
// eax = token length (0 = no more tokens on this line); HINT_P advances.
hint_tok_line:
  mov esi, [HINT_P]
  mov edi, [HINT_END]
htl_skip:
  cmp esi, edi
  jae htl_empty
  movzx eax, byte ptr [esi]
  cmp eax, 20
  je htl_adv
  cmp eax, 09
  je htl_adv
  cmp eax, 0D
  je htl_adv
  cmp eax, 0A
  je htl_empty                  // end of line: no more colour tokens
  cmp eax, 2C
  je htl_adv
  cmp eax, 23
  je htl_empty                  // a comment ends the colour column
  jmp htl_tok
htl_adv:
  inc esi
  jmp htl_skip
htl_tok:
  mov edx, HINT_TOK
  xor ecx, ecx
htl_loop:
  cmp esi, edi
  jae htl_done
  movzx eax, byte ptr [esi]
  cmp eax, 20
  je htl_done
  cmp eax, 09
  je htl_done
  cmp eax, 0D
  je htl_done
  cmp eax, 0A
  je htl_done
  cmp eax, 2C
  je htl_done
  cmp eax, 23
  je htl_done
  cmp ecx, 18
  jae htl_adv2
  mov [edx], al
  inc edx
  inc ecx
htl_adv2:
  inc esi
  jmp htl_loop
htl_done:
  mov byte ptr [edx], 0
  mov [HINT_P], esi
  mov eax, ecx
  ret
htl_empty:
  mov byte ptr [HINT_TOK], 0
  xor eax, eax
  ret

// ---- hint_parse_col: the OPTIONAL colour column (v0.5.15) --------------
// Three extra decimal numbers on the SAME line are R,G,B.  Anything else --
// fewer than three, a non-number, a trailing comment -- leaves HINT_E_COL at
// 0, which means "use the Hint col row".  Falling back to the default is
// deliberate: a file written before this version must keep rendering exactly
// as it did.
hint_parse_col:
  mov dword ptr [HINT_E_COL], 0
  call hint_tok_line
  test eax, eax
  jz hint_pc_done
  call hint_atoi
  mov [HINT_TMP_N], eax
  call hint_tok_line
  test eax, eax
  jz hint_pc_done
  call hint_atoi
  mov [HINT_TMP_COL], eax
  call hint_tok_line
  test eax, eax
  jz hint_pc_done
  call hint_atoi
  mov ecx, [HINT_TMP_N]
  cmp ecx, 0FF
  ja hint_pc_done
  mov edx, [HINT_TMP_COL]
  cmp edx, 0FF
  ja hint_pc_done
  cmp eax, 0FF
  ja hint_pc_done
  // Pack in HTML order; ovl_swaprb turns it into what the marker wants.
  shl ecx, 10
  shl edx, 8
  or ecx, edx
  or ecx, eax
  mov [HINT_E_COL], ecx
hint_pc_done:
  ret

// ---- hint_tok: next whitespace-delimited token into HINT_TOK ----------
hint_tok:
  push esi
  push edi
  mov esi, [HINT_P]
  mov edi, HINT_TOK
  xor ecx, ecx
hint_tok_ws:
  cmp esi, [HINT_END]
  jae hint_tok_end
  movzx eax, byte ptr [esi]
  cmp eax, 20
  jbe hint_tok_adv             // space and every control char
  cmp eax, 80
  jae hint_tok_adv             // non-ASCII: skips a UTF-8 BOM and any CJK
  cmp eax, 23
  jne hint_tok_collect
hint_tok_cmt:
  cmp esi, [HINT_END]
  jae hint_tok_end
  movzx eax, byte ptr [esi]
  inc esi
  cmp eax, 0A
  jne hint_tok_cmt
  jmp hint_tok_ws
hint_tok_adv:
  inc esi
  jmp hint_tok_ws
hint_tok_collect:
  cmp esi, [HINT_END]
  jae hint_tok_fin
  movzx eax, byte ptr [esi]
  cmp eax, 20
  jbe hint_tok_fin
  mov byte ptr [edi], al
  inc edi
  inc ecx
  inc esi
  cmp ecx, 40
  jb hint_tok_collect
hint_tok_fin:
  mov byte ptr [edi], 0
  mov [HINT_P], esi
  mov eax, ecx
  pop edi
  pop esi
  ret
hint_tok_end:
  mov byte ptr [edi], 0
  mov [HINT_P], esi
  xor eax, eax
  pop edi
  pop esi
  ret

// ---- hint_time: HINT_TOK -> HINT_T_KIND/P/F ---------------------------
//   "1200"      -> kind 0 (absolute stage frame), F = 1200
//   "boss:2:60" -> kind 1, P = 2, F = 60
//   anything else -> kind -1, which never matches
hint_time:
  push esi
  push edx
  mov dword ptr [HINT_T_KIND], 0
  mov dword ptr [HINT_T_P], 0
  mov dword ptr [HINT_T_F], 0
  mov esi, HINT_TOK
  movzx eax, byte ptr [esi]
  or al, 20
  cmp al, 62                    // 'b' of "boss"
  jne hint_time_abs
hint_time_skip:
  movzx eax, byte ptr [esi]
  test eax, eax
  jz hint_time_bad
  cmp eax, 3A                   // ':'
  je hint_time_pat
  inc esi
  jmp hint_time_skip
hint_time_pat:
  inc esi
  xor eax, eax
hint_time_pl:
  movzx edx, byte ptr [esi]
  cmp edx, 30
  jb hint_time_pd
  cmp edx, 39
  ja hint_time_pd
  imul eax, eax, 0A
  sub edx, 30
  add eax, edx
  inc esi
  jmp hint_time_pl
hint_time_pd:
  mov [HINT_T_P], eax
  cmp byte ptr [esi], 3A
  jne hint_time_bad
  inc esi
  xor eax, eax
hint_time_fl:
  movzx edx, byte ptr [esi]
  cmp edx, 30
  jb hint_time_fd
  cmp edx, 39
  ja hint_time_fd
  imul eax, eax, 0A
  sub edx, 30
  add eax, edx
  inc esi
  jmp hint_time_fl
hint_time_fd:
  mov [HINT_T_F], eax
  mov dword ptr [HINT_T_KIND], 1
  jmp hint_time_done
hint_time_bad:
  mov dword ptr [HINT_T_KIND], FFFFFFFF
  jmp hint_time_done
hint_time_abs:
  call hint_atoi
  mov [HINT_T_F], eax
hint_time_done:
  pop edx
  pop esi
  ret

// ---- hint_xy: HINT_TOK ("192,348") -> HINT_T_X / HINT_T_Y -------------
hint_xy:
  push esi
  push edx
  mov dword ptr [HINT_T_X], 0
  mov dword ptr [HINT_T_Y], 0
  mov esi, HINT_TOK
  xor eax, eax
hint_xy_x:
  movzx edx, byte ptr [esi]
  cmp edx, 30
  jb hint_xy_xd
  cmp edx, 39
  ja hint_xy_xd
  imul eax, eax, 0A
  sub edx, 30
  add eax, edx
  inc esi
  jmp hint_xy_x
hint_xy_xd:
  mov [HINT_T_X], eax
  cmp byte ptr [esi], 2C        // ','
  jne hint_xy_done
  inc esi
  xor eax, eax
hint_xy_y:
  movzx edx, byte ptr [esi]
  cmp edx, 30
  jb hint_xy_yd
  cmp edx, 39
  ja hint_xy_yd
  imul eax, eax, 0A
  sub edx, 30
  add eax, edx
  inc esi
  jmp hint_xy_y
hint_xy_yd:
  mov [HINT_T_Y], eax
hint_xy_done:
  pop edx
  pop esi
  ret

// ---- hint_read_one: slurp HINT_PATHW into HINT_BUF, set HINT_LEN ------
hint_read_one:
  pushfd
  pushad
  mov dword ptr [HINT_LEN], 0
  push 0
  push 80                       // FILE_ATTRIBUTE_NORMAL
  push 3                        // OPEN_EXISTING
  push 0
  push 1                        // FILE_SHARE_READ
  push 80000000                 // GENERIC_READ
  push HINT_PATHW
  call dword ptr [7D9234]       // CreateFileW
  cmp eax, -1
  je hint_read_done
  mov [HINT_HF], eax
  push 0
  push HINT_RD
  push dword ptr [HINT_BUFMAX]  // VALUE, not its address
  push HINT_BUF
  push dword ptr [HINT_HF]
  call dword ptr [7D90E8]       // ReadFile
  test eax, eax
  jz hint_read_close
  mov eax, [HINT_RD]
  cmp eax, [HINT_BUFMAX]
  jb hint_read_ok
  mov eax, [HINT_BUFMAX]
hint_read_ok:
  mov [HINT_LEN], eax
  mov edi, HINT_BUF
  add edi, eax
  mov byte ptr [edi], 0
hint_read_close:
  push dword ptr [HINT_HF]
  call dword ptr [7D924C]       // CloseHandle
hint_read_done:
  popad
  popfd
  ret

// ---- hint_parse: tokenise HINT_BUF into HINT_ARR ----------------------
hint_parse:
  pushfd
  pushad
  mov dword ptr [HINT_CURSTAGE], 0
  mov eax, HINT_BUF
  mov [HINT_P], eax
  add eax, [HINT_LEN]
  mov [HINT_END], eax
hint_p_loop:
  call hint_tok
  test eax, eax
  jz hint_p_done
  cmp eax, 5
  jne hint_p_num
  movzx eax, byte ptr [HINT_TOK]
  or al, 20
  cmp al, 73                    // 's' -> "stage N"
  je hint_p_stageword
hint_p_num:
  movzx eax, byte ptr [HINT_TOK]
  cmp eax, 30
  jb hint_p_marker
  cmp eax, 39
  ja hint_p_marker
  call hint_atoi
  mov [HINT_CURSTAGE], eax
  jmp hint_p_loop
hint_p_stageword:
  call hint_tok
  call hint_atoi
  mov [HINT_CURSTAGE], eax
  jmp hint_p_loop
hint_p_marker:
  inc dword ptr [HINT_DBGM]
  // <mark> <size> <char> <start> <x,y> <end>
  movzx eax, byte ptr [HINT_TOK]
  mov [HINT_E_MARK], eax
  call hint_tok
  call hint_atoi
  mov [HINT_E_SIZE], eax
  // ---- character: "all", or a single digit 1..4 ----
  call hint_tok
  mov dword ptr [HINT_E_CHAR], 0
  movzx eax, byte ptr [HINT_TOK]
  cmp eax, 31
  jb hint_p_c_done
  cmp eax, 34
  ja hint_p_c_done
  cmp byte ptr [HINT_TOK+1], 0
  jne hint_p_c_done
  sub eax, 30
  mov [HINT_E_CHAR], eax
hint_p_c_done:
  // ---- start ----
  call hint_tok
  call hint_time
  mov eax, [HINT_T_KIND]
  mov [HINT_E_SK], eax
  mov eax, [HINT_T_P]
  mov [HINT_E_SP], eax
  mov eax, [HINT_T_F]
  mov [HINT_E_SF], eax
  // ---- x,y ----
  call hint_tok
  call hint_xy
  mov eax, [HINT_T_X]
  mov [HINT_E_X], eax
  mov eax, [HINT_T_Y]
  mov [HINT_E_Y], eax
  // ---- end ----
  call hint_tok
  call hint_time
  mov eax, [HINT_T_KIND]
  mov [HINT_E_EK], eax
  mov eax, [HINT_T_P]
  mov [HINT_E_EP], eax
  mov eax, [HINT_T_F]
  mov [HINT_E_EF], eax
  // ---- optional colour column: three decimal numbers, SAME line ----
  call hint_parse_col
  // a malformed time on either end is dropped rather than guessed
  cmp dword ptr [HINT_E_SK], FFFFFFFF
  je hint_p_loop
  cmp dword ptr [HINT_E_EK], FFFFFFFF
  je hint_p_loop
  // the two ends must use the SAME notation
  mov eax, [HINT_E_SK]
  cmp eax, [HINT_E_EK]
  jne hint_p_loop
  // only keep entries for the stage we are playing
  mov eax, [HINT_CURSTAGE]
  mov [HINT_DBGS], eax
  cmp eax, [HINT_WANT]
  jne hint_p_loop
  mov eax, [HINT_N]
  cmp eax, HINT_MAXN
  jae hint_p_loop
  imul eax, eax, 30
  add eax, HINT_ARR
  mov ecx, [HINT_E_MARK]
  mov [eax], ecx
  mov ecx, [HINT_E_SIZE]
  mov [eax+4], ecx
  mov ecx, [HINT_E_CHAR]
  mov [eax+8], ecx
  mov ecx, [HINT_E_X]
  mov [eax+0C], ecx
  mov ecx, [HINT_E_Y]
  mov [eax+10], ecx
  mov ecx, [HINT_E_SK]
  mov [eax+14], ecx
  mov ecx, [HINT_E_SP]
  mov [eax+18], ecx
  mov ecx, [HINT_E_SF]
  mov [eax+1C], ecx
  mov ecx, [HINT_E_EK]
  mov [eax+20], ecx
  mov ecx, [HINT_E_EP]
  mov [eax+24], ecx
  mov ecx, [HINT_E_EF]
  mov [eax+28], ecx
  // v0.5.15: the line's own colour, HTML order; 0 = use the Hint col row.
  mov ecx, [HINT_E_COL]
  mov [eax+2C], ecx
  inc dword ptr [HINT_N]
  jmp hint_p_loop
hint_p_done:
  popad
  popfd
  ret

// ---- hint_diff_ok: does this file apply to the current difficulty? -----
// Ported verbatim from Le02 v0.7.6.  Scans cFileName for
// -easy/-normal/-hard/-unreal, case-folded by ORing bit 5 into each UTF-16
// unit.  No tag -> applies to every difficulty.
// -> eax = 1 to load, 0 to skip.
hint_diff_ok:
  pushad
  mov esi, HINT_FD
  add esi, 2C                   // WIN32_FIND_DATAW.cFileName
hint_diff_scan:
  mov ax, [esi]
  test ax, ax
  jz hint_diff_none
  cmp ax, 2D                    // '-'
  jne hint_diff_next
  mov eax, [esi+2]              // the two units after the dash
  or eax, 200020                // fold case
  cmp eax, 610065               // "ea"
  je hint_diff_easy
  cmp eax, 6F006E               // "no"
  je hint_diff_normal
  cmp eax, 610068               // "ha"
  je hint_diff_hard
  cmp eax, 6E0075               // "un"
  je hint_diff_unreal
hint_diff_next:
  add esi, 2
  jmp hint_diff_scan
hint_diff_easy:
  xor ebx, ebx
  jmp hint_diff_cmp
hint_diff_normal:
  mov ebx, 1
  jmp hint_diff_cmp
hint_diff_hard:
  mov ebx, 2
  jmp hint_diff_cmp
hint_diff_unreal:
  mov ebx, 3
hint_diff_cmp:
  // Le02 clamps anything above Unreal down to Easy, and Le03's practice menu
  // really does offer 0..6 (SEL_DATA caps SEL_DIFF at 6), so this branch is
  // live here: on the Extra difficulties a "-easy" file loads and the other
  // three tags do not.  Kept as-is to match Le02 exactly.
  mov eax, [SEL_DIFF]
  cmp eax, 3
  jbe hint_diff_have
  xor eax, eax
hint_diff_have:
  cmp ebx, eax
  jne hint_diff_no
  mov dword ptr [HINT_OK], 1
  jmp hint_diff_out
hint_diff_none:
  mov dword ptr [HINT_OK], 1
  jmp hint_diff_out
hint_diff_no:
  mov dword ptr [HINT_OK], 0
hint_diff_out:
  popad
  mov eax, [HINT_OK]
  ret

// ---- hint_load: enumerate <exe dir>\hint\*.txt and parse each ---------
hint_load:
  pushfd
  pushad
  mov dword ptr [HINT_N], 0
  mov dword ptr [HINT_ERR], 0
  // the stage to keep: the real one from the stage object, else the menu
  mov eax, [OVL_STAGE]
  cmp eax, 10000
  jb hint_load_sel
  cmp eax, 7FFF0000
  ja hint_load_sel
  mov eax, [eax+30]
  test eax, eax
  jz hint_load_sel
  jmp hint_load_want
hint_load_sel:
  mov eax, [SEL_STAGE]
  inc eax
hint_load_want:
  mov [HINT_WANT], eax
  // ---- the exe's own path ----
  push 104
  push HINT_PATHW
  push 0
  call dword ptr [7D9184]       // GetModuleFileNameW
  test eax, eax
  jz hint_load_done
  // ---- cut at the last backslash, keeping it ----
  mov esi, HINT_PATHW
  lea edi, [esi+eax*2]
hint_load_cut:
  cmp edi, esi
  jbe hint_load_done
  sub edi, 2
  cmp word ptr [edi], 5C
  jne hint_load_cut
  add edi, 2
  mov [HINT_DIREND], edi
  // ---- append "hint\*.txt" ----
  mov esi, HINT_TAIL
hint_load_tail:
  mov ax, [esi]
  mov [edi], ax
  add esi, 2
  add edi, 2
  test ax, ax
  jnz hint_load_tail
  // The loop below rebuilds <dir><cFileName>, so the directory must include
  // the "hint\" we just appended -- otherwise it looks for the .txt files in
  // the game directory instead of the hint subdirectory.
  mov eax, [HINT_DIREND]
  add eax, 0A                   // "hint\" = 5 UTF-16 chars
  mov [HINT_DIREND], eax
  // ---- enumerate ----
  push HINT_FD
  push HINT_PATHW
  call dword ptr [7D90D8]       // FindFirstFileW
  cmp eax, -1
  je hint_load_done
  mov [HINT_FH], eax
hint_load_loop:
  // rebuild <dir><cFileName>  (cFileName is at FIND_DATAW + 0x2C)
  mov edi, [HINT_DIREND]
  mov esi, HINT_FD+2C
hint_load_name:
  mov ax, [esi]
  mov [edi], ax
  add esi, 2
  add edi, 2
  test ax, ax
  jnz hint_load_name
  // a name carrying -easy/-normal/-hard/-unreal only loads on that difficulty
  call hint_diff_ok
  test eax, eax
  jz hint_load_next
  call hint_read_one
  cmp dword ptr [HINT_LEN], 0
  je hint_load_next
  call hint_parse
hint_load_next:
  push HINT_FD
  push dword ptr [HINT_FH]
  call dword ptr [7D90DC]       // FindNextFileW
  test eax, eax
  jnz hint_load_loop
  push dword ptr [HINT_FH]
  call dword ptr [7D90D4]       // FindClose
hint_load_done:
  popad
  popfd
  ret

// ===================================================================== //
// Hint system -- drawing (structure follows Le02 v0.7.6 draw_hints)     //
// ===================================================================== //

// ---- hint_len: playfield LENGTH -> physical pixels (no origin) --------
// Must not go through hint_px: that one adds the playfield origin, which is
// right for a position and completely wrong for an arm length.
hint_len:
  push edx
  push ecx
  cmp eax, 0
  jge hint_len_lo
  xor eax, eax
hint_len_lo:
  cmp eax, 4000
  jbe hint_len_go
  mov eax, 4000
hint_len_go:
  shl eax, 3
  imul eax, [OVL_SXP]
  imul eax, eax, HINT_NUMX
  mov ecx, HINT_QSCALE
  xor edx, edx
  div ecx
  pop ecx
  pop edx
  ret

// ---- hint_px / hint_py: playfield position -> physical pixels ---------
// The SAME formula as ovl_marker, Fix term included.  That is the whole point:
// the Player+ cross is calibrated with Fix X / Fix Y until it sits exactly on
// the judgement dot, and a hint marker authored at the raw playfield position
// must land on that same calibrated spot.  Without the Fix term here the two
// crosses disagreed by exactly (Fix - 64) quarter units, which is what made
// every hint read as "a bit to the right of the dot".
//
// ★★★ THE SCALE IS ALL-OR-NOTHING.  Everything inside this transform is in
// the same unit -- playfield * 8, HINT_OXQ/HINT_OYQ, and (Fix - 128) -- and
// the divisor HINT_QSCALE is 320000.  v0.5.15 doubled the shift, the Fix bias
// and the divisor but left the origins at their quarter-unit values, which
// halved the origin term: every marker landed ~162 px left and ~28 px up,
// with the error growing as you approach the playfield's top-left corner.
// At neutral Fix the result must be IDENTICAL to the old quarter-unit
// formula, i.e.  new(P, org, fix) == old(P, org/2, fix/2)  for every P:
//   (8P + 2*org_old + (fix-128)) / 320000  ==  (4P + org_old + (fix_old-64)) / 160000
// The quickest check is a hint file with a marker at playfield (0,0): it must
// land on the same pixel as it did in the quarter-unit build.
hint_px:
  push edx
  push ecx
  cmp eax, 0
  jge hint_px_lo
  xor eax, eax
hint_px_lo:
  cmp eax, 4000
  jbe hint_px_go
  mov eax, 4000
hint_px_go:
  shl eax, 3
  add eax, [HINT_OXQ]
  mov ecx, [HINT_DX]
  sub ecx, 80
  add eax, ecx
  imul eax, [OVL_SXP]
  imul eax, eax, HINT_NUMX
  mov ecx, HINT_QSCALE
  xor edx, edx
  div ecx
  pop ecx
  pop edx
  ret

hint_py:
  push edx
  push ecx
  cmp eax, 0
  jge hint_py_lo
  xor eax, eax
hint_py_lo:
  cmp eax, 4000
  jbe hint_py_go
  mov eax, 4000
hint_py_go:
  shl eax, 3
  add eax, [HINT_OYQ]
  mov ecx, [HINT_DY]
  sub ecx, 80
  add eax, ecx
  imul eax, [OVL_SYP]
  imul eax, eax, HINT_NUMY
  mov ecx, HINT_QSCALE
  xor edx, edx
  div ecx
  pop ecx
  pop edx
  ret

// ---- hint_window_ok: is the current position inside this entry's window?
// eax = 1/0, esi = the entry.  Windows are LEFT-CLOSED RIGHT-OPEN and both
// ends are guaranteed to use the same notation (hint_parse drops the rest).
hint_window_ok:
  mov eax, [esi+14]
  test eax, eax
  jnz hint_win_boss
  mov eax, [OVL_V_FRAME]
  cmp eax, [esi+1C]
  jb hint_win_no
  cmp eax, [esi+28]
  jae hint_win_no
  mov eax, 1
  ret
hint_win_boss:
  mov ecx, [OVL_V_PATTERN]
  cmp ecx, 0
  jl hint_win_no
  mov edx, [HINT_PAT_FRAME]
  mov eax, [esi+18]
  cmp ecx, eax
  jb hint_win_no
  ja hint_win_s1
  cmp edx, [esi+1C]
  jb hint_win_no
hint_win_s1:
  mov eax, [esi+24]
  cmp ecx, eax
  ja hint_win_no
  jb hint_win_yes
  cmp edx, [esi+28]
  jae hint_win_no
hint_win_yes:
  mov eax, 1
  ret
hint_win_no:
  xor eax, eax
  ret

// ---- hint_dash_h / hint_dash_v: dashed guide lines --------------------
// One UpdateSubresource per dash so the gaps let the game show through.
// Dash and gap are both HINT_DASH pixels (Le02 uses size/2).
hint_dash_h:
  pushfd
  pushad
  mov esi, [HINT_D0]
hint_dash_h_loop:
  cmp esi, [HINT_D1]
  jae hint_dash_h_done
  mov edi, esi
  add edi, [HINT_DASH]
  cmp edi, [HINT_D1]
  jbe hint_dash_h_ok
  mov edi, [HINT_D1]
hint_dash_h_ok:
  mov dword ptr [OVL_BOX], esi
  mov eax, [HINT_LY]
  mov dword ptr [OVL_BOX+4], eax
  mov dword ptr [OVL_BOX+8], 0
  mov dword ptr [OVL_BOX+0C], edi
  add eax, 3
  mov dword ptr [OVL_BOX+10], eax
  mov dword ptr [OVL_BOX+14], 1
  push 0
  push 100                      // SrcRowPitch = 64 px * 4 (buffer row)
  push OVL_MBUF
  push OVL_BOX
  push 0
  push dword ptr [OVL_BACKBUF]
  call game+1B9B90
  add esp, 18
  mov esi, edi
  add esi, [HINT_DASH]
  jmp hint_dash_h_loop
hint_dash_h_done:
  popad
  popfd
  ret

hint_dash_v:
  pushfd
  pushad
  mov esi, [HINT_D0]
hint_dash_v_loop:
  cmp esi, [HINT_D1]
  jae hint_dash_v_done
  mov edi, esi
  add edi, [HINT_DASH]
  cmp edi, [HINT_D1]
  jbe hint_dash_v_ok
  mov edi, [HINT_D1]
hint_dash_v_ok:
  mov eax, [HINT_LX]
  mov dword ptr [OVL_BOX], eax
  mov dword ptr [OVL_BOX+4], esi
  mov dword ptr [OVL_BOX+8], 0
  add eax, 3
  mov dword ptr [OVL_BOX+0C], eax
  mov dword ptr [OVL_BOX+10], edi
  mov dword ptr [OVL_BOX+14], 1
  push 0
  push 0C                       // SrcRowPitch = 3 px * 4
  push OVL_MBUF
  push OVL_BOX
  push 0
  push dword ptr [OVL_BACKBUF]
  call game+1B9B90
  add esp, 18
  mov esi, edi
  add esi, [HINT_DASH]
  jmp hint_dash_v_loop
hint_dash_v_done:
  popad
  popfd
  ret

// ---- hint_draw_one: draw the entry in HINT_ROW ------------------------
hint_draw_one:
  pushfd
  pushad
  // Fill the colour buffer with whatever colour the fade test picked in
  // hint_draw.  192 dwords = the 3 rows x 64 px a bar may span.
  mov edi, OVL_MBUF
  mov eax, [HINT_USECOL]
  mov ecx, 0C0
hint_one_fill:
  mov [edi], eax
  add edi, 4
  dec ecx
  jnz hint_one_fill
  mov esi, [HINT_ROW]
  mov eax, [esi+0C]
  call hint_px
  mov [HINT_PXX], eax
  mov eax, [esi+10]
  call hint_py
  mov [HINT_PYY], eax
  // dash length = size/2 (Le02: HINT_DASHLEN = HINT_SIZE >> 1, min 8)
  mov eax, [esi+4]
  shr eax, 1
  test eax, eax
  jnz hint_one_dl
  mov eax, 8
hint_one_dl:
  mov [HINT_DASH], eax
  mov eax, [esi]
  cmp al, 2D                    // '-'
  je hint_one_h
  cmp al, 7C                    // '|'
  je hint_one_v
  // ---- '+' crosshair ----
  mov eax, [esi+4]
  shr eax, 1
  call hint_len                 // arm in PHYSICAL pixels
  test eax, eax
  jnz hint_one_arm
  mov eax, 8
hint_one_arm:
  cmp eax, 1E
  jbe hint_one_arm_ok
  mov eax, 1E                   // keep the bar inside the buffer row
hint_one_arm_ok:
  mov [HINT_ARM], eax
  mov ecx, [HINT_PXX]
  mov edx, [HINT_PYY]
  mov esi, [HINT_ARM]
  mov eax, ecx
  sub eax, esi
  mov ebx, ecx
  add ebx, esi
  inc ebx
  mov edi, edx
  add edi, 3
  push 0
  push 100
  push OVL_MBUF
  push OVL_BOX
  push 0
  push dword ptr [OVL_BACKBUF]
  mov dword ptr [OVL_BOX], eax
  mov dword ptr [OVL_BOX+4], edx
  mov dword ptr [OVL_BOX+8], 0
  mov dword ptr [OVL_BOX+0C], ebx
  mov dword ptr [OVL_BOX+10], edi
  mov dword ptr [OVL_BOX+14], 1
  call game+1B9B90
  add esp, 18
  mov ecx, [HINT_PXX]
  mov edx, [HINT_PYY]
  mov esi, [HINT_ARM]
  mov eax, edx
  sub eax, esi
  mov ebx, edx
  add ebx, esi
  inc ebx
  mov edi, ecx
  add edi, 3
  push 0
  push 0C
  push OVL_MBUF
  push OVL_BOX
  push 0
  push dword ptr [OVL_BACKBUF]
  mov dword ptr [OVL_BOX], ecx
  mov dword ptr [OVL_BOX+4], eax
  mov dword ptr [OVL_BOX+8], 0
  mov dword ptr [OVL_BOX+0C], edi
  mov dword ptr [OVL_BOX+10], ebx
  mov dword ptr [OVL_BOX+14], 1
  call game+1B9B90
  add esp, 18
  jmp hint_one_done
hint_one_h:
  xor eax, eax
  call hint_px
  mov [HINT_D0], eax
  mov eax, 180                  // 384 playfield units wide
  call hint_px
  mov [HINT_D1], eax
  mov eax, [HINT_PYY]
  mov [HINT_LY], eax
  call hint_dash_h
  jmp hint_one_done
hint_one_v:
  xor eax, eax
  call hint_py
  mov [HINT_D0], eax
  mov eax, 1C0                  // 448 playfield units tall
  call hint_py
  mov [HINT_D1], eax
  mov eax, [HINT_PXX]
  mov [HINT_LX], eax
  call hint_dash_v
hint_one_done:
  popad
  popfd
  ret

// ---- hint_draw: every matching entry ----------------------------------
hint_draw:
  pushfd
  pushad
  cmp dword ptr [OVL_V_HINT], 0
  je hint_draw_done
  cmp dword ptr [OVL_BACKBUF], 0
  je hint_draw_done
  cmp dword ptr [HINT_N], 0
  je hint_draw_done
  // The colour buffer is filled per entry inside hint_draw_one, with the
  // colour the fade test picks.  It cannot be filled here any more, and
  // ovl_marker cannot be relied on for it either: that one returns early
  // whenever the Player+ row is off.
  call ovl_getpos
  mov dword ptr [HINT_CUR], 0
hint_draw_loop:
  mov eax, [HINT_CUR]
  cmp eax, [HINT_N]
  jae hint_draw_done
  imul eax, eax, 30
  add eax, HINT_ARR
  mov [HINT_ROW], eax
  mov esi, eax
  mov ecx, [esi+8]              // character filter, 0 = all
  test ecx, ecx
  jz hint_draw_win
  mov edx, [CHAR_IDX]
  inc edx
  cmp ecx, edx
  jne hint_draw_next
hint_draw_win:
  call hint_window_ok
  test eax, eax
  jz hint_draw_next
  // ---- colour: the line's OWN colour if it named one (record +0x2C), else
  //      whatever the Hint col row holds; dimmed when the player stands on
  //      the marker. ----
  mov ecx, [esi+2C]
  test ecx, ecx
  jnz hint_draw_have_col
  mov ecx, [HINT_COL]
hint_draw_have_col:
  mov eax, [DBG_PX]
  sub eax, [esi+0C]
  test eax, eax
  jns hint_draw_adx
  neg eax
hint_draw_adx:
  mov ebx, [DBG_PY]
  sub ebx, [esi+10]
  test ebx, ebx
  jns hint_draw_ady
  neg ebx
hint_draw_ady:
  add eax, ebx
  cmp eax, [HINT_FADE_R]
  jae hint_draw_col
  // Dim = every channel halved.  One shift plus a mask does all three at once
  // and works for ANY colour, where the old fixed HINT_COL_DIM only ever
  // matched the build's own default.
  shr ecx, 1
  and ecx, 7F7F7F
hint_draw_col:
  // Colours are held in HTML order; the marker buffer wants COLORREF.
  call ovl_swaprb
  mov [HINT_USECOL], ecx
  call hint_draw_one
hint_draw_next:
  inc dword ptr [HINT_CUR]
  jmp hint_draw_loop
hint_draw_done:
  popad
  popfd
  ret

// ===================================================================== //
// Hint system -- capture (ported from Le02 v0.7.6 hint_capture)         //
// Pressing Z on the Capture row appends one line describing the current //
// spot to <exe dir>\hint\<stage>.txt, creating the file if needed.      //
// ===================================================================== //

// ---- hint_itoa: eax = value -> decimal at edi, edi advanced -----------
hint_itoa:
  push eax
  push ebx
  push ecx
  push edx
  push esi
  mov esi, HINT_NUMBUF2
  xor ecx, ecx
  test eax, eax
  jnz hint_itoa_dig
  mov byte ptr [esi], 30
  mov ecx, 1
  jmp hint_itoa_rev
hint_itoa_dig:
  mov ebx, 0A
hint_itoa_d:
  xor edx, edx
  div ebx
  add dl, 30
  mov [esi+ecx], dl
  inc ecx
  test eax, eax
  jnz hint_itoa_d
hint_itoa_rev:
  dec ecx
  mov al, [esi+ecx]
  mov [edi], al
  inc edi
  test ecx, ecx
  jnz hint_itoa_rev
  pop esi
  pop edx
  pop ecx
  pop ebx
  pop eax
  ret

// ---- hint_emit_time: eax=kind, ecx=pattern, edx=frame -> text at edi ---
hint_emit_time:
  test eax, eax
  jnz hint_emit_boss
  mov eax, edx
  call hint_itoa
  ret
hint_emit_boss:
  mov byte ptr [edi], 62        // 'b'
  mov byte ptr [edi+1], 6F      // 'o'
  mov byte ptr [edi+2], 73      // 's'
  mov byte ptr [edi+3], 73      // 's'
  mov byte ptr [edi+4], 3A      // ':'
  add edi, 5
  push edx
  mov eax, ecx
  call hint_itoa
  mov byte ptr [edi], 3A
  inc edi
  pop edx
  mov eax, edx
  call hint_itoa
  ret

// ---- hint_cap_path: HINT_PATHW = <hint dir><stage>.txt ----------------
// load_hints leaves HINT_PATHW pointing at whichever file the walk finished
// on, so appending straight to it would dump every capture into that one
// file.  Rebuild the name from the stage we resolved.
hint_cap_path:
  push eax
  push edi
  mov edi, [HINT_DIREND]
  mov eax, [HINT_WANT]
  call hint_itoaw               // WIDE: CreateFileW wants UTF-16
  mov word ptr [edi], 2E        // '.'
  mov word ptr [edi+2], 74      // 't'
  mov word ptr [edi+4], 78      // 'x'
  mov word ptr [edi+6], 74      // 't'
  mov word ptr [edi+8], 0
  pop edi
  pop eax
  ret

// ---- hint_itoaw: like hint_itoa but writes UTF-16 --------------------
// The capture LINE is plain ASCII (that is what the hint files are), but the
// PATH goes to CreateFileW, which is the W API and needs 2 bytes per char.
hint_itoaw:
  push eax
  push ebx
  push ecx
  push edx
  push esi
  mov esi, HINT_NUMBUF2
  xor ecx, ecx
  test eax, eax
  jnz hint_itoaw_dig
  mov byte ptr [esi], 30
  mov ecx, 1
  jmp hint_itoaw_rev
hint_itoaw_dig:
  mov ebx, 0A
hint_itoaw_d:
  xor edx, edx
  div ebx
  add dl, 30
  mov [esi+ecx], dl
  inc ecx
  test eax, eax
  jnz hint_itoaw_d
hint_itoaw_rev:
  dec ecx
  mov al, [esi+ecx]
  mov [edi], al
  mov byte ptr [edi+1], 0
  add edi, 2
  test ecx, ecx
  jnz hint_itoaw_rev
  pop esi
  pop edx
  pop ecx
  pop ebx
  pop eax
  ret

// ---- hint_capture ----------------------------------------------------
hint_capture:
  pushfd
  pushad
  mov dword ptr [HINT_CAP_OK], 0
  // ---- the player's raw playfield position ----
  mov eax, [OVL_PLAYER]
  cmp eax, 10000
  jb hint_capture_done
  cmp eax, 7FFF0000
  ja hint_capture_done
  mov eax, [eax]
  cmp eax, 10000
  jb hint_capture_done
  cmp eax, 7FFF0000
  ja hint_capture_done
  cvttss2si ecx, dword ptr [eax]
  cvttss2si edx, dword ptr [eax+4]
  mov [HINT_C_X], ecx
  mov [HINT_C_Y], edx
  // ---- choose the time form ----
  // Inside a boss fight an absolute stage frame is useless for authoring a
  // boss:P:F window, so write boss:<current pattern>:<frames into it> ending
  // at boss:<next pattern>:0, i.e. "until this pattern ends".
  mov eax, [OVL_V_FRAME]
  mov [HINT_C_F], eax
  mov dword ptr [HINT_C_KIND], 0
  mov dword ptr [HINT_C_PID], 0
  mov [HINT_C_PF], eax
  mov dword ptr [HINT_C_EKIND], 0
  mov dword ptr [HINT_C_EPID], 0
  add eax, 4B0                  // 1200: a generous mid-stage fallback
  mov [HINT_C_EF], eax
  mov eax, [OVL_V_PATTERN]
  cmp eax, 0
  jl hint_cap_form_done
  mov dword ptr [HINT_C_KIND], 1
  mov [HINT_C_PID], eax
  mov ecx, [HINT_PAT_FRAME]
  mov [HINT_C_PF], ecx
  mov dword ptr [HINT_C_EKIND], 1
  inc eax
  mov [HINT_C_EPID], eax
  mov dword ptr [HINT_C_EF], 0
hint_cap_form_done:
  // ---- build "+ 16 all <start> <x>,<y> <end>" CRLF ----
  mov edi, HINT_LINE
  mov byte ptr [edi], 2B        // '+'
  mov byte ptr [edi+1], 20
  add edi, 2
  mov eax, 10                   // 16: the default marker size
  call hint_itoa
  mov byte ptr [edi], 20
  inc edi
  mov byte ptr [edi], 61
  mov byte ptr [edi+1], 6C
  mov byte ptr [edi+2], 6C
  mov byte ptr [edi+3], 20
  add edi, 4
  mov eax, [HINT_C_KIND]
  mov ecx, [HINT_C_PID]
  mov edx, [HINT_C_PF]
  call hint_emit_time
  mov byte ptr [edi], 20
  inc edi
  mov eax, [HINT_C_X]
  call hint_itoa
  mov byte ptr [edi], 2C        // ','
  inc edi
  mov eax, [HINT_C_Y]
  call hint_itoa
  mov byte ptr [edi], 20
  inc edi
  mov eax, [HINT_C_EKIND]
  mov ecx, [HINT_C_EPID]
  mov edx, [HINT_C_EF]
  call hint_emit_time
  mov byte ptr [edi], 0D
  mov byte ptr [edi+1], 0A
  add edi, 2
  mov eax, HINT_LINE
  sub edi, eax
  mov [HINT_CAPLEN], edi
  call hint_cap_path
  // ---- open (creating if needed) and append ----
  push 0
  push 80
  push 4                        // OPEN_ALWAYS
  push 0
  push 1
  push C0000000                 // GENERIC_READ | GENERIC_WRITE
  push HINT_PATHW
  call dword ptr [7D9234]       // CreateFileW
  cmp eax, -1
  je hint_capture_done
  mov [HINT_HANDLE], eax
  push 0
  push eax
  call dword ptr [7D90E0]       // GetFileSize
  test eax, eax
  jnz hint_cap_nl
  // a brand new file needs its stage header first
  mov edi, HINT_LINE2
  mov eax, [HINT_WANT]
  call hint_itoa
  mov byte ptr [edi], 0D
  mov byte ptr [edi+1], 0A
  add edi, 2
  mov eax, HINT_LINE2
  sub edi, eax
  mov [HINT_CAPLEN2], edi
  push 0
  push HINT_WROTE
  push dword ptr [HINT_CAPLEN2]
  push HINT_LINE2
  push dword ptr [HINT_HANDLE]
  call dword ptr [7D9228]       // WriteFile
  jmp hint_cap_seek
hint_cap_nl:
  // make sure the file ends with a line break before appending, or the new
  // entry glues onto the last line and the parser misreads it
  mov ecx, eax
  dec ecx
  push 0
  push 0
  push ecx
  push dword ptr [HINT_HANDLE]
  call dword ptr [7D90CC]       // SetFilePointer
  push 0
  push HINT_GOT
  push 1
  push HINT_LASTCH
  push dword ptr [HINT_HANDLE]
  call dword ptr [7D90E8]       // ReadFile
  cmp byte ptr [HINT_LASTCH], 0A
  je hint_cap_seek
  push 2
  push 0
  push 0
  push dword ptr [HINT_HANDLE]
  call dword ptr [7D90CC]
  mov byte ptr [HINT_LASTCH], 0D
  mov byte ptr [HINT_LASTCH+1], 0A
  push 0
  push HINT_WROTE
  push 2
  push HINT_LASTCH
  push dword ptr [HINT_HANDLE]
  call dword ptr [7D9228]
hint_cap_seek:
  push 2
  push 0
  push 0
  push dword ptr [HINT_HANDLE]
  call dword ptr [7D90CC]       // seek to end
  push 0
  push HINT_WROTE
  push dword ptr [HINT_CAPLEN]
  push HINT_LINE
  push dword ptr [HINT_HANDLE]
  call dword ptr [7D9228]       // WriteFile
  push dword ptr [HINT_HANDLE]
  call dword ptr [7D924C]       // CloseHandle
  mov dword ptr [HINT_CAP_OK], 1
hint_capture_done:
  popad
  popfd
  ret

// ===================================================================== //
// Settings file (v0.5.9)                                               //
//   <exe dir>\prac.cfg -- plain text, one "key=value" per line.         //
//                                                                       //
//   Only "playerplus" is persisted today.  The reader scans the whole    //
//   buffer for the literal key, so adding more keys later needs no       //
//   change here -- just another line in the file.                        //
//                                                                       //
//   Why: the Player+ cross is a read-out that some people want and some  //
//   do not, and a build-time default cannot please both.  So the F12 row  //
//   is the default, and any change to it is written straight back: turn   //
//   it off once and it stays off until you turn it back on.  Deleting     //
//   prac.cfg restores the default.                                       //
// ===================================================================== //

// ---- cfg_path: CFG_PATHW = "<exe dir>prac.cfg" -------------------------
cfg_path:
  pushad
  push 104
  push CFG_PATHW
  push 0
  call dword ptr [7D9184]       // GetModuleFileNameW
  test eax, eax
  jz cfg_path_done
  mov esi, CFG_PATHW
  lea edi, [esi+eax*2]
cfg_path_cut:
  cmp edi, esi
  jbe cfg_path_done
  sub edi, 2
  cmp word ptr [edi], 5C        // backslash
  jne cfg_path_cut
  add edi, 2
  mov esi, CFG_TAILW
cfg_path_cp:
  mov ax, [esi]
  mov [edi], ax
  add esi, 2
  add edi, 2
  test ax, ax
  jnz cfg_path_cp
cfg_path_done:
  popad
  ret

// ---- cfg_load: read the whole file once and apply every key we know ----
// A missing key leaves the build's own default in place, so a fresh install
// behaves exactly like before.  Every value is clamped to its row's own
// maximum (the 4th dword of the CFG_TABLE entry), so a hand-edited file
// cannot push a row out of range.
// ---- devmode gate ---------------------------------------------------
// Developer mode stays on only when prac.cfg contains the code token
// somewhere in its first 256 bytes.  The token is not a key/value pair,
// so the normal key parser ignores it.
code_present:
  push esi
  push edi
  push ecx
  push edx
  mov edx, CFG_BUF               // candidate start
  mov ecx, 0E2                   // 256 - 31 + 1 positions
cp_scan:
  mov esi, edx
  mov edi, CODE_STR
  push ecx
  mov ecx, 1F                    // 31 bytes
cp_cmp:
  mov al, [esi]
  cmp al, [edi]
  jne cp_miss
  inc esi
  inc edi
  dec ecx
  jnz cp_cmp
  pop ecx
  mov eax, 1
  jmp cp_done
cp_miss:
  pop ecx
  inc edx
  dec ecx
  jnz cp_scan
  xor eax, eax
cp_done:
  pop edx
  pop ecx
  pop edi
  pop esi
  ret
CODE_STR:
  db 4A 79 6E 58 6A 75 6E 67 75 6F 7A 68 75 79 69 62 61 69 6C 65 69 73 69 64 69 65 6C 61 6E 6D 61, 00
CODE_SEEN:
  dd 0
CODE_LINE:
  db 63 6F 64 65 3A 20 4A 79 6E 58 6A 75 6E 67 75 6F 7A 68 75 79 69 62 61 69 6C 65 69 73 69 64 69 65 6C 61 6E 6D 61 0A

cfg_load:
  pushfd
  pushad
  mov dword ptr [CFG_LOADED], 1
  call cfg_path
  push 0
  push 80                       // FILE_ATTRIBUTE_NORMAL
  push 3                        // OPEN_EXISTING
  push 0
  push 1                        // FILE_SHARE_READ
  push 80000000                 // GENERIC_READ
  push CFG_PATHW
  call dword ptr [7D9234]       // CreateFileW
  cmp eax, -1
  je cfg_load_done
  mov [CFG_H], eax
  push 0
  push CFG_RD
  push 200                      // 512 bytes -- MUST equal CFG_BUF's own size,
  push CFG_BUF                  // or ReadFile runs off the end of the buffer
  push dword ptr [CFG_H]
  call dword ptr [7D90E8]       // ReadFile
  push dword ptr [CFG_H]
  call dword ptr [7D924C]       // CloseHandle
  xor edi, edi
cfg_load_entry:
  cmp edi, [CFG_N]
  jae cfg_load_done
  mov eax, edi
  imul eax, eax, 10
  add eax, CFG_TABLE
  mov [CFG_ENT], eax
  mov esi, [eax]
  mov ecx, [eax+4]
  call cfg_find
  test eax, eax
  jz cfg_load_next
  mov esi, eax
  call cfg_atoi
  mov ecx, [CFG_ENT]
  mov edx, [ecx+0C]
  cmp eax, edx
  jbe cfg_load_ok
  mov eax, edx                  // clamp to the row's own maximum
cfg_load_ok:
  mov ecx, [CFG_ENT]
  mov ecx, [ecx+8]
  mov [ecx], eax
cfg_load_next:
  inc edi
  jmp cfg_load_entry
cfg_load_done:
  call code_present
  mov [CODE_SEEN], eax
  cmp dword ptr [CFG_DEVMODE], 0
  je cfg_load_end
  call code_present
  test eax, eax
  jnz cfg_load_end
  mov dword ptr [CFG_DEVMODE], 0
cfg_load_end:
  popad
  popfd
  ret

// cfg_find: esi = key, ecx = key length -> eax = pointer to the first digit
// after "key=", or 0.  The '=' is what stops a short key from matching the
// front of a longer one ("hint" vs "hintcol").
//
// NOTE the '=' test has to happen while ebx is still advanced past the key:
// restoring ebx first would test the key's own first character instead, and
// then nothing would ever match.
cfg_find:
  mov edx, [CFG_RD]
  mov ebx, CFG_BUF
cfg_find_scan:
  cmp edx, ecx
  jb cfg_find_no
  push esi
  push ecx
  push ebx
cfg_find_cmp:
  mov al, [ebx]
  cmp al, [esi]
  jne cfg_find_miss
  inc ebx
  inc esi
  dec ecx
  jnz cfg_find_cmp
  cmp byte ptr [ebx], 3D
  je cfg_find_hit
cfg_find_miss:
  pop ebx
  pop ecx
  pop esi
cfg_find_adv:
  inc ebx
  dec edx
  jmp cfg_find_scan
cfg_find_hit:
  mov eax, ebx
  inc eax
  pop ebx
  pop ecx
  pop esi
  ret
cfg_find_no:
  xor eax, eax
  ret

// cfg_atoi: esi -> eax.  Decimal, stops at the first non-digit.
cfg_atoi:
  xor eax, eax
cfg_atoi_loop:
  movzx edx, byte ptr [esi]
  cmp edx, 30
  jb cfg_atoi_done
  cmp edx, 39
  ja cfg_atoi_done
  imul eax, eax, 0A
  sub edx, 30
  add eax, edx
  inc esi
  jmp cfg_atoi_loop
cfg_atoi_done:
  ret

// cfg_itoa: eax -> decimal at [ebx].  ebx advances past the digits.
cfg_itoa:
  push eax
  push ecx
  push edx
  push esi
  push edi
  mov edi, CFG_TMPD
  mov ecx, 0A
  xor esi, esi
cfg_itoa_loop:
  xor edx, edx
  div ecx
  add edx, 30
  mov [edi], dl
  inc edi
  inc esi
  test eax, eax
  jnz cfg_itoa_loop
cfg_itoa_pop:
  dec edi
  mov al, [edi]
  mov [ebx], al
  inc ebx
  dec esi
  jnz cfg_itoa_pop
cfg_itoa_out:
  pop edi
  pop esi
  pop edx
  pop ecx
  pop eax
  ret

// ---- cfg_save: rewrite the file with ALL keys, in table order ----------
// The file is opened CREATE_ALWAYS, so a "write only what changed" version
// would silently erase the other six keys -- that is exactly the shape the
// single-key version had, and why it had to be rewritten rather than
// extended.
cfg_save:
  pushfd
  pushad
  call cfg_path
  push 0
  push 80
  push 2                        // CREATE_ALWAYS
  push 0
  push 1
  push 40000000                 // GENERIC_WRITE
  push CFG_PATHW
  call dword ptr [7D9234]       // CreateFileW
  cmp eax, -1
  je cfg_save_done
  mov [CFG_H], eax
  xor edi, edi
cfg_save_loop:
  cmp edi, [CFG_N]
  jae cfg_save_close
  mov eax, edi
  imul eax, eax, 10
  add eax, CFG_TABLE
  mov [CFG_ENT], eax
  mov esi, [eax]
  mov ecx, [eax+4]
  mov ebx, CFG_LINE
cfg_save_cp:
  mov al, [esi]
  mov [ebx], al
  inc esi
  inc ebx
  dec ecx
  jnz cfg_save_cp
  mov byte ptr [ebx], 3D        // '='
  inc ebx
  mov eax, [CFG_ENT]
  mov eax, [eax+8]
  mov eax, [eax]
  call cfg_itoa
  mov byte ptr [ebx], 0A        // newline
  inc ebx
  mov eax, ebx
  sub eax, CFG_LINE
  push 0
  push CFG_WROTE
  push eax
  push CFG_LINE
  push dword ptr [CFG_H]
  call dword ptr [7D9228]       // WriteFile
  inc edi
  jmp cfg_save_loop
cfg_save_close:
  cmp dword ptr [CFG_DEVMODE], 0
  jne cfg_save_code
  cmp dword ptr [CODE_SEEN], 0
  je cfg_save_close2
cfg_save_code:
  je cfg_save_close2
  push 0
  push CFG_WROTE
  push CODE_LEN
  push CODE_LINE
  push dword ptr [CFG_H]
  call dword ptr [7D9228]
cfg_save_close2:
  push dword ptr [CFG_H]
  call dword ptr [7D924C]       // CloseHandle
  call cfg_snap
cfg_save_done:
  popad
  popfd
  ret

// ---- cfg_tick: once per frame, from ovl_mirror -------------------------
// Load on the very first frame, then rewrite the file whenever one of the
// values stops matching what we last wrote.
cfg_tick:
  pushfd
  pushad
  cmp dword ptr [CFG_LOADED], 0
  jne cfg_tick_chk
  call cfg_load
  call cfg_snap
  jmp cfg_tick_done
cfg_tick_chk:
  mov esi, CFG_TABLE
  mov edi, CFG_LAST
  mov ecx, [CFG_N]
cfg_tick_scan:
  test ecx, ecx
  jz cfg_tick_done
  mov eax, [esi+8]
  mov eax, [eax]
  cmp eax, [edi]
  jne cfg_tick_save
  add esi, 10
  add edi, 4
  dec ecx
  jmp cfg_tick_scan
cfg_tick_save:
  call cfg_save
cfg_tick_done:
  popad
  popfd
  ret

// Copy the live values into CFG_LAST, so cfg_tick has a baseline to compare
// against and does not rewrite the disk every single frame.
cfg_snap:
  pushad
  mov esi, CFG_TABLE
  mov edi, CFG_LAST
  mov ecx, [CFG_N]
cfg_snap_loop:
  test ecx, ecx
  jz cfg_snap_done
  mov eax, [esi+8]
  mov eax, [eax]
  mov [edi], eax
  add esi, 10
  add edi, 4
  dec ecx
  jmp cfg_snap_loop
cfg_snap_done:
  popad
  ret

// ---- ovl_getpos: DBG_PX / DBG_PY = the player's judgement point --------
// Returns eax = 1 when the player object is valid, 0 otherwise; the two
// dwords are zeroed in that case.  Shared by the calibration cross and by
// the hint fade so both always read the same position.
//
// The clamp matters: cvttss2si turns an out-of-range float into INT_MIN, and
// a wild value would make the `div` in the scaling below overflow and raise
// #DE -- which is a real crash this code has already hit once.  The playfield
// is only a few hundred units across, so 0..2000 is generous.
ovl_getpos:
  push ecx
  push edx
  mov dword ptr [DBG_PX], 0
  mov dword ptr [DBG_PY], 0
  mov eax, [OVL_PLAYER]
  cmp eax, 10000
  jb ovl_gp_no
  cmp eax, 7FFF0000
  ja ovl_gp_no
  mov eax, [eax]
  cmp eax, 10000
  jb ovl_gp_no
  cmp eax, 7FFF0000
  ja ovl_gp_no
  cvttss2si ecx, dword ptr [eax]
  cvttss2si edx, dword ptr [eax+4]
  test ecx, ecx
  jns ovl_gp_cx
  xor ecx, ecx
ovl_gp_cx:
  cmp ecx, 7D0
  jbe ovl_gp_cy
  mov ecx, 7D0
ovl_gp_cy:
  test edx, edx
  jns ovl_gp_cy2
  xor edx, edx
ovl_gp_cy2:
  cmp edx, 7D0
  jbe ovl_gp_ok
  mov edx, 7D0
ovl_gp_ok:
  mov [DBG_PX], ecx
  mov [DBG_PY], edx
  mov eax, 1
  pop edx
  pop ecx
  ret
ovl_gp_no:
  xor eax, eax
  pop edx
  pop ecx
  ret

// ---- ovl_marker: the calibration crosshair -----------------------------
// Ported from Le02's draw_hints.  The marker sits at the player's playfield
// position, plus Fix X / Fix Y (BIASED by 0x40 because menu rows are
// compared unsigned and cannot hold a negative), plus the playfield origin
// HINT_OXQ / HINT_OYQ.
//
// ★ The Fix term is added EXACTLY ONCE, and in the same place hint_px /
// hint_py add it.  It used to be added twice here -- once in raw playfield
// units before the `shl eax,2`, once in quarter units after -- so this cross
// moved FIVE quarter-units per Fix count while every hint marker moved zero.
// That is why the hint crosses always sat to one side of the player cross and
// why a single Fix step was a coarse ~3 px.  Le02 applies it once; so do we.
//
// Position source, exactly as Le02: OVL_PLAYER is the player object, [obj]
// is the position struct, and the judgement point is the float pair at
// [pos] and [pos+4].
//
// Drawn with two UpdateSubresource calls -- a horizontal and a vertical bar
// -- so no extra DIB is needed; both read the same pre-filled colour buffer.
ovl_marker:
  pushfd
  pushad
  // Gated on the Player+ row, NOT on Hint: this cross is the hitbox /
  // calibration display, and Le02 keeps it switchable on its own.
  cmp dword ptr [OVL_V_PCROSS], 0
  je ovl_marker_done
  mov eax, [OVL_BACKBUF]
  test eax, eax
  jz ovl_marker_done
  // The position comes from ovl_getpos so the cross and the hint fade can
  // never disagree about where the judgement point is.
  call ovl_getpos
  test eax, eax
  jz ovl_marker_done
  mov ecx, [DBG_PX]
  mov edx, [DBG_PY]
  mov [OVL_MLY], edx
  // Scale WITHOUT ovl_sx/ovl_sy: those add OVL_OX/OVL_OY, which ovl_panel_draw
  // parks at -panelOrigin and leaves behind for the next frame -- that was
  // dragging the marker sideways.
  //
  // The playfield is ALSO not in the 640x480 logical space: measured against
  // the character on screen, X advances 3.37 px per game unit and Y 3.54,
  // where the logical->physical factor is 4.0.  So the client scale is
  // corrected by HINT_NUM*/HINT_DEN before use.
  // Everything below works in QUARTER logical units, so the Fix rows can be
  // tuned BELOW one logical unit: 1 unit is ~3.3 physical px, a quarter is
  // ~0.83 px -- which is what it takes to land the cross exactly on the dot.
  // Fix X/Y read 64 at neutral; one count is now ~0.6 px.
  //
  // ONE division: (v4 * SXP * NUMX) / (400 * DEN).  Two successive integer
  // divisions truncated twice and cost up to a pixel.
  mov eax, ecx
  shl eax, 3                      // DBG * 8 (eighth logical units)
  add eax, [HINT_DX]
  sub eax, 80                     // + (FixX - 128), in eighth units
  add eax, [HINT_OXQ]             // + origin, already in eighth units
  imul eax, [OVL_SXP]
  imul eax, eax, HINT_NUMX
  mov ecx, HINT_QSCALE            // 400 * DEN * 2 (eighth units)
  xor edx, edx
  div ecx
  mov [OVL_MX], eax
  mov eax, [OVL_MLY]
  shl eax, 3
  add eax, [HINT_DY]
  sub eax, 80
  add eax, [HINT_OYQ]
  imul eax, [OVL_SYP]
  imul eax, eax, HINT_NUMY
  mov ecx, HINT_QSCALE
  xor edx, edx
  div ecx
  mov [OVL_MY], eax
  // ---- fill the marker colour buffer once ----
  // The horizontal bar is 3 rows x (2*size+1) px, so the buffer must hold at
  // least 3*(2*size+1) dwords -- at the row maximum (0x40) that is 387.  It
  // used to be filled with only 80 and the buffer was 96, so the bar's tail
  // read past the fill and came out black.
  //
  // OVL_V_PCOL is held in HTML order (that is what the menu shows and what
  // prac.cfg stores); this buffer is handed to UpdateSubresource, which wants
  // COLORREF, so the swap happens here -- the one place a colour crosses over.
  mov ecx, [OVL_V_PCOL]
  call ovl_swaprb
  mov edi, OVL_MBUF
  mov eax, ecx
  mov ecx, 200                  // 512 dwords = the whole OVL_MBUF
ovl_marker_fill:
  mov [edi], eax
  add edi, 4
  dec ecx
  jnz ovl_marker_fill
  // ---- horizontal bar: (2*size+1) wide x 3 tall ----
  // Kept small on purpose: it is the player's own hitbox marker, so it must
  // not cover the thing it is pointing at.
  mov edi, [OVL_V_PSIZE]
  lea edi, [edi+edi+1]
  mov esi, edi
  shl edi, 2                    // SrcRowPitch = width * 4
  mov eax, [OVL_MX]
  sub eax, [OVL_V_PSIZE]
  mov dword ptr [OVL_BOX], eax
  mov eax, [OVL_MY]
  sub eax, 1
  mov dword ptr [OVL_BOX+4], eax
  mov dword ptr [OVL_BOX+8], 0
  mov eax, [OVL_MX]
  add eax, [OVL_V_PSIZE]
  inc eax
  mov dword ptr [OVL_BOX+0C], eax
  mov eax, [OVL_MY]
  add eax, 2
  mov dword ptr [OVL_BOX+10], eax
  mov dword ptr [OVL_BOX+14], 1
  push 0
  push edi
  push OVL_MBUF
  push OVL_BOX
  push 0
  push dword ptr [OVL_BACKBUF]
  call game+1B9B90
  add esp, 18
  // ---- vertical bar: 3 wide x (2*size+1) tall ----
  mov eax, [OVL_MX]
  sub eax, 1
  mov dword ptr [OVL_BOX], eax
  mov eax, [OVL_MY]
  sub eax, [OVL_V_PSIZE]
  mov dword ptr [OVL_BOX+4], eax
  mov dword ptr [OVL_BOX+8], 0
  mov eax, [OVL_MX]
  add eax, 2
  mov dword ptr [OVL_BOX+0C], eax
  mov eax, [OVL_MY]
  add eax, [OVL_V_PSIZE]
  inc eax
  mov dword ptr [OVL_BOX+10], eax
  mov dword ptr [OVL_BOX+14], 1
  push 0
  push 0C                        // SrcRowPitch = 3*4
  push OVL_MBUF
  push OVL_BOX
  push 0
  push dword ptr [OVL_BACKBUF]
  call game+1B9B90
  add esp, 18
ovl_marker_done:
  popad
  popfd
  ret

// ---- seed digit entry (ported from Le02 v0.7.6 ovl_type_keys) ----------
// Z on the Seed row enters typing mode; digits 0-9 append; BACK divides by
// ten; ESC restores the old value.
ovl_type_keys:
  // ---- Z (5A) ----
  mov al, byte ptr [OVL_VKBUF+5A]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+4]
  mov byte ptr [OVL_PREV_KEYS+4], al
  cmp al, cl
  je ovl_type_z_done
  test al, al
  jz ovl_type_z_done
  call ovl_type_toggle
ovl_type_z_done:
  // ---- ESC (1B) ----
  mov al, byte ptr [OVL_VKBUF+1B]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+5]
  mov byte ptr [OVL_PREV_KEYS+5], al
  cmp al, cl
  je ovl_type_esc_done
  test al, al
  jz ovl_type_esc_done
  call ovl_type_cancel
ovl_type_esc_done:
  // ---- BACK (08) ----
  mov al, byte ptr [OVL_VKBUF+08]
  and al, 80
  mov cl, byte ptr [OVL_PREV_KEYS+6]
  mov byte ptr [OVL_PREV_KEYS+6], al
  cmp al, cl
  je ovl_type_back_done
  test al, al
  jz ovl_type_back_done
  cmp dword ptr [OVL_TYPE_ON], 0
  je ovl_type_back_done
  cmp dword ptr [OVL_TYPE_KIND], 0
  jne ovl_type_back_hex
  mov eax, [OVL_TYPE_VAL]
  mov ecx, [eax]
  xor edx, edx
  push eax
  mov eax, ecx
  mov ecx, 0A
  div ecx
  pop ecx
  mov [ecx], eax
  jmp ovl_type_back_done
ovl_type_back_hex:
  // Drop the last HEX digit: one nibble, counted from the left, so the six
  // digits read exactly like the RRGGBB you typed.
  mov eax, [OVL_TYPE_HEXN]
  test eax, eax
  jz ovl_type_back_done
  dec eax
  mov [OVL_TYPE_HEXN], eax
  mov ecx, 5
  sub ecx, eax
  shl ecx, 2
  mov edx, 0F
  shl edx, cl
  not edx
  mov eax, [OVL_TYPE_VAL]
  mov ecx, [eax]
  and ecx, edx
  mov [eax], ecx
ovl_type_back_done:
  // ---- digits ----
  cmp dword ptr [OVL_TYPE_ON], 0
  je ovl_type_digits_done
  // ebx tracks whether ANY digit is currently down.  Only when none is down
  // may OVL_TYPE_LAST be cleared: clearing it while a key is still held
  // makes the next call see a fresh press, which doubles every digit.
  xor ebx, ebx
  mov ecx, 30
ovl_type_digit_loop:
  movzx eax, byte ptr [OVL_VKBUF+ecx]
  and al, 80
  jz ovl_type_digit_next
  mov ebx, 1
  cmp ecx, [OVL_TYPE_LAST]
  je ovl_type_digit_next
  mov [OVL_TYPE_LAST], ecx
  mov edx, ecx
  cmp ecx, 3A
  jb ovl_td_num
  // 0x3A..0x40 are not digits at all; 0x41..0x46 are A..F and only count in
  // hex mode.  Either way the key is remembered as LAST so it cannot
  // retrigger, but the scan carries on rather than aborting.
  cmp dword ptr [OVL_TYPE_KIND], 0
  je ovl_type_digit_next
  cmp ecx, 41
  jb ovl_type_digit_next
  cmp ecx, 47
  jae ovl_type_digit_next
  sub edx, 37
  jmp ovl_td_have
ovl_td_num:
  sub edx, 30
ovl_td_have:
  inc dword ptr [TYPEDBG_DIGIT]
  cmp dword ptr [OVL_TYPE_KIND], 0
  jne ovl_td_hex
  call ovl_type_append
  jmp ovl_type_digits_done
ovl_td_hex:
  call ovl_type_append_hex
  jmp ovl_type_digits_done
ovl_type_digit_next:
  inc ecx
  cmp ecx, 47
  jl ovl_type_digit_loop
  test ebx, ebx
  jnz ovl_type_digits_done
  mov dword ptr [OVL_TYPE_LAST], 0
ovl_type_digits_done:
  ret

// Z.  Which row the cursor is on decides what it does, and EVERY case is
// decided from the row DESCRIPTOR -- its value pointer, or its min/max
// range -- never from a row INDEX.  Hard-coded indices are exactly what
// once made the Capture row render the Seed label and steal its digit
// entry in Le02, the moment rows were inserted above the seed rows.
ovl_type_toggle:
  cmp dword ptr [OVL_TYPE_ON], 0
  jne ovl_type_commit
  call ovl_row
  // On the MAIN table the Hint row is the door to the hint settings panel.
  // Inside the panel (OVL_SUB set) the same row is an ordinary 0..1 switch,
  // which is why this test comes before the range test and is the only place
  // the two tables behave differently.
  cmp dword ptr [OVL_SUB], 0
  jne ovl_type_t_notmain
  mov eax, OVL_V_HINT
  cmp [esi+4], eax
  jne ovl_type_t_notmain
  call ovl_sub_open
  ret
ovl_type_t_notmain:
  // The Speed row types a decimal number too.  Dispatch is by value pointer,
  // like every other row test; the seed row's "typing switches Lock Seed on"
  // side effect is keyed off OVL_V_SEED in ovl_type_commit, so it cannot leak
  // onto this row.
  mov eax, SPEED_FPS
  cmp [esi+4], eax
  je ovl_type_try_speed
  cmp dword ptr [esi+0C], 1
  jne ovl_type_try_seed
  cmp dword ptr [esi+8], 0
  jne ovl_type_try_seed
  mov eax, [esi+4]
  mov ecx, [eax]
  xor ecx, 1
  mov [eax], ecx
  ret
ovl_type_try_speed:
  inc dword ptr [TYPEDBG_ENTER]
  mov eax, [SPEED_FPS]
  mov [OVL_TYPE_OLD], eax
  mov dword ptr [OVL_TYPE_FRESH], 1
  mov dword ptr [OVL_TYPE_LAST], 0
  mov dword ptr [OVL_TYPE_ON], 1
  mov dword ptr [OVL_TYPE_KIND], 0
  // Clear the value up front, the way the hex rows do on their first nibble.
  // OVL_TYPE_FRESH alone was not enough: the row kept its old value and typing
  // "30" produced 6030 instead of 30.
  mov dword ptr [SPEED_FPS], 0
  mov eax, SPEED_FPS
  mov [OVL_TYPE_VAL], eax
  mov eax, TXT_OVL_SPEED
  mov [OVL_TYPE_ORIG], eax
  mov [OVL_TYPE_ROW], esi
  mov eax, TXT_OVL_SPEED
  mov [esi], eax
  ret

ovl_type_try_seed:
  mov eax, OVL_V_SEED
  cmp [esi+4], eax
  jne ovl_type_try_colour
  mov eax, [OVL_V_SEED]
  mov [OVL_TYPE_OLD], eax
  mov dword ptr [OVL_TYPE_FRESH], 1
  mov dword ptr [OVL_TYPE_LAST], 0
  mov dword ptr [OVL_TYPE_ON], 1
  mov dword ptr [OVL_TYPE_KIND], 0
  mov eax, OVL_V_SEED
  mov [OVL_TYPE_VAL], eax
  mov eax, TXT_OVL_SEED
  mov [OVL_TYPE_ORIG], eax
  mov [OVL_TYPE_ROW], esi
  mov eax, TXT_OVL_SEED_EDIT
  mov [esi], eax
  ret
// The two colour rows type a 6-digit hex value.  Which of them is decided
// from the value pointer, exactly like everything else here.
ovl_type_try_colour:
  call ovl_row_is_colour
  test eax, eax
  jz ovl_type_try_capture
  mov eax, [esi+4]
  mov [OVL_TYPE_VAL], eax
  mov eax, [eax]
  mov [OVL_TYPE_OLD], eax
  mov dword ptr [OVL_TYPE_LAST], 0
  mov dword ptr [OVL_TYPE_HEXN], 0
  mov dword ptr [OVL_TYPE_ON], 1
  mov dword ptr [OVL_TYPE_KIND], 1
  mov eax, [esi]
  mov [OVL_TYPE_ORIG], eax
  mov [OVL_TYPE_ROW], esi
  mov ecx, [esi+4]
  mov eax, OVL_V_PCOL
  cmp ecx, eax
  mov eax, TXT_OVL_HINTCOL_EDIT
  jne ovl_type_colour_set
  mov eax, TXT_OVL_PCOL_EDIT
ovl_type_colour_set:
  mov [esi], eax
  ret
ovl_type_try_capture:
  // Z on the Capture row writes the current spot into <stage>.txt
  mov eax, OVL_V_CAPTURE
  cmp [esi+4], eax
  jne ovl_type_toggle_done
  call hint_capture
  cmp dword ptr [HINT_CAP_OK], 0
  je ovl_type_toggle_done
  inc dword ptr [OVL_V_CAPTURE]
  ret

ovl_type_commit:
  // Committing a hand-typed seed switches the lock on -- you typed it, so
  // you want it used -- and arms the edge detector so the Lock Seed row
  // does not immediately grab the current seed over the top of it.  (To grab
  // instead, toggle Lock Seed off and on again.)  A typed COLOUR has no such
  // side effect, so it just exits.
  // Confirming an untouched Speed entry must not leave 0 behind (the value is
  // cleared when typing starts), so put the old speed back in that case.
  mov eax, [OVL_TYPE_VAL]
  cmp eax, SPEED_FPS
  jne ovl_tc_not_speed
  cmp dword ptr [SPEED_FPS], 0
  jne ovl_tc_not_speed
  mov ecx, [OVL_TYPE_OLD]
  mov [SPEED_FPS], ecx
ovl_tc_not_speed:
  mov eax, [OVL_TYPE_VAL]
  cmp eax, OVL_V_SEED
  jne ovl_type_exit
  mov dword ptr [OVL_V_LOCKSEED], 1
  mov dword ptr [OVL_PREV_SEEDSW], 1
ovl_type_exit:
  mov dword ptr [OVL_TYPE_ON], 0
  mov dword ptr [OVL_TYPE_LAST], 0
  mov ecx, [OVL_TYPE_ROW]
  test ecx, ecx
  jz ovl_type_toggle_done
  mov eax, [OVL_TYPE_ORIG]
  test eax, eax
  jz ovl_type_toggle_done
  mov [ecx], eax
ovl_type_toggle_done:
  ret

ovl_type_cancel:
  cmp dword ptr [OVL_TYPE_ON], 0
  jne ovl_type_cancel_do
  // Not typing: ESC backs out of the hint settings panel.
  mov dword ptr [OVL_SUB], 0
  call ovl_set_active
  jmp ovl_type_cancel_done
ovl_type_cancel_do:
  mov eax, [OVL_TYPE_VAL]
  test eax, eax
  jz ovl_type_exit
  mov ecx, [OVL_TYPE_OLD]
  mov [eax], ecx
  jmp ovl_type_exit
ovl_type_cancel_done:
  ret

// edx = the digit (0..9).  Append to the value behind OVL_TYPE_VAL, clamped.
// The first digit after entering typing mode replaces the old value, so a
// previous seed does not have to be backspaced away first.
ovl_type_append:
  mov eax, [OVL_TYPE_VAL]
  cmp dword ptr [OVL_TYPE_FRESH], 0
  je ovl_type_app_shift
  mov dword ptr [OVL_TYPE_FRESH], 0
  mov [eax], edx
  ret
ovl_type_app_shift:
  mov ecx, [eax]
  cmp ecx, 19999999
  ja ovl_type_app_done
  jne ovl_type_app_room
  cmp edx, 5
  ja ovl_type_app_done
ovl_type_app_room:
  imul ecx, ecx, 0A
  add ecx, edx
  mov [eax], ecx
ovl_type_app_done:
  ret

// edx = the hex digit (0..15).  The digits fill the value from the LEFT, so
// typing F, F, 0, 0, 0, 0 reads "FF0000" the whole way rather than sliding
// right; that is the whole reason for the nibble counter.
ovl_type_append_hex:
  mov ecx, [OVL_TYPE_HEXN]
  cmp ecx, 6
  jae ovl_type_apph_done
  test ecx, ecx
  jnz ovl_type_apph_shift
  mov eax, [OVL_TYPE_VAL]
  mov dword ptr [eax], 0
ovl_type_apph_shift:
  mov eax, 5
  sub eax, ecx
  shl eax, 2
  mov ecx, eax
  shl edx, cl
  mov eax, [OVL_TYPE_VAL]
  mov ecx, [eax]
  or ecx, edx
  mov [eax], ecx
  inc dword ptr [OVL_TYPE_HEXN]
ovl_type_apph_done:
  ret

// ---- ovl_swallow: hide the keyboard from the game while the menu is open
// Entered from the 5-byte `jmp` that replaced `push 0x100` at 0x56DEB8, so
// EBP is still the game's frame pointer and the raw keyboard buffer is at
// [ebp-0x104].  The displaced instruction is re-issued before rejoining.
ovl_swallow:
  pushfd
  pushad
  cmp dword ptr [OVERLAY_OPEN], 0
  je ovl_swallow_done
  mov edi, ebp
  sub edi, 104
  xor eax, eax
  mov ecx, 40
ovl_swallow_clr:
  mov [edi], eax
  add edi, 4
  dec ecx
  jnz ovl_swallow_clr
ovl_swallow_done:
  popad
  popfd
  push 100
  jmp game+16DEBD

ovl_panel_draw:
  pushfd
  pushad
  inc dword ptr [OVL_HITS]
  // Resolve the live row table first: the height, the row loop and the
  // swatches all read through OVL_ACTIVE_*, and OVL_SUB may have flipped
  // since ovl_input ran.
  call ovl_set_active
  call ovl_measure
  // Count the visible rows first: the panel height and the row layout both key
  // off it, so hidden rows must not reserve a slot.
  mov dword ptr [OVL_VISN], 0
  mov edi, [OVL_ACTIVE_N]
  mov esi, [OVL_ACTIVE_FLAG]
  xor eax, eax
ovl_vis_l:
  cmp eax, edi
  jge ovl_vis_done
  movzx ebx, byte ptr [esi+eax]
  test ebx, 1
  jz ovl_vis_cnt
  cmp dword ptr [CFG_DEVMODE], 0
  jne ovl_vis_cnt
  jmp ovl_vis_next
ovl_vis_cnt:
  inc dword ptr [OVL_VISN]
ovl_vis_next:
  inc eax
  jmp ovl_vis_l
ovl_vis_done:

  // Panel height (logical) = 0x28 + ACTIVE_N*0x10: first row at 40, 16 units
  // per row, and v0.7.6 leaves only ~3 units below the last row.  Stashed in
  // OVL_RY, which the row loop overwrites later.
  mov eax, [OVL_VISN]
  imul eax, eax, 10
  add eax, 30
  mov [OVL_RY], eax

  // ---- render into an OFFSCREEN DIB, then blit once ----------------------
  // Drawing straight onto the screen DC is far too slow for GDI rendering
  // (the game fell to ~3 fps) and its Rectangle fills get batched separately
  // from TextOutW, which hid the text.  Rendering into a memory DIB fixes
  // both, and the final SetDIBitsToDevice blit is the same call the game
  // itself uses to put its frame on screen.
  mov eax, 10
  call ovl_sx
  mov [OVL_PX], eax              // panel origin, physical screen px
  mov eax, 10
  call ovl_sy
  mov [OVL_PY], eax
  mov eax, F0                    // 240
  call ovl_sx
  sub eax, [OVL_PX]
  mov [OVL_PW], eax              // panel width
  mov eax, [OVL_RY]
  call ovl_sy
  sub eax, [OVL_PY]
  mov [OVL_PH], eax              // panel height

  push dword ptr [OVL_PH]
  push dword ptr [OVL_PW]
  call ovl_dib_ensure
  add esp, 8
  cmp dword ptr [OVL_MEMDC], 0
  je ovl_panel_done

  // Draw with coordinates relative to the panel's own top-left corner.
  mov eax, [OVL_PX]
  neg eax
  mov [OVL_OX], eax
  mov eax, [OVL_PY]
  neg eax
  mov [OVL_OY], eax
  mov ebx, [OVL_MEMDC]
  call ovl_mkfont                // select our UI font into the memory DC

  // ---- black body ----
  // Written straight into the DIB bits, NOT via CreateSolidBrush+Rectangle.
  // GDI batches Rectangle() but runs TextOutW() immediately, and the batch is
  // only executed at the trailing GdiFlush -- i.e. after the text -- so any
  // GDI fill here would wipe the text out.  A direct write cannot be
  // reordered.  (The border uses ovl_rect_bits for the same reason.)
  push 0
  call ovl_clear_dib
  add esp, 4
  // ---- blue border ----
  // The backbuffer is DXGI_FORMAT_R8G8B8A8_UNORM (byte0 = R) while a GDI
  // 32bpp DIB stores byte0 = B, so every colour literal here is written as
  // (R<<16)|(G<<8)|B -- i.e. the RGB triple as a plain hex number.
  push FF                        // RGB(0,0,255)
  push F0
  push dword ptr [OVL_RY]
  push 10
  push 10
  call ovl_frame_s
  add esp, 14
  // Sync GDI before the first text draw.  The border is written straight into
  // the DIB bits (ovl_rect_bits) and, until GDI is flushed, the following
  // TextOutW calls do not land in that DIB at all -- the panel then shows up
  // as an empty black box with only the border visible.
  call ovl_flush
  // ---- title (ovl_text draws its own drop shadow) ----
  // The hint settings panel gets its own title, so the two menus are never
  // confused for one another.
  mov eax, TXT_OVL_TITLE
  cmp dword ptr [OVL_SUB], 0
  je ovl_title_pick
  mov eax, TXT_OVL_TITLE2
ovl_title_pick:
  push FFFFA0                    // pale yellow RGB(255,255,160)
  push 18                        // logical x = 24
  push 18                        // logical y = 24
  push eax
  call ovl_text_s
  add esp, 10
  // ---- rows ----
  mov dword ptr [OVL_RCUR], 0
  mov dword ptr [OVL_RVIS], 0
ovl_draw_row:
  mov eax, [OVL_RCUR]
  cmp eax, [OVL_ACTIVE_N]
  jge ovl_panel_done
  // skip developer-only rows when devmode is off.
  // NOTE: must NOT touch ebx here -- the GDI draws below keep the memory DC in
  // ebx, and clobbering it silently sends every row to the wrong DC (the panel
  // renders empty with no error).
  mov ecx, [OVL_ACTIVE_FLAG]
  movzx edx, byte ptr [ecx+eax]
  test edx, 1
  jz ovl_draw_vis
  cmp dword ptr [CFG_DEVMODE], 0
  jne ovl_draw_vis
  jmp ovl_draw_next
ovl_draw_vis:
  // OVL_RPTR = ACTIVE_TBL + row*18h
  mov eax, [OVL_RCUR]
  imul eax, eax, 18
  add eax, [OVL_ACTIVE_TBL]
  mov [OVL_RPTR], eax
  // OVL_RY = 28h + VISIBLE row index*10h  (logical) -> 40 + n*16
  mov eax, [OVL_RVIS]
  imul eax, eax, 10
  add eax, 28
  mov [OVL_RY], eax

  // ---- label: always this row's own label string ----
  mov esi, [OVL_RPTR]
  mov eax, [esi]
  mov [OVL_RTXT], eax
  // ---- value: a 0/1 row renders its ALT word ("OFF"/"ON"), a colour row
  //      renders six hex digits, everything else renders decimal.  Le02
  //      folded these into one printf format string; GDI cannot format, so
  //      they are separate.  The colour case is recognised by the SWATCH
  //      array being non-zero, i.e. from the row DESCRIPTOR, never an index.
  mov ecx, [OVL_ACTIVE_ALT]
  mov eax, [OVL_RCUR]
  mov eax, [ecx+eax*4]
  test eax, eax
  jz ovl_val_colour_chk
  mov esi, [OVL_RPTR]
  mov ecx, [esi+4]
  mov ecx, [ecx]
  and ecx, 1
  mov eax, [eax+ecx*4]
  mov [OVL_RVAL], eax
  jmp ovl_val_done
ovl_val_colour_chk:
  mov ecx, [OVL_ACTIVE_SW]
  mov eax, [OVL_RCUR]
  cmp dword ptr [ecx+eax*4], 0
  je ovl_val_num
  mov esi, [OVL_RPTR]
  mov eax, [esi+4]
  push dword ptr [eax]
  call ovl_hextext               // eax = "RRGGBB"
  add esp, 4
  mov [OVL_RVAL], eax
  jmp ovl_val_done
ovl_val_num:
  mov esi, [OVL_RPTR]
  mov eax, [esi+4]
  push dword ptr [eax]
  call ovl_numtext               // eax = formatted value string ptr
  add esp, 4
  mov [OVL_RVAL], eax
ovl_val_done:

  // --- text colour: saturated yellow when selected, pale yellow otherwise.
  //     v0.7.6 has NO highlight bar -- the selection is shown by the colour.
  mov eax, [OVL_RCUR]
  call ovl_rowcolor
  mov [OVL_RCOL], eax
  push eax
  push 18                        // logical x = 24
  push dword ptr [OVL_RY]
  push dword ptr [OVL_RTXT]
  call ovl_text_s                // scaled
  add esp, 10
  // --- value: left-aligned in a column at logical x = 78 (120) ---
  push dword ptr [OVL_RCOL]
  push 78                        // logical value column = 120
  push dword ptr [OVL_RY]
  push dword ptr [OVL_RVAL]
  call ovl_text_s                // scaled
  add esp, 10
  // ---- colour swatch: a filled box at the right-hand end of a colour row,
  //      so the colour is obvious no matter how the six hex digits read.
  //      A DIRECT DIB write, for the reason given on ovl_rect_bits -- a GDI
  //      fill would be reordered to after the text and wipe it out.
  mov ecx, [OVL_ACTIVE_SW]
  mov eax, [OVL_RCUR]
  mov ecx, [ecx+eax*4]
  test ecx, ecx
  jz ovl_sw_done
  mov ecx, [ecx]
  mov [OVL_PC_COL], ecx
  mov eax, [OVL_RY]
  add eax, 2
  call ovl_sy
  mov [OVL_BOX], eax             // top
  mov eax, [OVL_SWX]
  call ovl_sx
  mov [OVL_BOX+4], eax           // left
  mov eax, [OVL_RY]
  add eax, 0C
  call ovl_sy
  mov [OVL_BOX+8], eax           // bottom
  mov eax, [OVL_SWX]
  add eax, 0C
  call ovl_sx
  mov [OVL_BOX+0C], eax          // right
  push dword ptr [OVL_PC_COL]
  push dword ptr [OVL_BOX+0C]
  push dword ptr [OVL_BOX+8]
  push dword ptr [OVL_BOX+4]
  push dword ptr [OVL_BOX]
  call ovl_swatch_rect
  add esp, 14
ovl_sw_done:

  inc dword ptr [OVL_RVIS]
ovl_draw_next:
  inc dword ptr [OVL_RCUR]
  jmp ovl_draw_row
ovl_panel_done:
  call ovl_rmfont                // put the DC's old font back
  call ovl_flush                 // make sure the DIB's pixels are final
  // No blit here any more: the caller (ovl_d3d11_composite) uploads this DIB
  // into the game's backbuffer.  The old SetDIBitsToDevice to the desktop DC
  // produced something that was not part of the game frame.
  popad
  popfd
  ret

// ---- ovl_dib_ensure: make the offscreen panel DIB match (w,h) -----------
// args: (w, h) in physical pixels.  Recreates the DIB if the size changed.
ovl_dib_ensure:
  push ebp
  mov ebp, esp
  sub esp, 10
  pushad
  // The DIB only needs a GDI DC to be created against; a transient screen DC
  // is fine and is released again before returning.
  push 0
  call dword ptr [7D9358]        // GetDC(0)
  mov [ebp-4], eax
  test eax, eax
  jz ovl_dib_done
  cmp dword ptr [OVL_MEMDC], 0
  je ovl_dib_make
  mov eax, [ebp+8]
  cmp eax, [OVL_DIBW]
  jne ovl_dib_free
  mov eax, [ebp+0C]
  cmp eax, [OVL_DIBH]
  je ovl_dib_done
ovl_dib_free:
  push dword ptr [OVL_OLDBMP]
  push dword ptr [OVL_MEMDC]
  call dword ptr [7D9014]        // SelectObject(memdc, old bitmap)
  push dword ptr [OVL_DIB]
  call dword ptr [7D9010]        // DeleteObject(dib)
  push dword ptr [OVL_MEMDC]
  call dword ptr [7D900C]        // DeleteDC(memdc)
  mov dword ptr [OVL_MEMDC], 0
ovl_dib_make:
  mov eax, [ebp+8]
  mov [OVL_BMI+4], eax           // biWidth
  mov eax, [ebp+0C]
  neg eax
  mov [OVL_BMI+8], eax           // biHeight (negative = top-down)
  push dword ptr [ebp-4]
  call dword ptr [7D9008]        // CreateCompatibleDC(screen DC)
  mov [OVL_MEMDC], eax
  push 0                         // dwOffset
  push 0                         // hSection
  push OVL_BITS                  // &ppvBits
  push 0                         // usage = DIB_RGB_COLORS
  push OVL_BMI                   // &bmi
  push dword ptr [ebp-4]         // hdc
  call dword ptr [7D9020]        // CreateDIBSection
  mov [OVL_DIB], eax
  push eax
  push dword ptr [OVL_MEMDC]
  call dword ptr [7D9014]        // SelectObject(memdc, dib)
  mov [OVL_OLDBMP], eax
  mov eax, [ebp+8]
  mov [OVL_DIBW], eax
  mov eax, [ebp+0C]
  mov [OVL_DIBH], eax
ovl_dib_done:
  push dword ptr [ebp-4]
  push 0
  call dword ptr [7D9354]        // ReleaseDC(0, dc)
  popad
  mov esp, ebp
  pop ebp
  ret

// ---- ovl_clear_dib: fill the panel DIB with one 32-bit colour ----------
// args: (colour).  Writes the DIB bits directly; see the note in
// ovl_panel_draw about why the GDI fill had to go.
ovl_clear_dib:
  push ebp
  mov ebp, esp
  pushad
  mov edi, [OVL_BITS]
  test edi, edi
  jz ovl_clear_done
  mov ecx, [OVL_PW]
  imul ecx, [OVL_PH]
  jle ovl_clear_done
  mov eax, [ebp+8]
  cld
  db F3 AB                       // rep stosd (keystone rejects rep prefixes)
ovl_clear_done:
  popad
  pop ebp
  ret

// ---- seed lock (ported verbatim from Le02 v0.7.6 seed_hook) -----------
// Entered via `call` from game+D8D9B.  On entry [esp] = return address and
// [esp+4] = the seed the game pushed.  That stack slot is deliberately NOT
// rewritten: we push our own value for the wrapper call instead, so the
// caller's frame is never touched (the game's own `add esp,4` at 0xD8DA6
// still pops its stale argument).
//
// Registers are saved one at a time rather than with pushad, because the
// caller's EDI must stay LIVE for the [edi+0x40] write -- reading it out of
// a pushad slot depends on slot order, and getting that wrong writes the
// seed to an arbitrary address.
//
// NOTE every literal is HEX.  pushfd plus the five pushes below cover
// 6*4 = 24 bytes, so the game's argument -- which is at [esp+4] on entry --
// ends up at [esp+1C] (that is 28 DECIMAL).  Writing `28` here means 0x28 = 40
// and reads the stale dword 12 bytes ABOVE the argument instead, which seeds
// the RNG with something that is NOT the game's seed.  That silently breaks
// replay determinism (the recording used the real seed, playback does not),
// so the offset below must stay 1C.
seed_hook:
  pushfd
  push eax
  push ecx
  push edx
  push esi
  push edi
  mov eax, [esp+1C]
  // ---- Z Replay: a replay can only reproduce a run if it starts from the SAME
  //      RNG seed, and the game re-seeds randomly at every stage entry.  So a
  //      recording stores the seed it was played with, and a playback forces
  //      that seed instead of the live one.  (This is why every test failed at
  //      the earliest comparable frame: the two runs had different seeds.)
  //      The existing Lock Seed switch does the same thing via OVL_V_SEED, but
  //      going through it here would overwrite the user's menu settings.
  cmp dword ptr [ZREP_MODE], 2
  jne zrep_seed_rec
  mov eax, [ZREP_SEED]
  mov dword ptr [edi+40], eax
  jmp seed_hook_used
zrep_seed_rec:
  cmp dword ptr [ZREP_MODE], 1
  jne zrep_seed_none
  mov [ZREP_SEED], eax
zrep_seed_none:
  cmp dword ptr [OVL_V_LOCKSEED], 0
  je seed_hook_used
  mov eax, [OVL_V_SEED]
  mov dword ptr [edi+40], eax
seed_hook_used:
  mov [SEED_USED], eax
  push eax
  call game+FBFC0
  add esp, 4
  pop edi
  pop esi
  pop edx
  pop ecx
  pop eax
  popfd
  xor eax, eax
  ret

// ===================== Z Replay (P1 MVP) ================================
// Records the per-frame logical key mask plus a 4-byte FNV-1a fingerprint of
// the game state, and plays it back.  F9 toggles recording, F10 replays.
// Red line: never desync -- on the first fingerprint mismatch playback stops
// and ZREP_BAD / ZREP_ERRS record exactly where.
//
// L1 (the patch must be invisible to the simulation): everything below runs at
// ONE well-defined point per logic frame (the live input source), touches only
// cave memory, does no file I/O and calls nothing in the game except the
// original call it replaces.  The only new work on the sim path is the
// fingerprint, a few dozen instructions.
//
// Record layout (6 bytes): +0 u16 key mask, +2 u32 fingerprint.
zrep_kbd_hook:
  pushfd
  push eax
  push ecx
  push edx
  push edi
  // Diagnostic: force DIK_RIGHT for recorded frames [300,420) only.  Forcing it
  // from frame 0 crashed the game -- the player is then pushed around during
  // the stage intro.  Kept because it is the cheapest way to prove that writing
  // this array is what drives the player.
  cmp dword ptr [ZREP_FORCE], 0
  je zrep_kh_noforce
  mov eax, [ZREP_RECN]
  cmp eax, 12C
  jb zrep_kh_noforce
  cmp eax, 1A4
  jae zrep_kh_noforce
  mov byte ptr [game+60FB8C+CD], 80
  cmp dword ptr [ZREP_FORCE], 1
  je zrep_kh_noforce
  mov byte ptr [game+60FB8C+2C], 80
zrep_kh_noforce:
  // diagnostic: how many keys does the array hold right now?
  mov esi, game+60FB8C
  xor ecx, ecx
  xor edx, edx
zrep_cnt_l:
  cmp byte ptr [esi + ecx], 0
  je zrep_cnt_n
  inc edx
zrep_cnt_n:
  inc ecx
  cmp ecx, 100
  jb zrep_cnt_l
  mov dword ptr [ZREP_NKEYS], edx
  cmp dword ptr [ZREP_STARTED], 0
  je zrep_kh_done
  // Never touch the game while it is paused or playing its own replay.
  cmp byte ptr [game+B0A520], 0
  jne zrep_kh_done
  cmp byte ptr [game+B0457D], 0
  jne zrep_kh_done
  cmp dword ptr [ZREP_MODE], 1
  je zrep_kh_record
  cmp dword ptr [ZREP_MODE], 2
  jne zrep_kh_done
  // ---- playback: put the recorded keys into the game's own array ---------
  mov edx, [ZREP_PLAYN]
  cmp edx, [ZREP_CNT]
  jae zrep_kh_done
  imul edx, edx, 6
  add edx, ZREP_BUF
  movzx edi, word ptr [edx]           // the recorded 16-bit key mask
  cmp dword ptr [ZREP_OVR], 0
  je zrep_ovr_skip
  mov edi, [ZREP_OVR]
zrep_ovr_skip:
  // diagnostic: when the mask differs from the previous frame, this frame is a
  // transition.  With ZREP_SKIPTR set we drop it instead of comparing it.
  // Compare straight against the cave variable: NO temporary register, because
  // edx still holds the mask that the original code stores into ZREP_LASTM a few
  // instructions below.  (Clobbering edx here killed the game.)
  // On a skipped frame LASTM is still updated, otherwise every later frame also
  // looks like a transition and the playback freezes.
  cmp dword ptr [ZREP_SKIPTR], 0
  je zrep_tr_keep
  cmp dword ptr [ZREP_LASTM], edi
  je zrep_tr_keep
  mov dword ptr [ZREP_LASTM], edi
  jmp zrep_ih_done
zrep_tr_keep:
  // ---- release EVERY key first: the array must reflect the recording exactly.
  //      Without this the playback keeps keys the recording never had (measured:
  //      8 non-zero bytes vs 6), and the same mask produced a diagonal move.
  xor ecx, ecx
zrep_kh_clr:
  and byte ptr [game+60FB8C+ecx], 7F
  inc ecx
  cmp ecx, 100
  jb zrep_kh_clr
  xor ecx, ecx
  mov esi, ZREP_KEYS                // player 1's 16 DIK bindings
zrep_kh_pl:
  mov eax, [esi + ecx*4]
  test eax, eax
  jz zrep_kh_pn
  cmp eax, 100                        // DIK codes are below 0x100
  jae zrep_kh_pn
  mov dl, 0
  bt edi, ecx
  jnc zrep_kh_pw
  mov dl, 80
zrep_kh_pw:
  mov byte ptr [eax + game+60FB8C], dl
zrep_kh_pn:
  inc ecx
  cmp ecx, 10
  jb zrep_kh_pl
  jmp zrep_kh_done
  // ---- record: read the keys out of the game's own array ----------------
zrep_kh_record:
  mov edi, [ZREP_RECN]
  cmp edi, [ZREP_MAX]
  jae zrep_kh_done
  xor eax, eax                        // mask being built
  xor ecx, ecx
  mov esi, ZREP_KEYS
zrep_kh_rl:
  mov edx, [esi + ecx*4]
  test edx, edx
  jz zrep_kh_rn
  cmp edx, 100
  jae zrep_kh_rn
  test byte ptr [edx + game+60FB8C], 80
  jz zrep_kh_rn
  mov edi, 1
  shl edi, cl
  or eax, edi
zrep_kh_rn:
  inc ecx
  cmp ecx, 10
  jb zrep_kh_rl
  // Store it in this frame's record slot.  The input hook writes the
  // fingerprint into the same slot and must NOT overwrite these two bytes.
  movzx edx, ax
  mov dword ptr [ZREP_LASTM], edx
  mov edi, [ZREP_RECN]
  imul edi, edi, 6
  add edi, ZREP_BUF
  mov word ptr [edi], ax
zrep_kh_done:
  pop edi
  pop edx
  pop ecx
  pop eax
  popfd
  mov esi, 1                          // the instruction this hook replaced
  jmp game+16DF47

zrep_rng_hook:
  inc dword ptr [ZREP_RNGC]
  mov eax, 9908B0DF
  jmp game+214CE8

zrep_input_hook:
  pushfd
  push ebx
  push ecx
  push edx
  push esi
  push edi

  // reproduce the original call: push ebx(1) ; call 0x4FADE0 ; add esp,4
  push 1
  call game+FADE0
  add esp, 4
  // diagnostic: did 0x4FADE0 ever report a key?
  or dword ptr [ZREP_MASKOR], eax
  test eax, eax
  jz zrep_mo_skip
  inc dword ptr [ZREP_MASKON]
zrep_mo_skip:
  // diagnostic: OR the game's own 256-byte key-state array into ZREP_KBDOR.
  // 0x40 = 64 dwords = 256 bytes.  eax is the frame's mask and must survive.
  push eax
  mov esi, game+60FB8C
  mov edi, ZREP_KBDOR
  mov ecx, 40
zrep_kbdor_l:
  mov eax, [esi]
  or dword ptr [edi], eax
  add esi, 4
  add edi, 4
  dec ecx
  jnz zrep_kbdor_l
  pop eax
  // eax = this frame's logical key mask: the thing we record / inject.
  //
  // ---- segment start ---------------------------------------------------
  // initFrameTimer sets ZREP_SEG_NEW at every stage start; consume it here, on
  // the next frame, so both a recording and a playback begin on the same frame.
  cmp dword ptr [ZREP_SEG_NEW], 0
  je zrep_seg_done
  mov dword ptr [ZREP_SEG_NEW], 0
  // ---- debug: what was [stage+0x4C] at the moment the segment started? ----
  // (recorded at the COMMIT below, not here)
  mov dword ptr [ZREP_SEG_PEND], 1
zrep_seg_done:
  // ---- hotkeys: F9 = record on/off, F10 = replay from the start --------
  // Read from the overlay's GetKeyboardState copy, so no extra API call.
  mov dl, byte ptr [OVL_VKBUF+78]
  and dl, 80
  mov cl, byte ptr [ZREP_PREV]
  mov byte ptr [ZREP_PREV], dl
  cmp dl, cl
  je zrep_hk_f10
  test dl, dl
  jz zrep_hk_f10
  cmp dword ptr [ZREP_MODE], 1
  je zrep_hk_f9_stop
  // arm: start a fresh stream, and wait for the NEXT stage start before
  // recording anything (so record and playback share an initial state)
  mov dword ptr [ZREP_MODE], 1
  mov dword ptr [ZREP_STARTED], 0
  mov dword ptr [ZREP_RECN], 0
  mov dword ptr [ZREP_CNT], 0
  mov dword ptr [ZREP_ERRS], 0
  mov eax, [OVL_STAGE]
  cmp eax, 10000
  jb zrep_hk_f10
  cmp eax, 7FFF0000
  ja zrep_hk_f10
  mov eax, [eax+4C]
  mov [ZREP_LASTF], eax
  jmp zrep_hk_f10
zrep_hk_f9_stop:
  mov dword ptr [ZREP_MODE], 0
  mov ecx, [ZREP_RECN]
  mov dword ptr [ZREP_CNT], ecx
zrep_hk_f10:
  mov dl, byte ptr [OVL_VKBUF+79]
  and dl, 80
  mov cl, byte ptr [ZREP_PREV+1]
  mov byte ptr [ZREP_PREV+1], dl
  cmp dl, cl
  je zrep_hk_done
  test dl, dl
  jz zrep_hk_done
  cmp dword ptr [ZREP_CNT], 0
  je zrep_hk_done
  // arm playback; the stream starts consuming at the next stage start
  mov dword ptr [ZREP_MODE], 2
  mov dword ptr [ZREP_STARTED], 0
  mov dword ptr [ZREP_PLAYN], 0
  mov dword ptr [ZREP_ERRS], 0
  mov eax, [OVL_STAGE]
  cmp eax, 10000
  jb zrep_hk_done
  cmp eax, 7FFF0000
  ja zrep_hk_done
  mov eax, [eax+4C]
  mov [ZREP_LASTF], eax
zrep_hk_done:
  // ---- mode dispatch ---------------------------------------------------
  cmp dword ptr [ZREP_MODE], 0
  je zrep_ih_done
  // Never touch the game while ITS OWN replay or attract demo is playing back,
  // and never record or consume while the pause menu is open: the pause menu
  // still comes through this code path, so without this the paused frames
  // would be recorded and the stream would shift (plan-zreplay.md 6.2).
  cmp byte ptr [game+B0A520], 0
  jne zrep_ih_done
  cmp byte ptr [game+B0457D], 0
  jne zrep_ih_done
  // ---- commit a pending segment start ----------------------------------
  // Done HERE, past the gates, not back at the marker.  The first frame either
  // side actually consumes has to be the first frame these gates let through;
  // committing at the marker made the playback start 8 frames late (measured:
  // chapter 0 for the recording vs 8 for the playback), which offset the whole
  // stream so every later comparison was against the wrong record.
  cmp dword ptr [ZREP_SEG_PEND], 0
  je zrep_seg_committed
  mov dword ptr [ZREP_SEG_PEND], 0
  // Every stage construction starts a new segment.  This used to be guarded by
  // "only before we have started", which meant an ESC/R restart mid-recording
  // did NOT reset the stream: the recording then began at chapter 485 while the
  // playback began at chapter 0, and frame 0 differed by construction.
  mov edx, [OVL_STAGE]
  cmp edx, 10000
  jb zrep_seg_c2
  cmp edx, 7FFF0000
  ja zrep_seg_c2
  mov edx, [edx+4C]
  cmp dword ptr [ZREP_MODE], 1
  jne zrep_seg_cp
  mov dword ptr [ZREP_SEGAT_R], edx
  jmp zrep_seg_c2
zrep_seg_cp:
  mov dword ptr [ZREP_SEGAT_P], edx
zrep_seg_c2:
  // Only RECORDING may clear the buffers: in playback mode RECN/CNT hold the
  // recording we are about to consume.
  cmp dword ptr [ZREP_MODE], 1
  jne zrep_seg_cp2
  mov dword ptr [ZREP_RECN], 0
  mov dword ptr [ZREP_CNT], 0
zrep_seg_cp2:
  mov dword ptr [ZREP_PLAYN], 0
  mov dword ptr [ZREP_RNGC], 0
  mov dword ptr [ZREP_MASKOR], 0
  mov dword ptr [ZREP_MASKON], 0
  mov dword ptr [ZREP_STARTED], 1
zrep_seg_committed:
  cmp dword ptr [ZREP_STARTED], 0
  je zrep_ih_done
  // ---- warm-up: wait until the stage object exists and has settled --------
  push eax
  mov eax, [OVL_STAGE]
  cmp eax, 10000
  jb zrep_warm_no
  cmp eax, 7FFF0000
  ja zrep_warm_no
  mov eax, [eax+4C]
  cmp eax, [ZREP_WARM]
  jb zrep_warm_no
  // the player must actually be spawned: during the frames right after a
  // restart the object exists but lives is still 0, and comparing from there
  // measured lives 3 vs 0 -- a start-state difference that poisoned everything.
  mov eax, [OVL_PLAYER]
  cmp eax, 10000
  jb zrep_warm_no
  cmp eax, 7FFF0000
  ja zrep_warm_no
  cmp dword ptr [eax+48], 0
  je zrep_warm_no
  pop eax
  jmp zrep_warm_yes
zrep_warm_no:
  pop eax
  jmp zrep_ih_done
zrep_warm_yes:
  cmp dword ptr [ZREP_MODE], 1
  je zrep_ih_record
  // ---- playback --------------------------------------------------------
  mov ecx, [ZREP_PLAYN]
  cmp ecx, [ZREP_CNT]
  jae zrep_ih_done
  imul ecx, ecx, 6
  add ecx, ZREP_BUF
  movzx edx, word ptr [ecx]
  push ecx
  push edx
  // ---- debug field capture, frames [ZREP_DBG_FROM, +32) ----
  mov ecx, [ZREP_PLAYN]
  mov eax, ecx
  sub eax, [ZREP_DBG_FROM]
  cmp eax, 60
  jae zrep_dbg_p_done
  shl eax, 6
  add eax, ZREP_DBG_P
  mov dword ptr [ZREP_DBG_PTR], eax
  mov dword ptr [ZREP_DBG_N], 0
  mov dword ptr [ZREP_DBG_ON], 1
  // slot 13 = the mask the keyboard hook built or injected this frame
  mov ecx, [ZREP_DBG_PTR]
  // (the mask/nkeys debug slots are gone: the walk now fills slots 0..14)
zrep_dbg_p_done:
  call zrep_fingerprint
  mov dword ptr [ZREP_DBG_ON], 0
  pop edx
  pop ecx
  cmp dword ptr [ZREP_FPV], 0
  je zrep_ih_done
  cmp eax, [ecx+2]
  je zrep_ih_play_ok
  // ---- MISMATCH ---------------------------------------------------------
  // Default: stop loudly on the first one (the red line).  ZREP_SOFT is a
  // diagnostic that keeps going so the frames after the divergence stay
  // observable; it never ships.
  cmp dword ptr [ZREP_SOFT], 0
  jne zrep_soft_path
  inc dword ptr [ZREP_ERRS]
  mov eax, [ZREP_PLAYN]
  mov dword ptr [ZREP_BAD], eax
  mov dword ptr [ZREP_MODE], 0
  mov eax, edx
  jmp zrep_ih_done
zrep_soft_path:
  inc dword ptr [ZREP_ERRS]
  cmp dword ptr [ZREP_BAD], -1
  jne zrep_soft_go
  mov eax, [ZREP_PLAYN]
  mov dword ptr [ZREP_BAD], eax
zrep_soft_go:
  inc dword ptr [ZREP_PLAYN]
  mov eax, edx
  jmp zrep_ih_done
zrep_ih_play_ok:
  inc dword ptr [ZREP_PLAYN]
  mov eax, edx                         // inject the recorded mask
  jmp zrep_ih_done
  // ---- record ----------------------------------------------------------
zrep_ih_record:
  mov ecx, [ZREP_RECN]
  cmp ecx, [ZREP_MAX]
  jae zrep_ih_rec_full
  // ---- debug field capture, frames [ZREP_DBG_FROM, +32) ----
  mov edx, ecx
  sub edx, [ZREP_DBG_FROM]
  cmp edx, 60
  jae zrep_dbg_r_done
  shl edx, 6
  add edx, ZREP_DBG_R
  mov dword ptr [ZREP_DBG_PTR], edx
  mov dword ptr [ZREP_DBG_N], 0
  mov dword ptr [ZREP_DBG_ON], 1
  // slot 13 = the mask the keyboard hook built or injected this frame
  mov ecx, [ZREP_DBG_PTR]
  // (the mask/nkeys debug slots are gone: the walk now fills slots 0..14)
zrep_dbg_r_done:
  push eax
  call zrep_fingerprint
  pop edx
  mov dword ptr [ZREP_DBG_ON], 0
  cmp dword ptr [ZREP_FPV], 0
  je zrep_ih_done
  mov ecx, [ZREP_RECN]
  imul ecx, ecx, 6
  add ecx, ZREP_BUF
  // NOTE: the u16 key mask is written by zrep_kbd_hook, which owns the real
  // input array.  Do not write it here -- 0x4FADE0 only returns a success flag.
  mov dword ptr [ecx+2], eax
  inc dword ptr [ZREP_RECN]
  mov eax, edx                         // pass the real input through
  jmp zrep_ih_done
zrep_ih_rec_full:
  // Buffer full: stop recording and keep what we have (ZREP_CNT freezes it).
  mov ecx, [ZREP_RECN]
  mov dword ptr [ZREP_CNT], ecx
  mov dword ptr [ZREP_MODE], 0
zrep_ih_done:
  pop edi
  pop esi
  pop edx
  pop ecx
  pop ebx
  popfd
  ret

// ---- zrep_fingerprint: FNV-1a over the state that matters ---------------
// Every pointer is range-checked before it is followed; a dead pointer simply
// ends the walk early, and both sides then hash the same prefix.
zrep_fingerprint:
  pushfd
  push ebx
  push ecx
  push edx
  push esi
  push edi
  mov ebx, 811C9DC5
  mov dword ptr [ZREP_FPV], 1
  // ============ TEMPORARY WIDE DIAGNOSTIC ============
  // Hash every dword of the player object in [0x10, 0xA8).  Pointer-looking
  // values become a sentinel: heap addresses differ between runs by design.
  mov esi, [OVL_PLAYER]
  cmp esi, 10000
  jb zrep_w_bad
  cmp esi, 7FFF0000
  ja zrep_w_bad
  // the four arguments of the move function
  mov ecx, [ZREP_MDIV]
  call zrep_fp_mix
  mov ecx, [ZREP_MDX]
  call zrep_fp_mix
  mov ecx, [ZREP_MDY]
  call zrep_fp_mix
  mov ecx, [ZREP_MMUL]
  call zrep_fp_mix
  jmp zrep_fp_ret
zrep_w_bad:
  mov dword ptr [ZREP_FPV], 0
  xor ecx, ecx
  mov edi, 0
zrep_w_bl:
  call zrep_fp_mix
  dec edi
  jnz zrep_w_bl
  // ===================================================
zrep_fp_ret:
  mov eax, ebx
  cmp dword ptr [ZREP_DBG_ON], 0
  je zrep_fp_nocnt
  push eax
  mov eax, [ZREP_DBG_PTR]
  mov edx, [ZREP_DBG_N]
  mov dword ptr [eax+3C], edx
  pop eax
zrep_fp_nocnt:
  pop edi
  pop esi
  pop edx
  pop ecx
  pop ebx
  popfd
  ret

// ---------------------------------------------------------------------------
// Capture the movement arguments.  Hooked at 0x4E1027 (6 bytes,
// "divss xmm0,[esp+8]"), which the stub re-executes before jumping back.
// ecx is dead here and is used as scratch; pushing would move [esp+..].
// ---------------------------------------------------------------------------
zrep_move_hook:
  mov ecx, [esi]
  mov [ZREP_MENT], ecx
  mov ecx, [esp + 8]
  mov [ZREP_MDIV], ecx
  mov ecx, [esp + 12]
  mov [ZREP_MDX], ecx
  mov ecx, [esp + 16]
  mov [ZREP_MDY], ecx
  mov ecx, [esp + 20]
  mov [ZREP_MMUL], ecx
  divss xmm0, dword ptr [esp + 8]
  jmp 4E102D
zrep_pmask_hook:
  mov [ZREP_PMASK], esi
  pop ebx
  pop edi
  mov eax, esi
  pop esi
  pop ebp
  jmp 4FAF8A
zrep_fp_mixf:
  // Anything with |x| < 2^-16 is hashed as zero.  2^-16 has exponent 0x71, so
  // its exponent field is 0x71 << 23 = 0x38800000.  This kills the denormal
  // residue that damping/rounding leaves behind (measured: -1e-9 vs 0), which
  // cannot affect gameplay but does change the raw bits.
  mov edx, ecx
  and edx, 7F800000
  cmp edx, 38800000
  jae zrep_fpmf_go
  xor ecx, ecx
zrep_fpmf_go:
  jmp zrep_fp_mix

zrep_fp_mix:
  xor ebx, ecx
  imul ebx, ebx, 1000193
  // ---- debug capture: store this field's raw value while the window is open
  //      (see plan-zreplay.md: used to find which field diverges first)
  //      eax and edx MUST be preserved: zrep_fingerprint keeps the stage and
  //      boss pointers in eax across these calls, so clobbering it makes the
  //      walk dereference garbage.
  cmp dword ptr [ZREP_DBG_ON], 0
  je zrep_fpm_done
  push eax
  push edx
  mov eax, [ZREP_DBG_N]
  cmp eax, 10
  jae zrep_fpm_pop
  mov edx, [ZREP_DBG_PTR]
  mov dword ptr [edx+eax*4], ecx
  inc eax
  mov dword ptr [ZREP_DBG_N], eax
zrep_fpm_pop:
  pop edx
  pop eax
zrep_fpm_done:
  ret

// ---- ovl_mirror: feed the read-only rows from live game state ---------
// Ported from Le02 v0.7.6's overlay_logic, which mirrors NOSORE_DEBT into
// the Hit row and [stage+0x4C] into the Frame row, and walks the boss chain
// for the Pattern row.  Every pointer is range-checked before it is followed:
// outside a stage OVL_STAGE still holds a stale value and a wild pointer here
// would fault on every frame.
//
//   Hit     -- incremented by ovl_nogameover itself, nothing to do here
//   Frame   -- [stage+0x4C]
//   Pattern -- [stage+8] -> [manager] -> [boss+0x44], 0-based, same as Le02
//              ([boss+0x08] is the "a boss is on screen" gate)
// ---- speed control -------------------------------------------------------
// K = 60000 / fps is the frame limiter's own constant; changing it moves the
// wall clock only, so the logic frame count is untouched and this cannot
// desync a replay.
// ---- load the acceleration DLL ----------------------------------------
// Le03speed.dll patches the shared IDXGISwapChain vtable (leprac's method), which
// cannot be done from asm.  LoadLibraryA is already imported at 0x7D90D0.
fps_loaddll:
  push eax
  cmp dword ptr [DLL_LOADED], 0
  jne fld_done
  mov dword ptr [DLL_LOADED], 1
  // ---- embedded speed DLL: extract to the temp dir and load it --------
  // Falls back to the sidecar next to the exe when anything fails.
  pushad
  push SPD_TMPBUF               // stdcall: rightmost arg first
  push 104
  call dword ptr [7D9138]      // GetTempPathA(260, buf)
  test eax, eax
  jz ft_spd_fb
  mov edi, SPD_TMPBUF
  add edi, eax
  mov esi, SPD_TMPNAME
ft_spd_nc:
  mov al, [esi]
  test al, al
  jz ft_spd_ne
  mov [edi], al
  inc esi
  inc edi
  jmp ft_spd_nc
ft_spd_ne:
  mov byte ptr [edi], 0
  push 104
  push SPD_TMPW
  push -1
  push SPD_TMPBUF
  push 0
  push 0
  call dword ptr [7D9168]        // MultiByteToWideChar(CP_ACP,0,buf,-1,wbuf,260)
  test eax, eax
  jz ft_spd_fb
  push SPD_TMPW
  call dword ptr [7D9230]       // drop a stale copy from a previous run
  push 0
  push 80
  push 2
  push 0
  push 0
  push 40000000
  push SPD_TMPW
  call dword ptr [7D9234]       // CreateFileW(..., GENERIC_WRITE, CREATE_ALWAYS)
  cmp eax, -1
  je ft_spd_fb
  mov ebx, eax
  push 0
  push SPD_WRITTEN
  mov eax, SPD_DLL_END
  sub eax, SPD_DLL
  push eax
  push SPD_DLL
  push ebx
  call dword ptr [7D9228]        // WriteFile
  push ebx
  call dword ptr [7D924C]        // CloseHandle
  push SPD_TMPBUF
  call dword ptr [7D90D0]      // LoadLibraryA(temp path)
  jmp ft_spd_done
ft_spd_fb:
  push DLLNAME
  call dword ptr [7D90D0]      // fallback: sidecar next to the exe
ft_spd_done:
  mov [SPD_HMOD], eax
  popad
  mov eax, [SPD_HMOD]
  test eax, eax
  jz fld_done
  push NVNAME
  push eax
  call dword ptr [7D9200]          // GetProcAddress(h, "g_noVsync")
  mov [NOVSYNC_PTR], eax
fld_done:
  pop eax
  ret

fps_tick:
  push eax
  push ecx
  push edx
  call fps_loaddll
  // While the Speed row is being typed into, leave the value completely alone.
  // The clamp below writes 60 back EVERY FRAME, so a half-typed value was
  // being re-seeded with 60 before the digits arrived (typing "30" produced
  // 6030).  Skipping out here also stops the game from jumping to 0fps mid-entry.
  cmp dword ptr [OVL_TYPE_ON], 0
  je fps_clamp
  mov eax, [OVL_TYPE_VAL]
  cmp eax, SPEED_FPS
  je fps_done
fps_clamp:
  // deceleration is developer-only: clamp the row up to 60fps when dev is off
  mov eax, [SPEED_FPS]
  cmp dword ptr [CFG_DEVMODE], 0
  jne fps_dev
  cmp eax, 3C
  jge fps_dev
  mov eax, 3C
  mov [SPEED_FPS], eax
fps_dev:
  cmp dword ptr [RBOOST], 0
  je fps_check
  cmp byte ptr [REPLAY_FLAG], 0
  je fps_check
  test byte ptr [game+60FB8C+1D], 80       // LCtrl -> fast
  jz fps_try_slow
  mov eax, 0F0
  jmp fps_check
fps_try_slow:
  test byte ptr [game+60FB8C+2A], 80       // LShift -> slow
  jz fps_check
  mov eax, 1E
fps_check:
  cmp eax, 3E8
  jbe fps_clamp_hi
  mov eax, 3E8
fps_clamp_hi:
  cmp eax, 1
  jae fps_clamp_lo
  mov eax, 1
fps_clamp_lo:
  cmp eax, [SPEED_APPLIED]
  je fps_done
  mov [SPEED_APPLIED], eax
  // vsync is only worth dropping when the target rate exceeds 60
  mov ecx, [NOVSYNC_PTR]
  test ecx, ecx
  jz fps_nv_done
  xor edx, edx
  cmp eax, 3C
  seta dl
  mov [ecx], edx
fps_nv_done:
  push eax
  mov eax, 3C
  imul eax, eax, 3E8
  pop ecx
  xor edx, edx
  div ecx
  cmp word ptr [game+DB361], C969          // still `imul ecx,ecx,imm32`?
  jne fps_done
  mov [game+DB363], eax
fps_done:
  pop edx
  pop ecx
  pop eax
  ret

ovl_mirror:
  pushfd
  pushad
  // ---- settings file (v0.5.9): load once, then persist any change ------
  // Deliberately first: it must run in every scene, not only in a stage.
  call cfg_tick
  call fps_tick
  // Le02 mirrors the Pattern row EVERY frame -- HINT_PAT_IDX when a boss is
  // on screen, -1 otherwise.  Pre-load -1 here and overwrite it below only
  // when a boss really is up, so the row never falls back to a stale 0.
  mov dword ptr [OVL_V_PATTERN], FFFFFFFF
  mov eax, [OVL_STAGE]
  cmp eax, 10000
  jb ovl_mirror_done
  cmp eax, 7FFF0000
  ja ovl_mirror_done
  mov ecx, [eax+4C]
  mov [OVL_V_FRAME], ecx
  // liveness: the stage number at +0x30 must be 1..8.
  //
  // NOT 1..7.  Le03 has EIGHT stage entries: the six main stages, stage 7
  // (Extra) and stage 8 (Alpha / AbsurdlyExtra).  The mod's own tables are
  // eight entries long (MAX_PATTERNID, PATTERNS_TABLE, IDS_TABLE, PHASES_TABLE,
  // SECTION_CNT, all 0..7) and the music hooks already special-case stage 8
  // by name (prepareAlphaMusic / musicAlphaGate compare [esi+30] against 8).
  //
  // With the old 1..7 bound, entering Alpha made this test fail, so ovl_mirror
  // bailed out at ovl_mirror_clear on EVERY frame.  Three things broke at once:
  //   * the Pattern row stayed at -1 for the whole stage (the reported bug)
  //   * the hint self-heal below never ran
  //   * HINT_PAT_FRAME never advanced, so `boss:P:F` windows could not match
  // Only Alpha was affected; stages 1..7 were inside the bound.
  mov ecx, [eax+30]
  cmp ecx, 1
  jb ovl_mirror_clear
  cmp ecx, 8
  ja ovl_mirror_clear
  // ---- self-heal: hints must belong to the stage we are really on ------
  // hint_load reads the stage number from this very [stage+0x30].  If the
  // two ever disagree -- a load that happened before the stage object
  // existed, a stage change inside a full run, a hint file added mid-session
  // -- reload once here.  hint_load writes the same number back into
  // HINT_WANT, so the comparison matches on the next frame and this cannot
  // spin.  hint_load preserves every register, so ecx is still the stage.
  cmp ecx, [HINT_WANT]
  je ovl_mirror_hintok
  // v0.5.19: no hint-file I/O while a replay or attract demo is playing back
  // either.  hint_load enumerates the directory and reads several files, and
  // delaying the replay's stage construction is exactly the kind of
  // perturbation that shifts its frame sequence (see `desync分析.md`).
  // HINT_WANT is deliberately left alone, so the next real stage reloads.
  cmp byte ptr [game+B0A552], 0
  jne ovl_mirror_hintok
  cmp byte ptr [game+B0A554], 0
  jne ovl_mirror_hintok
  mov [HINT_WANT], ecx
  call hint_load
ovl_mirror_hintok:
  mov eax, [OVL_STAGE]
  mov eax, [eax+8]               // boss manager
  cmp eax, 10000
  jb ovl_mirror_clear
  cmp eax, 7FFF0000
  ja ovl_mirror_clear
  mov eax, [eax]                 // boss object
  cmp eax, 10000
  jb ovl_mirror_clear
  cmp eax, 7FFF0000
  ja ovl_mirror_clear
  cmp dword ptr [eax+8], 0       // is a boss actually on screen?
  je ovl_mirror_clear
  // [boss+0x44] is ALREADY 0-based, exactly like Le02 and like the hint txt
  // convention: the practice mod's own table (IDS_TABLE, stage 1) is
  //   ids_0: FFFFFFFF 0 1 2 3 4 5     with names None / MNon 1 / MSpell 1 / ...
  // so the stage's first pattern (the mid non-spell) has ID 0, and
  // applyPatternIdWarp stores that ID straight into [boss+0x44] with no
  // adjustment.  Do NOT subtract one here -- that turned the first pattern
  // into -1, the value reserved for "no boss".
  // 0 is also the "no pattern" state (entrance dialogue / mid-stage), which
  // is why the [boss+8] gate below -- not the number -- decides -1.
  mov ecx, [eax+44]
  cmp ecx, 400
  jae ovl_mirror_clear
  mov [OVL_V_PATTERN], ecx
  jmp ovl_mirror_done
ovl_mirror_clear:
  // Mid-stage the row keeps the -1 loaded above, NOT 0.  Pattern 0 is a real
  // pattern (the mid non-spell), so "no boss" has to be a different value or
  // the two are indistinguishable -- Le02 spells this out, and that is the
  // trap that made a boss:0 window light up mid-stage.
ovl_mirror_done:
  // ---- Lock Seed rising edge: adopt the seed already in use ----------
  // Deliberately SEED_USED (what the RNG was actually seeded with) and not
  // the raw global: the global can be overwritten by another code path right
  // after the stage is built, and SEED_USED is the value a replay must match.
  mov eax, [OVL_V_LOCKSEED]
  cmp eax, [OVL_PREV_SEEDSW]
  je ovl_seedsw_done
  mov [OVL_PREV_SEEDSW], eax
  test eax, eax
  jz ovl_seedsw_done
  mov eax, [SEED_USED]
  mov [OVL_V_SEED], eax
ovl_seedsw_done:
  // frame counter within the current boss pattern, for boss: windows
  mov eax, [OVL_V_PATTERN]
  cmp eax, [HINT_PAT_LAST]
  je hint_pf_inc
  mov [HINT_PAT_LAST], eax
  mov dword ptr [HINT_PAT_FRAME], 0
  jmp hint_pf_done
hint_pf_inc:
  cmp eax, 0
  jl hint_pf_done
  inc dword ptr [HINT_PAT_FRAME]
hint_pf_done:
  popad
  popfd
  ret

// ---- No Gameover (ported verbatim from Le02 v0.7.6 nogameover_hook) ----
// With the switch OFF this reproduces vanilla byte for byte.  With it ON,
// lives > 0 still takes the ORIGINAL path and the game's own `dec` ticks the
// counter down as usual; only the would-have-been-GAME-OVER case differs --
// lives is faked to 1 so that same `dec` lands back on 0 and the run
// continues.  The counter therefore never goes negative.
ovl_nogameover:
  cmp dword ptr [OVL_V_NOGAMEOVER], 0
  je ovl_ng_vanilla
  cmp dword ptr [eax+48], 0
  jg ovl_ng_count
  mov dword ptr [eax+48], 1
ovl_ng_count:
  jmp game+E02CE
ovl_ng_vanilla:
  cmp dword ptr [eax+48], 0
  jg game+E02CE
  jmp game+E0297

// ---- Lock Power (ported verbatim from Le02 v0.7.6 ovl_lockpower) -------
// Locks onto whatever power you currently have: the first frame after the
// switch goes on captures the live power into OVL_LP_TARGET and every frame
// after that stores it back, so power becomes genuinely static.  Switching it
// off re-arms the capture.  The vanilla clamp is kept verbatim for OFF.
//
// v0.5.18 -- Le03 has TWO characters and the player object carries a power
// value for each: +0x7C is the main one, +0x80 the partner's (the game's own
// HUD draws both, and its config has a 自機交換 / character-switch option).
// The vanilla code clamps the pair in the same function -- +0x7C right here
// at game+E076B, +0x80 at game+E078C -- so this one hook can serve both.
// Each row gets its own latch, so 1P and 2P can be locked independently.
// ---- autobomb: fire a bomb instead of taking the hit -------------------
// Entered by the 7-byte jmp that replaced the state-machine dispatch
// prologue at game+E0126.  ECX = player, EDI = controller.
// ---- miss counter: one increment per life actually lost ---------------
// Entered by the 5-byte call that replaced the call sitting immediately
// after `dec [player+0x48]` in the death branch.  Flags are preserved so
// the surrounding code cannot tell the difference.
ovl_miss:
  pushfd
  inc dword ptr [OVL_V_HIT]
  popfd
  jmp game+26F80

ovl_autobomb:
  mov eax, [ecx+54]              // displaced instruction #1
  cmp eax, 1
  jne ovl_ab_vanilla
  cmp dword ptr [OVL_V_AUTOBOMB], 0
  je ovl_ab_vanilla
  cmp dword ptr [ecx+60], 0
  jle ovl_ab_vanilla
  pushad
  mov ecx, edi                   // controller
  call game+E1210                // the game's own bomb routine
  popad
  cmp dword ptr [ecx+54], 5
  jne ovl_ab_vanilla
  jmp game+E073E                 // skip the hit body: no life loss
ovl_ab_vanilla:
  dec eax
  cmp eax, 5
  jmp game+E012D                 // original `ja` + jump table

ovl_lockpower:
  mov eax, [edi]
  mov [OVL_PLAYER], eax
  // ---- 1P: P+0x7C ----
  cmp dword ptr [OVL_V_LOCKPWR], 0
  jne ovl_lp1_on
  mov dword ptr [OVL_LP_HELD], 0
  cmp dword ptr [eax+7C], 0      // OFF -> the vanilla clamp, verbatim
  jge ovl_lp1_hi
  mov dword ptr [eax+7C], 0
ovl_lp1_hi:
  cmp dword ptr [eax+7C], 1F4
  jl ovl_lp2
  mov dword ptr [eax+7C], 1F4
  jmp ovl_lp2
ovl_lp1_on:
  cmp dword ptr [OVL_LP_HELD], 0
  jne ovl_lp1_pin
  mov edx, [eax+7C]
  mov dword ptr [OVL_LP_TARGET], edx
  mov dword ptr [OVL_LP_HELD], 1
ovl_lp1_pin:
  mov edx, [OVL_LP_TARGET]
  mov dword ptr [eax+7C], edx
  // ---- 2P: P+0x80 ----
ovl_lp2:
  cmp dword ptr [OVL_V_LOCKPWR2], 0
  jne ovl_lp2_on
  mov dword ptr [OVL_LP_HELD2], 0
  jmp ovl_lb_check                  // OFF -> game+E078C is the vanilla +80 clamp
ovl_lp2_on:
  cmp dword ptr [OVL_LP_HELD2], 0
  jne ovl_lp2_pin
  mov edx, [eax+80]
  mov dword ptr [OVL_LP_TARGET2], edx
  mov dword ptr [OVL_LP_HELD2], 1
ovl_lp2_pin:
  mov edx, [OVL_LP_TARGET2]
  mov dword ptr [eax+80], edx
  jmp ovl_lb_check

ovl_lb_check:
  // Lock Bomb (1P): latch [player+0x60] when the switch goes on, then pin it.
  cmp dword ptr [OVL_V_LOCKBOMB], 0
  je ovl_lb_off
  cmp dword ptr [BOMB_HELD], 0
  jne ovl_lb_pin
  mov edx, [eax+60]
  mov dword ptr [BOMB_TARGET], edx
  mov dword ptr [BOMB_HELD], 1
ovl_lb_pin:
  mov edx, [BOMB_TARGET]
  mov dword ptr [eax+60], edx
  jmp ovl_lb_done
ovl_lb_off:
  mov dword ptr [BOMB_HELD], 0
ovl_lb_done:
  jmp game+E078C

// ---- ovl_sync: force GDI to finish its batched drawing on the panel DIB --
// GdiFlush turned out NOT to be enough: whether the batched Rectangle() fills
// landed before or after the immediate TextOutW() depended on the exact code
// layout, which is why the text kept vanishing.  Re-selecting the bitmap
// makes GDI complete any pending drawing on the old surface first, and that
// IS reliable.
ovl_sync:
  push ebp
  mov ebp, esp
  pushad
  push dword ptr [OVL_OLDBMP]
  push dword ptr [OVL_MEMDC]
  call dword ptr [7D9014]        // SelectObject(memdc, old 1x1 bitmap)
  push dword ptr [OVL_DIB]
  push dword ptr [OVL_MEMDC]
  call dword ptr [7D9014]        // SelectObject(memdc, panel DIB)
  popad
  pop ebp
  ret

// ---- ovl_mkfont: create the UI font and select it into ebx (the HDC) ----
// CreateFontW is stdcall with 14 args, so they are pushed RIGHT TO LEFT:
// pszFaceName first, cHeight last.  Being stdcall it pops its own arguments
// -- there must be NO `add esp` after the call.
// The height is derived from OVL_SYP so the text tracks the game's own
// upscale factor (12 logical units ~ the game's own HUD text size).
ovl_mkfont:
  push ebp
  mov ebp, esp
  pushad
  // The font is created once and cached in OVL_HFONT: creating it every
  // frame costs far too much (it dropped the game to a few fps).
  cmp dword ptr [OVL_HFONT], 0
  jne ovl_mkfont_sel
  mov eax, 14                    // 20 logical units (ink ~= v0.7.6's 13)
  mov edx, [OVL_SYP]
  call ovl_scalev2               // eax = height in physical pixels
  push TXT_OVL_FACE              // 14 pszFaceName
  push 0                         // 13 iPitchAndFamily
  push 1                         // 12 iQuality = NONANTIALIASED_QUALITY
  push 0                         // 11 iClipPrecision
  push 4                         // 10 iOutPrecision = OUT_TT_PRECIS
  push 1                         //  9 iCharSet = DEFAULT_CHARSET
  push 0                         //  8 bStrikeOut
  push 0                         //  7 bUnderline
  push 0                         //  6 bItalic
  push 2BC                       //  5 cWeight = FW_BOLD (700)
  push 0                         //  4 cOrientation
  push 0                         //  3 cEscapement
  push 0                         //  2 cWidth
  push eax                       //  1 cHeight
  call dword ptr [7D903C]        // CreateFontW
  mov [OVL_HFONT], eax
ovl_mkfont_sel:
  push dword ptr [OVL_HFONT]
  push ebx
  call dword ptr [7D9014]        // SelectObject(hdc, font)
  mov [OVL_OLDFONT], eax
  popad
  pop ebp
  ret

// ---- ovl_rmfont: put the DC's previous font back ------------------------
// The font itself is cached and must NOT be deleted here.
ovl_rmfont:
  push ebp
  mov ebp, esp
  pushad
  push dword ptr [OVL_OLDFONT]
  push ebx
  call dword ptr [7D9014]        // SelectObject(hdc, old)
  popad
  pop ebp
  ret

// ---- ovl_text_r: args (string,y,x_right,colour); right-aligned ----------
// Measures the string with GetTextExtentPoint32W and shifts x left by the
// width so the text ends exactly at x_right (both in physical pixels).
ovl_text_r:
  push ebp
  mov ebp, esp
  sub esp, 16
  pushad
  push dword ptr [ebp+8]         // string
  call ovl_strlen                // eax = char count
  add esp, 4
  push OVL_SIZE
  push eax
  push dword ptr [ebp+8]
  push ebx
  call dword ptr [7D9048]        // GetTextExtentPoint32W(hdc, str, len, &size)
  mov eax, [ebp+10]              // x_right (logical)
  call ovl_sx                    // -> physical screen x
  sub eax, [OVL_SIZE]            // minus text width
  mov [ebp-4], eax
  mov eax, [ebp+0C]              // y (logical)
  call ovl_sy
  mov [ebp-8], eax
  push dword ptr [ebp+14]        // colour
  push dword ptr [ebp-4]         // x
  push dword ptr [ebp-8]         // y
  push dword ptr [ebp+8]         // string
  call ovl_text
  add esp, 10
  popad
  mov esp, ebp
  pop ebp
  ret

// ---- ovl_measure: client size -> scale percent x100, plus screen origin --
// OVL_SXP = clientW*100/640 ; OVL_SYP = clientH*100/480
// OVL_OX/OVL_OY = screen position of the client origin (the overlay is drawn
// on the desktop DC, so every coordinate must be offset by it).
ovl_measure:
  push ebp
  mov ebp, esp
  sub esp, 20
  pushad
  mov eax, [0A91AF4]
  test eax, eax
  jz ovl_measure_x
  lea ecx, [ebp-14]             // RECT
  push ecx
  push eax
  call dword ptr [7D92A8]         // GetClientRect(hwnd, &rect)
  mov eax, [ebp-0C]             // right
  mov ecx, [ebp-8]             // bottom
  mov dword ptr [OVL_CLW], eax
  mov dword ptr [OVL_CLH], ecx
  // xpct = clientW*100/640
  mov edx, 64
  mul edx
  mov ecx, 280
  xor edx, edx
  div ecx
  mov [OVL_SXP], eax
  // ypct = clientH*100/480
  mov eax, [OVL_CLH]
  mov edx, 64
  mul edx
  mov ecx, 1E0
  xor edx, edx
  div ecx
  mov [OVL_SYP], eax
  // The overlay is composited into the game's backbuffer, whose origin IS the
  // client origin, so the screen offset must be zero.  (v0.3.0 added the
  // desktop position here because it painted the screen DC -- not used now.)
  mov dword ptr [OVL_OX], 0
  mov dword ptr [OVL_OY], 0
ovl_measure_x:
  popad
  mov esp, ebp
  pop ebp
  ret

// ---- ovl_sx / ovl_sy: logical coord -> physical SCREEN coord ------------
ovl_sx:
  mov edx, [OVL_SXP]
  call ovl_scalev2
  add eax, [OVL_OX]
  ret
ovl_sy:
  mov edx, [OVL_SYP]
  call ovl_scalev2
  add eax, [OVL_OY]
  ret

// ---- ovl_flush: force GDI to execute its batched drawing commands -------
// GdiFlush is not in the import table, so it is resolved once via
// GetModuleHandleW + GetProcAddress and cached in OVL_PFLUSH.
// This matters because GDI batches Rectangle() but executes TextOutW()
// immediately -- without an explicit flush the panel fills land on top of
// the text and hide it.
ovl_flush:
  push ebp
  mov ebp, esp
  pushad
  cmp dword ptr [OVL_PFLUSH], 0
  jne ovl_flush_call
  push TXT_GDI32
  call dword ptr [7D9094]        // GetModuleHandleW(L"gdi32.dll")
  test eax, eax
  jz ovl_flush_done
  push TXT_GDIFLUSH
  push eax
  call dword ptr [7D9200]        // GetProcAddress(h, "GdiFlush")
  test eax, eax
  jz ovl_flush_done
  mov [OVL_PFLUSH], eax
ovl_flush_call:
  call dword ptr [OVL_PFLUSH]    // GdiFlush()
ovl_flush_done:
  popad
  pop ebp
  ret

// ---- ovl_fill_s: args (y1,x1,y2,x2,colour) in logical coords -----------
ovl_fill_s:
  push ebp
  mov ebp, esp
  sub esp, 16
  pushad
  mov eax, [ebp+8]                // y1
  call ovl_sy
  mov [ebp-4], eax
  mov eax, [ebp+0C]               // x1
  call ovl_sx
  mov [ebp-8], eax
  mov eax, [ebp+10]               // y2
  call ovl_sy
  mov [ebp-12], eax
  mov eax, [ebp+14]               // x2
  call ovl_sx
  mov [ebp-16], eax
  push dword ptr [ebp+18]         // colour
  push dword ptr [ebp-16]         // x2
  push dword ptr [ebp-12]         // y2
  push dword ptr [ebp-8]          // x1
  push dword ptr [ebp-4]          // y1
  call ovl_fill
  add esp, 14
  popad
  mov esp, ebp
  pop ebp
  ret

// eax = (eax*edx)/100  (edx preserved, ecx clobbered)
ovl_scalev2:
  push edx
  mov edx, eax
  pop eax
  imul eax, edx
  xor edx, edx
  mov ecx, 64
  div ecx
  ret

// ---- ovl_frame_s: args (y1,x1,y2,x2,colour) in logical coords ----------
ovl_frame_s:
  push ebp
  mov ebp, esp
  sub esp, 16
  pushad
  mov eax, [ebp+8]
  call ovl_sy
  mov [ebp-4], eax
  mov eax, [ebp+0C]
  call ovl_sx
  mov [ebp-8], eax
  mov eax, [ebp+10]
  call ovl_sy
  mov [ebp-12], eax
  mov eax, [ebp+14]
  call ovl_sx
  mov [ebp-16], eax
  push dword ptr [ebp+18]
  push dword ptr [ebp-16]
  push dword ptr [ebp-12]
  push dword ptr [ebp-8]
  push dword ptr [ebp-4]
  call ovl_frame_rect
  add esp, 14
  popad
  mov esp, ebp
  pop ebp
  ret

// ---- ovl_text_s: args (string,y,x,colour) in logical coords ------------
// Call sites push in the order: colour, x, y, string.
ovl_text_s:
  push ebp
  mov ebp, esp
  sub esp, 8
  pushad
  mov eax, [ebp+0C]               // y
  call ovl_sy
  mov [ebp-4], eax
  mov eax, [ebp+10]               // x
  call ovl_sx
  mov [ebp-8], eax
  push dword ptr [ebp+14]         // colour
  push dword ptr [ebp-8]          // x
  push dword ptr [ebp-4]          // y
  push dword ptr [ebp+8]          // string
  call ovl_text
  add esp, 10
  popad
  mov esp, ebp
  pop ebp
  ret



// ---- ovl_fill: solid rect.  args: (y1,x1,y2,x2,colour) ------------------
// Uses ebx = HDC.  Creates a solid brush, fills with Rectangle, frees it.
// ---- ovl_rect_bits: fill a PHYSICAL rect straight into the panel DIB ----
// args: (y1, x1, y2, x2, colour) -- same contract as ovl_fill, but the pixels
// are written into OVL_BITS directly instead of going through
// CreateSolidBrush + Rectangle.
//
// THIS IS THE FIX for the panel text vanishing.  GDI DEFERS Rectangle()
// fills until the next sync point, while TextOutW() runs immediately; the
// deferred fills are therefore executed at the single trailing GdiFlush --
// i.e. AFTER the text -- and wipe it out.  Whether the text survived used to
// depend on incidental timing/layout, which is why it kept coming and going
// with unrelated edits.  A direct write cannot be reordered.
ovl_rect_bits:
  push ebp
  mov ebp, esp
  sub esp, 16
  pushad
  mov edi, [OVL_BITS]
  test edi, edi
  jz ovl_rb_done
  mov ebx, [ebp+0C]              // left
  test ebx, ebx
  jns ovl_rb_l
  xor ebx, ebx
ovl_rb_l:
  mov esi, [ebp+10]              // right
  cmp esi, [OVL_PW]
  jbe ovl_rb_r
  mov esi, [OVL_PW]
ovl_rb_r:
  cmp ebx, esi
  jae ovl_rb_done
  mov edx, [ebp+8]               // top
  test edx, edx
  jns ovl_rb_t
  xor edx, edx
ovl_rb_t:
  mov ecx, [ebp+14]              // bottom
  cmp ecx, [OVL_PH]
  jbe ovl_rb_b
  mov ecx, [OVL_PH]
ovl_rb_b:
  cmp edx, ecx
  jae ovl_rb_done
  mov [ebp-4], ecx
  sub [ebp-4], edx               // row count
  mov [ebp-8], esi
  sub [ebp-8], ebx               // column count
  mov eax, edx
  imul eax, [OVL_PW]
  add eax, ebx
  lea edi, [edi+eax*4]           // first pixel
  // Colour: callers pass (R<<16)|(G<<8)|B (see the note in ovl_panel_draw),
  // but a 32-bit DIB pixel has B at byte 0, so swap the outer two bytes --
  // otherwise every fill comes out with red and blue exchanged.
  mov eax, [ebp+18]
  mov ecx, eax
  and ecx, 0FF
  shl ecx, 10                    // B -> byte 2
  mov edx, eax
  and edx, 0FF00                 // G stays
  and eax, 0FF0000
  shr eax, 10                    // R -> byte 0
  or eax, ecx
  or eax, edx
ovl_rb_row:
  push eax
  push edi
  mov ecx, [ebp-8]
  cld
  db F3 AB                       // rep stosd (keystone rejects rep prefixes)
  pop edi
  pop eax
  mov ecx, [OVL_PW]
  lea edi, [edi+ecx*4]           // next row
  dec dword ptr [ebp-4]
  jnz ovl_rb_row
ovl_rb_done:
  popad
  mov esp, ebp
  pop ebp
  ret

// ---- ovl_fill: (y1,x1,y2,x2,colour) via GDI Rectangle -------------------
// Kept for reference only -- the panel no longer uses it, see ovl_rect_bits.
ovl_fill:
  push ebp
  mov ebp, esp
  pushad
  push dword ptr [ebp+18]         // colour (COLORREF, 0x00BBGGRR)
  call dword ptr [7D902C]         // CreateSolidBrush
  mov edi, eax                    // brush
  push edi
  push ebx                        // hdc
  call dword ptr [7D9014]         // SelectObject
  mov esi, eax                    // old brush
  // Rectangle(hdc, left, top, right, bottom) -> push bottom, right, top, left
  // arg contract: [ebp+8]=y1 [ebp+0C]=x1 [ebp+10]=y2 [ebp+14]=x2
  push dword ptr [ebp+10]         // y2 = bottom
  push dword ptr [ebp+14]         // x2 = right
  push dword ptr [ebp+8]          // y1 = top
  push dword ptr [ebp+0C]         // x1 = left
  push ebx
  call dword ptr [7D9038]         // Rectangle
  push esi
  push ebx
  call dword ptr [7D9014]         // restore old brush
  push edi
  call dword ptr [7D9010]         // DeleteObject
  popad
  pop ebp
  ret

// ---- ovl_frame_rect: 1px hollow rect. args: (y1,x1,y2,x2,colour) --------
// Implemented as four 1px solid fills (no CreatePen import needed).
// Local frame: [ebp+8]=y1 [ebp+0C]=x1 [ebp+10]=y2 [ebp+14]=x2 [ebp+18]=colour
ovl_frame_rect:
  push ebp
  mov ebp, esp
  pushad
  // Four thin edges, each a DIRECT write into the DIB (ovl_rect_bits).  They
  // used to go through ovl_fill/Rectangle, whose fills GDI defers until the
  // trailing GdiFlush -- i.e. until after all the text had been drawn.
  // ---- top edge: (y1, x1)-(y1+3, x2) ----
  push dword ptr [ebp+18]          // colour
  push dword ptr [ebp+14]          // x2
  mov eax, [ebp+8]
  add eax, 3
  push eax                         // y2 = y1+3
  push dword ptr [ebp+0C]          // x1
  push dword ptr [ebp+8]           // y1
  call ovl_rect_bits
  add esp, 14
  // ---- bottom edge: (y2-3, x1)-(y2, x2) ----
  push dword ptr [ebp+18]
  push dword ptr [ebp+14]
  push dword ptr [ebp+10]          // y2
  push dword ptr [ebp+0C]          // x1
  mov eax, [ebp+10]
  sub eax, 3
  push eax                         // y1 = y2-3
  call ovl_rect_bits
  add esp, 14
  // ---- left edge: (y1, x1)-(y2, x1+3) ----
  push dword ptr [ebp+18]
  mov eax, [ebp+0C]
  add eax, 3
  push eax                         // x2 = x1+3
  push dword ptr [ebp+10]          // y2
  push dword ptr [ebp+0C]          // x1
  push dword ptr [ebp+8]           // y1
  call ovl_rect_bits
  add esp, 14
  // ---- right edge: (y1, x2-3)-(y2, x2) ----
  push dword ptr [ebp+18]
  push dword ptr [ebp+14]          // x2
  push dword ptr [ebp+10]          // y2
  mov eax, [ebp+14]
  sub eax, 3
  push eax                         // x1 = x2-3
  push dword ptr [ebp+8]           // y1
  call ovl_rect_bits
  add esp, 14
  popad
  pop ebp
  ret

// ---- ovl_text: draw a UTF-16 string at (x,y) in colour. -----------------
// args: (string,y,x,colour)  -- matches the push order used by callers.
// A hard black shadow at (+2,+2) is drawn first; that drop shadow is what
// gives the overlay the same look as Le02 v0.7.6.
ovl_text:
  push ebp
  mov ebp, esp
  sub esp, 10                     // [ebp-4] = string ptr, [ebp-8] = length
  pushad
  // ---- make sure the string is 2-byte aligned --------------------------
  // TextOutW FAILS OUTRIGHT (returns 0 and draws nothing) when handed a
  // misaligned UTF-16 pointer.  Every literal in the data section sits right
  // after the code, so whether the strings landed on an even or an odd
  // address flipped with ANY change in code size -- that was the entire
  // "the panel text disappeared again / three nops bring it back" mystery.
  // Aligning the scratch buffer's base at runtime fixes it for good.
  mov esi, [ebp+8]
  test esi, 1
  jz ovl_text_aligned
  mov edi, OVL_TXTCOPY
  add edi, 1
  and edi, 0FFFFFFFE              // round the scratch buffer up to even
  mov ecx, 3F                     // at most 63 units
ovl_text_cpy:
  mov ax, [esi]
  mov [edi], ax
  add esi, 2
  add edi, 2
  test ax, ax
  jz ovl_text_cpy_done
  dec ecx
  jnz ovl_text_cpy
  mov word ptr [edi], 0
ovl_text_cpy_done:
  mov esi, OVL_TXTCOPY
  add esi, 1
  and esi, 0FFFFFFFE
  mov [ebp-4], esi
  jmp ovl_text_have
ovl_text_aligned:
  mov [ebp-4], esi
ovl_text_have:
  // NOTE: do NOT put a GdiFlush here.  The panel now draws every fill by
  // writing the DIB bits directly (ovl_clear_dib / ovl_rect_bits), so there
  // is nothing pending for GDI to reorder around the text; a flush in the
  // middle of the sequence only perturbs the DC state.
  push 1                          // TRANSPARENT
  push ebx
  call dword ptr [7D9054]         // SetBkMode(hdc, TRANSPARENT)
  push dword ptr [ebp-4]          // string
  call ovl_strlen                 // eax = char count
  add esp, 4
  mov [ebp-8], eax                // length (TextOutW needs cch)
  inc dword ptr [OVL_TXTCNT]      // diagnostic: count text draws
  // ---- shadow: black at (+2,+2) ----
  xor eax, eax
  push eax
  push ebx
  call dword ptr [7D9058]         // SetTextColor(hdc, black)
  push dword ptr [ebp-8]
  push dword ptr [ebp-4]          // string
  mov eax, [ebp+0C]
  add eax, 2
  push eax                        // y + 2
  mov eax, [ebp+10]
  add eax, 2
  push eax                        // x + 2
  push ebx
  call dword ptr [7D9004]         // TextOutW
  // ---- the text itself ----
  push dword ptr [ebp+14]         // colour
  push ebx
  call dword ptr [7D9058]         // SetTextColor
  push dword ptr [ebp-8]
  push dword ptr [ebp-4]          // string
  push dword ptr [ebp+0C]         // y
  push dword ptr [ebp+10]         // x
  push ebx
  call dword ptr [7D9004]         // TextOutW
  // Force the glyphs into the DIB straight away.  Without this the panel can
  // come out as a bare black box: the text is drawn but never reaches the
  // bits that get uploaded to the backbuffer.
  call ovl_flush
  popad
  mov esp, ebp
  pop ebp
  ret

// ---- ovl_strlen: eax = wcslen(arg) --------------------------------------
ovl_strlen:
  push ebp
  mov ebp, esp
  mov esi, [ebp+8]
  xor eax, eax
ovl_strlen_l:
  cmp word ptr [esi+eax*2], 0
  je ovl_strlen_d
  inc eax
  jmp ovl_strlen_l
ovl_strlen_d:
  pop ebp
  ret

// ---- ovl_numtext: format a dword into a static buffer, return ptr -------
// arg = value; returns eax = pointer to NUL-terminated UTF-16 digits.
ovl_numtext:
  push ebp
  mov ebp, esp
  pushad
  mov eax, [ebp+8]
  mov edi, OVL_NUMBUF
  mov ecx, 0                      // digit count
  // Le02 relies on the game's own %d to print -1; GDI cannot format, so the
  // sign has to be emitted here or the Pattern row would read 4294967295.
  test eax, eax
  jns ovl_num_abs
  mov word ptr [edi], 2D          // '-'
  add edi, 2
  neg eax
ovl_num_abs:
  test eax, eax
  jnz ovl_num_l
  mov word ptr [edi], 30          // '0'
  mov word ptr [edi+2], 0
  jmp ovl_num_d
ovl_num_l:
  mov esi, 0
ovl_num_dig:
  xor edx, edx
  mov ebx, 0A
  div ebx                         // eax=quot, edx=rem
  add dl, 30
  movzx edx, dl
  mov [OVL_NUMTMP+esi*2], dx
  inc esi
  test eax, eax
  jnz ovl_num_dig
  // reverse into OVL_NUMBUF
  xor ecx, ecx
ovl_num_rev:
  dec esi
  mov dx, [OVL_NUMTMP+esi*2]
  mov [edi+ecx*2], dx
  inc ecx
  test esi, esi
  jnz ovl_num_rev
  mov word ptr [edi+ecx*2], 0
ovl_num_d:
  // Return the START of the buffer, NOT edi: for a negative value edi has
  // already been advanced past the '-' (see ovl_num_abs), so returning edi
  // silently dropped the sign and the Pattern row showed "1" instead of "-1".
  mov dword ptr [OVL_NUMPTR], OVL_NUMBUF
  popad
  mov eax, [OVL_NUMPTR]
  pop ebp
  ret

// eax = text colour for this row.  Matches Le02 v0.7.6: the selected row is
// drawn in saturated yellow, every other row in a paler yellow.  Written as
// (R<<16)|(G<<8)|B because the destination is an R8G8B8A8 backbuffer.
ovl_rowcolor:
  mov ecx, [OVL_ACTIVE_CUR]
  cmp eax, [ecx]
  je ovl_rowcolor_sel
  mov eax, 0FFFFA0               // RGB(255,255,160)
  ret
ovl_rowcolor_sel:
  mov eax, 0FFFF00               // RGB(255,255,0)
  ret

// ---- ovl_hextext: dword -> "RRGGBB" into OVL_NUMBUF, pointer in eax -----
// Six UPPERCASE hex digits, no prefix.  GDI cannot format, and a colour row
// has to read the same way the hint file writes it, so this mirrors what
// Le01's "%06X" produced.
ovl_hextext:
  push ebp
  mov ebp, esp
  pushad
  mov eax, [ebp+8]
  mov edi, OVL_NUMBUF
  mov esi, 5                     // nibble index, most significant first
ovl_hex_loop:
  mov edx, eax
  mov ecx, esi
  shl ecx, 2                     // nibble -> bit offset
  shr edx, cl
  and edx, 0F
  cmp edx, 0A
  jb ovl_hex_dec
  add edx, 37                    // 'A' - 10
  jmp ovl_hex_put
ovl_hex_dec:
  add edx, 30                    // '0'
ovl_hex_put:
  mov [edi], dx
  add edi, 2
  dec esi
  jns ovl_hex_loop
  mov word ptr [edi], 0
  popad
  mov eax, OVL_NUMBUF
  mov esp, ebp
  pop ebp
  ret

// ---- ovl_swatch_rect: fill a rect in the panel DIB ---------------------
// args: (top, left, bottom, right, colour), physical pixels, colour in HTML
// order.  This is ovl_rect_bits with an explicit, unambiguous argument order
// at the call site, and the same R/B swap for the 32bpp DIB.
ovl_swatch_rect:
  push ebp
  mov ebp, esp
  sub esp, 16
  pushad
  mov edi, [OVL_BITS]
  test edi, edi
  jz ovl_swr_done
  mov edx, [ebp+8]               // top
  test edx, edx
  jns ovl_swr_t
  xor edx, edx
ovl_swr_t:
  mov ecx, [ebp+10]              // bottom
  cmp ecx, [OVL_PH]
  jbe ovl_swr_b
  mov ecx, [OVL_PH]
ovl_swr_b:
  cmp edx, ecx
  jae ovl_swr_done
  mov ebx, [ebp+0C]              // left
  test ebx, ebx
  jns ovl_swr_l
  xor ebx, ebx
ovl_swr_l:
  mov esi, [ebp+14]              // right
  cmp esi, [OVL_PW]
  jbe ovl_swr_r
  mov esi, [OVL_PW]
ovl_swr_r:
  cmp ebx, esi
  jae ovl_swr_done
  mov [ebp-4], ecx
  sub [ebp-4], edx               // row count
  mov [ebp-8], esi
  sub [ebp-8], ebx               // column count
  mov eax, edx
  imul eax, [OVL_PW]
  add eax, ebx
  lea edi, [edi+eax*4]           // first pixel
  mov eax, [ebp+18]
  mov ecx, eax
  and ecx, 0FF
  shl ecx, 10                    // B -> byte 2
  mov edx, eax
  and edx, 0FF00                 // G stays
  and eax, 0FF0000
  shr eax, 10                    // R -> byte 0
  or eax, ecx
  or eax, edx
ovl_swr_row:
  push eax
  push edi
  mov ecx, [ebp-8]
  cld
  db F3 AB                       // rep stosd (keystone rejects rep prefixes)
  pop edi
  pop eax
  mov ecx, [OVL_PW]
  lea edi, [edi+ecx*4]           // next row
  dec dword ptr [ebp-4]
  jnz ovl_swr_row
ovl_swr_done:
  popad
  mov esp, ebp
  pop ebp
  ret

customMenuRender:
  pushfd
  pushad
  // Start `Bomb:` at the selected character's real default.  Re-applied
  // whenever the character changes, so it is also correct if the player
  // backs out and picks somebody else.
  mov eax, [CHAR_IDX]
  cmp eax, [LAST_CHAR]
  je menu_char_done
  mov [LAST_CHAR], eax
  cmp eax, 3
  ja menu_char_done
  mov eax, [BOMB_DEF+eax*4]
  mov [SEL_BOMB], eax
menu_char_done:
  call getInput
  mov esi, eax
  xor ecx, ecx
menu_keys:
  mov edx, [esi+ecx*4+84]
  mov edx, [esi+edx*4+4]
  mov [KEYS+ecx*4], edx
  inc ecx
  cmp ecx, 7
  jl menu_keys
  cmp dword ptr [CURR_SEL], 0
  jne menu_ready
  mov eax, SEL_STAGE
  mov [CURR_SEL], eax
  mov eax, [DIFF]
  mov [SEL_DIFF], eax
menu_ready:
  mov edi, [CURR_SEL]
  mov esi, edi
  sub esi, SEL_ARR_BEGIN
  add esi, SEL_DATA
  movzx ebx, word ptr [esi]
  movzx esi, word ptr [esi+2]

  // The Pattern row is the only one whose real upper bound is dynamic:
  // it is the last pattern of the stage, or the last chapter in Section
  // mode.  Computing it here feeds both the clamp and the left-wrap.
  cmp edi, PATTERN_WARP
  jne menu_max_ok
  mov eax, [SEL_STAGE]
  cmp dword ptr [SEL_MODE], 0
  jne menu_sec_max
  movzx ebx, byte ptr [MAX_PATTERNID+eax]
  jmp menu_max_ok
menu_sec_max:
  movzx ebx, byte ptr [SECTION_CNT+eax]
  test ebx, ebx
  jz menu_max_ffff
  mov edi, SEL_SECTION
  dec ebx
  xor esi, esi
  jmp menu_max_ok
menu_max_ffff:
  mov ebx, ffff
menu_max_ok:
  mov [SEL_MAX], ebx

  cmp esi, 0
  je customMenu_slowInc
  mov eax, ffffffff
  jmp customMenu_keyCheck
customMenu_slowInc:
  mov eax, 1

customMenu_keyCheck:
  // Wrap dwell: the value has just landed on an extreme, so give the
  // player a moment to let go before the held key can move it again.
  cmp dword ptr [WRAP_LOCK], 0
  je wrap_no_lock
  cmp dword ptr [WRAP_TIMER], 0
  jz wrap_release
  dec dword ptr [WRAP_TIMER]
  jmp customMenu_notLeft
wrap_release:
  mov dword ptr [WRAP_LOCK], 0
wrap_no_lock:
  mov ecx, [KEY_RIGHT]
  cmp ecx, 0
  je customMenu_notRight
  cmp ecx, eax
  ja customMenu_notRight
  add [edi], ecx
  cmp ebx, ffff
  je customMenu_rightClb
  cmp [edi], ebx
  jna customMenu_rightClb // does not exceed max
  // Over the maximum: wrap to the bottom.  Unbounded rows (max ==
  // FFFF) never reach here, so they keep their plain clamp.
  mov dword ptr [edi], 0
  call wrap_latch
customMenu_rightClb:
  call customMenuSwitchClb
customMenu_notRight:
  mov ecx, [KEY_LEFT]
  cmp ecx, 0
  je customMenu_notLeft
  cmp ecx, eax
  ja customMenu_notLeft
  sub [edi], ecx
  cmp [edi], 0
  jnl customMenu_leftClb // not <zero
  // Under the minimum: bounded rows wrap to the top, unbounded ones
  // (max == FFFF, i.e. Frame and Score) just clamp at zero.
  mov eax, [SEL_MAX]
  cmp eax, ffff
  je customMenu_leftZero
  mov [edi], eax
  call wrap_latch
  jmp customMenu_leftClb
customMenu_leftZero:
  mov [edi], 0
customMenu_leftClb:
  call customMenuSwitchClb
customMenu_notLeft:
  mov edi, [CURR_SEL]
  cmp [KEY_UP], 1
  jne customMenu_notUp
  sub edi, 4
  cmp edi, SEL_ARR_BEGIN
  jnl customMenu_notUp
  mov edi, SEL_ARR_LAST
customMenu_notUp:
  cmp [KEY_DOWN], 1
  jne customMenu_notDown
  add edi, 4
  cmp edi, SEL_ARR_LAST
  jng customMenu_notDown
  mov edi, SEL_ARR_BEGIN
customMenu_notDown:

  mov [CURR_SEL], edi
  mov edi, 90

  mov eax, [SEL_STAGE]
  inc eax
  push eax
  push TXT_STAGE
  mov eax, SEL_STAGE
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  mov eax, [SEL_MODE]
  push [MODE_TXTS+eax*4]
  push TXT_MODE
  mov eax, SEL_MODE
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  mov eax, [SEL_DIFF]
  push [DIFF_TXTS+eax*4]
  push TXT_DIFF
  mov eax, SEL_DIFF
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  push [FRAME_COUNT_INIT]
  push TXT_FRAME
  mov eax, FRAME_COUNT_INIT
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  cmp dword ptr [SEL_MODE], 0
  jne draw_section
  mov eax, [SEL_STAGE]
  mov ebx, [PATTERNS_TABLE+eax*4]
  mov eax, [PATTERN_WARP]
  mov ebx, [ebx+eax*4]
  push ebx
  push TXT_PATTERN
  mov eax, PATTERN_WARP
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10
  jmp draw_row_done
draw_section:
  mov eax, [SEL_SECTION]
  inc eax
  push eax
  push TXT_SECTION
  mov eax, PATTERN_WARP
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10
draw_row_done:

  push [SEL_POWER]
  push TXT_POWER
  mov eax, SEL_POWER
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  push [SEL_POWER2]
  push TXT_POWER2
  mov eax, SEL_POWER2
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  push [SEL_FLASHBOMB]
  push TXT_FLASHBOMB
  mov eax, SEL_FLASHBOMB
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  push [SEL_RESOURCE]
  push TXT_RESOURCE
  mov eax, SEL_RESOURCE
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  push [SEL_LIFE]
  push TXT_LIFE
  mov eax, SEL_LIFE
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  push [SEL_BOMB]
  push TXT_BOMB
  mov eax, SEL_BOMB
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 14
  add edi, 10

  mov eax, [SEL_SCORE]
  cdq
  mov ebx, 3E8 // 1000
  div ebx
  push edx
  push eax
  push TXT_SCORE
  mov eax, SEL_SCORE
  call getColor
  push eax
  push ff
  push ff
  call getTextTexture
  add esp, 0c
  push eax
  push edi
  push 30
  call drawTextTexture
  add esp, 18
  add edi, 10


  mov eax, [SEL_DIFF]
  mov [DIFF], eax
  popad
  popfd
  mov eax, [SEL_STAGE]
  mov [edi+67C], eax
  mov dword ptr [IS_PRAC], 1

  jmp customMenuRender_ret

beginPracticeStage:

  pushfd
  pushad
  call preparePracticeState
  // Hit counter is per ATTEMPT, not per life: reset it here (a fresh practice
  // start) and NOT in initFrameTimer, which also fires on every respawn and
  // was zeroing the count immediately after each hit.
  mov dword ptr [OVL_V_HIT], 0
  // NOTE: hint_load used to be called from here.  That was wrong.  This
  // function runs BEFORE the stage object has ever been through
  // initFrameTimer, so OVL_STAGE was still 0 (first start) or the PREVIOUS
  // stage's object (second start) -- and hint_load derives the stage to load
  // from OVL_STAGE.  Le02 loads from initFrameTimer, right after the stage
  // pointer is stashed, and so do we now; see below.
  popad
  popfd
  mov edi, ecx
  xorps xmm0, xmm0
  jmp beginPracticeStage_ret

initFrameTimer:

  pushfd
  push eax
  mov [OVL_STAGE], edi           // Le02 stashes the stage object here too
  mov dword ptr [edi+4C], 0
  // ---- Z Replay segment marker ----------------------------------------
  // This hook is the one point guaranteed to run at EVERY stage start, and it
  // is the same point that zeroes the frame counter.  Z Replay uses it as the
  // segment boundary: a recording and a playback then begin on exactly the
  // same game frame.  (Detecting it from [stage+0x4C] going backwards does NOT
  // work -- during the stage load OVL_STAGE can still point at the old, freed
  // object, so the "first decrease" lands on a garbage value and the two runs
  // start a frame apart.  Measured: that made frame 0 itself mismatch.)
  mov dword ptr [ZREP_SEG_NEW], 1
  inc dword ptr [ZREP_INITN]
  // A new stage means the player object from the previous one is gone; drop
  // the pointer until the power clamp hands us the new one (see setPracFalse
  // for what happens when a stale OVL_PLAYER is dereferenced).
  mov dword ptr [OVL_PLAYER], 0
  // ---- hints are (re)loaded HERE, exactly like Le02 -------------------
  // The stage pointer above is live and [edi+0x30] already carries the real
  // stage number, so hint_load always picks the stage we are actually on.
  // Le02 does this on every initFrameTimer too; the cost is a directory
  // enumeration plus a couple of small file reads.
  call hint_load
  mov dword ptr [MUSIC_PLAYED], 0
  mov dword ptr [MUSIC_KIND], 0
  cmp dword ptr [IS_PRAC], 1
  jne frame_done
  mov eax, [FRAME_COUNT_INIT]
  mov [edi+4C], eax
frame_done:
  pop eax
  popfd
  jmp initFrameTimer_ret

applyPatternIdWarp:

  pushfd
  push ebx
  cmp dword ptr [IS_PRAC], 1
  jne boss_done
  mov ebx, [SELECTED_ID]
  cmp ebx, 0
  jl boss_done
  mov [eax+44], ebx
boss_done:
  pop ebx
  popfd
  mov [esi], eax
  call game+2EB0CF
  jmp applyPatternIdWarp_ret

setPracFalse:
  mov dword ptr [IS_PRAC], 0
  // ---- drop the player pointer the moment practice ends -------------------
  // OVL_PLAYER is a pointer to the LIVE player object; it is written every
  // frame by the power clamp (ovl_lockpower) and read by ovl_getpos and
  // hint_capture.  When practice ends the object is freed, but OVL_PLAYER kept
  // pointing at it.  ovl_getpos' guard is only "does this look like a pointer"
  // (0x10000..0x7fff0000), and a freed block that has been reused for text
  // passes that easily -- the game then died with 0xC0000005 inside
  // `cvttss2si ecx,[eax]` reading the position floats.  That is the flaky
  // in-stage-restart crash: ESC -> restart ends practice (this function runs,
  // IS_PRAC goes to 0), the overlay keeps drawing the calibration cross, and
  // whether it exploded depended on what the allocator had put in the freed
  // block.  Clearing the pointer makes the first range check reject it.
  mov dword ptr [OVL_PLAYER], 0
  call game+10E020
  jmp setPracFalse_ret

setPower:
  pushfd
  push eax
  push edx
  cmp dword ptr [IS_PRAC], 1
  jne power_done
  mov eax, [edi]
  mov eax, [eax]
  mov edx, [SEL_POWER]
  mov [eax+7C], edx
  mov edx, [SEL_FLASHBOMB]
  mov [eax+6C], edx
  mov edx, [SEL_POWER2]
  mov [eax+80], edx
  mov edx, [SEL_RESOURCE]
  mov [eax+94], edx
  mov edx, [SEL_LIFE]
  mov [eax+48], edx
  mov edx, [SEL_BOMB]
  mov [eax+60], edx
power_done:
  pop edx
  pop eax
  popfd
  mov dword ptr [edi+2834], 0
  jmp setPower_ret

setScore:

  pushfd
  push ebx
  mov dword ptr [eax+58], 0
  cmp dword ptr [IS_PRAC], 1
  jne score_done
  mov ebx, [SEL_SCORE]
  imul ebx, ebx, 3E8
  mov [eax+58], ebx
score_done:
  pop ebx
  popfd
  jmp setScore_ret

musicFix1:
  mov eax, [esi+4C]
  cmp dword ptr [IS_PRAC], 1
  jne music_original
  cmp dword ptr [MUSIC_PLAYED], 0
  je music_first
  cmp dword ptr [MUSIC_PLAYED], 1
  jne music_original
  push edx
  mov edx, [SEL_STAGE]
  mov edx, [BOSS_FRAMES+edx*4]
  cmp [FRAME_COUNT_INIT], edx
  pop edx
  jl music_original
  mov dword ptr [MUSIC_PLAYED], 2
  mov dword ptr [MUSIC_KIND], 1
  call selectBossMusicKind
  cmp eax, eax
  jmp musicFix1_ret
music_first:
  call prepareAlphaMusic
  cmp eax, [esi+6C]
  jl music_original
  mov dword ptr [MUSIC_PLAYED], 1
  mov dword ptr [MUSIC_KIND], 0
  cmp eax, eax
  jmp musicFix1_ret
music_original:
  cmp eax, [esi+6C]
  jmp musicFix1_ret

musicFix2:

  cmp dword ptr [IS_PRAC], 1
  jne music_normal_kind
  push dword ptr [MUSIC_KIND]
  jmp music_push_stage
music_normal_kind:
  push 0
music_push_stage:
  push dword ptr [esi+30]
  jmp musicFix2_ret

selectBossMusicKind:
  cmp dword ptr [esi+30], 4
  jne music_route_done
  push edx
  mov edx, [esi+38]
  cmp edx, 2
  ja music_route_pop
  inc edx
  mov [MUSIC_KIND], edx
music_route_pop:
  pop edx
music_route_done:
  ret
prepareAlphaMusic:
  cmp dword ptr [esi+30], 8
  jne music_alpha_return
  mov dword ptr [MUSIC_PLAYED], 2
  mov dword ptr [MUSIC_KIND], 1
  // Alpha has no stage track and its boss appears before the stage-music time.
  add esp, 4
  cmp eax, eax
  jmp musicFix1_ret
music_alpha_return:
  ret

musicAlphaGate:

  cmp dword ptr [IS_PRAC], 1
  jne music_alpha_original
  cmp dword ptr [MUSIC_KIND], 1
  je musicAlphaGate_ret
music_alpha_original:
  cmp dword ptr [esi+30], 8
  je game+EC288
  jmp musicAlphaGate_ret

musicBossSchedule:

  cmp dword ptr [IS_PRAC], 1
  jne music_immediate
  cmp dword ptr [MUSIC_KIND], 0
  je music_immediate
  // Native boss music uses a ten-tick deferred load, with three stack arguments.
  pop eax
  pop edx
  push 0
  push edx
  push eax
  call game+113A0
  jmp musicBossSchedule_ret
music_immediate:
  call game+111F0
  jmp musicBossSchedule_ret

// The game has two player-init paths and we do not know which one runs
// last, so write Life/Bomb in both -- setPower above, and these two.
life_stub:
  cmp dword ptr [IS_PRAC], 1
  jne life_stub_orig
  mov ecx, [edi]
  mov eax, [SEL_LIFE]
  mov [ecx+48], eax
  jmp life_stub_ret
life_stub_orig:
  mov dword ptr [eax+48], 3
  jmp life_stub_ret
bomb_stub:
  cmp dword ptr [IS_PRAC], 1
  jne bomb_stub_orig
  mov eax, [SEL_BOMB]
  jmp bomb_stub_ret
bomb_stub_orig:
  mov eax, [edi+eax*4+C0]
  jmp bomb_stub_ret
mgrNudge:
  push eax
  push ecx
  push edx
  cmp dword ptr [IS_PRAC], 1
  jne mgrNudge_out
  cmp dword ptr [SEL_MODE], 1
  jne mgrNudge_out
  mov eax, [edi]
  test eax, eax
  je mgrNudge_out
  cmp dword ptr [eax+48], 0
  jne mgrNudge_out
  mov eax, [edi+28]
  dec eax
  cmp eax, 7
  ja mgrNudge_out
  mov ecx, [BOSS_FRAMES+eax*4]
  dec ecx
  cmp [edi+d4], ecx
  jne mgrNudge_out
  inc dword ptr [edi+d4]
mgrNudge_out:
  pop edx
  pop ecx
  pop eax
  mov ecx, [edi+d4]
  jmp mgrNudge_ret

wrap_latch:
  // esi still holds this row's SEL_DATA fast flag.  Only the
  // hold-to-scroll rows need the dwell; a slow row already needs a fresh
  // key press for every single step, so it cannot run away on its own.
  cmp esi, 0
  je wrap_latch_ret
  mov dword ptr [WRAP_LOCK], 1
  mov dword ptr [WRAP_TIMER], 12 // 18 frames, about 0.3 s
wrap_latch_ret:
  ret
getBossExtraFlag:
  // ecx and edx are live at every bossBombGate site, so preserve them.
  push ecx
  push edx
  mov al, [ebx+A5]
  cmp dword ptr [IS_PRAC], 1
  jne boss_extra_return
  // Ground truth: what the practice menu is set to right now.
  mov ecx, [SEL_STAGE]
  cmp ecx, 6
  jl boss_extra_scene
  cmp ecx, 7
  jg boss_extra_scene
  mov ecx, [SEL_DIFF]
  cmp ecx, 5
  jl boss_extra_scene
  cmp ecx, 6
  jg boss_extra_scene
  mov al, 1
  jmp boss_extra_return
boss_extra_scene:
  // BAN's scene-snapshot test, kept as a second opinion.
  cmp dword ptr [ebx+30], 7
  jl boss_extra_return
  cmp dword ptr [ebx+30], 8
  jg boss_extra_return
  cmp dword ptr [ebx+34], 5
  jl boss_extra_return
  cmp dword ptr [ebx+34], 6
  jg boss_extra_return
  mov al, 1
boss_extra_return:
  pop edx
  pop ecx
  ret

bossBombGate0:

  push eax
  call getBossExtraFlag
  cmp al, 1
  pop eax
  jmp bossBombGate0_ret

bossBombGate1:

  push eax
  call getBossExtraFlag
  cmp al, 1
  pop eax
  jmp bossBombGate1_ret

bossBombGate2:

  push eax
  call getBossExtraFlag
  cmp al, 1
  pop eax
  jmp bossBombGate2_ret

bossBombGate3:

  push eax
  call getBossExtraFlag
  cmp al, 1
  pop eax
  jmp bossBombGate3_ret

bossBombGate4:

  push eax
  call getBossExtraFlag
  cmp al, 0
  pop eax
  jmp bossBombGate4_ret

getPhase:
  xor eax, eax
  cmp dword ptr [IS_PRAC], 1
  jne phase_return
  mov eax, [SELECTED_PHASE]
phase_return:
  ret

pmTimer:

  pushfd
  push eax
  call getPhase
  mov eax, [PM_REMAINING+eax*4]
  mov [ebx+9E0], eax
  pop eax
  popfd
  jmp pmTimer_ret

pmElapsed:

  mov dword ptr [eax+6C], 0
  pushfd
  push eax
  push edx
  mov edx, eax
  cmp dword ptr [edx+44], 13
  jne pm_elapsed_done
  call getPhase
  mov eax, [PM_ELAPSED+eax*4]
  mov [edx+6C], eax
pm_elapsed_done:
  pop edx
  pop eax
  popfd
  jmp pmElapsed_ret

pmClear:

  push eax
  call getPhase
  cmp eax, 2
  jl pm_clear_original
  cmp edi, [PM_ELAPSED+eax*4]
  pop eax
  je game+7187F
  jmp pmClear_ret
pm_clear_original:
  pop eax
  cmp edi, 4B0
  je game+718B2
  jmp pmClear_ret

customMenuSwitchClb:
  mov eax, [CURR_SEL]
  cmp eax, SEL_STAGE
  jne callback_pattern
  mov dword ptr [FRAME_COUNT_INIT], 0
  mov dword ptr [PATTERN_WARP], 0
  mov dword ptr [SEL_SECTION], 0
callback_pattern:
  mov eax, [SEL_STAGE]
  cmp dword ptr [SEL_MODE], 0
  jne callback_section
  movzx ebx, byte ptr [MAX_PATTERNID+eax]
  cmp [PATTERN_WARP], ebx
  jle callback_in_range
  mov [PATTERN_WARP], ebx
callback_in_range:
  mov ecx, [PATTERN_WARP]
  mov ebx, [IDS_TABLE+eax*4]
  mov edx, [ebx+ecx*4]
  mov [SELECTED_ID], edx
  mov ebx, [PHASES_TABLE+eax*4]
  mov ebx, [ebx+ecx*4]
  mov [SELECTED_PHASE], ebx
  // Boss mode: the frame is part of the pattern, and a frame that does
  // not match the pattern desyncs the boss and can crash the game, so
  // re-derive it on every change -- that makes the Frame row read-only.
  cmp edx, 0
  jl callback_none
  movzx ebx, byte ptr [MBOSS_PATTERN_CNT+eax]
  cmp edx, ebx
  jge callback_boss
  mov eax, [MBOSS_FRAMES+eax*4]
  jmp callback_frame
callback_boss:
  mov eax, [BOSS_FRAMES+eax*4]
callback_frame:
  mov [FRAME_COUNT_INIT], eax
  jmp callback_done
callback_none:
  mov dword ptr [FRAME_COUNT_INIT], 0
  jmp callback_done
callback_section:
  // Section mode: the frame is the user's to nudge; only re-derive it
  // when something other than the Frame row changed.
  cmp dword ptr [CURR_SEL], FRAME_COUNT_INIT
  je callback_done
  mov dword ptr [PATTERN_WARP], 0
  mov dword ptr [SELECTED_ID], ffffffff
  mov dword ptr [SELECTED_PHASE], 0
  movzx ebx, byte ptr [SECTION_CNT+eax]
  test ebx, ebx
  jz callback_sec_none
  dec ebx
  cmp [SEL_SECTION], ebx
  jle callback_sec_ok
  mov [SEL_SECTION], ebx
callback_sec_ok:
  mov ecx, [SEL_SECTION]
  mov ebx, [SECTION_TABLE+eax*4]
  mov ebx, [ebx+ecx*4]
  mov [FRAME_COUNT_INIT], ebx
  // If this chapter starts PAST the midboss frame, the game never runs its
  // `timer == midboss_frame` branch, so [boss+0x48] stays 0 (midboss) and the
  // boss frame plays the MIDBOSS's pattern set.  Point the boss's starting
  // pattern at this stage's first BOSS pattern instead -- the game's own
  // applyPatternIdWarp then writes [boss+0x44] = SELECTED_ID.
  mov eax, [SEL_STAGE]
  mov ecx, [MBOSS_FRAMES+eax*4]
  cmp [FRAME_COUNT_INIT], ecx
  jle callback_sec_no_boss
  movzx ecx, byte ptr [MBOSS_PATTERN_CNT+eax]
  inc ecx
  mov [PATTERN_WARP], ecx
  mov ebx, [IDS_TABLE+eax*4]
  mov ebx, [ebx+ecx*4]
  mov [SELECTED_ID], ebx
  mov ebx, [PHASES_TABLE+eax*4]
  mov ebx, [ebx+ecx*4]
  mov [SELECTED_PHASE], ebx
  jmp callback_done
callback_sec_no_boss:
  mov dword ptr [PATTERN_WARP], 0
  jmp callback_done
callback_sec_none:
  mov dword ptr [SEL_SECTION], 0
  mov dword ptr [FRAME_COUNT_INIT], 0
callback_done:
  ret
getColor:
  cmp [CURR_SEL], eax
  je color_selected
  mov eax, FF
  ret
color_selected:
  xor eax, eax
  ret

preparePracticeState:
  mov dword ptr [RECORD_VALID], 0
  cmp byte ptr [game+B0A554], 0
  jne practice_state_inactive
  cmp byte ptr [game+B0A552], 0
  jne practice_state_replay
  cmp byte ptr [game+B0A551], 1
  jne practice_state_inactive
  cmp dword ptr [IS_PRAC], 1
  jne practice_state_inactive
  mov eax, [SEL_STAGE]
  mov [RECORD_CONFIG+10], eax
  mov eax, [SEL_DIFF]
  mov [RECORD_CONFIG+14], eax
  mov eax, [FRAME_COUNT_INIT]
  mov [RECORD_CONFIG+18], eax
  mov eax, [PATTERN_WARP]
  mov [RECORD_CONFIG+1C], eax
  mov eax, [SEL_POWER]
  mov [RECORD_CONFIG+20], eax
  mov eax, [SEL_POWER2]
  mov [RECORD_CONFIG+24], eax
  mov eax, [SEL_FLASHBOMB]
  mov [RECORD_CONFIG+28], eax
  mov eax, [SEL_RESOURCE]
  mov [RECORD_CONFIG+2C], eax
  mov eax, [SEL_SCORE]
  mov [RECORD_CONFIG+30], eax
  mov eax, [SELECTED_ID]
  mov [RECORD_CONFIG+34], eax
  mov eax, [SELECTED_PHASE]
  mov [RECORD_CONFIG+38], eax
  mov dword ptr [RECORD_CONFIG], 5250454C
  mov dword ptr [RECORD_CONFIG+4], 50524341
  mov dword ptr [RECORD_CONFIG+8], 1
  mov dword ptr [RECORD_CONFIG+C], 3
  mov esi, RECORD_CONFIG
  xor eax, eax
  mov ecx, F
practice_checksum:
  xor eax, [esi]
  add esi, 4
  loop practice_checksum
  mov [RECORD_CONFIG+3C], eax
  mov dword ptr [RECORD_VALID], 1
  ret
practice_state_replay:
  cmp dword ptr [REPLAY_VALID], 1
  jne practice_state_inactive
  mov eax, [REPLAY_CONFIG+10]
  mov [SEL_STAGE], eax
  mov eax, [REPLAY_CONFIG+14]
  mov [SEL_DIFF], eax
  mov eax, [REPLAY_CONFIG+18]
  mov [FRAME_COUNT_INIT], eax
  mov eax, [REPLAY_CONFIG+1C]
  mov [PATTERN_WARP], eax
  mov eax, [REPLAY_CONFIG+20]
  mov [SEL_POWER], eax
  mov eax, [REPLAY_CONFIG+24]
  mov [SEL_POWER2], eax
  mov eax, [REPLAY_CONFIG+28]
  mov [SEL_FLASHBOMB], eax
  mov eax, [REPLAY_CONFIG+2C]
  mov [SEL_RESOURCE], eax
  mov eax, [REPLAY_CONFIG+30]
  mov [SEL_SCORE], eax
  mov eax, [REPLAY_CONFIG+34]
  mov [SELECTED_ID], eax
  mov eax, [REPLAY_CONFIG+38]
  mov [SELECTED_PHASE], eax
  mov eax, [SEL_STAGE]
  inc eax
  mov [game+B0A548], eax
  mov eax, [SEL_DIFF]
  mov [DIFF], eax
  mov dword ptr [IS_PRAC], 1
  ret
practice_state_inactive:
  mov dword ptr [IS_PRAC], 0
  ret
validateReplayConfig:
  cmp dword ptr [REPLAY_CONFIG], 5250454C
  jne replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+4], 50524341
  jne replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+8], 1
  jne replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+C], 3
  jne replay_config_bad
  mov esi, REPLAY_CONFIG
  xor eax, eax
  mov ecx, 10
replay_checksum:
  xor eax, [esi]
  add esi, 4
  loop replay_checksum
  test eax, eax
  jne replay_config_bad
  mov eax, [REPLAY_CONFIG+10]
  cmp eax, 7
  ja replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+14], 6
  ja replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+18], FFFF
  ja replay_config_bad
  mov ecx, [REPLAY_CONFIG+1C]
  movzx edx, byte ptr [MAX_PATTERNID+eax]
  cmp ecx, edx
  ja replay_config_bad
  mov edx, [IDS_TABLE+eax*4]
  mov edx, [edx+ecx*4]
  cmp edx, [REPLAY_CONFIG+34]
  jne replay_config_bad
  mov edx, [PHASES_TABLE+eax*4]
  mov edx, [edx+ecx*4]
  cmp edx, [REPLAY_CONFIG+38]
  jne replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+20], 1F4
  ja replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+24], 1F4
  ja replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+28], FA0
  ja replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+2C], 2710
  ja replay_config_bad
  cmp dword ptr [REPLAY_CONFIG+30], FFFF
  ja replay_config_bad
  mov eax, 1
  ret
replay_config_bad:
  xor eax, eax
  ret

replayLoadBegin:

  mov dword ptr [REPLAY_VALID], 0
  mov dword ptr [esi+8], 0
  jmp replayLoadBegin_ret

replayLoadSettings:

  call game+2EA71C
  pushfd
  pushad
  cmp dword ptr [ebp-8C], 0
  je replay_load_body_complete
  cmp eax, 1
  jne replay_load_done
replay_load_body_complete:
  cmp byte ptr [esi+74], 1
  jne replay_load_done
  push dword ptr [ebp-88]
  push 1
  push 40
  push REPLAY_CONFIG
  call game+2EA71C
  add esp, 10
  cmp eax, 1
  jne replay_load_done
  call validateReplayConfig
  mov [REPLAY_VALID], eax
replay_load_done:
  popad
  popfd
  jmp replayLoadSettings_ret

replaySaveSettings:

  call game+2EB3DF
  pushfd
  pushad
  cmp dword ptr [ebp-8C], 0
  je replay_save_body_complete
  cmp eax, 1
  jne replay_save_done
replay_save_body_complete:
  cmp dword ptr [RECORD_VALID], 1
  jne replay_save_done
  cmp byte ptr [esi+74], 1
  jne replay_save_done
  push dword ptr [ebp-88]
  push 1
  push 40
  push RECORD_CONFIG
  call game+2EB3DF
  add esp, 10
replay_save_done:
  popad
  popfd
  jmp replaySaveSettings_ret
MBOSS_FRAMES:
  dd 897 9C3 D47 0 17D3 0 1963 0
BOSS_FRAMES:
  dd ED7 1A8F 19C7 2B5B 2AF7 5DB 2EDF F9
MAX_PATTERNID:
 db 6 8 A 8 B 8 1A 5
MBOSS_PATTERN_CNT:
 db 2 2 2 0 2 0 3 0
PATTERNS_TABLE:
 dd names_0
 dd names_1
 dd names_2
 dd names_3
 dd names_4
 dd names_5
 dd names_6
 dd names_7
IDS_TABLE:
 dd ids_0
 dd ids_1
 dd ids_2
 dd ids_3
 dd ids_4
 dd ids_5
 dd ids_6
 dd ids_7
PHASES_TABLE:
 dd phases_0
 dd phases_1
 dd phases_2
 dd phases_3
 dd phases_4
 dd phases_5
 dd phases_6
 dd phases_7
names_0:
 dd name_0_0
 dd name_0_1
 dd name_0_2
 dd name_0_3
 dd name_0_4
 dd name_0_5
 dd name_0_6
ids_0:
  dd FFFFFFFF 0 1 2 3 4 5
phases_0:
  dd 0 0 0 0 0 0 0
