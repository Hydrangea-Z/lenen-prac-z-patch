// Le03 1.21a practice port.
// Native-menu interaction derived from Priw8 prac.cea v0.2.
// Stage/pattern research: leprac, Oscar; phase skips: RosePenguin100.
// Target SHA-256: 955cd8fe51cd95813decf1d429578b9844a63ef9a5b8ebf048be5c2322ca1426
// CE: attach to the prepared Le03prac.exe; enable before entering practice.
// All numeric literals are hexadecimal. Do not apply to another version.
//
// v0.5.11 -- FIX: Alpha (stage 8) showed Pattern = -1 for the whole stage.
//            ovl_mirror's stage-number liveness test was written as 1..7, but
//            Le03 has eight stage entries -- stage 7 is Extra and stage 8 is
//            Alpha.  The bound is now 1..8.  Details at the test itself.
//
// v0.5.10 -- FIX: seed_hook read the wrong stack slot.  The game's seed is
//            pushed just before the call, so after pushfd + 5 pushes it sits
//            at [esp+1C] (28 decimal) -- but the hook said [esp+28], i.e. hex
//            0x28 = 40, which is 12 bytes too far.  With Lock Seed OFF (the
//            default) the RNG was therefore seeded from a stale stack dword
//            instead of the game's own seed, which desynchronises replay
//            playback and makes boss patterns differ from the recording.
//            Locking the seed masked the bug because that path overwrites
//            the value anyway.
//
// v0.5.8  -- hint cross now shares the player cross's transform (Fix X/Y was
//            applied TWICE to the player cross and never to the hints, so the
//            two disagreed by 5*(Fix-64) quarter units); hint_load moved from
//            beginPracticeStage to initFrameTimer, where Le02 has it, so it
//            always sees the live stage object; ovl_mirror self-heals
//            HINT_WANT if it ever stops matching the stage being played.
define(game,"Le03prac.exe")
define(cave,game+BE8000)
define(DIFF,game+B0A53C)
define(CHAR_IDX,game+B0A540)
define(getInput,game+82BC0)
define(getTextTexture,game+117DD0)
define(drawTextTexture,game+11EAA0)
define(KEY_DOWN,KEYS+0)
define(KEY_LEFT,KEYS+4)
define(KEY_RIGHT,KEYS+8)
define(KEY_UP,KEYS+C)
define(KEY_Z,KEYS+10)
define(KEY_X,KEYS+14)
define(KEY_SHIFT,KEYS+18)
define(HINT_NUMX,14D)
define(HINT_NUMY,190)
define(HINT_DEN,190)
define(HINT_SCALE,9C40)
define(HINT_QSCALE,27100)

[ENABLE]
