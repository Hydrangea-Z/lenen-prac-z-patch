// ---- v0.2.6: F12 overlay hook -------------------------------------------
// The present/compositor 0x578DD0 is the only place that blits the finished
// frame to the window (StretchDIBits to the window DC at 0x57934D).  Drawing
// via the game's own software renderer BEFORE that point is unreliable
// (box() writes into scene buffers that are already flushed), so instead we
// hook the instruction right after the blit, while the window DC is still
// open in ebx, and paint the overlay with native GDI.  That makes the panel
// appear in EVERY scene, on top of whatever was just presented.
game+10B52F:
 jmp ovl_present_hook
game+10B534:
// ---- D3D11 present hook -----------------------------------------------
// The overlay must be composited into the game's OWN backbuffer BEFORE it is
// presented.  Painting the desktop DC after Present (the old v0.3.0 scheme)
// is not part of the game frame: the menu was captured by screenshots but
// never appeared during play.
// 0x5F3EBC is the single direct call to the DXGI Present wrapper 0x5BACD0
// (reached only when [0xA1EAE8]!=0 and mode [0xB1BA70]==2, i.e. the D3D11
// path this build actually runs on).  The displaced 5 bytes are re-issued
// from the stub, so the stack the caller cleans at 0x5F3EC1 is unchanged.
game+1F3EBC:
 jmp ovl_d3d11_present
game+1F3EC1:
// ---- keyboard swallow hook --------------------------------------------
// 0x56DEB8 is the `push 0x100` right after the game's GetKeyboardState call;
// it converts that 256-byte buffer into the game's own key array.  Zeroing
// the buffer here while the menu is open means gameplay sees no key held.
game+16DEB8:
 jmp ovl_swallow
game+16DEBD:
// ---- No Gameover: the game-over decision (ported from Le02 game+B980C) --
// vanilla:  mov eax,[edi] / cmp [eax+0x48],0 / jg 0x4E02CE   (lives>0 -> die
//           and respawn) else the run ends.
game+E0291:
 jmp ovl_nogameover
 nop
game+E0297:
// ---- Lock Power: the power clamp that closes the player update ---------
// vanilla:  mov eax,[edi] / cmp [eax+0x7C],0 / jge / mov [eax+0x7C],0
//           mov eax,[edi] / cmp [eax+0x7C],0x1F4 / jl / mov [eax+0x7C],0x1F4
game+E076B:
 jmp ovl_lockpower
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
 nop
game+E078C:
// ---- Seed lock: the game's own seeding call (ported from Le02 game+B2BD9)
// vanilla:  mov eax,[0xF0A54C] / push eax / mov [edi+0x40],eax / call 0x4FBFC0
// This is a `call` in vanilla, so the hook is a `call` too: on entry the
// stack is [ret][seed] -- exactly what seed_hook expects.
game+D8D9B:
 call seed_hook
game+D8DA0:
game+82607:
 db 00 // cmp [edi+664], 0 -- always take the fixed-rect branch
game+826FF:
 db 68 58 01 00 00 // push 0x158 -- frame bottom 344 (was 310)
game+8273B:
 db 68 58 01 00 00 // push 0x158 -- second (white) frame pass
game+827B2:
 jmp customMenuRender
game+8295A:
customMenuRender_ret:
game+D883E:
 jmp beginPracticeStage
game+D8843:
beginPracticeStage_ret:
game+D949F:
 jmp initFrameTimer
 nop
