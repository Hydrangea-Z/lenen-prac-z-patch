// UTF-16LE strings (each terminated by a 16-bit NUL).
// These are plain labels, NOT printf formats: the overlay draws them with
// GDI TextOutW, so numeric values are composed by ovl_numtext and drawn
// separately, right-aligned.
// NOTE: every UTF-16 literal below MUST be 2-byte aligned or TextOutW fails
// outright.  cea has no `align` directive, so ovl_text fixes the alignment at
// runtime by copying the string into OVL_TXTCOPY first.
TXT_OVL_TITLE:
  db 46 00 31 00 32 00 20 00 4d 00 45 00 4e 00 55 00 00 00
// Kept short on purpose: the label column holds about twelve characters
// before it runs into the value column, so "Lock Power 2:" would not fit.
TXT_OVL_LOCKP1:
  db 4c 00 6f 00 63 00 6b 00 20 00 50 00 31 00 3a 00 20 00 00 00
TXT_OVL_LOCKP2:
  db 4c 00 6f 00 63 00 6b 00 20 00 50 00 32 00 3a 00 20 00 00 00
TXT_OVL_NOGAMEOVER:
  db 4e 00 6f 00 20 00 47 00 61 00 6d 00 65 00 6f 00 76 00 65 00 72 00 3a 00 20 00 00 00
TXT_OVL_HINT:
  db 48 00 69 00 6e 00 74 00 3a 00 20 00 00 00
TXT_OVL_PCROSS:
  db 50 00 6c 00 61 00 79 00 65 00 72 00 20 00 2b 00 3a 00 20 00 00 00
TXT_OVL_CAPTURE:
  db 43 00 61 00 70 00 74 00 75 00 72 00 65 00 3a 00 20 00 00 00
TXT_OVL_PATTERN:
  db 50 00 61 00 74 00 74 00 65 00 72 00 6e 00 3a 00 20 00 00 00
TXT_OVL_HIT:
  db 4D 00 69 00 73 00 73 00 3A 00 20 00 00 00
TXT_OVL_LOCKSEED:
  db 4c 00 6f 00 63 00 6b 00 20 00 53 00 65 00 65 00 64 00 3a 00 20 00 00 00
TXT_OVL_SEED_EDIT:
  db 53 00 65 00 65 00 64 00 5b 00 74 00 79 00 70 00 65 00 5d 00 3a 00 20 00 00 00
// ---- v0.5.15: the hint settings panel ----
// Same wording as Le01/Le02 (TXT_OVL_TITLE2 there) so the three panels are
// indistinguishable -- the "(ESC: back)" hint is the only place the panel
// tells you how to leave it.
TXT_OVL_TITLE2:
  db 46 00 31 00 32 00 20 00 2d 00 20 00 48 00 49 00 4e 00 54 00 20 00 28 00 45 00 53 00 43 00 3a 00 20 00 62 00 61 00 63 00 6b 00 29 00 00 00
TXT_OVL_HINTCOL:
  db 48 00 69 00 6e 00 74 00 20 00 63 00 6f 00 6c 00 3a 00 20 00 20 00 00 00
TXT_OVL_PSIZE:
  db 50 00 2b 00 20 00 73 00 69 00 7a 00 65 00 3a 00 20 00 20 00 20 00 00 00
TXT_OVL_PCOL:
  db 50 00 2b 00 20 00 63 00 6f 00 6c 00 3a 00 20 00 20 00 20 00 20 00 00 00
TXT_OVL_HINTCOL_EDIT:
  db 48 00 69 00 6e 00 74 00 20 00 63 00 6f 00 6c 00 5b 00 74 00 79 00 70 00 65 00 5d 00 3a 00 20 00 00 00
TXT_OVL_PCOL_EDIT:
  db 50 00 2b 00 20 00 63 00 6f 00 6c 00 5b 00 74 00 79 00 70 00 65 00 5d 00 3a 00 20 00 20 00 00 00
TXT_OVL_SEED:
  db 53 00 65 00 65 00 64 00 3a 00 20 00 00 00
TXT_OVL_FIX_X:
  db 46 00 69 00 78 00 20 00 58 00 3a 00 20 00 00 00
TXT_OVL_FIX_Y:
  db 46 00 69 00 78 00 20 00 59 00 3a 00 20 00 00 00
TXT_OVL_FRAME:
  db 46 00 72 00 61 00 6d 00 65 00 3a 00 20 00 00 00
TXT_OFF:
  db 4f 00 46 00 46 00 00 00
TXT_ON:
  db 4f 00 4e 00 00 00
TXT_OVL_FACE:
  db 43 00 6f 00 6e 00 73 00 6f 00 6c 00 61 00 73 00 00 00
// For resolving GdiFlush at runtime (see ovl_flush).
TXT_GDI32:
  db 67 00 64 00 69 00 33 00 32 00 2e 00 64 00 6c 00 6c 00 00 00
TXT_GDIFLUSH:
  db 47 64 69 46 6c 75 73 68 00
// ---- Z Replay data -----------------------------------------------------
// Frames of stage construction to skip before the stream starts.  Comparing
// from the very first frame compared an unbuilt object on one side (measured:
// lives 3 vs 0 at frame 1), which poisoned every later comparison.
// Diagnostic override for the playback mask.  0 = use the recording; any other
// value replaces it, so a single key can be injected on its own.
// 1 = the fingerprint was computed from live objects, 0 = the object was
// unavailable and the frame must be skipped (not compared, not stored).
// DIAGNOSTIC ONLY.  1 = skip the frame where the mask changes, so the effect of
// an in-frame ordering difference can be isolated.  Must stay 0 in any build
// that claims "never desync" -- a skipped frame is an unverified frame.
// The 32-bit key mask the game derives from the 256-byte array.  Captured at
// the packing function's exit, so it is the value the game actually uses.
// DIAGNOSTIC ONLY.  1 = keep playing after a mismatch, recording only the first
// bad frame.  Used to observe the frames AFTER a divergence (the hashed pmask
// lags one frame).  Must stay 0 in any build that claims "never desync".
// The entity the move function is actually moving ([esi] at the hook).
SPEED_FPS:
  dd 3C          // 60 = vanilla; the Speed row edits this
TYPEDBG_ENTER:
  dd 0
TYPEDBG_DIGIT:
  dd 0
SPEED_APPLIED:
  dd 0
DLL_LOADED:
  dd 0
DLLNAME:
  db 4C 65 30 33 73 70 65 65 64 2E 64 6C 6C 00
NOVSYNC_PTR:
  dd 0
NVNAME:
  db 67 5F 6E 6F 56 73 79 6E 63 00
RBOOST:
  dd 0
ZREP_MENT:
  dd 0
// Movement arguments captured from the move function (see zrep_move_hook).
ZREP_MDIV:
  dd 0
ZREP_MDX:
  dd 0
ZREP_MDY:
  dd 0
ZREP_MMUL:
  dd 0
ZREP_SOFT:
  dd 0
ZREP_PMASK:
  dd 0
ZREP_SKIPTR:
  dd 0
ZREP_FPV:
  dd 1
ZREP_OVR:
  dd 0
ZREP_WARM:
  dd 50
ZREP_MODE:
  dd 0
// How many times the RNG generator has been entered since this segment began.
// Reset at every segment start so recording and playback count from the same
// zero.
ZREP_RNGC:
  dd 0
// OR of every mask the hook has seen since the segment began, plus a count of
// frames that carried any key at all.  Diagnostic only.
// OR of the game's own key-state array (game+0x60FB8C, DIK indexed), taken at
// the input anchor.  Diagnostic: proves whether the array is already filled by
// the time our anchor runs.
// Diagnostic: when non-zero, force DIK_RIGHT pressed in the game's own key
// array, to prove that writing that array is what actually drives the player.
// The 16 DIK codes we record and inject.  The game's own binding table at
// game+0x60FC90 is filled at RUNTIME and does not contain the shoot key, so
// using it made the playback never fire (score diverged at the first kill).
// This fixed list covers the default controls; a later version should derive it
// from the binding tables plus whatever extra keys the game reads directly.
// The key mask the keyboard hook last built (record) or injected (playback),
// so the input hook can publish it into the debug row for side-by-side compare.
ZREP_LASTM:
  dd 0
// How many bytes of the key array are non-zero this frame (diagnostic).
ZREP_NKEYS:
  dd 0
ZREP_KEYS:
  dd 2C  // DIK_Z      shoot
  dd 2D  // DIK_X      bomb
  dd 2E  // DIK_C
  dd 2A  // DIK_LSHIFT slow
  dd 36  // DIK_RSHIFT
  dd 39  // DIK_SPACE
  dd 1C  // DIK_RETURN
  dd 01  // DIK_ESCAPE
  dd C8  // DIK_UP
  dd D0  // DIK_DOWN
  dd CB  // DIK_LEFT
  dd CD  // DIK_RIGHT
  dd 1D  // DIK_LCONTROL
  dd 9D  // DIK_RCONTROL
  dd 38  // DIK_LMENU
  dd 0F  // DIK_TAB
ZREP_FORCE:
  dd 0
ZREP_KBDOR:
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
