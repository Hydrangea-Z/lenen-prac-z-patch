// Per-character default bombs, in the game's own character order.
BOMB_DEF:
  dd 3 4 2 5
LAST_CHAR:
  dd ffffffff

// Wrap dwell state (see wrap_latch).
WRAP_LOCK:
  dd 0
WRAP_TIMER:
  dd 0

// ====================== v0.2.6 F12 OVERLAY DATA ===========================
// Row format, 6 dwords:
//   +0  label (UTF-16 format string, may contain one %d)
//   +4  pointer to the value dword this row edits
//   +8  minimum
//   +C  maximum
//   +10 step
//   +14 kind: 0 = plain numeric, 1 = 0/1 switch (OVL_ALT supplies words)
// v0.5.15 splits the menu in two, exactly like Le01 v0.1.9.  OVL_ROWS is what
// F12 shows; OVL_ROWS2 is the HINT SETTINGS panel, reached by pressing Z on
// the main table's Hint row.  Only one is live at a time (OVL_SUB), and every
// row operation resolves its row through OVL_ACTIVE_*, so no code has to know
// which table it is working on -- that is what keeps the descriptor-driven
// dispatch (never a row INDEX) working across the split.
OVL_ROWS:
  dd TXT_OVL_NOGAMEOVER, OVL_V_NOGAMEOVER, 0, 1, 1, 1
  dd TXT_OVL_LOCKP1,     OVL_V_LOCKPWR,    0, 1, 1, 1
  dd TXT_OVL_LOCKP2,     OVL_V_LOCKPWR2,   0, 1, 1, 1
  dd TXT_OVL_HINT,       OVL_V_HINT,       0, 1, 1, 1
  dd TXT_OVL_LOCKSEED,   OVL_V_LOCKSEED,   0, 1, 1, 1
  dd TXT_OVL_SEED,       OVL_V_SEED,       0, FFFFFFFF, 1, 0
  dd TXT_OVL_HIT,        OVL_V_HIT,        0, 0, 0, 0
  dd TXT_OVL_SPEED,     SPEED_FPS,       0F, 0F0, 0F, 0
  dd TXT_OVL_RBOOST,    RBOOST,          0, 1,      1, 1
  // v0.12.0-alpha: player-assist switches, always visible (ROWFLAG 0).
  dd TXT_OVL_LOCKBOMB,  OVL_V_LOCKBOMB,   0, 1, 1, 1
  dd TXT_OVL_AUTOBOMB,  OVL_V_AUTOBOMB,   0, 1, 1, 1
OVL_ROWS_N:
  dd B                         // HEX!  `dd 11` would be 17 rows, which walks
                               // off OVL_ROWS/OVL_ALT and crashes.

// The hint settings panel.  Same six-dword shape, same descriptor dispatch.
//   Hint col / P+ col  -- colour rows: left/right walk PP_PRESETS, Z types a
//                         6-digit hex value (see ovl_colour_step).
//   P+ size            -- the Player+ cross arm, in logical pixels.
//   Fix X / Fix Y      -- 1/8 logical pixel per step, 80 (128) = neutral.
OVL_ROWS2:
  dd TXT_OVL_HINT,       OVL_V_HINT,       0, 1, 1, 1
  dd TXT_OVL_HINTCOL,    HINT_COL,         0, FFFFFF, 1, 0
  dd TXT_OVL_PCROSS,     OVL_V_PCROSS,     0, 1, 1, 1
  dd TXT_OVL_PSIZE,      OVL_V_PSIZE,      1, 40, 1, 0
  dd TXT_OVL_PCOL,       OVL_V_PCOL,       0, FFFFFF, 1, 0
  dd TXT_OVL_FIX_X,      HINT_DX,          0, 100, 1, 0
  dd TXT_OVL_FIX_Y,      HINT_DY,          0, 100, 1, 0
  dd TXT_OVL_CAPTURE,    OVL_V_CAPTURE,    0, 0, 0, 0
  dd TXT_OVL_FRAME,      OVL_V_FRAME,      0, 0, 0, 0
  dd TXT_OVL_PATTERN,    OVL_V_PATTERN,    0, 0, 0, 0
OVL_ROWS2_N:
  dd A

// Per-row alt-word tables (only rows with max==1 and min==0 use these).
OVL_ALT:
  dd ALT_NOGAMEOVER
  dd ALT_NOGAMEOVER
  dd ALT_NOGAMEOVER
  dd ALT_NOGAMEOVER
  dd ALT_NOGAMEOVER
  dd 0
  dd 0
  dd 0
  dd ALT_NOGAMEOVER
  dd ALT_LOCKBOMB
  dd ALT_AUTOBOMB

OVL_ALT2:
  dd ALT_NOGAMEOVER
  dd 0
  dd ALT_NOGAMEOVER
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0

// Parallel to the row tables: 0, or a pointer to a colour the row should show
// as a swatch at the right-hand end.  A swatch is how a colour row stays
// readable no matter what the text formatter does with the hex value.
OVL_SWATCH:
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0                       // one entry per OVL_ROWS row (11)

OVL_SWATCH2:
  dd 0
  dd HINT_COL
  dd 0
  dd 0
  dd OVL_V_PCOL
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0

// The live row set.  ovl_set_active fills these from OVL_SUB once per frame
// (and again before drawing), so the renderer and the input handler always
// agree even if the flag changes in between.
OVL_ACTIVE_TBL:
  dd OVL_ROWS
OVL_ACTIVE_N:
  dd 6
OVL_ACTIVE_CUR:
  dd OVL_SELROW
OVL_ACTIVE_ALT:
  dd OVL_ALT
OVL_ACTIVE_SW:
  dd OVL_SWATCH

// Preset colours for the two colour rows, in HTML order (0x00RRGGBB).
// Left/right on a colour row walks this list; Z types an exact value.
// 0x000000 is deliberately NOT in the list -- it is the "not specified"
// sentinel in the hint-file colour column.
PP_PRESETS:
  dd 0FFFFFF      // white
  dd 0FFFFA0      // pale yellow (Le03's own marker tint)
  dd 0FF0000      // red
  dd 0FF8000      // orange
  dd 0FFFF00      // yellow
  dd 000FF00      // green
  dd 000FFFF      // cyan
  dd 00000FF      // blue
  dd 08000FF      // violet
  dd 0FF00FF      // magenta
  dd 0FF80C0      // pink
  dd 0808080      // grey
PP_PRESETS_N:
  dd C

TXT_OVL_SPEED:
  db 53 00 70 00 65 00 65 00 64 00 00 00
TXT_OVL_RBOOST:
  db 52 00 65 00 70 00 6C 00 61 00 79 00 20 00 62 00 6F 00 6F 00 73 00 74 00 00 00
ALT_NOGAMEOVER:
  dd TXT_OFF
  dd TXT_ON
OVL_V_NOGAMEOVER:
  dd 0
OVL_V_LOCKPWR:
  dd 0
// The partner character's power lock.  Le03 only -- Le01/Le02 have a single
// power value, which is why their menus have one Lock Power row.
OVL_V_LOCKPWR2:
  dd 0
OVL_PLAYER:
  dd 0
// Lock Power latches onto the live power on the first frame after enabling.
// One latch + target per character, so the two rows are independent.
OVL_LP_HELD:
  dd 0
OVL_LP_TARGET:
  dd 0
OVL_LP_HELD2:
  dd 0
OVL_LP_TARGET2:
  dd 0
// The stage object, stashed by the initFrameTimer hook.  Le02 keeps the same
// pointer (its DBG_STAGE) and mirrors [stage+0x4C] into the Frame row.
OVL_STAGE:
  dd 0
OVL_TXTCNT:
  dd 0
// What the RNG was actually seeded with (Le02's SEED_USED), and the edge
// state for the Lock Seed switch.
SEED_USED:
  dd 0
OVL_PREV_SEEDSW:
  dd 0
// Seed typing mode (Le02's OVL_TYPE_*).  OVL_TYPE_ROW remembers WHICH row is
// in typing mode so its label can be restored without a row index.
OVL_TYPE_ON:
  dd 0
OVL_TYPE_OLD:
  dd 0
OVL_TYPE_FRESH:
  dd 0
OVL_TYPE_LAST:
  dd 0
OVL_TYPE_ROW:
  dd 0
// v0.5.15 generalises the entry mode so the two colour rows can use it too.
//   OVL_TYPE_KIND 0 = decimal (the seed), 1 = six hex nibbles (a colour)
//   OVL_TYPE_VAL  pointer to the dword being edited (never a row index)
//   OVL_TYPE_ORIG the row's original label, restored on exit
//   OVL_TYPE_HEXN how many hex nibbles have been typed, counted from the LEFT
OVL_TYPE_KIND:
  dd 0
OVL_TYPE_VAL:
  dd 0
OVL_TYPE_ORIG:
  dd 0
OVL_TYPE_HEXN:
  dd 0
// The colour a hint entry asked for, in HTML order; 0 = "not specified", in
// which case the marker uses HINT_COL.  Stashed on the record at +0x2C.
HINT_E_COL:
  dd 0
HINT_TMP_N:
  dd 0
HINT_TMP_COL:
  dd 0
// ---- hint marker (Le02's HINT_* block) --------------------------------
// Marker correction, BIASED by 0x80 because menu rows are compared unsigned
// and cannot hold a negative: 0x80 means no shift, 0x80+n moves n EIGHTHS of
// a logical unit right/down.  v0.5.15 moved this from quarter units (bias
// 0x40, range 0..0x80) to eighth units (bias 0x80, range 0..0x100) so the
// Fix rows match Le01/Le02 exactly: one count is now ~0.4 px instead of
// ~0.83, which is what it takes to land the cross on the judgement dot.
HINT_DX:
  dd 7A   // 122 -- user default (128 = neutral)
HINT_DY:
  dd 7D   // 125 -- user default
HINT_NUMBUF2:
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
HINT_LINE:
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
HINT_LINE2:
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
HINT_C_X:
  dd 0
HINT_C_Y:
  dd 0
HINT_C_F:
  dd 0
HINT_C_KIND:
  dd 0
HINT_C_PID:
  dd 0
HINT_C_PF:
  dd 0
HINT_C_EKIND:
  dd 0
HINT_C_EPID:
  dd 0
HINT_C_EF:
  dd 0
HINT_CAPLEN:
  dd 0
HINT_CAPLEN2:
  dd 0
HINT_HANDLE:
