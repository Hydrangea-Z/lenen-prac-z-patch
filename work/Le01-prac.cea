  shl eax, 7
  add eax, E877E4
  mov eax, [eax+48]
  test eax, eax
  jz ovl_hb_skip
  mov dword ptr [HB_CTX+4], eax
  mov dword ptr [HB_CTX+8], 0      // size resolved from the texture desc
  mov dword ptr [HB_CTX+C], 0
  mov dword ptr [HB_CTX+10], 42000000  // 32.0f playfield origin X
  mov dword ptr [HB_CTX+14], 41800000  // 16.0f playfield origin Y
  mov dword ptr [HB_CTX+18], 44200000  // 640.0f logical width
  mov dword ptr [HB_CTX+1C], 43F00000  // 480.0f logical height
  mov dword ptr [HB_CTX+20], 1
  push HB_CTX
  call dword ptr [HB_FN]
  add esp, 4
ovl_hb_skip:
  popad
  popfd
  jmp game+198DE0

