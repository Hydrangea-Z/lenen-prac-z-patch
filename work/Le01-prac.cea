// ==========================================================================
// Le01 practice patch  --  连缘无现里 / Evanescent Existence (CN 1.20a)
//
// Base : original Le01.exe
//        sha256 598752993abdd13a25ac9d0e3a1a5f581f6a1e4d455e418efc3ca0ff2944cf36
// Out  : Le01prac.exe
//
// The hook sites and the game-side stubs come from Priw8's Le01 practice
// patch (v0.2a); the practice MENU is ours -- the same row set, wrap/dwell
// behaviour and layout as the Le02/Le03 tools.  Priw8's "Prac patch vX.Y by
// Priw8" banner line is gone.
//
// All numeric literals are hexadecimal (CE convention).
// ==========================================================================

define(game,"Le01prac.exe")

// ---- game globals -------------------------------------------------------
define(KEYS,game+AE7A34)
define(KEY_DOWN,KEYS)
define(KEY_LEFT,KEYS+4)
define(KEY_RIGHT,KEYS+8)
define(KEY_UP,KEYS+c)
define(KEY_Z,KEYS+10)
define(KEY_X,KEYS+14)
define(KEY_SHIFT,KEYS+18)
define(DIFF,game+AE7780)          // difficulty, 0..7
define(SHOT,game+AE7784)          // 0 = Yabusame, 1 = Tsubakura, 2 = Suzumi
define(SHOT_YABU,0)
define(SHOT_TSUBA,1)
define(SHOT_SUZU,2)

// makeColor(r,g,b) -> the packed pixel value `box` wants.  NOTE: this used
// to be misnamed getTextTexture; it is the game's own colour packer (the
// real text drawer is drawTextTexture below).  The backbuffer is R8G8B8A8,
// so the packed dword is 0x00BBGGRR.  Everything WE hold stays in HTML order
// (0x00RRGGBB) and the R/B swap happens at the last moment, so the menu, the
// cfg file and the hint files all read like HTML.
define(makeColor,game+F6930)
define(drawTextTexture,game+FD610)

// ---- F12 overlay (v0.1.5) ------------------------------------------------
// box(x1,y1,x2,y2,colour,filled): the game's own 6-argument rectangle
// helper.  Identical byte-for-byte dispatcher to Le02's `box` -- it just
// lives at a different address in this build.
define(box,game+DB9D0)
// GetKeyboardState, straight out of the IAT (VA 0x7B72E8).  Reading the
// physical keyboard means the menu works in every scene without touching
// the game's own key arrays.
define(KBD_IAT,game+3B72E8)
// The game's mapped key-state array: written only by the input refresh
// (game+14B9C0), read only by the three "is this key down?" helpers.  We
// zero it while the menu is open, which is what suppresses input.
define(OVL_KEYARR,game+5EBB6C)
// Re-entrancy guard of the input refresh: the instruction we hook sets it.
define(OVL_GUARD,game+5FAAB8)

// ---- file APIs for the hint loader (same IAT layout as Le02, +0xB000) ----
define(MODULE_IAT,game+3B71B0)
define(FILE_IAT,game+3B7238)
define(READ_IAT,game+3B70E8)
WRITE_IAT_PLACEHOLDER:
define(WRITE_IAT,game+3B722C)
define(CLOSE_IAT,game+3B7250)
define(GETSIZE_IAT,game+3B70E0)
define(SEEK_IAT,game+3B70CC)
define(FINDFIRST_IAT,game+3B70D8)
define(FINDNEXT_IAT,game+3B70DC)
define(FINDCLOSE_IAT,game+3B70D4)

define(cave,game+BA9000)

