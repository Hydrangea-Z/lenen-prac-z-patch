// ==========================================================================
// F12 overlay data (v0.1.5)
// ==========================================================================

// Row table, six dwords each: label, value pointer, min, max, step, wrap.
//
// v0.1.9 splits the menu in two.  OVL_ROWS is what F12 shows; OVL_ROWS2 is
// the HINT SETTINGS panel, reached by pressing Z on the main table's Hint
// row.  Only one is live at a time (OVL_SUB), and every row operation
// resolves its row through OVL_ACTIVE_*, so no code has to know which table
// it is working on -- which is what keeps the descriptor-driven dispatch
// (never a row INDEX) working across the split.
OVL_ROWS:
  dd TXT_OVL_NOGAMEOVER OVL_V_NOGAMEOVER 0 1 1 1
  dd TXT_OVL_LOCKPWR OVL_V_LOCKPWR 0 1 1 1
  dd TXT_OVL_HINT OVL_V_HINT 0 1 1 1
  dd TXT_OVL_LOCKSEED OVL_V_LOCKSEED 0 1 1 1
  dd TXT_OVL_SEED OVL_V_SEED 0 FFFFFFFF 1000000 0
  dd TXT_OVL_DEBT OVL_V_DEBT 0 0 0 0
  dd TXT_OVL_SPEED SPEED_FPS 0F 0F0 0F 0
  // v0.5.0-alpha: player-assist switches, always visible (ROWFLAG 0).
  dd TXT_OVL_LOCKBOMB OVL_V_LOCKBOMB 0 1 1 1
  dd TXT_OVL_AUTOBOMB OVL_V_AUTOBOMB 0 1 1 1
OVL_ROWS_N:
  dd 9

// The hint settings panel.  Same six-dword shape, same descriptor dispatch.
//   Hint col / P+ col  -- colour rows: left/right walk PP_PRESETS, Z types
//                         a 6-digit hex value (see ovl_colour_step).
//   P+ size            -- the Player+ cross arm, in logical pixels.
//   Fix X / Fix Y      -- 1/8 logical pixel per step, 0x80 (128) = neutral.
OVL_ROWS2:
  dd TXT_OVL_HINT OVL_V_HINT 0 1 1 1
  dd TXT_OVL_HINTCOL HINT_COL 0 FFFFFF 1 0
  dd TXT_OVL_PCROSS OVL_V_PCROSS 0 1 1 1
  dd TXT_OVL_PSIZE OVL_V_PSIZE 1 40 1 0
  dd TXT_OVL_PCOL OVL_V_PCOL 0 FFFFFF 1 0
  dd TXT_OVL_FIX_X OVL_V_FIX_X 0 100 1 0
  dd TXT_OVL_FIX_Y OVL_V_FIX_Y 0 100 1 0
  dd TXT_OVL_CAPTURE OVL_V_CAPTURE 0 0 0 0
  dd TXT_OVL_FRAME OVL_V_FRAME 0 0 0 0
  dd TXT_OVL_PATTERN OVL_V_PATTERN 0 0 0 0
OVL_ROWS2_N:
  dd A

// Parallel to OVL_ROWS, one dword per row, same order.
//   0                -> the row draws its own format string (a number)
//   &{off,on} pair   -> the row draws that text instead, chosen by the value
OVL_ALT:
  dd ALT_NOGAMEOVER
  dd ALT_LOCKPWR
  dd ALT_HINT
  dd ALT_LOCKSEED
  dd 0
  dd 0
  dd 0
  dd ALT_LOCKBOMB
  dd ALT_AUTOBOMB

OVL_ALT2:
  dd ALT_HINT
  dd 0
  dd ALT_PCROSS
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0

// Parallel to the row tables: 0, or a pointer to a colour the row should
// show as a swatch at the right-hand end.  A swatch is how a colour row
// stays readable no matter what the text formatter does with %06X.
OVL_SWATCH:
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0

OVL_SWATCH2:
  dd 0
  dd HINT_COL
  dd 0
  dd 0
  dd OVL_V_PCOL
  dd 0
  dd 0
  dd 0
  dd 0
  dd 0

// The live row set.  ovl_set_active fills these from OVL_SUB once per frame
// (and again before drawing), so the renderer and the input handler always
// agree even if the flag changes in between.
OVL_ACTIVE_TBL:
  dd OVL_ROWS
OVL_ACTIVE_N:
  dd 6
OVL_ACTIVE_CUR:
  dd OVL_CUR
OVL_ACTIVE_ALT:
  dd OVL_ALT
OVL_ACTIVE_SW:
  dd OVL_SWATCH
// Panel bottom = 0x28 + rows*0x10 (the row pitch is 0x10 and the first row
// sits at 0x28).  At 12 rows this is 0xE8, the height this panel always had.
OVL_PANEL_B:
  dd 0

OVL_CUR:
  dd 0
OVL_CUR2:
  dd 0
OVL_SUB:
  dd 0
OVL_V_PSIZE:
  dd 4
OVL_V_PCOL:
  dd 0FFFF00      // user default: yellow (was white)
OVL_PC_COL:
  dd 0
OVL_SWX:
  dd 0C8          // where the colour swatches sit, logical x

// Preset colours for the two colour rows, in HTML order (0x00RRGGBB).
// Left/right on a colour row walks this list; Z types an exact value.
// 0x000000 is deliberately NOT in the list -- it is the "not specified"
// sentinel in the hint-file colour column.
PP_PRESETS:
  dd 0FFFFFF      // white
  dd 0FFFFA0      // pale yellow (Le03's own marker tint)
  dd 0FF0000      // red
  dd 0FF8000      // orange
  dd 0FFFF00      // yellow
  dd 000FF00      // green
  dd 000FFFF      // cyan
  dd 00000FF      // blue
  dd 08000FF      // violet
  dd 0FF00FF      // magenta
  dd 0FF80C0      // pink
  dd 0808080      // grey
PP_PRESETS_N:
  dd C

OVL_DRAWN:
  dd 0
OVERLAY_OPEN:
  dd 0
OVL_PREV_F12:
  db 0
// One byte per key whose rising edge we care about: UP, DOWN, LEFT, RIGHT, Z
OVL_PREV_KEYS:
  dd 0
  dd 0
// v0.2.0 pause-menu quick keys: +0 = R (restart), +1 = Q (return to title).
OVL_PREV_RQ:
  dd 0
OVL_HOLD_DIR:
  dd 0
OVL_HOLD_N:
  dd 0
OVL_NUDGE_N:
  dd 0
OVL_HOLD_DELAY:
  dd 14
OVL_NUDGE_EVERY:
  dd 3
OVL_RCUR:
  dd 0
OVL_RPTR:
  dd 0
OVL_RY:
  dd 0
OVL_RTXT:
  dd 0
// Live game objects, stashed by our own hooks so the read-only rows can
// poll them.  OVL_STAGE <- initFrameTimer's edi (the scene: [scene+0x30] is
// the stage number, [scene+0x48] the stage timer).  OVL_MGR <- mgrNudge's
// edi (the stage manager: [manager+0x28] the stage number, [manager] the
// boss object).
OVL_STAGE:
  dd 0
OVL_MGR:
  dd 0
OVL_PLAYER:
  dd 0            // the live player object, stashed by ovl_lockpower

// ---- hint / cross geometry ---------------------------------------------
// HINT_OX / HINT_OY are where playfield (0,0) sits in the game's own
// 640x480 logical space -- the space box() draws in.  Measured empirically
// (see Le01移植笔记.md 9.8): draw the cross at a known playfield position,
// screenshot, compare with where the ship actually is.
HINT_OX:
  dd 20
HINT_OY:
  dd 10
HINT_ARM:
  dd 4            // the default P+ size; the live value is OVL_V_PSIZE
// The marker colour lives in HINT_COL, which is ALSO the F12 row "Hint col"
// -- so a marker line that names no colour of its own follows that row, and
// the F12 row's initial value is what this build used to hard-code.
// Everything here is HTML order (0x00RRGGBB); the R/B swap for `box` happens
// at the last moment in ovl_swaprb.
HINT_COL:
  dd 0FFFF00      // user default: yellow (was white)
HINT_COL_DIM:
  dd 0404040      // no longer read -- the dim pass is computed as half of HINT_COL
// 8.0f, for the 1/8-pixel Fix X/Y scale (see draw_hints / draw_pcross).
HINT_F8:
  dd 41000000
HINT_PX:
  dd 0            // scratch: the raw playfield coords the marker saw
HINT_PY:
  dd 0
HINT_CX:
  dd 0            // scratch: the marker centre in game space
HINT_CY:
  dd 0

// ---- lock power (v0.1.7) -----------------------------------------------
// The first frame after the switch goes on captures the live power into
// OVL_LP_TARGET; every frame after that stores it back.  OVL_LP_HELD is
// cleared while the switch is off so toggling re-locks to the power you
// have right then.
OVL_LP_TARGET:
  dd 0
OVL_LP_HELD:
  dd 0

// ---- seed lock (v0.1.7) ------------------------------------------------
SEED_USED:
  dd 0            // what we actually handed the seed wrapper
OVL_PREV_SEEDSW:
  dd 0            // previous Lock Seed, for the grab-on-rising-edge
OVL_TYPE_ON:
  dd 0            // 1 while a row is in direct entry (Seed digits or a colour)
OVL_TYPE_OLD:
  dd 0            // value to restore if you press ESC
OVL_TYPE_FRESH:
  dd 0            // 1 -> the next decimal digit replaces instead of appending
OVL_TYPE_LAST:
  dd 0            // the digit key currently held (VK), 0 = none
OVL_TYPE_ROW:
  dd 0            // the row that is in typing mode (its descriptor)
// v0.1.9: typing is generic over two KINDS -- 0 = decimal (the Seed row),
// 1 = six hex digits (the two colour rows).  VAL is the value pointer to
// write, ORIG the label to put back when typing ends, HEXN how many hex
// digits have been typed.
OVL_TYPE_KIND:
  dd 0
OVL_TYPE_VAL:
  dd 0
OVL_TYPE_ORIG:
  dd 0
OVL_TYPE_HEXN:
  dd 0

// Row values.  Fix X/Y start at the neutral 0x80 (128); everything else is
// whatever this build has always used.
OVL_V_NOGAMEOVER:
  dd 0
OVL_V_LOCKPWR:
  dd 0
OVL_V_LOCKBOMB:
  dd 0
OVL_V_AUTOBOMB:
  dd 0
BOMB_TARGET:
  dd 0
BOMB_HELD:
  dd 0
OVL_V_HINT:
  dd 1            // defaults ON, like Le02/Le03
OVL_V_PCROSS:
  dd 1            // defaults ON, like Le02/Le03
OVL_V_CAPTURE:
  dd 0
OVL_V_FRAME:
  dd 0
OVL_V_PATTERN:
  dd 0
OVL_V_LOCKSEED:
  dd 0
OVL_V_SEED:
  dd 0
OVL_V_DEBT:
  dd 0
OVL_V_FIX_X:
  dd 80
OVL_V_FIX_Y:
  dd 7F          // 127 -- user default (0x80 = neutral)

// 256 bytes for GetKeyboardState.
OVL_VKBUF:
  db 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00

// ---- strings (UTF-16LE; this game's text renderer takes them straight) --
TXT_OVL_TITLE:
  db 46 00 31 00 32 00 20 00 4d 00 45 00 4e 00 55 00 00 00
TXT_OVL_NOGAMEOVER:
  db 4e 00 6f 00 20 00 47 00 61 00 6d 00 65 00 6f 00 76 00 65 00 72 00 3a 00 20 00 25 00 64 00 00 00
TXT_OVL_LOCKPWR:
  db 4c 00 6f 00 63 00 6b 00 20 00 50 00 6f 00 77 00 65 00 72 00 3a 00 20 00 20 00 25 00 64 00 00 00
TXT_OVL_HINT:
  db 48 00 69 00 6e 00 74 00 3a 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 25 00 64 00 00 00
TXT_OVL_PCROSS:
  db 50 00 6c 00 61 00 79 00 65 00 72 00 20 00 2b 00 3a 00 20 00 20 00 20 00 20 00 25 00 64 00 00 00
TXT_OVL_CAPTURE:
  db 43 00 61 00 70 00 74 00 75 00 72 00 65 00 3a 00 20 00 20 00 20 00 20 00 20 00 25 00 64 00 00 00
TXT_OVL_FRAME:
  db 46 00 72 00 61 00 6d 00 65 00 3a 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 25 00 64 00 00 00
TXT_OVL_PATTERN:
  db 50 00 61 00 74 00 74 00 65 00 72 00 6e 00 3a 00 20 00 20 00 20 00 20 00 20 00 25 00 64 00 00 00
TXT_OVL_LOCKSEED:
  db 4c 00 6f 00 63 00 6b 00 20 00 53 00 65 00 65 00 64 00 3a 00 20 00 20 00 20 00 25 00 64 00 00 00
TXT_OVL_SEED:
  db 53 00 65 00 65 00 64 00 3a 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 25 00 75 00 00 00
TXT_OVL_SEED_EDIT:
  db 53 00 65 00 65 00 64 00 5b 00 74 00 79 00 70 00 65 00 5d 00 3a 00 20 00 20 00 25 00 75 00 00 00
TXT_OVL_SPEED:
  db 53 00 70 00 65 00 65 00 64 00 3A 00 20 00 20 00 20 00 20 00 20 00 20 00 25 00 64 00 00 00
TXT_OVL_DEBT:
  db 4D 00 69 00 73 00 73 00 3A 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 25 00 64 00 00 00
TXT_OVL_FIX_X:
  db 46 00 69 00 78 00 20 00 58 00 3a 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 25 00 64 00 00 00
TXT_OVL_FIX_Y:
  db 46 00 69 00 78 00 20 00 59 00 3a 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 25 00 64 00 00 00

// ---- on/off labels for the 0..1 switch rows ----
// Each ALT_* is a 2-dword table {text_if_0, text_if_1} pointed at by the
// matching slot of OVL_ALT.  These strings carry no format specifier, so
// the value argument the draw loop pushes is simply ignored.
ALT_NOGAMEOVER:
  dd TXT_NOGAMEOVER_OFF TXT_NOGAMEOVER_ON
ALT_LOCKPWR:
  dd TXT_LOCKPWR_OFF TXT_LOCKPWR_ON
ALT_LOCKBOMB:
  dd TXT_LOCKBOMB_OFF TXT_LOCKBOMB_ON
ALT_AUTOBOMB:
  dd TXT_AUTOBOMB_OFF TXT_AUTOBOMB_ON
ALT_HINT:
  dd TXT_HINT_OFF TXT_HINT_ON
ALT_PCROSS:
  dd TXT_PCROSS_OFF TXT_PCROSS_ON
ALT_LOCKSEED:
  dd TXT_LOCKSEED_OFF TXT_LOCKSEED_ON

TXT_NOGAMEOVER_OFF:
  db 4e 00 6f 00 20 00 47 00 61 00 6d 00 65 00 6f 00 76 00 65 00 72 00 3a 00 20 00 6f 00 66 00 66 00 00 00
TXT_NOGAMEOVER_ON:
  db 4e 00 6f 00 20 00 47 00 61 00 6d 00 65 00 6f 00 76 00 65 00 72 00 3a 00 20 00 6f 00 6e 00 20 00 00 00
TXT_LOCKPWR_OFF:
  db 4c 00 6f 00 63 00 6b 00 20 00 50 00 6f 00 77 00 65 00 72 00 3a 00 20 00 20 00 6f 00 66 00 66 00 00 00
TXT_LOCKPWR_ON:
  db 4c 00 6f 00 63 00 6b 00 20 00 50 00 6f 00 77 00 65 00 72 00 3a 00 20 00 20 00 6f 00 6e 00 20 00 00 00
TXT_OVL_LOCKBOMB:
  db 4c 00 6f 00 63 00 6b 00 20 00 42 00 6f 00 6d 00 62 00 3a 00 20 00 20 00 20 00 25 00 64 00 00 00
TXT_OVL_AUTOBOMB:
  db 41 00 75 00 74 00 6f 00 20 00 42 00 6f 00 6d 00 62 00 3a 00 20 00 20 00 20 00 25 00 64 00 00 00
TXT_LOCKBOMB_OFF:
  db 4c 00 6f 00 63 00 6b 00 20 00 42 00 6f 00 6d 00 62 00 3a 00 20 00 20 00 20 00 6f 00 66 00 66 00 00 00
TXT_LOCKBOMB_ON:
  db 4c 00 6f 00 63 00 6b 00 20 00 42 00 6f 00 6d 00 62 00 3a 00 20 00 20 00 20 00 6f 00 6e 00 20 00 00 00
TXT_AUTOBOMB_OFF:
  db 41 00 75 00 74 00 6f 00 20 00 42 00 6f 00 6d 00 62 00 3a 00 20 00 20 00 20 00 6f 00 66 00 66 00 00 00
TXT_AUTOBOMB_ON:
  db 41 00 75 00 74 00 6f 00 20 00 42 00 6f 00 6d 00 62 00 3a 00 20 00 20 00 20 00 6f 00 6e 00 20 00 00 00
TXT_HINT_OFF:
  db 48 00 69 00 6e 00 74 00 3a 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 6f 00 66 00 66 00 00 00
TXT_HINT_ON:
  db 48 00 69 00 6e 00 74 00 3a 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 20 00 6f 00 6e 00 20 00 00 00
TXT_LOCKSEED_OFF:
  db 4c 00 6f 00 63 00 6b 00 20 00 53 00 65 00 65 00 64 00 3a 00 20 00 20 00 20 00 6f 00 66 00 66 00 00 00
TXT_LOCKSEED_ON:
  db 4c 00 6f 00 63 00 6b 00 20 00 53 00 65 00 65 00 64 00 3a 00 20 00 20 00 20 00 6f 00 6e 00 20 00 00 00
TXT_PCROSS_OFF:
  db 50 00 6c 00 61 00 79 00 65 00 72 00 20 00 2b 00 3a 00 20 00 20 00 20 00 20 00 6f 00 66 00 66 00 00 00
TXT_PCROSS_ON:
  db 50 00 6c 00 61 00 79 00 65 00 72 00 20 00 2b 00 3a 00 20 00 20 00 20 00 20 00 6f 00 6e 00 20 00 00 00


// ---- v0.1.9 strings: submenu title, the three new rows, and the two
//      hex-typing labels.  All UTF-16LE, same as everything above. ----
TXT_OVL_TITLE2:
  db 46 00 31 00 32 00 20 00 2D 00 20 00 48 00 49 00 4E 00 54 00 20 00 28 00 45 00 53 00 43 00 3A 00 20 00 62 00 61 00 63 00 6B 00 29 00 00 00
TXT_OVL_HINTCOL:
  db 48 00 69 00 6E 00 74 00 20 00 63 00 6F 00 6C 00 3A 00 20 00 20 00 20 00 20 00 25 00 30 00 36 00 58 00 00 00
TXT_OVL_PSIZE:
  db 50 00 2B 00 20 00 73 00 69 00 7A 00 65 00 3A 00 20 00 20 00 20 00 20 00 20 00 25 00 64 00 00 00
TXT_OVL_PCOL:
